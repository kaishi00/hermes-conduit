    "Start one from a shortcut or by asking during a call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte einen über einen Schnellbefehl oder indem du während eines Anrufs darum bittest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia uno desde un atajo o pidiéndolo durante una llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez-en un depuis un raccourci ou en le demandant pendant un appel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari perintah cepat atau dengan meminta saat panggilan."
          }
        },
        "it" : {
          "stringUnit" : {
