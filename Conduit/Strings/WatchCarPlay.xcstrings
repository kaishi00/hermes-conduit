    },
    "Add them on your iPhone in Settings, Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge sie auf deinem iPhone in den Einstellungen unter „Sprachmodus“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelos en tu iPhone en Ajustes, Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-les sur votre iPhone dans Réglages, Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan di iPhone Anda di Pengaturan, Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungile su iPhone in Impostazioni, Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneの「設定」>「音声」で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 ‘설정’ > ‘음성’으로 이동해 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj je na iPhonie w sekcji Ustawienia, Głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione-os no iPhone em Ajustes, Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте их на iPhone в разделе «Настройки › Голос»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları iPhone'unuzda Ayarlar, Ses bölümünden ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
