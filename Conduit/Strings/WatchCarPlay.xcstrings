    "Conduit on your iPhone couldn't reach Hermes. Open it once and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit auf deinem iPhone konnte Hermes nicht erreichen. Öffne die App einmal und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit en tu iPhone no pudo conectar con Hermes. Ábrelo una vez y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sur votre iPhone n'a pas pu joindre Hermes. Ouvrez-le une fois et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit di iPhone Anda tidak dapat menghubungi Hermes. Buka sekali, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit su iPhone non è riuscito a raggiungere Hermes. Aprilo una volta e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の Conduit が Hermes に接続できませんでした。一度開いてから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Conduit이 Hermes에 연결할 수 없었어요. Conduit을 한 번 연 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit na Twoim iPhonie nie mógł połączyć się z Hermesem. Otwórz go raz i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit no seu iPhone não conseguiu acessar o Hermes. Abra-o uma vez e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit на iPhone не удалось связаться с Hermes. Откройте его один раз и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzdaki Conduit, Hermes'e ulaşamadı. Bir kez açıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Conduit 无法连接 Hermes。请打开一次后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Conduit 無法連線到 Hermes。請先打開它一次，然後再試一次。"
          }
        }
      }
    },
    "Conduit on your iPhone switched to another Hermes profile or server, so this call ended." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit auf deinem iPhone hat zu einem anderen Hermes-Profil oder -Server gewechselt, daher wurde dieser Anruf beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit en tu iPhone cambió a otro perfil o servidor de Hermes, así que esta llamada terminó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sur votre iPhone est passé à un autre profil ou serveur Hermes : cet appel a donc pris fin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit di iPhone Anda beralih ke profil atau server Hermes lain, jadi panggilan ini berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit su iPhone è passato a un altro profilo o server Hermes, quindi questa chiamata è terminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の Conduit が別の Hermes プロファイルまたはサーバーに切り替わったため、この通話は終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Conduit이 다른 Hermes 프로필이나 서버로 전환되어 이 통화가 종료됐어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit na Twoim iPhonie przełączył się na inny profil lub serwer Hermes, więc to połączenie zostało zakończone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit no seu iPhone trocou para outro perfil ou servidor Hermes, então esta chamada terminou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit на вашем iPhone переключился на другой профиль или сервер Hermes, поэтому звонок завершён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzdaki Conduit başka bir Hermes profiline veya sunucusuna geçti; bu nedenle bu arama sona erdi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Conduit 切换到了其他 Hermes 配置或服务器，因此此通话已结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Conduit 已切換到其他 Hermes 設定檔或伺服器，因此此通話已結束。"
          }
        }
      }
    },
    "Hermes couldn't open GPT-Live for the Watch. Update the Conduit notifier plugin and the push relay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte GPT-Live für die Watch nicht öffnen. Aktualisiere das Conduit-Notifier-Plug-in und das Push-Relay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo abrir GPT-Live para el Apple Watch. Actualiza el plugin de notificaciones de Conduit y el relay push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n'a pas pu ouvrir GPT-Live pour l'Apple Watch. Mettez à jour le plugin de notification Conduit et le relais push."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak dapat membuka GPT-Live untuk Watch. Perbarui plugin notifier Conduit dan relai push."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è riuscito ad aprire GPT-Live per Apple Watch. Aggiorna il plugin di notifica di Conduit e il relay push."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes は Watch 用の GPT-Live を開けませんでした。Conduit 通知プラグインとプッシュリレーをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Watch용 GPT-Live를 열 수 없었어요. Conduit 알림 플러그인과 푸시 릴레이를 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie mógł otworzyć GPT-Live dla zegarka. Zaktualizuj wtyczkę powiadomień Conduit i przekaźnik push."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu abrir o GPT-Live para o Watch. Atualize o plugin notificador do Conduit e a retransmissão de push."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не удалось открыть GPT-Live для часов. Обновите плагин уведомлений Conduit и push-ретранслятор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, Watch için GPT-Live'ı açamadı. Conduit bildirim eklentisini ve bildirim aktarıcısını güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法为 Watch 打开 GPT-Live。请更新 Conduit 通知插件和推送中继。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 無法為 Apple Watch 啟動 GPT-Live。請更新 Conduit 通知外掛程式和推播中繼。"
          }
        }
      }
    },
