  "strings" : {
    "Hermes couldn't open GPT-Live for the Watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte GPT-Live für die Watch nicht öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo abrir GPT-Live para el Apple Watch."
          }
        },
        "fr" : {
