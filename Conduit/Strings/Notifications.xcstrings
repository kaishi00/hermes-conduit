    "The push relay can't send to this build of Conduit. Check the relay's APNs settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay kann nicht an diesen Build von Conduit senden. Prüfe die APNs-Einstellungen des Relays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay push no puede enviar a esta compilación de Conduit. Revisa los ajustes de APNs del relay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais push ne peut pas envoyer à cette version de Conduit. Vérifiez les réglages APNs du relais."
