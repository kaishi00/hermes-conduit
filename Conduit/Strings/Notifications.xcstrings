    "A reply to a message you sent from a source turned off here sends no Response ready notification. Applies to this profile on this dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort auf eine Nachricht, die du aus einer hier ausgeschalteten Quelle gesendet hast, löst keine „Antwort bereit“-Mitteilung aus. Gilt für dieses Profil auf diesem Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una respuesta a un mensaje que enviaste desde un origen desactivado aquí no envía la notificación «Respuesta lista». Se aplica a este perfil en este panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une réponse à un message envoyé depuis une source désactivée ici n'envoie pas de notification « Réponse prête ». S'applique à ce profil sur ce tableau de bord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balasan untuk pesan yang kamu kirim dari sumber yang dimatikan di sini tidak mengirim notifikasi Respons siap. Berlaku untuk profil ini di dasbor ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una risposta a un messaggio inviato da un'origine disattivata qui non invia la notifica «Risposta pronta». Vale per questo profilo su questa dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでオフにした送信元から送ったメッセージへの返信では「応答完了」通知は届きません。このダッシュボードのこのプロファイルに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 끈 출처에서 보낸 메시지에 대한 답장은 '응답 준비됨' 알림을 보내지 않아요. 이 대시보드의 이 프로필에 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź na wiadomość wysłaną ze źródła wyłączonego tutaj nie wysyła powiadomienia „Odpowiedź gotowa”. Dotyczy tego profilu na tym pulpicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma resposta a uma mensagem que você enviou de uma origem desativada aqui não envia a notificação “Resposta pronta”. Vale para este perfil neste painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ на сообщение, отправленное из выключенного здесь источника, не присылает уведомление «Ответ готов». Действует для этого профиля на этой панели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada kapatılan bir kaynaktan gönderdiğin mesaja verilen yanıt “Yanıt hazır” bildirimi göndermez. Bu panodaki bu profil için geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复你从此处已关闭的来源发送的消息时，不会发送“回复就绪”通知。仅适用于此仪表盘上的此配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆你從此處已關閉的來源傳送的訊息時，不會傳送「回覆就緒」通知。僅適用於此儀表板上的此設定檔。"
          }
        }
      }
    },
    "Allow notifications in Settings to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
