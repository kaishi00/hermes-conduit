        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推播中繼正忙。請一分鐘後再試。"
          }
        }
      }
    },
    "The push relay no longer knows this iPhone. Turn notifications off and on again in Settings > Notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay kennt dieses iPhone nicht mehr. Schalte Mitteilungen unter Einstellungen > Mitteilungen aus und wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay push ya no reconoce este iPhone. Desactiva y vuelve a activar las notificaciones en Ajustes > Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais push ne reconnaît plus cet iPhone. Désactivez puis réactivez les notifications dans Réglages > Notifications."
          }
        },
        "id" : {
          "stringUnit" : {
