    },
    "Apple didn't return a push token in time. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat nicht rechtzeitig ein Push-Token geliefert. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no devolvió un token push a tiempo. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n'a pas renvoyé de jeton push à temps. Vérifiez votre connexion et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple tidak mengembalikan token push tepat waktu. Periksa koneksi Anda dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple non ha restituito un token push in tempo. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleからプッシュトークンが時間内に返されませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 제시간에 푸시 토큰을 반환하지 않았어요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple nie zwróciło tokenu push na czas. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple não retornou um token de push a tempo. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не вернула push-токен вовремя. Проверьте подключение и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple zamanında bir anlık bildirim token'ı döndürmedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 未及时返回推送令牌。请检查网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 未及時傳回推播權杖。請檢查連線後再試一次。"
          }
        }
      }
    },
