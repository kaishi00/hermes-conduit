        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retransmissão de push não reconhece mais este iPhone. Desative e ative novamente as notificações em Ajustes > Notificações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-ретранслятор больше не узнаёт этот iPhone. Выключите и снова включите уведомления в разделе «Настройки» > «Уведомления»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim aktarıcısı bu iPhone'u artık tanımıyor. Ayarlar > Bildirimler'de bildirimleri kapatıp yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推送中继已不再识别这台 iPhone。请在“设置”>“通知”中关闭通知后再重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推播中繼已不再識別這支 iPhone。請在「設定」>「通知」中關閉通知後再重新開啟。"
          }
        }
      }
    },
    "The push relay's check didn't reach this iPhone in time. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüfung des Push-Relays hat dieses iPhone nicht rechtzeitig erreicht. Prüfe deine Verbindung und versuche es erneut."
