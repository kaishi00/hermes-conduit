    "Moved to the new relay. Pair each Hermes profile again to keep receiving notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum neuen Relay gewechselt. Kopple jedes Hermes-Profil erneut, um weiterhin Mitteilungen zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se movió al nuevo relay. Vuelve a vincular cada perfil de Hermes para seguir recibiendo notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transféré vers le nouveau relais. Jumelez à nouveau chaque profil Hermes pour continuer à recevoir les notifications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipindahkan ke relai baru. Pasangkan setiap profil Hermes lagi agar tetap menerima pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostato sul nuovo relay. Abbina di nuovo ogni profilo Hermes per continuare a ricevere le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいリレーに移行しました。通知を引き続き受け取るには、各Hermesプロファイルをもう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 릴레이로 옮겼어요. 계속 알림을 받으려면 각 Hermes 프로필을 다시 페어링하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesiono do nowego przekaźnika. Sparuj ponownie każdy profil Hermes, aby nadal otrzymywać powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movido para a nova retransmissão. Emparelhe cada perfil do Hermes de novo para continuar recebendo notificações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переход на новый ретранслятор выполнен. Выполните сопряжение для каждого профиля Hermes заново, чтобы продолжать получать уведомления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni aktarıcıya taşındı. Bildirim almaya devam etmek için her Hermes profilini yeniden eşleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已切换到新的中继。请重新配对每个 Hermes 配置档，以继续接收通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已改用新的中繼。請重新配對每個 Hermes 設定檔，才能繼續接收通知。"
          }
        }
      }
    },
