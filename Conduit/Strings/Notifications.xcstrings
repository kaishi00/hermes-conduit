    },
    "This Hermes can't update plugins from Conduit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes kann Plugins nicht aus Conduit aktualisieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes no puede actualizar plugins desde Conduit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Hermes ne peut pas mettre à jour de plugins depuis Conduit"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ini tidak dapat memperbarui plugin dari Conduit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Hermes non può aggiornare plugin da Conduit"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesはConduitからプラグインをアップデートできません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes는 Conduit에서 플러그인을 업데이트할 수 없습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Hermes nie może aktualizować wtyczek z Conduit"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes não pode atualizar plugins pelo Conduit"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Hermes не может обновлять плагины из Conduit"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes eklentileri Conduit’ten güncelleyemiyor"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 无法从 Conduit 更新插件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 無法從 Conduit 更新外掛程式"
          }
        }
      }
    },
    "This dashboard's plugin (version %@) is older than one-tap updates. Run the steps under Do it manually on the host once. After that, Conduit updates it for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Plugin dieses Dashboards (Version %@) ist älter als Ein-Tipp-Updates. Führe die Schritte unter „Manuell erledigen“ einmal auf dem Host aus. Danach aktualisiert Conduit es für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin de este panel (versión %@) es anterior a las actualizaciones con un toque. Ejecuta una vez en el host los pasos de «Hazlo manualmente». Después, Conduit lo actualizará por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin de ce tableau de bord (version %@) est antérieur aux mises à jour en un geste. Exécutez une fois sur l’hôte les étapes de « Le faire manuellement ». Ensuite, Conduit le mettra à jour pour vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin dasbor ini (versi %@) lebih lama dari pembaruan sekali ketuk. Jalankan langkah di Lakukan secara manual di host sekali. Setelah itu, Conduit memperbaruinya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plugin di questa dashboard (versione %@) è precedente agli aggiornamenti con un tocco. Esegui una volta sull’host i passaggi in «Fallo manualmente». Dopo, Conduit lo aggiornerà per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダッシュボードのプラグイン（バージョン%@）はワンタップアップデートより前のものです。「手動で行う」の手順をホストで一度実行してください。以降はConduitがアップデートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대시보드의 플러그인(버전 %@)은 원탭 업데이트 이전 버전입니다. 호스트에서 '직접 하기'의 단계를 한 번 실행하세요. 그 후에는 Conduit가 업데이트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczka tego panelu (wersja %@) jest starsza niż aktualizacje jednym dotknięciem. Wykonaj raz na hoście kroki z sekcji „Zrób to ręcznie”. Potem Conduit zaktualizuje ją za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin deste painel (versão %@) é anterior às atualizações com um toque. Execute uma vez no host os passos em “Fazer manualmente”. Depois disso, o Conduit o atualiza para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагин этой панели (версия %@) старше обновлений одним касанием. Один раз выполните на хосте шаги из раздела «Сделать вручную». После этого Conduit будет обновлять его сам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panonun eklentisi (sürüm %@) tek dokunuşla güncellemelerden eski. Elle yapın altındaki adımları ana makinede bir kez çalıştırın. Bundan sonra Conduit onu sizin için günceller."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仪表板的插件（版本 %@）早于一键更新。请在主机上运行一次“手动操作”下的步骤。之后 Conduit 会为你更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此儀表板的外掛程式（版本 %@）早於一鍵更新。請在主機上執行一次「手動操作」下的步驟。之後 Conduit 會為你更新。"
          }
        }
      }
    },
    "This dashboard's plugin is missing or older than one-tap updates. Run the steps under Do it manually on the host once. After that, Conduit updates it for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Plugin dieses Dashboards fehlt oder ist älter als Ein-Tipp-Updates. Führe die Schritte unter „Manuell erledigen“ einmal auf dem Host aus. Danach aktualisiert Conduit es für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin de este panel falta o es anterior a las actualizaciones con un toque. Ejecuta una vez en el host los pasos de «Hazlo manualmente». Después, Conduit lo actualizará por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin de ce tableau de bord est absent ou antérieur aux mises à jour en un geste. Exécutez une fois sur l’hôte les étapes de « Le faire manuellement ». Ensuite, Conduit le mettra à jour pour vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin dasbor ini tidak ada atau lebih lama dari pembaruan sekali ketuk. Jalankan langkah di Lakukan secara manual di host sekali. Setelah itu, Conduit memperbaruinya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plugin di questa dashboard manca o è precedente agli aggiornamenti con un tocco. Esegui una volta sull’host i passaggi in «Fallo manualmente». Dopo, Conduit lo aggiornerà per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダッシュボードのプラグインがないか、ワンタップアップデートより前のものです。「手動で行う」の手順をホストで一度実行してください。以降はConduitがアップデートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대시보드의 플러그인이 없거나 원탭 업데이트 이전 버전입니다. 호스트에서 '직접 하기'의 단계를 한 번 실행하세요. 그 후에는 Conduit가 업데이트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki tego panelu brakuje lub jest starsza niż aktualizacje jednym dotknięciem. Wykonaj raz na hoście kroki z sekcji „Zrób to ręcznie”. Potem Conduit zaktualizuje ją za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin deste painel não está instalado ou é anterior às atualizações com um toque. Execute uma vez no host os passos em “Fazer manualmente”. Depois disso, o Conduit o atualiza para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагина этой панели нет или он старше обновлений одним касанием. Один раз выполните на хосте шаги из раздела «Сделать вручную». После этого Conduit будет обновлять его сам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panonun eklentisi yok ya da tek dokunuşla güncellemelerden eski. Elle yapın altındaki adımları ana makinede bir kez çalıştırın. Bundan sonra Conduit onu sizin için günceller."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仪表板的插件缺失或早于一键更新。请在主机上运行一次“手动操作”下的步骤。之后 Conduit 会为你更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此儀表板的外掛程式缺少或早於一鍵更新。請在主機上執行一次「手動操作」下的步驟。之後 Conduit 會為你更新。"
          }
        }
      }
    },
    "This iPhone isn't set up to answer from notifications. Set it up again in Settings > Notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone ist nicht dafür eingerichtet, aus Mitteilungen heraus zu antworten. Richte es unter „Einstellungen“ > „Mitteilungen“ erneut ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no está configurado para responder desde las notificaciones. Vuelve a configurarlo en Ajustes > Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n'est pas configuré pour répondre depuis les notifications. Configurez-le à nouveau dans Réglages > Notifications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini belum disiapkan untuk menjawab dari pemberitahuan. Siapkan lagi di Pengaturan > Pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non è configurato per rispondere dalle notifiche. Configuralo di nuovo in Impostazioni > Notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneは通知から回答できるように設定されていません。「設定」>「通知」でもう一度設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 알림에서 답하도록 설정되어 있지 않아요. ‘설정’ > ‘알림’에서 다시 설정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPhone nie jest skonfigurowany do odpowiadania z powiadomień. Skonfiguruj go ponownie w sekcji Ustawienia > Powiadomienia."
