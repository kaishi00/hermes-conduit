        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 이 Conduit 빌드로 보낼 수 없어요. 릴레이의 APNs 설정을 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
