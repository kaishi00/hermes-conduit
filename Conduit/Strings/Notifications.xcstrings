        }
      }
    },
    "Conduit doesn't ask you to update. New versions, security fixes included, wait here until you update. An update you start still asks for its restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bittet dich nicht um Updates. Neue Versionen, auch mit Sicherheitskorrekturen, warten hier, bis du aktualisierst. Ein Update, das du startest, fragt trotzdem nach seinem Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit doesn't ask you to update. New versions, security fixes included, wait here until you update. An update you start still asks for its restart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no te pide actualizar. Las versiones nuevas, incluidas las correcciones de seguridad, esperan aquí hasta que actualices. Una actualización que inicies sigue pidiendo su reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ne vous demande pas de mettre à jour. Les nouvelles versions, correctifs de sécurité compris, attendent ici jusqu’à votre mise à jour. Une mise à jour que vous lancez demande toujours son redémarrage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak meminta Anda memperbarui. Versi baru, termasuk perbaikan keamanan, menunggu di sini sampai Anda memperbarui. Pembaruan yang Anda mulai tetap meminta untuk dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non ti chiede di aggiornare. Le nuove versioni, correzioni di sicurezza comprese, aspettano qui finché non aggiorni. Un aggiornamento che avvii chiede comunque il suo riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit はアップデートを求めません。セキュリティ修正を含む新しいバージョンは、アップデートするまでここで待機します。開始したアップデートは、引き続き再起動を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit가 업데이트를 요청하지 않습니다. 보안 수정을 포함한 새 버전은 업데이트할 때까지 여기에서 기다립니다. 직접 시작한 업데이트는 여전히 재시작을 요청합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie prosi o aktualizację. Nowe wersje, również z poprawkami bezpieczeństwa, czekają tutaj, aż je zaktualizujesz. Aktualizacja, którą rozpoczniesz, nadal poprosi o ponowne uruchomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não pede para atualizar. Versões novas, incluindo correções de segurança, ficam aqui até você atualizar. Uma atualização que você iniciar ainda pede a reinicialização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не просит обновиться. Новые версии, включая исправления безопасности, ждут здесь, пока вы не обновите. Обновление, которое вы запустили, всё равно попросит перезапуск."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit güncellemenizi istemez. Güvenlik düzeltmeleri dahil yeni sürümler, siz güncelleyene kadar burada bekler. Başlattığınız bir güncelleme yine de yeniden başlatma ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 不会请你更新。新版本（包括安全修复）会在这里等你更新。你开始的更新仍会请你重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 不會請你更新。新版本（包括安全性修正）會在這裡等你更新。你開始的更新仍會請你重新啟動。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
