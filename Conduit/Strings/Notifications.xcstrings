          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo plugin já está no host, e só o painel ainda usa o antigo. Reinicie o painel uma vez no host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый плагин уже на хосте, и только дашборд ещё работает со старым. Перезапустите дашборд на хосте один раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni eklenti ana makinede ve yalnızca panel hâlâ eskisini kullanıyor. Paneli ana makinede bir kez yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新插件已在主机上，只有仪表板仍在运行旧插件。请在主机上重启一次仪表板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
