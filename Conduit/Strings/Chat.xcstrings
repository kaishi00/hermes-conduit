    "Folders can't be attached. Drop the files inside them instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner können nicht angehängt werden. Zieh stattdessen die Dateien darin hierher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas no se pueden adjuntar. Suelta los archivos que contienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers ne peuvent pas être joints. Déposez plutôt les fichiers qu'ils contiennent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder tidak dapat dilampirkan. Letakkan file di dalamnya saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle non si possono allegare. Trascina invece i file che contengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダは添付できません。中のファイルをドロップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더는 첨부할 수 없어요. 폴더 안의 파일을 끌어다 놓으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można dołączać folderów. Upuść pliki z ich wnętrza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastas não podem ser anexadas. Solte os arquivos que estão nelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папки нельзя прикрепить. Перетащите файлы из них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörler eklenemez. Bunun yerine içlerindeki dosyaları bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
