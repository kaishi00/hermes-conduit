        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij czaty w wybranej kolejności. Następny przypięty czat trafi na górę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste as conversas para a ordem que quiser. A próxima conversa que você fixar vai para o topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите чаты в нужном порядке. Следующий закреплённый чат окажется сверху."
