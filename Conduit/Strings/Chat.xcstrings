        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assumindo este chat do Hermes Desktop. Se houver uma resposta em andamento, o Conduit espera que ela termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенос чата из Hermes Desktop. Если там идёт ответ, Conduit дождётся его завершения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet Hermes Desktop'tan devralınıyor. Yanıt veriyorsa Conduit yanıtın bitmesini bekler."
