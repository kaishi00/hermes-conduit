    "Send gives Hermes this value. Skip lets it continue without one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Senden“ gibt Hermes diesen Wert. „Überspringen“ lässt Hermes ohne Wert weitermachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar le da a Hermes este valor. Omitir le permite continuar sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer transmet cette valeur à Hermes. Ignorer le laisse continuer sans valeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim memberikan nilai ini kepada Hermes. Lewati membiarkan Hermes melanjutkan tanpa nilai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia passa questo valore a Hermes. Salta lo lascia continuare senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信」するとこの値がHermesに渡されます。「スキップ」すると値なしで続行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘보내기’를 누르면 이 값을 Hermes에 전달해요. ‘건너뛰기’를 누르면 값 없이 계속해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wyślij” przekazuje Hermesowi tę wartość. „Pomiń” pozwala mu kontynuować bez niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar entrega este valor ao Hermes. Pular deixa que ele continue sem um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отправить» передаст Hermes это значение. «Пропустить» позволит продолжить без него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönder, bu değeri Hermes'e verir. Atla, Hermes'in değer olmadan devam etmesini sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“发送”会把这个值交给 Hermes；“跳过”则让它在没有该值的情况下继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「傳送」會將這個值交給 Hermes。「略過」會讓它在沒有值的情況下繼續。"
          }
        }
      }
    },
