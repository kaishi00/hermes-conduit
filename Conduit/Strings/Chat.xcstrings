    "The model's safety filter refused this message. Try asking another way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sicherheitsfilter des Modells hat diese Nachricht abgelehnt. Formuliere sie anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El filtro de seguridad del modelo rechazó este mensaje. Prueba a decirlo de otra forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre de sécurité du modèle a refusé ce message. Essayez de le formuler autrement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter keamanan model menolak pesan ini. Coba tanyakan dengan cara lain."
