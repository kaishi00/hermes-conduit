    "%@ isn’t on the server. It may have been deleted, or it’s on another computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht auf dem Server. Die Datei wurde vielleicht gelöscht oder liegt auf einem anderen Computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está en el servidor. Puede que se haya borrado o que esté en otro ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas sur le serveur. Le fichier a peut-être été supprimé ou se trouve sur un autre ordinateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ada di server. Mungkin sudah dihapus, atau ada di komputer lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è sul server. Potrebbe essere stato eliminato o trovarsi su un altro computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はサーバー上にありません。削除されたか、別のコンピュータにある可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일이 서버에 없습니다. 삭제되었거나 다른 컴퓨터에 있을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma na serwerze. Mógł zostać usunięty albo jest na innym komputerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está no servidor. Pode ter sido apagado ou estar em outro computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нет на сервере. Возможно, файл удалён или находится на другом компьютере."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sunucuda yok. Silinmiş ya da başka bir bilgisayarda olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器上没有 %@。它可能已被删除，或在另一台电脑上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器上沒有 %@。它可能已被刪除，或在另一台電腦上。"
          }
        }
      }
    },
