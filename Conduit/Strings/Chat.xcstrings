          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标的条件已更改。请重新选择要移除的条件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標的條件已變更。請重新選擇要移除的條件。"
          }
        }
      }
