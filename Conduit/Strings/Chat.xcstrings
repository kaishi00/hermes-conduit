    "Your later messages and the replies to them leave the chat, and this one goes back in the composer to change and send again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine späteren Nachrichten und die Antworten darauf verschwinden aus dem Chat, und diese kommt zurück ins Eingabefeld, um sie zu ändern und erneut zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus mensajes posteriores y sus respuestas salen del chat, y este vuelve al editor para cambiarlo y enviarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos messages suivants et leurs réponses quittent le chat, et celui-ci revient dans le champ de saisie pour être modifié et renvoyé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan Anda berikutnya dan balasannya keluar dari chat, dan pesan ini kembali ke kolom tulis untuk diubah dan dikirim lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi messaggi successivi e le relative risposte escono dalla chat, e questo torna nel campo di scrittura per modificarlo e inviarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以降のメッセージとその返信はチャットから外れ、このメッセージは入力欄に戻るので、変更して送り直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이후 메시지와 그 답변은 채팅에서 빠지고, 이 메시지는 입력창으로 돌아가 수정해서 다시 보낼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje późniejsze wiadomości i odpowiedzi na nie znikną z czatu, a ta wróci do pola tekstowego, aby ją zmienić i wysłać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas mensagens posteriores e as respostas a elas saem do chat, e esta volta ao campo de texto para ser alterada e enviada de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши последующие сообщения и ответы на них уйдут из чата, а это вернётся в поле ввода, чтобы изменить его и отправить снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki mesajlarınız ve onlara verilen yanıtlar sohbetten çıkar, bu mesaj ise değiştirip yeniden göndermeniz için yazma alanına döner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你之后的消息及对它们的回复将离开聊天，这条消息会回到输入框，供你修改后再次发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你之後的訊息及對它們的回覆將離開聊天，這則訊息會回到輸入框，供你修改後再次傳送。"
          }
        }
      }
    },
    "Your message for a new chat wasn't sent. It's saved for your next new chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
