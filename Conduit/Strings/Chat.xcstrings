    "Save & sign in gives Hermes this login for the site. The model never sees the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Speichern & anmelden“ gibt Hermes diese Anmeldung für die Website. Das Modell sieht das Passwort nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar e iniciar sesión le da a Hermes este inicio de sesión para el sitio. El modelo nunca ve la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
