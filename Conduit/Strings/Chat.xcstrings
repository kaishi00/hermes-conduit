    "Hermes ends it on your host. Anything it was serving or watching stops with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes beendet ihn auf deinem Host. Was er bereitgestellt oder beobachtet hat, stoppt mit ihm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lo termina en tu host. Lo que estuviera sirviendo o vigilando se detiene con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes l’arrête sur votre hôte. Tout ce qu’il servait ou surveillait s’arrête avec lui."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes menghentikannya di host Anda. Apa pun yang dilayani atau dipantaunya ikut berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lo termina sul tuo host. Tutto ciò che serviva o osservava si ferma con lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがホスト上で終了します。提供や監視をしていたものも一緒に止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 호스트에서 종료합니다. 제공하거나 감시하던 것도 함께 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes zakończy go na Twoim hoście. Wszystko, co obsługiwał lub obserwował, zatrzyma się razem z nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes o encerra no seu host. Tudo o que ele servia ou observava para junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes завершит его на вашем хосте. Всё, что он обслуживал или отслеживал, остановится вместе с ним."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes onu ana makinenizde sonlandırır. Sunduğu veya izlediği her şey onunla birlikte durur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 会在你的主机上结束它。它提供或监视的内容也会一起停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 會在你的主機上結束它。它提供或監看的內容也會一起停止。"
          }
        }
      }
    },
    "Hermes stops coming back to this chat when it's idle. Set another with /heartbeat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kehrt nicht mehr in diesen Chat zurück, wenn er ruht. Lege mit /heartbeat einen neuen fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes deja de volver a este chat cuando está inactivo. Configura otro con /heartbeat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne revient plus dans cette discussion quand elle est inactive. Définissez-en un autre avec /heartbeat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes berhenti kembali ke chat ini saat tidak aktif. Atur yang lain dengan /heartbeat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes smette di tornare in questa chat quando è inattiva. Impostane un altro con /heartbeat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル時にHermesがこのチャットへ戻らなくなります。/heartbeatで新しく設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유휴 상태일 때 Hermes가 이 채팅으로 돌아오지 않습니다. /heartbeat로 새로 설정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes przestanie wracać do tego czatu, gdy jest bezczynny. Ustaw inny poleceniem /heartbeat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes deixa de voltar a este chat quando ocioso. Defina outro com /heartbeat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes перестанет возвращаться в этот чат во время простоя. Задайте новый через /heartbeat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes boştayken bu sohbete dönmeyi bırakır. /heartbeat ile yenisini ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 将不再在空闲时回到此聊天。用 /heartbeat 设置新的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 將不再於閒置時回到此聊天。用 /heartbeat 設定新的。"
          }
        }
      }
    },
