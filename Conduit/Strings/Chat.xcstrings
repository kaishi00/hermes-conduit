    "When Hermes waits on your approval or answer in any chat, it shows here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Hermes in einem Chat auf deine Freigabe oder Antwort wartet, steht es hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Hermes waits on your approval or answer in any chat, it shows here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando Hermes espera tu aprobación o respuesta en cualquier chat, aparece aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Hermes attend votre approbation ou votre réponse dans une discussion, elle apparaît ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Hermes menunggu persetujuan atau jawaban Anda di obrolan mana pun, itu muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Hermes aspetta la tua approvazione o risposta in una chat, compare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがいずれかのチャットであなたの承認や回答を待っていると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 어떤 채팅에서든 승인이나 답변을 기다리면 여기에 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Hermes czeka w którymś czacie na Twoją zgodę lub odpowiedź, pojawia się to tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o Hermes aguarda sua aprovação ou resposta em qualquer chat, aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда Hermes ждёт вашего одобрения или ответа в каком-либо чате, это появится здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
