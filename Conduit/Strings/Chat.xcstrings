    "Steps ran for this reply, and retrying runs them again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Antwort liefen Schritte, und Wiederholen führt sie erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta respuesta ejecutó pasos, y reintentar los vuelve a ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des étapes ont été exécutées pour cette réponse, et la relancer les exécute à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada langkah yang dijalankan untuk balasan ini, dan mencoba lagi akan menjalankannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questa risposta sono stati eseguiti dei passaggi, e riprovare li esegue di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この返信ではステップが実行されました。再試行するともう一度実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 답변에서 단계가 실행되었으며, 다시 시도하면 다시 실행됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla tej odpowiedzi wykonano kroki, a ponowienie wykona je jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etapas foram executadas para esta resposta, e tentar de novo as executa outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого ответа выполнялись шаги, и повтор выполнит их снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yanıt için adımlar çalıştı ve yeniden denemek onları tekrar çalıştırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条回复运行过步骤，重试会再次运行它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這則回覆執行過步驟，重試會再次執行它們。"
          }
        }
      }
    },
