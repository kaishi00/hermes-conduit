    "%@ is a folder, so it wasn't attached. Drop the files inside it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Ordner und wurde daher nicht angehängt. Zieh stattdessen die Dateien darin hierher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una carpeta, así que no se adjuntó. Suelta los archivos que contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un dossier, il n'a donc pas été joint. Déposez plutôt les fichiers qu'il contient."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah folder, jadi tidak dilampirkan. Letakkan file di dalamnya saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è una cartella, quindi non è stata allegata. Trascina invece i file che contiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はフォルダのため添付されませんでした。中のファイルをドロップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 폴더라서 첨부되지 않았어요. 폴더 안의 파일을 끌어다 놓으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to folder, więc nie został dołączony. Upuść pliki z jego wnętrza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é uma pasta, então não foi anexada. Solte os arquivos que estão nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — это папка, поэтому она не прикреплена. Перетащите файлы из неё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir klasör olduğu için eklenmedi. Bunun yerine içindeki dosyaları bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是文件夹，因此未添加为附件。请改为拖放其中的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是資料夾，因此未加入附件。請改為拖放其中的檔案。"
          }
        }
      }
    },
    "%@ is larger than the %@ MB attachment limit. You can raise the limit in Settings › Chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ überschreitet das Anhanglimit von %@ MB. Du kannst das Limit unter „Einstellungen › Chat“ erhöhen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera el límite de %@ MB para archivos adjuntos. Puedes subir el límite en Ajustes › Chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépasse la limite de %@ Mo par pièce jointe. Vous pouvez augmenter la limite dans Réglages › Discussion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ melebihi batas lampiran %@ MB. Anda dapat menaikkan batas di Pengaturan › Obrolan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera il limite di %@ MB per gli allegati. Puoi aumentare il limite in Impostazioni › Chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は添付ファイルの上限（%@MB）を超えています。上限は「設定」>「チャット」で引き上げられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일이 첨부 한도인 %@MB보다 커요. ‘설정’ › ‘채팅’에서 한도를 높일 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ przekracza limit załączników %@ MB. Możesz zwiększyć limit w sekcji Ustawienia › Czat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ excede o limite de %@ MB para anexos. Você pode aumentar o limite em Ajustes › Chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ превышает лимит вложений (%@ МБ). Увеличить лимит можно в разделе «Настройки › Чат»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ MB ek sınırından büyük. Sınırı Ayarlar › Sohbet bölümünden yükseltebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
