    "New projects go to the profile in use. To make one in another profile, switch to it first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Projekte gehören zum aktiven Profil. Für ein Projekt in einem anderen Profil wechsle zuerst dorthin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos nuevos van al perfil en uso. Para crear uno en otro perfil, cambia primero a ese perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux projets vont dans le profil utilisé. Pour en créer un dans un autre profil, passez d’abord à celui-ci."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek baru masuk ke profil yang sedang dipakai. Untuk membuatnya di profil lain, beralihlah ke profil itu dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi progetti vanno nel profilo in uso. Per crearne uno in un altro profilo, passa prima a quel profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプロジェクトは使用中のプロファイルに追加されます。別のプロファイルに作成するには、先にそのプロファイルに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 프로젝트는 사용 중인 프로필에 만들어져요. 다른 프로필에 만들려면 먼저 그 프로필로 전환하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe projekty trafiają do używanego profilu. Aby utworzyć projekt w innym profilu, najpierw się na niego przełącz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos projetos vão para o perfil em uso. Para criar um em outro perfil, troque para ele primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые проекты попадают в текущий профиль. Чтобы создать проект в другом профиле, сначала переключитесь на него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni projeler kullanılan profile eklenir. Başka bir profilde oluşturmak için önce o profile geç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新项目会归入当前使用的档案。要在其他档案中创建，请先切换到该档案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
