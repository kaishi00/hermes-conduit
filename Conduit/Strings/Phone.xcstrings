    "%@ This one was kept on the phone and goes once the plugin is on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dieses Ereignis wurde auf dem Telefon behalten und wird gesendet, sobald das Plugin eingeschaltet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Este se guardó en el teléfono y se envía en cuanto el plugin esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Celui-ci a été gardé sur le téléphone et part dès que le plugin est activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Yang ini disimpan di ponsel dan dikirim setelah plugin dinyalakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Questo è stato tenuto sul telefono e parte appena il plugin è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ これは iPhone に保存されており、プラグインがオンになると送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 항목은 휴대폰에 보관되어 있으며 플러그인이 켜지면 전송됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ To zdarzenie zostało zachowane na telefonie i zostanie wysłane, gdy wtyczka będzie włączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Este foi guardado no telefone e é enviado assim que o plugin estiver ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Это событие сохранено на телефоне и будет отправлено, когда плагин включат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bu olay telefonda tutuldu ve eklenti açıldığında gönderilecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此事件已保存在手机上，插件开启后就会发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此事件已保留在手機上，外掛開啟後就會傳送。"
          }
        }
      }
    },
    "Sharing is off. %@ Conduit deletes the data there once it's on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Teilen ist aus. %@ Conduit löscht die Daten dort, sobald es eingeschaltet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir está desactivado. %@ Conduit borra los datos allí en cuanto esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage est désactivé. %@ Conduit supprime les données là-bas dès qu’il est activé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi nonaktif. %@ Conduit menghapus data di sana setelah plugin dinyalakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione è disattivata. %@ Conduit elimina i dati lì appena è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有はオフです。%@ オンになると、Conduit がそこにあるデータを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유가 꺼져 있습니다. %@ 켜지면 Conduit가 그곳의 데이터를 삭제합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie jest wyłączone. %@ Conduit usunie tam dane, gdy wtyczka zostanie włączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento está desativado. %@ O Conduit apaga os dados lá assim que estiver ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмен выключен. %@ Conduit удалит там данные, как только плагин включат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
