        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat menjangkau Hermes, jadi ini disimpan di ponsel. Ini dikirim bersama peristiwa berikutnya, atau buka Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
