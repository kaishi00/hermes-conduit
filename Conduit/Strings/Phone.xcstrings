    "Update the Conduit plugin on your Hermes host to log events. This one was kept on the phone and goes after the update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere das Conduit-Plugin auf deinem Hermes-Host, um Ereignisse zu protokollieren. Dieses wurde auf dem Telefon behalten und wird nach dem Update gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza el plugin de Conduit en tu host de Hermes para registrar eventos. Este se guardó en el teléfono y se enviará tras la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour le plugin Conduit sur votre hôte Hermes pour consigner des événements. Celui-ci est gardé sur le téléphone et partira après la mise à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui plugin Conduit di host Hermes Anda untuk mencatat peristiwa. Yang ini disimpan di ponsel dan dikirim setelah pembaruan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna il plugin Conduit sul tuo host Hermes per registrare gli eventi. Questo è stato tenuto sul telefono e partirà dopo l'aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを記録するには、HermesホストのConduitプラグインをアップデートしてください。このイベントはiPhoneに保管され、アップデート後に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트를 기록하려면 Hermes 호스트의 Conduit 플러그인을 업데이트하세요. 이 이벤트는 휴대폰에 보관되었으며 업데이트 후 전송됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj wtyczkę Conduit na hoście Hermesa, aby zapisywać zdarzenia. To zdarzenie zostało zachowane w telefonie i zostanie wysłane po aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o plugin do Conduit no seu host do Hermes para registrar eventos. Este foi mantido no telefone e será enviado após a atualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите плагин Conduit на хосте Hermes, чтобы записывать события. Это событие сохранено на телефоне и будет отправлено после обновления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olayları kaydetmek için Hermes sunucunuzdaki Conduit eklentisini güncelleyin. Bu olay telefonda tutuldu ve güncellemeden sonra gönderilecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 主机上的 Conduit 插件以记录事件。此事件已保存在手机上，更新后会发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 Hermes 主機上的 Conduit 外掛程式以記錄事件。此事件已保留在手機上，更新後會傳送。"
          }
        }
      }
    },
