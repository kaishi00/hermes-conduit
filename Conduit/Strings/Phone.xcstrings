    "Waiting: health data goes only to the dashboard it was turned on for. Switch back to it to sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet: Gesundheitsdaten gehen nur an das Dashboard, für das das Teilen eingeschaltet wurde. Wechsle zurück zu diesem Dashboard, um zu synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En espera: los datos de salud solo van al panel para el que se activó la opción. Vuelve a ese panel para sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente : les données de santé ne vont qu'au tableau de bord pour lequel le partage a été activé. Revenez à celui-ci pour synchroniser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu: data kesehatan hanya dikirim ke dasbor tempat berbagi dinyalakan. Beralih kembali ke dasbor tersebut untuk menyinkronkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa: i dati di salute vanno solo alla dashboard per cui è stata attivata la condivisione. Torna a quella dashboard per sincronizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中：ヘルスケアデータは、共有をオンにしたダッシュボードにのみ送信されます。同期するには、そのダッシュボードに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중: 건강 데이터는 공유를 켠 대시보드로만 전송돼요. 동기화하려면 해당 대시보드로 다시 전환하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwanie: dane zdrowotne trafiają tylko do panelu, dla którego włączono udostępnianie. Przełącz się z powrotem na ten panel, aby zsynchronizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando: os dados de saúde vão apenas para o painel em que o compartilhamento foi ativado. Volte para ele para sincronizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание: данные о здоровье передаются только в тот дашборд, для которого была включена отправка. Чтобы синхронизировать, вернитесь к нему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleniyor: sağlık verileri yalnızca paylaşımın açıldığı panele gider. Eşzamanlamak için o panele geri geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待中：健康数据只会发送到开启共享时所在的仪表板。请切换回该仪表板以同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待中：健康資料只會傳送到開啟分享時所在的儀表板。請切換回該儀表板以同步。"
          }
        }
      }
    },
