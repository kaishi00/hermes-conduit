    "Conduit couldn't keep this on the phone. Unlock your iPhone, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte dies nicht auf dem Telefon behalten. Entsperre dein iPhone und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit couldn't keep this on the phone. Unlock your iPhone, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
