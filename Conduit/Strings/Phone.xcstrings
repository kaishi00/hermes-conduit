          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas l'autorisation d'utiliser votre position. Autorisez-la dans l'app Réglages, sous Confidentialité et sécurité > Service de localisation > Conduit."
