        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit가 이것을 휴대폰에 보관할 수 없었습니다. iPhone 잠금을 해제한 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
