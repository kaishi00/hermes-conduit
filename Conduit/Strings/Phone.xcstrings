    "Conduit ran out of time before it could send this. Nothing was sent; try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hatte keine Zeit mehr, das zu senden. Es wurde nichts gesendet; versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se quedó sin tiempo antes de poder enviarlo. No se envió nada; inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit a manqué de temps avant de pouvoir l’envoyer. Rien n’a été envoyé ; réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
