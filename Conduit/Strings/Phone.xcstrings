    "Other Hermes profiles on %@ that are paired with this iPhone can read it too. You can turn this off in Settings > Location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Hermes-Profile auf %@, die mit diesem iPhone gekoppelt sind, können ihn ebenfalls lesen. Du kannst das unter Einstellungen > Standort ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros perfiles de Hermes en %@ vinculados con este iPhone también pueden leerla. Puedes desactivarlo en Ajustes > Ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres profils Hermes sur %@ jumelés avec cet iPhone peuvent aussi la lire. Vous pouvez désactiver cela dans Réglages > Position."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil Hermes lain di %@ yang dipasangkan dengan iPhone ini juga dapat membacanya. Anda dapat menonaktifkannya di Pengaturan > Lokasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche gli altri profili Hermes su %@ abbinati a questo iPhone possono leggerla. Puoi disattivarlo in Impostazioni > Posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneとペアリングされている%@上のほかのHermesプロファイルも読み取れます。「設定」>「位置情報」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone과 페어링된 %@의 다른 Hermes 프로필도 읽을 수 있습니다. 설정 > 위치에서 끌 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne profile Hermes na %@ sparowane z tym iPhone’em też mogą ją odczytywać. Możesz to wyłączyć w Ustawienia > Lokalizacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros perfis do Hermes em %@ pareados com este iPhone também podem lê-la. Você pode desativar isso em Ajustes > Localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие профили Hermes на %@, связанные с этим iPhone, тоже могут её читать. Это можно отключить в Настройки > Геопозиция."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üzerinde bu iPhone ile eşlenmiş diğer Hermes profilleri de okuyabilir. Bunu Ayarlar > Konum'dan kapatabilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上与这台 iPhone 配对的其他 Hermes 配置文件也可以读取。你可以在“设置”>“位置”中关闭此项。"
