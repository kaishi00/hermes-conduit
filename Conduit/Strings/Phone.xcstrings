    "Nothing logged from this iPhone. Add Log to Hermes to an automation in the Shortcuts app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von diesem iPhone wurde nichts protokolliert. Füge „In Hermes protokollieren“ in der Kurzbefehle-App zu einer Automation hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada registrado desde este iPhone. Añade Registrar en Hermes a una automatización en la app Atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été consigné depuis cet iPhone. Ajoutez Consigner dans Hermes à une automatisation dans l'app Raccourcis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada yang dicatat dari iPhone ini. Tambahkan Catat ke Hermes ke otomatisasi di app Pintasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla registrato da questo iPhone. Aggiungi Registra in Hermes a un'automazione nell'app Comandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneからの記録はありません。ショートカットAppでオートメーションに「Hermesに記録」を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 기록된 내용이 없습니다. 단축어 앱에서 자동화에 Hermes에 기록을 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z tego iPhone'a nic nie zapisano. Dodaj akcję Zapisz w Hermesie do automatyzacji w aplikacji Skróty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada registrado deste iPhone. Adicione Registrar no Hermes a uma automação no app Atalhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С этого iPhone ничего не записано. Добавьте действие «Записать в Hermes» в автоматизацию в приложении «Быстрые команды»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'dan kaydedilen bir şey yok. Kestirmeler uygulamasında bir otomasyona Hermes'e Kaydet ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
