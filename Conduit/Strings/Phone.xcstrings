          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 和 Pulse 将无法再读取，Pulse 也会忘记从中保留的截止日期。你的自动化会继续记录新事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 和 Pulse 將無法再讀取，Pulse 也會忘記從中保留的截止日期。你的自動化會繼續記錄新事件。"
          }
        }
