    "Hermes could not start a chat for the screenshot. It's kept and will be attached once Hermes is ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte keinen Chat für das Bildschirmfoto starten. Es bleibt erhalten und wird angehängt, sobald Hermes bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo iniciar un chat para la captura de pantalla. Se conserva y se adjuntará cuando Hermes esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n'a pas pu démarrer de discussion pour la capture d'écran. Elle est conservée et sera jointe dès qu'Hermes sera prêt."
