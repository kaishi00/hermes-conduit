    "Paused: sign in to this dashboard again. Location is sent again once you open Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert: Melde dich erneut bei diesem Dashboard an. Der Standort wird wieder gesendet, sobald du Conduit öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: vuelve a iniciar sesión en este panel. La ubicación se envía de nuevo cuando abras Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause : reconnectez-vous à ce tableau de bord. La position est de nouveau envoyée dès que vous ouvrez Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeda: masuk lagi ke dasbor ini. Lokasi dikirim lagi setelah kamu membuka Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa: accedi di nuovo a questa dashboard. La posizione viene inviata di nuovo quando apri Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中：このダッシュボードに再度サインインしてください。Conduitを開くと位置情報の送信が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지됨: 이 대시보드에 다시 로그인하세요. Conduit를 열면 위치 전송이 다시 시작됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymano: zaloguj się ponownie do tego panelu. Lokalizacja zostanie znów wysłana, gdy otworzysz Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado: entre neste painel novamente. A localização volta a ser enviada quando você abrir o Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостановлено: войдите в эту панель снова. Геопозиция снова будет отправляться, когда вы откроете Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatıldı: bu panoya tekrar giriş yap. Conduit'i açtığında konum yeniden gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停：请重新登录此控制台。打开 Conduit 后会再次发送位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暫停：請重新登入此控制台。打開 Conduit 後會再次傳送位置。"
          }
        }
      }
    },
    "Paused: sign in to this dashboard again. Sharing catches up when you open Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
