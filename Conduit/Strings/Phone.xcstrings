        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu acessar o Hermes, então isto foi mantido no telefone. Será enviado com o próximo evento, ou abra o Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось связаться с Hermes, поэтому это сохранено на телефоне. Оно будет отправлено со следующим событием, или откройте Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit Hermes'e ulaşamadı, bu yüzden bu telefonda tutuldu. Bir sonraki olayla gönderilecek ya da Conduit'i açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
