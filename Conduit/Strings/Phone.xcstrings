          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法將其保留在手機上。請解鎖 iPhone，然後再試一次。"
          }
        }
      }
    },
    "Conduit couldn't reach Hermes, so this was kept on the phone. It goes with the next event, or open Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte Hermes nicht erreichen, daher wurde dies auf dem Telefon behalten. Es wird mit dem nächsten Ereignis gesendet, oder öffne Conduit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo conectar con Hermes, así que esto se guardó en el teléfono. Se enviará con el próximo evento, o abre Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu joindre Hermes, donc ceci est gardé sur le téléphone. Il partira avec le prochain événement, ou ouvrez Conduit."
