    },
    "Conduit doesn't have access to your calendar or reminders. Allow it in the Settings app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hat keinen Zugriff auf deinen Kalender oder deine Erinnerungen. Erlaube ihn in der App „Einstellungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no tiene acceso a tu calendario ni a tus recordatorios. Permítelo en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas accès à votre calendrier ni à vos rappels. Autorisez-le dans l'app Réglages."
