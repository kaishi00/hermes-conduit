    "Conduit can't see your photos. Allow Photos for Conduit in Settings to share them with Hermes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann deine Fotos nicht sehen. Erlaube Conduit in den Einstellungen den Zugriff auf Fotos, um sie mit Hermes zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no puede ver tus fotos. Permite el acceso a Fotos para Conduit en Ajustes para compartirlas con Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ne peut pas voir vos photos. Autorisez Photos pour Conduit dans Réglages pour les partager avec Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat melihat foto Anda. Izinkan Foto untuk Conduit di Pengaturan agar dapat membagikannya dengan Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non può vedere le tue foto. Consenti l’accesso a Foto per Conduit in Impostazioni per condividerle con Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは写真を見ることができません。Hermesと共有するには、「設定」でConduitに写真へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 사진을 볼 수 없어요. Hermes와 공유하려면 설정에서 Conduit의 사진 접근을 허용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie widzi Twoich zdjęć. Zezwól Conduit na dostęp do Zdjęć w Ustawieniach, aby udostępniać je Hermesowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não consegue ver suas fotos. Permita o acesso a Fotos para o Conduit em Ajustes para compartilhá-las com o Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не видит ваши фото. Разрешите Conduit доступ к Фото в Настройках, чтобы делиться ими с Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit fotoğraflarınızı göremiyor. Hermes ile paylaşmak için Ayarlar'da Conduit'e Fotoğraflar erişimi verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法查看你的照片。请在“设置”中允许 Conduit 访问照片，以便与 Hermes 共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法查看你的照片。請在「設定」中允許 Conduit 取用照片，以便與 Hermes 分享。"
          }
        }
      }
    },
