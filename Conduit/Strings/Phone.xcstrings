    "Sharing is off. The host couldn't be reached, so Conduit deletes the data there the next time it connects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Teilen ist aus. Der Host war nicht erreichbar, daher löscht Conduit die Daten dort, sobald es sich das nächste Mal verbindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has dejado de compartir. No se pudo contactar con el host, así que Conduit borrará los datos allí la próxima vez que se conecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage est désactivé. L’hôte était injoignable : Conduit supprimera les données sur celui-ci lors de sa prochaine connexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi nonaktif. Host tidak dapat dijangkau, jadi Conduit akan menghapus datanya di sana saat terhubung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione è disattivata. L’host non era raggiungibile, quindi Conduit eliminerà i dati lì alla prossima connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有をオフにしました。ホストに接続できなかったため、次に接続したときに Conduit がホスト上のデータを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유가 꺼졌어요. 호스트에 연결할 수 없어서 다음에 연결될 때 Conduit이 호스트의 데이터를 삭제해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie jest wyłączone. Nie udało się połączyć z hostem, więc Conduit usunie tam dane przy następnym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento está desativado. Não foi possível acessar o host, então o Conduit vai apagar os dados lá na próxima vez que se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмен выключен. Хост был недоступен, поэтому Conduit удалит данные на нём при следующем подключении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşım kapalı. Ana bilgisayara ulaşılamadı; Conduit bir sonraki bağlantıda verileri orada silecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭共享。无法连接主机，Conduit 会在下次连接时删除主机上的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉共享。無法連線到主機，Conduit 會在下次連線時刪除主機上的資料。"
          }
        }
      }
    },
