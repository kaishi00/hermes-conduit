    "This one was kept on the phone and goes once the host's plugin keeps events." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Ereignis wurde auf dem iPhone behalten und wird gesendet, sobald das Plugin des Hosts Ereignisse speichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este se guardó en el teléfono y se enviará cuando el plugin del host guarde eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui-ci a été gardé sur le téléphone et partira quand le plugin de l'hôte conservera les événements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang ini disimpan di ponsel dan dikirim setelah plugin host menyimpan peristiwa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è stato tenuto sul telefono e verrà inviato quando il plugin dell'host conserverà gli eventi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは電話に保存され、ホストのプラグインがイベントを保存できるようになると送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목은 휴대폰에 보관되었으며, 호스트의 플러그인이 이벤트를 보관하게 되면 전송됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zdarzenie zostało zachowane na telefonie i zostanie wysłane, gdy wtyczka hosta będzie przechowywać zdarzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este foi guardado no telefone e será enviado quando o plugin do host guardar eventos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это событие сохранено на телефоне и будет отправлено, когда плагин на хосте начнёт хранить события."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, telefonda tutuldu ve ana bilgisayardaki eklenti olayları sakladığında gönderilecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此条已保留在手机上，待主机的插件支持保存事件后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此筆已保留在手機上，待主機的外掛支援保存事件後傳送。"
          }
        }
      }
    },
