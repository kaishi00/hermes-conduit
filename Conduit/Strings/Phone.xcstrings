    "Reminders that go off at a place can't be set from Hermes yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen, die an einem Ort auslösen, können noch nicht von Hermes eingerichtet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes aún no puede crear recordatorios que avisen al llegar a un lugar o salir de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne peut pas encore créer de rappels qui se déclenchent à un lieu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat yang berbunyi di suatu tempat belum bisa dibuat dari Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non può ancora impostare promemoria che si attivano in un luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
