    "Inline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Verlauf"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la respuesta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la réponse"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam balasan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella risposta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信内"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변 안에서"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W odpowiedzi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na resposta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ответе"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtın içinde"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复内"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆內"
          }
        }
      }
    },
    "Inline waits for delegates inside the reply; Background lets the reply finish first. Auto is inline when progress messages are off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Verlauf wartet die Antwort auf die Delegierten; Im Hintergrund lässt die Antwort zuerst fertig werden. Automatisch ist im Verlauf, wenn Fortschrittsmeldungen aus sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la respuesta espera a los delegados dentro de la respuesta; En segundo plano deja que la respuesta termine antes. Auto va en la respuesta si los mensajes de progreso están desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la réponse attend les délégués au sein de la réponse ; En arrière-plan laisse la réponse se terminer d'abord. Auto choisit Dans la réponse quand les messages de progression sont désactivés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam balasan menunggu delegasi di dalam balasan; Latar belakang membiarkan balasan selesai lebih dulu. Otomatis memakai Dalam balasan saat pesan progres nonaktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella risposta attende i delegati all'interno della risposta; In background lascia finire prima la risposta. Auto usa Nella risposta quando i messaggi di avanzamento sono disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信内では返信の中で委任エージェントを待ち、バックグラウンドでは先に返信を終えます。自動は、進捗メッセージがオフのとき返信内になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변 안에서는 답변 중에 위임 에이전트를 기다리고, 백그라운드는 답변을 먼저 끝냅니다. 자동은 진행 메시지가 꺼져 있으면 답변 안에서로 동작합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W odpowiedzi czeka na agentów delegowanych wewnątrz odpowiedzi; W tle pozwala najpierw dokończyć odpowiedź. Auto działa jak W odpowiedzi, gdy komunikaty o postępie są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na resposta espera os delegados dentro da resposta; Em segundo plano deixa a resposta terminar antes. Auto usa Na resposta quando as mensagens de progresso estão desativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«В ответе» ждёт делегатов внутри ответа; «В фоне» сначала завершает ответ. «Авто» работает как «В ответе», когда сообщения о ходе работы выключены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtın içinde, devredilen ajanları yanıtın içinde bekler; Arka planda, önce yanıtın bitmesine izin verir. Otomatik, ilerleme mesajları kapalıyken Yanıtın içinde gibi çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复内会在回复中等待委派代理；后台会先完成回复。自动在关闭进度消息时使用回复内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆內會在回覆中等待委派代理程式；背景會先完成回覆。自動在關閉進度訊息時使用回覆內。"
          }
        }
      }
    },
    "Let a delegate agent start and coordinate its own delegates, up to the depth above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass einen delegierten Agenten eigene Delegierte starten und koordinieren, bis zur obigen Tiefe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que un agente delegado inicie y coordine sus propios delegados, hasta la profundidad de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à un agent délégué de lancer et coordonner ses propres délégués, jusqu'à la profondeur ci-dessus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan agen delegasi memulai dan mengoordinasikan delegasinya sendiri, hingga kedalaman di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a un agente delegato di avviare e coordinare i propri delegati, fino alla profondità indicata sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委任エージェントが独自の委任エージェントを開始して調整できるようにします（上記の深さまで）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위임 에이전트가 자체 위임 에이전트를 시작하고 조정하도록 허용합니다(위의 깊이까지)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól agentowi delegowanemu uruchamiać i koordynować własnych agentów, do głębokości podanej wyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um agente delegado inicie e coordene seus próprios delegados, até a profundidade acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволить делегированному агенту запускать и координировать собственных делегатов, до указанной выше глубины."
          }
        },
        "tr" : {
