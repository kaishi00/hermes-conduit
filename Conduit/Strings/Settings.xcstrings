    "A key saved here is shared with every profile that has no key of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein hier gespeicherter Schlüssel gilt für jedes Profil ohne eigenen Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clave guardada aquí se comparte con cada perfil que no tenga una propia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé enregistrée ici est partagée avec chaque profil qui n’a pas la sienne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci yang disimpan di sini dibagikan ke setiap profil yang tidak punya kunci sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave salvata qui è condivisa con ogni profilo che non ne ha una propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに保存したキーは、独自のキーがないすべてのプロファイルで共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 저장한 키는 자체 키가 없는 모든 프로필과 공유됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz zapisany tutaj jest wspólny dla każdego profilu bez własnego klucza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave salva aqui é compartilhada com todo perfil que não tenha a sua própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый здесь ключ используют все профили без собственного ключа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buraya kaydedilen anahtar, kendi anahtarı olmayan her profille paylaşılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里保存的密钥会共享给所有没有自己密钥的配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡儲存的金鑰會共用給所有沒有自己金鑰的設定檔。"
          }
        }
      }
    },
    "A newer Conduit plugin is available for %@. Conduit can update it for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ gibt es ein neueres Conduit-Plugin. Conduit kann es für dich aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un plugin de Conduit más reciente para %@. Conduit puede actualizarlo por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plugin Conduit plus récent est disponible pour %@. Conduit peut le mettre à jour pour vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin Conduit yang lebih baru tersedia untuk %@. Conduit dapat memperbaruinya untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È disponibile un plugin Conduit più recente per %@. Conduit può aggiornarlo per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用の新しいConduitプラグインがあります。Conduitでアップデートできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@용 새 Conduit 플러그인이 있습니다. Conduit에서 업데이트할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla %@ jest dostępna nowsza wtyczka Conduit. Conduit może ją zaktualizować za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um plugin do Conduit mais recente para %@. O Conduit pode atualizá-lo para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для %@ доступен более новый плагин Conduit. Conduit может обновить его за вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için daha yeni bir Conduit eklentisi var. Conduit bunu sizin için güncelleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有更新的 Conduit 插件可用。Conduit 可以为你更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有較新的 Conduit 外掛程式可用。Conduit 可以為你更新。"
          }
        }
      }
    },
