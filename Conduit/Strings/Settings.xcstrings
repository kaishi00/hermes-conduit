    "Snapshot files before Hermes edits them, so changes can be rolled back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien vor dem Bearbeiten durch Hermes sichern, damit Änderungen rückgängig gemacht werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una instantánea de los archivos antes de que Hermes los edite, para poder revertir los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer un instantané des fichiers avant que Hermes ne les modifie, pour pouvoir annuler les changements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat snapshot file sebelum Hermes mengeditnya, agar perubahan bisa dikembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea uno snapshot dei file prima che Hermes li modifichi, così le modifiche si possono annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes が編集する前にファイルのスナップショットを取り、変更を元に戻せるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 파일을 편집하기 전에 스냅샷을 만들어 변경 사항을 되돌릴 수 있게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz migawki plików przed edycją przez Hermesa, aby można było wycofać zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz um snapshot dos arquivos antes de o Hermes editá-los, para que as alterações possam ser revertidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делать снимок файлов перед их изменением Hermes, чтобы изменения можно было откатить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes dosyaları düzenlemeden önce anlık görüntü al, böylece değişiklikler geri alınabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Hermes 编辑文件前创建快照，以便回滚更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Hermes 編輯檔案前建立快照，以便還原變更。"
          }
        }
      }
    },
