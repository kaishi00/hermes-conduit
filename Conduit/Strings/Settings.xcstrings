    "Saved, but the old key couldn't be removed everywhere. A profile still using it says Old copy of the shared key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert, aber der alte Schlüssel konnte nicht überall entfernt werden. Ein Profil, das ihn noch nutzt, zeigt „Alte Kopie des gemeinsamen Schlüssels“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardada, pero la clave antigua no se pudo quitar en todas partes. Un perfil que aún la use muestra «Copia antigua de la clave compartida»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée, mais l’ancienne clé n’a pas pu être supprimée partout. Un profil qui l’utilise encore affiche « Ancienne copie de la clé partagée »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan, tetapi kunci lama tidak dapat dihapus di semua tempat. Profil yang masih memakainya menampilkan “Salinan lama kunci bersama”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata, ma la vecchia chiave non è stata rimossa ovunque. Un profilo che la usa ancora mostra «Vecchia copia della chiave condivisa»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しましたが、古いキーをすべての場所から削除できませんでした。まだ使っているプロファイルには「共有キーの古いコピー」と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장했지만 이전 키를 모든 곳에서 제거하지 못했습니다. 아직 사용하는 프로필에는 '공유 키의 이전 사본'이 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano, ale starego klucza nie udało się wszędzie usunąć. Profil, który wciąż go używa, pokazuje „Stara kopia wspólnego klucza”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
