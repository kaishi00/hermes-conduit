          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화를 다시 설정하는 중이라 지금은 이 호스트의 알림에 일반적인 텍스트만 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
