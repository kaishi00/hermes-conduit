        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구가 줄어든 위임 에이전트도 커넥터의 도구는 계속 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent delegowany z mniejszą liczbą narzędzi nadal zachowuje narzędzia Twoich łączników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um agente delegado com menos ferramentas ainda mantém as dos seus conectores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делегат с урезанным набором инструментов всё равно сохраняет инструменты ваших коннекторов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha az araç verilen bir devredilen ajan yine de bağlayıcılarınızın araçlarını korur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使工具集被缩小，委派代理仍会保留你连接器中的工具。"
