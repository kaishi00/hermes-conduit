        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si Conduit sigue a Hermes, muestra siempre o no muestra nunca las actualizaciones de mantenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si Conduit suit Hermes, affiche toujours ou n'affiche jamais les mises à jour de maintenance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah Conduit mengikuti Hermes, selalu menampilkan, atau tidak pernah menampilkan pembaruan pemeliharaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se Conduit segue Hermes, mostra sempre o non mostra mai gli aggiornamenti di manutenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitがメンテナンスの更新情報をHermesの設定に従って表示するか、常に表示するか、表示しないかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 유지 관리 업데이트를 Hermes 설정에 따라 표시할지, 항상 표시할지, 표시하지 않을지 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy Conduit ma postępować tak jak Hermes, zawsze pokazywać, czy nigdy nie pokazywać komunikatów konserwacyjnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
