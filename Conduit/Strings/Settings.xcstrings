    "Fast model on your host: %@. Update the Conduit plugin to change it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelles Modell auf deinem Host: %@. Aktualisiere das Conduit-Plugin, um es hier zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo rápido en tu host: %@. Actualiza el plugin de Conduit para cambiarlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle rapide sur ton hôte : %@. Mets à jour le plugin Conduit pour le changer ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model cepat di host kamu: %@. Perbarui plugin Conduit untuk mengubahnya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modello veloce sul tuo host: %@. Aggiorna il plugin Conduit per cambiarlo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストの高速モデル: %@。ここで変更するには Conduit プラグインを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트의 빠른 모델: %@. 여기서 바꾸려면 Conduit 플러그인을 업데이트하세요."
