    "Archive chats nobody has touched for a while. Pinned chats stay, and nothing is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats archivieren, die eine Weile niemand angefasst hat. Angeheftete Chats bleiben, und nichts wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva los chats que nadie ha tocado en un tiempo. Los chats fijados se quedan y no se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive les discussions auxquelles personne n'a touché depuis un moment. Les discussions épinglées restent, et rien n'est supprimé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arsipkan chat yang sudah lama tidak disentuh. Chat yang disematkan tetap ada, dan tidak ada yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia le chat che nessuno tocca da un po'. Le chat fissate restano e non viene eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらく誰も触れていないチャットをアーカイブします。ピン留めしたチャットは残り、何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한동안 아무도 건드리지 않은 채팅을 보관합니다. 고정된 채팅은 그대로이며 아무것도 삭제되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwizuj czaty, których nikt od dawna nie ruszał. Przypięte czaty zostają, a nic nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquiva conversas que ninguém tocou há algum tempo. Conversas fixadas ficam, e nada é apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивировать чаты, к которым давно никто не обращался. Закреплённые чаты остаются, ничего не удаляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süredir kimsenin dokunmadığı sohbetleri arşivler. Sabitlenmiş sohbetler kalır ve hiçbir şey silinmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档一段时间无人处理的聊天。置顶的聊天会保留，且不会删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存一段時間無人處理的聊天。釘選的聊天會保留，且不會刪除任何內容。"
          }
        }
      }
    },
