    "For reverse proxies such as Pangolin, Traefik, or nginx that check a header. Sent only to this server, over HTTPS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Wird nur an diesen Server gesendet, über HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Solo se envían a este servidor, por HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Envoyés uniquement à ce serveur, en HTTPS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk reverse proxy seperti Pangolin, Traefik, atau nginx yang memeriksa header. Hanya dikirim ke server ini, melalui HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i reverse proxy come Pangolin, Traefik o nginx che controllano un'intestazione. Inviate solo a questo server, tramite HTTPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けです。HTTPS経由でこのサーバにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤더를 확인하는 Pangolin, Traefik, nginx 같은 리버스 프록시용이에요. HTTPS를 통해 이 서버에만 전송돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla odwrotnych serwerów proxy, takich jak Pangolin, Traefik czy nginx, które sprawdzają nagłówek. Wysyłane tylko do tego serwera, przez HTTPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Enviados só para este servidor, por HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Отправляются только на этот сервер по HTTPS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin, Traefik veya nginx gibi bir üstbilgiyi denetleyen ters proxy'ler için. Yalnızca bu sunucuya, HTTPS üzerinden gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。仅通过 HTTPS 发送到此服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於會檢查標頭的反向代理伺服器，例如 Pangolin、Traefik 或 nginx。只會透過 HTTPS 傳送到此伺服器。"
          }
        }
      }
    },
    "For the %@ profile. Sign-ins and shared keys reach every profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Profil %@. Anmeldungen und gemeinsame Schlüssel gelten für jedes Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para el perfil %@. Los inicios de sesión y las claves compartidas llegan a todos los perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le profil %@. Les connexions et les clés partagées valent pour tous les profils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk profil %@. Akun masuk dan kunci bersama berlaku di semua profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per il profilo %@. Gli accessi e le chiavi condivise valgono per tutti i profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ プロファイル用です。サインインと共有キーはすべてのプロファイルで使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 프로필용입니다. 로그인과 공유 키는 모든 프로필에 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla profilu %@. Logowania i wspólne klucze działają we wszystkich profilach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para o perfil %@. Logins e chaves compartilhadas valem para todos os perfis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для профиля %@. Входы и общие ключи действуют во всех профилях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ profili için. Girişler ve paylaşılan anahtarlar her profile ulaşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于 %@ 配置。登录和共享密钥适用于所有配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於 %@ 設定檔。登入與共用金鑰適用於所有設定檔。"
          }
        }
      }
    },
    "Fraction of the context window that starts compression." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil des Kontextfensters, ab dem die Komprimierung beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracción de la ventana de contexto que activa la compresión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraction de la fenêtre de contexte qui déclenche la compression."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian jendela konteks yang memicu pemadatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frazione della finestra di contesto che avvia la compressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮を開始するコンテキストウインドウの割合です。"
