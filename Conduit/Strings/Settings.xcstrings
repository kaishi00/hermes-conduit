        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルには %@ 個の %@ キーがあります。上限に達したキーがあると、Hermesは別のキーに切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에는 %@개의 %@ 키가 있습니다. 키 하나가 한도에 도달하면 Hermes가 다른 키로 바꿉니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil ma %@ kluczy do %@. Hermes przechodzi na inny, gdy któryś osiągnie limit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil tem %@ chaves para %@. O Hermes passa para outra quando uma atinge o limite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого профиля %@ ключей для %@. Когда один достигает лимита, Hermes переходит к другому."
