    "This profile has %@ keys for %@. Hermes moves to another when one hits its limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil hat %@ Schlüssel für %@. Hermes wechselt, wenn einer sein Limit erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil tiene %@ claves para %@. Hermes pasa a otra cuando una llega a su límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil a %@ clés pour %@. Hermes passe à une autre quand l’une atteint sa limite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ini punya %@ kunci untuk %@. Hermes beralih ke kunci lain saat satu kunci mencapai batasnya."
