          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birlikte başlatılan devredilen ajanların, önbelleğe alınmış istemi paylaşmak için ilkinin yanıt vermeye başlamasını beklediği saniye. 0 kapalı demektir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时启动的委派代理等待第一个开始回答的秒数，以共享其缓存的提示词。0 表示关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
