    "Delegate agents can't ask you. On, they approve a command once; off, they decline it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delegierte Agenten können dich nicht fragen. Ein: Sie genehmigen einen Befehl einmalig; aus: Sie lehnen ihn ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes delegados no pueden preguntarte. Activado, aprueban un comando una vez; desactivado, lo rechazan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents délégués ne peuvent pas vous demander. Activé, ils approuvent une commande une fois ; désactivé, ils la refusent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen delegasi tidak bisa bertanya kepada Anda. Aktif: mereka menyetujui perintah sekali; nonaktif: mereka menolaknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli agenti delegati non possono chiederti nulla. Attivo, approvano un comando una volta; disattivo, lo rifiutano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委任エージェントはあなたに確認できません。オンでは1回限りコマンドを承認し、オフでは拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위임 에이전트는 사용자에게 물어볼 수 없습니다. 켜면 명령을 한 번 승인하고, 끄면 거부합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenci delegowani nie mogą Cię zapytać. Włączone: zatwierdzają polecenie jednorazowo; wyłączone: odrzucają je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentes delegados não podem perguntar a você. Ativado, aprovam um comando uma vez; desativado, recusam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делегированные агенты не могут спросить вас. Включено — разрешают команду один раз; выключено — отклоняют её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devredilen ajanlar size soramaz. Açıkken bir komutu bir kez onaylarlar; kapalıyken reddederler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委派代理无法询问你。开启时会单次批准命令；关闭时会拒绝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委派代理程式無法詢問你。開啟時會單次核准命令；關閉時會拒絕。"
          }
        }
      }
    },
