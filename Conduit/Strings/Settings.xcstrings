    "When Hermes asks the provider for faster priority processing, on models that offer it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann Hermes den Anbieter um schnellere, priorisierte Verarbeitung bittet, bei Modellen, die das anbieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo pide Hermes al proveedor un procesamiento prioritario más rápido, en los modelos que lo ofrecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Hermes demande au fournisseur un traitement prioritaire plus rapide, sur les modèles qui le proposent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
