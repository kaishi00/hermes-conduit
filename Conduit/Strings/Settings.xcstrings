        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使工具集被縮小，委派代理程式仍會保留你連接器中的工具。"
          }
        }
      }
    },
    "Background delegate agents report one by one, not all together at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delegierte Agenten im Hintergrund melden sich einzeln, nicht alle zusammen am Ende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes delegados en segundo plano informan uno a uno, no todos juntos al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents délégués en arrière-plan rendent compte un par un, pas tous ensemble à la fin."
          }
        },
        "id" : {
