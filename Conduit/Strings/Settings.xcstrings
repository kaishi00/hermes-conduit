        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybki model na Twoim hoście: %@. Zaktualizuj wtyczkę Conduit, aby zmienić go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo rápido no seu host: %@. Atualize o plugin do Conduit para alterá-lo aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая модель на вашем хосте: %@. Обновите плагин Conduit, чтобы изменить её здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucundaki hızlı model: %@. Burada değiştirmek için Conduit eklentisini güncelle."
