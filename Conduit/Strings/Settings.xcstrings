        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un delegato con meno strumenti mantiene comunque quelli dei tuoi connettori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールを絞られた委任エージェントでも、コネクタのツールは引き続き使えます。"
