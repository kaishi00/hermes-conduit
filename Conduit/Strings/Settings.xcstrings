        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機上的快速模型：%@。更新 Conduit 外掛後可在這裡更改。"
          }
        }
      }
    },
    "Your host has no fast model set, so the chat's own model answers. Update the Conduit plugin to pick one here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Host ist kein schnelles Modell eingestellt, daher antwortet das Modell des Chats. Aktualisiere das Conduit-Plugin, um hier eines zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu host no tiene un modelo rápido configurado, así que responde el modelo del chat. Actualiza el plugin de Conduit para elegir uno aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton hôte n'a pas de modèle rapide, c'est donc le modèle du chat qui répond. Mets à jour le plugin Conduit pour en choisir un ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host kamu belum punya model cepat, jadi model chat yang menjawab. Perbarui plugin Conduit untuk memilihnya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo host non ha un modello veloce impostato, quindi risponde il modello della chat. Aggiorna il plugin Conduit per sceglierne uno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストに高速モデルが設定されていないため、チャットのモデルが応答します。ここで選ぶには Conduit プラグインを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
