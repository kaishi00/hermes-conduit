        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby nie pokazywały się na ekranie blokady, w Ustawieniach iOS > Powiadomienia > Conduit ustaw Pokazuj podglądy na Gdy odblokowany."
