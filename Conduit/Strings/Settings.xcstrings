          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем хосте не задана быстрая модель, поэтому отвечает модель чата. Обновите плагин Conduit, чтобы выбрать её здесь."
          }
