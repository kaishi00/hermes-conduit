    "A delegate given fewer tools still keeps your connectors' tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Delegierter mit weniger Werkzeugen behält trotzdem die Werkzeuge deiner Konnektoren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un delegado con menos herramientas conserva las de tus conectores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un délégué doté de moins d'outils garde quand même ceux de vos connecteurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delegasi dengan alat yang lebih sedikit tetap memakai alat dari konektor Anda."
