    "Overrides the main model's context window, in tokens. 0 uses the model's own size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibt das Kontextfenster des Hauptmodells in Tokens. 0 verwendet die eigene Größe des Modells."
          }
        },
        "es" : {
          "stringUnit" : {
