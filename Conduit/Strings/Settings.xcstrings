    "Your host has no fast model set, so the chat's own model answers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Host ist kein schnelles Modell eingestellt, daher antwortet das Modell des Chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu host no tiene un modelo rápido configurado, así que responde el modelo del chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton hôte n'a pas de modèle rapide, c'est donc le modèle du chat qui répond."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host kamu belum punya model cepat, jadi model chat yang menjawab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo host non ha un modello veloce impostato, quindi risponde il modello della chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストに高速モデルが設定されていないため、チャットのモデルが応答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에 빠른 모델이 설정되어 있지 않아 채팅 모델이 답합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój host nie ma ustawionego szybkiego modelu, więc odpowiada model czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu host não tem um modelo rápido definido, então o modelo do chat responde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем хосте не задана быстрая модель, поэтому отвечает модель чата."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunda hızlı model ayarlı değil, bu yüzden sohbetin modeli yanıt veriyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主机没有设置快速模型，所以由聊天自己的模型回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主機沒有設定快速模型，所以由聊天自己的模型回答。"
          }
        }
      }
    },
    "Approval and clarify cards need a newer plugin. This dashboard's host keeps the plugin up to date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigabe- und Rückfragekarten erfordern ein neueres Plug-in. Der Host dieses Dashboards hält das Plugin aktuell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas de aprobación y aclaración necesitan un plugin más reciente. El host de este panel mantiene el plugin al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes d'approbation et de précision nécessitent un plugin plus récent. L'hôte de ce tableau de bord garde le plugin à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu persetujuan dan klarifikasi memerlukan plugin yang lebih baru. Host dasbor ini menjaga plugin tetap terbaru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede di approvazione e di chiarimento richiedono un plugin più recente. L'host di questa dashboard mantiene il plugin aggiornato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認カードと質問カードには新しいプラグインが必要です。このダッシュボードのホストがプラグインを最新に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 및 질문 카드를 사용하려면 최신 플러그인이 필요해요. 이 대시보드의 호스트가 플러그인을 최신 상태로 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty zatwierdzeń i pytań wymagają nowszej wtyczki. Host tego pulpitu dba o aktualność wtyczki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões de aprovação e esclarecimento precisam de um plugin mais recente. O host deste painel mantém o plugin atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для карточек разрешений и уточнений нужна более новая версия плагина. Хост этой панели сам обновляет плагин."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay ve netleştirme kartları için daha yeni bir eklenti gerekir. Bu panonun sunucusu eklentiyi güncel tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审批与澄清卡片需要更新的插件。此仪表板的主机会保持插件为最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核准與釐清卡片需要較新的外掛程式。此儀表板的主機會讓外掛保持最新版本。"
          }
        }
      }
    },
