    "Could not build a safe Hermes Kanban request (invalid %@). The operation was cancelled before any data changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine sichere Hermes-Kanban-Anfrage erstellt werden (ungültig: %@). Der Vorgang wurde abgebrochen, bevor Daten geändert wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear una solicitud segura de Kanban para Hermes (%@ no válido). La operación se canceló antes de que cambiara ningún dato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de construire une requête Kanban Hermes sûre (%@ non valide). L'opération a été annulée avant toute modification des données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membuat permintaan Kanban Hermes yang aman (%@ tidak valid). Operasi dibatalkan sebelum ada data yang berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile creare una richiesta Kanban sicura per Hermes (%@ non valido). L'operazione è stata annullata prima di qualsiasi modifica ai dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全なHermesカンバンリクエストを作成できませんでした（%@が無効です）。データが変更される前に操作はキャンセルされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전한 Hermes Kanban 요청을 만들 수 없어요(잘못된 %@). 데이터가 변경되기 전에 동작이 취소됐어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się utworzyć bezpiecznego żądania Kanban Hermes (nieprawidłowy parametr %@). Operację anulowano, zanim zmieniły się jakiekolwiek dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível montar uma solicitação segura ao Kanban do Hermes (%@ inválido). A operação foi cancelada antes de qualquer alteração nos dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сформировать безопасный запрос к Hermes Kanban (недопустимое значение: %@). Операция отменена до изменения каких-либо данных."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli bir Hermes Kanban isteği oluşturulamadı (geçersiz %@). İşlem, hiçbir veri değişmeden iptal edildi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法构建安全的 Hermes 看板请求（%@ 无效）。操作已在数据更改前取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立安全的 Hermes Kanban 請求（%@ 無效）。操作已在任何資料變更前取消。"
          }
        }
      }
    },
