    "Invalid board slug — use 1-64 lowercase letters or numbers with hyphens/underscores." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungültiger Board-Slug – verwende 1–64 Kleinbuchstaben oder Ziffern mit Binde- oder Unterstrichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificador de tablero no válido: usa de 1 a 64 letras minúsculas o números con guiones o guiones bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug de tableau non valide : utilisez de 1 à 64 lettres minuscules ou chiffres, avec des tirets ou des tirets bas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug papan tidak valid — gunakan 1-64 huruf kecil atau angka dengan tanda hubung/garis bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug della bacheca non valido: usa da 1 a 64 lettere minuscole o numeri con trattini o trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードのスラッグが無効です。小文字の英字、数字、ハイフン、アンダースコアを使って1〜64文字で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 보드 슬러그 — 소문자, 숫자, 하이픈/밑줄로 1~64자를 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprawidłowy identyfikator tablicy — użyj od 1 do 64 małych liter lub cyfr z łącznikami/podkreśleniami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug do quadro inválido — use de 1 a 64 letras minúsculas ou números, com hifens/sublinhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недопустимый слаг доски — используйте от 1 до 64 строчных букв или цифр, дефисов и подчёркиваний."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçersiz pano kısa adı — 1-64 küçük harf veya rakam kullanın; kısa çizgi ve alt çizgi kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看板标识无效——请使用 1-64 个小写字母、数字或连字符/下划线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看板代稱無效：請使用 1 到 64 個小寫字母或數字，可包含連字號或底線。"
          }
        }
      }
    },
