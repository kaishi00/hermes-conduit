    "\"%@\" is not a valid reasoning effort for a Hermes worker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist kein gültiger Reasoning-Aufwand für einen Hermes-Worker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un esfuerzo de razonamiento válido para un ejecutor de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'est pas un effort de raisonnement valide pour un worker Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan upaya penalaran yang valid untuk worker Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un'intensità di ragionamento valida per un worker Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はHermesワーカーの推論の強度として無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) Hermes 워커에 유효한 추론 수준이 아니에요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie jest prawidłową intensywnością rozumowania dla procesu roboczego Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um esforço de raciocínio válido para um executor do Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — недопустимая глубина рассуждений для обработчика Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”, bir Hermes çalışanı için geçerli bir akıl yürütme düzeyi değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Hermes 工作代理的有效思考强度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是 Hermes 執行者的有效推理強度。"
          }
        }
      }
    },
    "%@, but the board could not be refreshed. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, aber das Board konnte nicht aktualisiert werden. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, pero no se pudo actualizar el tablero. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, mais le tableau n'a pas pu être actualisé. %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, tetapi papan tidak dapat dimuat ulang. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ma non è stato possibile aggiornare la bacheca. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ただし、ボードを更新できませんでした。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 하지만 보드를 새로고침할 수 없었어요. %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ale nie udało się odświeżyć tablicy. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, mas não foi possível atualizar o quadro. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, но не удалось обновить доску. %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ancak pano yenilenemedi. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，但无法刷新看板。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，但無法重新整理看板。%@"
          }
        }
      }
    },
