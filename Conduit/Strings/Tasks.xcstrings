    "A cron expression, or a phrase Hermes reads, like every 2h or weekdays at 9am." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Cron-Ausdruck oder eine Angabe, die Hermes versteht, etwa every 2h oder weekdays at 9am."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una expresión cron o una frase que Hermes entienda, como every 2h o weekdays at 9am."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expression cron, ou une formule que Hermes comprend, comme every 2h ou weekdays at 9am."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspresi cron, atau frasa yang dipahami Hermes, seperti every 2h atau weekdays at 9am."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'espressione cron o una frase che Hermes capisce, come every 2h o weekdays at 9am."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cron 式、または Hermes が読める表現（every 2h、weekdays at 9am など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cron 표현식 또는 Hermes가 읽을 수 있는 문구(예: every 2h, weekdays at 9am)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrażenie cron lub fraza zrozumiała dla Hermesa, np. every 2h albo weekdays at 9am."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma expressão cron ou uma frase que o Hermes entenda, como every 2h ou weekdays at 9am."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
