    "Hermes sent a Kanban reply Conduit didn't understand. Updating Hermes and Conduit usually fixes this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat eine Kanban-Antwort gesendet, die Conduit nicht verstanden hat. Meist hilft es, Hermes und Conduit zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes envió una respuesta de Kanban que Conduit no entendió. Normalmente se soluciona actualizando Hermes y Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a envoyé une réponse Kanban que Conduit n'a pas comprise. Mettre à jour Hermes et Conduit règle généralement le problème."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes mengirim balasan Kanban yang tidak dipahami Conduit. Memperbarui Hermes dan Conduit biasanya dapat mengatasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ha inviato una risposta Kanban che Conduit non ha capito. Di solito si risolve aggiornando Hermes e Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesからConduitが解釈できないカンバンの応答が返されました。通常はHermesとConduitをアップデートすると解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Conduit이 이해할 수 없는 Kanban 응답을 보냈어요. 보통 Hermes와 Conduit을 업데이트하면 해결돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes wysłał odpowiedź Kanban, której Conduit nie rozumie. Zwykle pomaga aktualizacja Hermesa i Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
