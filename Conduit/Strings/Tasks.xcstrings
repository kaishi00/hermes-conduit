        }
      }
    },
    "The task was created%@, but Hermes could not move it to %@. It was not duplicated; close this form and refresh the board. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufgabe wurde erstellt%@, aber Hermes konnte sie nicht nach %@ verschieben. Sie wurde nicht dupliziert; schließe dieses Formular und aktualisiere das Board. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarea se creó%@, pero Hermes no pudo moverla a %@. No se duplicó; cierra este formulario y actualiza el tablero. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tâche a été créée%@, mais Hermes n'a pas pu la déplacer vers %@. Elle n'a pas été dupliquée ; fermez ce formulaire et actualisez le tableau. %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugas telah dibuat%@, tetapi Hermes tidak dapat memindahkannya ke %@. Tugas tidak diduplikasi; tutup formulir ini dan segarkan papan. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività è stata creata%@, ma Hermes non è riuscito a spostarla in %@. Non è stata duplicata: chiudi questo modulo e aggiorna la bacheca. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクは作成されました%@。ただし、Hermesで%@に移動できませんでした。重複して作成されてはいません。このフォームを閉じてボードを更新してください。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태스크가 생성됐어요%@. 하지만 Hermes가 %@ 상태로 옮기지 못했어요. 중복 생성되지는 않았으니 이 양식을 닫고 보드를 새로 고치세요. %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadanie zostało utworzone%@, ale Hermes nie mógł przenieść go do kolumny %@. Nie zostało zduplikowane; zamknij ten formularz i odśwież tablicę. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tarefa foi criada%@, mas o Hermes não conseguiu movê-la para %@. Ela não foi duplicada; feche este formulário e atualize o quadro. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задача создана%@, но Hermes не удалось переместить её в «%@». Дубликат не создан; закройте эту форму и обновите доску. %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görev oluşturuldu%@ ancak Hermes onu %@ sütununa taşıyamadı. Kopyası oluşturulmadı; bu formu kapatıp panoyu yenileyin. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务已创建%@，但 Hermes 无法将其移动到 %@。未创建重复任务；请关闭此表单并刷新看板。%@"
