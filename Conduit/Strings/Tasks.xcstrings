    "Each run uses this model and reasoning. Profile default follows the profile's, so a change there reaches this job too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Lauf nutzt dieses Modell und diese Denkstufe. Profilstandard folgt dem Profil, eine Änderung dort gilt also auch für diesen Job."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each run uses this model and reasoning. Profile default follows the profile's, so a change there reaches this job too."
          }
