        }
      }
    },
    "Each run is saved as its own conversation. Chats lists them under the Scheduled filter. Ask Hermes to add or change a schedule." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Lauf wird als eigene Unterhaltung gespeichert. Chats zeigt sie unter dem Filter „Geplant“. Bitte Hermes, einen Zeitplan hinzuzufügen oder zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ejecución se guarda como su propia conversación. Chats las muestra con el filtro Programado. Pídele a Hermes que añada o cambie una programación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque exécution est enregistrée comme sa propre conversation. Discussions les affiche sous le filtre Planifié. Demandez à Hermes d'ajouter ou de modifier une planification."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap eksekusi disimpan sebagai percakapan tersendiri. Obrolan menampilkannya di filter Terjadwal. Minta Hermes untuk menambah atau mengubah jadwal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esecuzione viene salvata come conversazione a sé. Chat le elenca nel filtro Pianificato. Chiedi a Hermes di aggiungere o modificare una pianificazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各実行は独立した会話として保存され、チャットの「スケジュール済み」フィルタに表示されます。スケジュールの追加や変更は Hermes に頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 실행은 별도의 대화로 저장되며 채팅의 예약됨 필터에 표시됩니다. 일정을 추가하거나 바꾸려면 Hermes에게 요청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde uruchomienie jest zapisywane jako osobna rozmowa. Czaty pokazują je w filtrze Zaplanowane. Poproś Hermesa, aby dodał lub zmienił harmonogram."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada execução é salva como uma conversa própria. Chats as lista no filtro Agendado. Peça ao Hermes para adicionar ou mudar um agendamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый запуск сохраняется отдельным разговором. В Чатах они показаны под фильтром «Запланировано». Попросите Hermes добавить или изменить расписание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her çalıştırma ayrı bir konuşma olarak kaydedilir. Sohbetler bunları Zamanlanmış filtresinde listeler. Bir zamanlama eklemek veya değiştirmek için Hermes'e sorun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行都会保存为单独的对话，显示在聊天的“已排期”筛选中。可以让 Hermes 添加或更改计划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次執行都會儲存為獨立對話，顯示在聊天的「已排程」篩選中。可以請 Hermes 新增或更改排程。"
          }
        }
      }
    },
