    "A workspace path can only be set for Worktree and Directory tasks. Hermes scratch tasks resolve their own directory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Arbeitsbereichspfad kann nur für Aufgaben vom Typ „Worktree“ und „Verzeichnis“ festgelegt werden. Temporäre Hermes-Aufgaben bestimmen ihr Verzeichnis selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se puede definir una ruta de espacio de trabajo para tareas de tipo Worktree y Directorio. Las tareas temporales de Hermes determinan su propio directorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chemin d'espace de travail ne peut être défini que pour les tâches Worktree et Dossier. Les tâches temporaires d'Hermes déterminent leur propre dossier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalur ruang kerja hanya dapat diatur untuk tugas Worktree dan Direktori. Tugas sementara Hermes menentukan direktorinya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un percorso dello spazio di lavoro può essere impostato solo per le attività Worktree e Directory. Le attività temporanee di Hermes determinano la propria directory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースのパスは、「ワークツリー」と「ディレクトリ」のタスクにのみ設定できます。Hermesの一時ワークスペースのタスクは、ディレクトリを自動で決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간 경로는 워크트리 및 디렉터리 태스크에만 설정할 수 있어요. Hermes 임시 태스크는 디렉터리를 자체적으로 정해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżkę obszaru roboczego można ustawić tylko dla zadań typu Worktree i Katalog. Tymczasowe zadania Hermesa same ustalają swój katalog."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um caminho de espaço de trabalho só pode ser definido para tarefas Worktree e Diretório. As tarefas temporárias do Hermes definem o próprio diretório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь рабочего пространства можно задать только для задач типа «Worktree» и «Каталог». Временные задачи Hermes определяют свой каталог сами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma alanı yolu yalnızca Worktree ve Dizin görevleri için ayarlanabilir. Hermes'in geçici görevleri kendi dizinlerini belirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有“工作树”和“目录”任务可以设置工作区路径。Hermes 暂存任务会自行确定目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有「工作樹」和「目錄」任務可以設定工作區路徑。Hermes 暫存任務會自行決定目錄。"
          }
        }
      }
    },
