    "The look ahead passed over it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorausschau hat es übergangen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La previsión lo pasó por alto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tour d'horizon l'a laissé de côté"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjauan ke depan melewatkannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sguardo avanti l'ha tralasciato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先読みでは取り上げられませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내다보기에서 다루지 않았습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przegląd nadchodzących dni to pominął"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A previsão passou por cima disso"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обзор на две недели это пропустил"
