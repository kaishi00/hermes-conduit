    "Only what's worth interrupting you for: one reminder a day, and promises checked less often." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur, wofür es sich lohnt, dich zu unterbrechen: eine Erinnerung am Tag, Versprechen seltener geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo que merece interrumpirte: un recordatorio al día y promesas revisadas con menos frecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement ce qui vaut la peine de vous interrompre : un rappel par jour, promesses vérifiées moins souvent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya yang layak menyela Anda: satu pengingat sehari, janji dicek lebih jarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ciò che vale un'interruzione: un promemoria al giorno, promesse controllate meno spesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割り込む価値のあることだけ：リマインダーは1日1件、約束の確認は控えめに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방해할 가치가 있는 것만: 하루 1개의 리마인더, 약속은 덜 자주 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko to, co warte przerwania: jedno przypomnienie dziennie, obietnice sprawdzane rzadziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que vale uma interrupção: um lembrete por dia e promessas verificadas com menos frequência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только то, ради чего стоит отвлечь: одно напоминание в день, обещания проверяются реже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca sizi bölmeye değecek şeyler: günde bir hatırlatma, sözler daha seyrek kontrol edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只提值得打扰你的事：每天一条提醒，承诺检查得少一些。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只提值得打擾你的事：每天一則提醒，承諾檢查得少一些。"
          }
        }
      }
    },
