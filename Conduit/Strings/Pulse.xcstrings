    "Thumbs move these too: two down make it quieter, two up louder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Daumen verändern das: zweimal runter macht es leiser, zweimal hoch lauter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pulgares también lo cambian: dos abajo lo hacen más discreto, dos arriba más visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pouces le changent aussi : deux vers le bas le rendent plus discret, deux vers le haut plus présent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jempol juga mengubahnya: dua ke bawah membuatnya lebih senyap, dua ke atas lebih menonjol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche i pollici lo cambiano: due in giù lo rendono più discreto, due in su più presente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評価でも変わります。低評価2回で控えめに、高評価2回で目立つようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평가로도 바뀝니다. 싫어요 두 번이면 조용해지고 좋아요 두 번이면 더 눈에 띕니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kciuki też to zmieniają: dwa w dół – ciszej, dwa w górę – głośniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os polegares também mudam isso: dois para baixo deixam mais discreto, dois para cima mais visível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценки тоже это меняют: два «не нравится» делают тише, два «нравится» — заметнее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğeniler de bunu değiştirir: iki beğenmeme daha sessiz, iki beğeni daha belirgin yapar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评分也会改变它：两次差评更安静，两次好评更显眼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評分也會改變它：兩次負評更安靜，兩次好評更顯眼。"
          }
        }
      }
    },
