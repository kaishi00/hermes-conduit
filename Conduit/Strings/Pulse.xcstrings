    "Pulse keeps its reports in a chat of its own in the profile it runs in, %@. It stays out of your chats." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse speichert seine Berichte in einem eigenen Chat im Profil, in dem es läuft: %@. Er erscheint nicht bei deinen Chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse guarda sus informes en un chat propio en el perfil en el que funciona, %@. No aparece entre tus chats."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse garde ses rapports dans un chat à lui dans le profil où il tourne, %@. Il n’apparaît pas parmi vos chats."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse menyimpan laporannya di obrolan miliknya sendiri di profil tempat ia berjalan, %@. Obrolan itu tidak muncul di daftar obrolanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse tiene i suoi resoconti in una chat tutta sua nel profilo in cui gira, %@. Non compare tra le tue chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse はレポートを、動作しているプロフィール（%@）内の専用チャットに保存します。このチャットはチャット一覧には表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse는 실행 중인 프로필(%@)의 전용 채팅에 보고서를 보관합니다. 이 채팅은 채팅 목록에 나타나지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse trzyma swoje raporty we własnym czacie w profilu, w którym działa: %@. Nie pojawia się on wśród Twoich czatów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse guarda seus relatórios em um chat próprio no perfil em que roda, %@. Ele não aparece entre seus chats."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse хранит свои отчёты в собственном чате в профиле, в котором работает: %@. Этот чат не показывается среди ваших чатов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse raporlarını çalıştığı profildeki (%@) kendine ait bir sohbette tutar. Bu sohbet, sohbetlerin arasında görünmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 把报告保存在它运行所在的个人资料（%@）中它自己的聊天里。这个聊天不会出现在你的聊天列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 會把報告保存在它執行所在的個人資料（%@）中它自己的聊天裡。這個聊天不會出現在你的聊天列表中。"
          }
        }
      }
    },
