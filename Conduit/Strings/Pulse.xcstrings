        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleriye bakış bunu atladı"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前瞻没有提到它"
          }
        },
        "zh-Hant" : {
