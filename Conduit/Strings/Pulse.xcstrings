    "Pulse reminded me: %@\n\nGo ahead with it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse hat mich erinnert: %@\n\nLeg jetzt damit los."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse me recordó: %@\n\nAdelante, hazlo ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse m'a rappelé : %@\n\nVas-y, fais-le maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mengingatkan saya: %@\n\nSilakan lanjutkan sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mi ha ricordato: %@\n\nProcedi pure adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulseからのリマインダー：%@\n\n今すぐ進めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse가 알려 준 일: %@\n\n지금 진행해 줘."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mi przypomniał: %@\n\nŚmiało, zrób to teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse me lembrou: %@\n\nVá em frente com isso agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse напомнил мне: %@\n\nПриступай к этому сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse bana hatırlattı: %@\n\nHadi, şimdi yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 提醒我：%@\n\n现在就去做吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 提醒我：%@\n\n現在就去做吧。"
          }
        }
      }
    },
    "Pulse reminded me: %@\n\nIt came up in the work on Kanban task %@. Check the task on the board, and if it's stuck, get it going again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse hat mich erinnert: %1$@\n\nDas kam bei der Arbeit an der Kanban-Aufgabe %2$@ auf. Sieh dir die Aufgabe auf dem Board an, und wenn sie feststeckt, bring sie wieder in Gang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse me recordó: %1$@\n\nSurgió en el trabajo de la tarea de Kanban %2$@. Revisa la tarea en el tablero y, si está atascada, ponla en marcha de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse m'a rappelé : %1$@\n\nC'est venu pendant le travail sur la tâche Kanban %2$@. Regarde la tâche sur le tableau et, si elle est bloquée, relance-la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mengingatkan saya: %1$@\n\nIni muncul saat mengerjakan tugas Kanban %2$@. Periksa tugasnya di papan, dan jika macet, jalankan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mi ha ricordato: %1$@\n\nÈ emerso durante il lavoro sull'attività Kanban %2$@. Controlla l'attività nella bacheca e, se è bloccata, rimettila in moto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulseからのリマインダー：%1$@\n\nカンバンタスク %2$@ の作業中に出てきたことです。ボードでタスクを確認して、止まっていたらもう一度動かしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse가 알려 준 일: %1$@\n\nKanban 태스크 %2$@ 작업 중에 나온 일이야. 보드에서 태스크를 확인하고, 멈춰 있으면 다시 진행시켜 줘."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mi przypomniał: %1$@\n\nPojawiło się to przy pracy nad zadaniem Kanban %2$@. Sprawdź zadanie na tablicy, a jeśli utknęło, uruchom je ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse me lembrou: %1$@\n\nIsso surgiu no trabalho da tarefa do Kanban %2$@. Confira a tarefa no quadro e, se estiver travada, coloque-a para andar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse напомнил мне: %1$@\n\nЭто всплыло в работе над задачей Kanban %2$@. Проверь задачу на доске и, если она застряла, запусти её снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse bana hatırlattı: %1$@\n\nBu, %2$@ Kanban görevi üzerinde çalışılırken çıktı. Görevi panoda kontrol et, takıldıysa yeniden yürüt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 提醒我：%1$@\n\n这是在处理看板任务 %2$@ 时提到的。在看板上查看这个任务，如果卡住了，就让它重新跑起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 提醒我：%1$@\n\n這是在處理 Kanban 任務 %2$@ 時提到的。在看板上查看這個任務，如果卡住了，就讓它重新跑起來。"
          }
        }
      }
    },
