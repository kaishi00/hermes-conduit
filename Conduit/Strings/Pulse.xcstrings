    "Tells Pulse this is taken care of, so it stops checking on it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt Pulse, dass das erledigt ist, damit es nicht mehr nachfragt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dice a Pulse que ya está resuelto, para que deje de comprobarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique à Pulse que c'est réglé, pour qu'il arrête de vérifier"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu Pulse bahwa ini sudah beres, jadi Pulse berhenti memeriksanya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice a Pulse che è già fatto, così smette di controllare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは対応済みだと Pulse に伝え、確認をやめさせます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리했다고 Pulse에 알려 더 이상 확인하지 않게 합니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówi Pulse, że to już załatwione, więc przestaje to sprawdzać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa ao Pulse que isso já foi resolvido, para ele parar de verificar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает Pulse, что это уже сделано, и он перестаёт это проверять"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse'a bunun halledildiğini söyler, böylece kontrol etmeyi bırakır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉 Pulse 这件事已经处理好，它就不再跟进"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴 Pulse 這件事已經處理好，它就不再追蹤"
          }
        }
      }
    },
    "Tells Pulse this is taken care of, so the next report knows it's done" : {
