    "Run work" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit ausführen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecutar trabajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancer du travail"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalankan pekerjaan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia lavori"
          }
        },
        "ja" : {
