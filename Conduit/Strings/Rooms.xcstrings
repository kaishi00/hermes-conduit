    "Your agents stop taking part, and %@ is told. Your copy of the room and their chats for it stay until you delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten nehmen nicht mehr teil, und %@ wird informiert. Deine Kopie des Raums und ihre Chats dafür bleiben, bis du sie löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes dejan de participar y se avisa a %@. Tu copia de la sala y sus chats en ella se quedan hasta que la elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents ne participent plus, et %@ est prévenu. Votre copie du salon et leurs discussions restent jusqu’à ce que vous la supprimiez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen Anda berhenti ikut serta, dan %@ diberi tahu. Salinan ruang Anda dan chat mereka di sana tetap ada sampai Anda menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi agenti smettono di partecipare e %@ viene avvisato. La tua copia della stanza e le loro chat restano finché non la elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのエージェントは参加をやめ、%@ さんに通知されます。グループのコピーとその中のチャットは、削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 에이전트가 더 이상 참여하지 않으며, %@ 님에게 알려요. 방의 사본과 그 안의 채팅은 삭제할 때까지 남아 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje agenty przestają brać udział, a %@ zostaje powiadomiony. Twoja kopia pokoju i ich czaty w nim zostają, dopóki jej nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus agentes deixam de participar, e %@ é avisado. Sua cópia da sala e as conversas deles nela ficam até você apagá-la."
          }
