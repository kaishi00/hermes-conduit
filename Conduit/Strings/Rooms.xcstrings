        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この招待はあなた自身のHermesのものです。リンクする相手に送ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 초대는 내 Hermes에서 만든 거예요. 연결할 사람에게 보내세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zaproszenie pochodzi z Twojego Hermesa. Wyślij je osobie, z którą chcesz się połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este convite é do seu próprio Hermes. Envie-o para a pessoa com quem você vai se vincular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приглашение от вашего собственного Hermes. Отправьте его человеку, с которым устанавливаете связь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu davet kendi Hermes'inizden. Bağlantı kuracağınız kişiye gönderin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邀请来自你自己的 Hermes。请把它发给你要关联的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邀請來自你自己的 Hermes。請把它傳給你要連結的人。"
          }
        }
      }
    },
    "Update the Conduit plugin on your Hermes host to link with someone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere das Conduit-Plugin auf deinem Hermes-Host, um dich mit jemandem zu verknüpfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza el plugin de Conduit en tu host de Hermes para vincularte con alguien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
