    "Each bot starts with its choices from your last room with the same people, else its defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Bot startet mit seinen Einstellungen aus deinem letzten Raum mit denselben Personen, sonst mit seinen Standardwerten."
          }
