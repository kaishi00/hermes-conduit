    "Make an invite for the person you're linking with. They open it in Conduit to link your Hermes with theirs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Einladung für die Person, mit der du dich verknüpfen möchtest. Sie öffnet sie in Conduit, um deinen Hermes mit ihrem zu verknüpfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una invitación para la persona con la que te vas a vincular. La abre en Conduit para vincular tu Hermes con el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une invitation pour la personne avec qui vous vous liez. Elle l'ouvre dans Conduit pour lier votre Hermes au sien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat undangan untuk orang yang ingin Anda tautkan. Dia membukanya di Conduit untuk menautkan Hermes Anda dengan miliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un invito per la persona con cui ti colleghi. Lo apre in Conduit per collegare il tuo Hermes al suo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクする相手のために招待を作成します。相手がConduitで開いて、あなたのHermesと相手のHermesをリンクします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결할 사람을 위한 초대를 만드세요. 상대가 Conduit에서 열어 내 Hermes와 상대의 Hermes를 연결해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz zaproszenie dla osoby, z którą chcesz się połączyć. Otworzy je w Conduit, aby połączyć Twojego Hermesa ze swoim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um convite para a pessoa com quem você vai se vincular. Ela abre o convite no Conduit para vincular o seu Hermes ao dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте приглашение для человека, с которым устанавливаете связь. Он откроет его в Conduit, чтобы связать ваш Hermes со своим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kuracağınız kişi için bir davet oluşturun. O kişi daveti Conduit'te açarak Hermes'inizi kendi Hermes'ine bağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为要关联的人创建邀请。对方在 Conduit 中打开它，即可将你的 Hermes 与其 Hermes 关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為要連結的人建立邀請。對方在 Conduit 中開啟它，即可將你的 Hermes 與其 Hermes 連結。"
          }
        }
      }
    },
