    "%@ is larger than the %@ MB a group room takes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist größer als die %@ MB, die ein Raum annimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera los %@ MB que admite una sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépasse les %@ Mo qu'accepte un salon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ melebihi batas %@ MB yang diterima ruang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera i %@ MB accettati da una stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はグループで送れる上限（%@MB）を超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일이 방에서 받을 수 있는 %@MB보다 커요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik %@ przekracza %@ MB, które przyjmuje pokój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ excede os %@ MB que uma sala aceita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ превышает %@ МБ — столько принимает комната."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, bir odanın kabul ettiği %@ MB sınırından büyük."
