    "Only the bots you pick answer. With none picked, every bot can answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die ausgewählten Bots antworten. Ist keiner ausgewählt, kann jeder Bot antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo responden los bots que elijas. Si no eliges ninguno, puede responder cualquier bot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les bots choisis répondent. Si aucun n’est choisi, tous les bots peuvent répondre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya bot yang kamu pilih yang menjawab. Jika tidak ada yang dipilih, semua bot bisa menjawab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondono solo i bot che scegli. Se non ne scegli nessuno, può rispondere qualsiasi bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだボットだけが返答します。何も選ばないと、どのボットも返答できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 봇만 답합니다. 아무것도 선택하지 않으면 모든 봇이 답할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiadają tylko wybrane boty. Jeśli żaden nie jest wybrany, może odpowiedzieć każdy bot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os bots escolhidos respondem. Sem nenhum escolhido, qualquer bot pode responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечают только выбранные боты. Если никто не выбран, ответить может любой бот."
