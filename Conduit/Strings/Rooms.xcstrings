    "Your copy of it and your agents' chats for it are deleted from your Hermes. The others keep theirs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kopie davon und die Chats deiner Agenten dafür werden von deinem Hermes gelöscht. Die anderen behalten ihre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu copia y los chats de tus agentes para ella se eliminan de tu Hermes. Los demás conservan los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre copie et les discussions de vos agents pour ce salon sont supprimées de votre Hermes. Les autres gardent les leurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan Anda dan obrolan agen Anda untuk ruang ini dihapus dari Hermes Anda. Yang lain tetap menyimpan milik mereka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua copia e le chat dei tuoi agenti per questa stanza vengono eliminate dal tuo Hermes. Gli altri tengono le loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループのコピーと、あなたのエージェントのこのグループ用チャットがあなたのHermesから削除されます。ほかの人の分はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방의 사본과 내 에이전트의 이 방 채팅이 내 Hermes에서 삭제돼요. 다른 사람들의 것은 그대로 남아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja kopia i czaty twoich agentów dla tego pokoju zostaną usunięte z twojego Hermesa. Inni zachowają swoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua cópia e os chats dos seus agentes para ela serão apagados do seu Hermes. Os outros mantêm os deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша копия комнаты и чаты ваших агентов для неё будут удалены с вашего Hermes. Остальные сохранят свои."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu odanın kopyası ve ajanlarınızın bu odadaki sohbetleri Hermes'inizden silinir. Diğerleri kendi kopyalarını tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群聊的副本以及你的智能体在其中的聊天将从你的 Hermes 删除。其他人会保留各自的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群組聊天的副本以及你的代理程式在其中的聊天將從你的 Hermes 刪除。其他人會保留各自的副本。"
          }
        }
      }
    },
    "%@ stops taking part, and %@'s Hermes is told." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nimmt nicht mehr teil, und der Hermes von %2$@ wird informiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deja de participar y se avisa al Hermes de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne participe plus, et le Hermes de %2$@ est prévenu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ berhenti ikut serta, dan Hermes milik %2$@ diberi tahu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ smette di partecipare e l’Hermes di %2$@ viene avvisato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は参加をやめ、%2$@ さんの Hermes に通知されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 더 이상 참여하지 않으며, %2$@ 님의 Hermes에 알려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ przestaje brać udział, a Hermes użytkownika %2$@ zostaje powiadomiony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deixa de participar, e o Hermes de %2$@ é avisado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ больше не участвует, и Hermes пользователя %2$@ получит уведомление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ artık katılmıyor ve %2$@ adlı kişinin Hermes'ine bildiriliyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不再参与，并会通知 %2$@ 的 Hermes。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不再參與，並會通知 %2$@ 的 Hermes。"
          }
        }
      }
    },
