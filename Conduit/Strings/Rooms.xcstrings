            "value" : "Vos agents ont été retirés"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen Anda dikeluarkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi agenti sono stati rimossi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのエージェントは外されました"
