        }
      }
    },
    "Someone opening your invite sees these four words. Read them to each other: if theirs match, the invite is yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer deine Einladung öffnet, sieht diese vier Wörter. Lest sie euch gegenseitig vor: Stimmen sie überein, ist die Einladung von dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien abra tu invitación verá estas cuatro palabras. Léelas en voz alta con la otra persona: si coinciden con las suyas, la invitación es tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque ouvre votre invitation voit ces quatre mots. Lisez-les-vous l'un à l'autre : s'ils correspondent, l'invitation vient bien de vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang membuka undangan Anda melihat empat kata ini. Bacakan satu sama lain: jika sama, undangan itu dari Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi apre il tuo invito vede queste quattro parole. Leggetevele a vicenda: se coincidono, l'invito è tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの招待を開いた人には、この4つの単語が表示されます。お互いに読み上げて、一致すれば招待はあなたのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 초대를 여는 사람에게 이 네 단어가 보여요. 서로 읽어 주세요. 일치하면 내가 보낸 초대예요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoba otwierająca Twoje zaproszenie widzi te cztery słowa. Przeczytajcie je sobie nawzajem: jeśli się zgadzają, zaproszenie jest od Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abrir seu convite vê estas quatro palavras. Leiam-nas um para o outro: se baterem, o convite é seu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, кто откроет ваше приглашение, увидит эти четыре слова. Прочитайте их друг другу: если они совпадают, приглашение ваше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davetinizi açan kişi bu dört kelimeyi görür. Birbirinize okuyun: eşleşiyorsa davet sizindir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开你邀请的人会看到这四个词。请互相念给对方听：如果一致，邀请就是你发的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟你邀請的人會看到這四個詞。請互相念給對方聽：如果一致，邀請就是你發的。"
          }
        }
      }
    },
