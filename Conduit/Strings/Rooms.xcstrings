        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши агенты больше не участвуют, и %@ получит уведомление. Ваша копия комнаты и их чаты в ней останутся, пока вы её не удалите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanlarınız artık katılmıyor ve %@ adlı kişiye bildiriliyor. Oda kopyanız ve içindeki sohbetleri, siz silene kadar kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
