        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o plugin do Conduit no seu host do Hermes para se vincular com alguém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите плагин Conduit на хосте Hermes, чтобы установить связь с кем-то."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biriyle bağlantı kurmak için Hermes sunucunuzdaki Conduit eklentisini güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 主机上的 Conduit 插件，以便与他人关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 Hermes 主機上的 Conduit 外掛程式，以便與他人連結。"
          }
        }
      }
    },
    "When they open the invite, their Conduit shows these four words. Check together that the words match before they link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Person die Einladung öffnet, zeigt ihr Conduit diese vier Wörter. Prüft gemeinsam, ob die Wörter übereinstimmen, bevor ihr euch verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la otra persona abra la invitación, su Conduit mostrará estas cuatro palabras. Comprueba con ella que las palabras coinciden antes de que se vincule."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l'autre personne ouvre l'invitation, son Conduit affiche ces quatre mots. Vérifiez ensemble que les mots correspondent avant qu'elle se lie à vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat dia membuka undangan, Conduit miliknya menampilkan empat kata ini. Periksa bersama bahwa kata-katanya sama sebelum dia menautkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l'altra persona apre l'invito, il suo Conduit mostra queste quattro parole. Controllate insieme che le parole coincidano prima che si colleghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手が招待を開くと、相手のConduitにこの4つの単語が表示されます。リンクする前に、単語が一致するか一緒に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대가 초대를 열면 상대의 Conduit에 이 네 단어가 보여요. 연결하기 전에 단어가 일치하는지 함께 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy druga osoba otworzy zaproszenie, jej Conduit pokaże te cztery słowa. Sprawdźcie razem, czy słowa się zgadzają, zanim się połączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a outra pessoa abrir o convite, o Conduit dela mostra estas quatro palavras. Confiram juntos se as palavras batem antes de ela se vincular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда другой человек откроет приглашение, его Conduit покажет эти четыре слова. Вместе проверьте, что слова совпадают, прежде чем он установит связь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşı taraf daveti açtığında Conduit'i bu dört kelimeyi gösterir. Bağlantı kurmadan önce kelimelerin eşleştiğini birlikte kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方打开邀请时，其 Conduit 会显示这四个词。在对方关联前，请一起确认这些词一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方開啟邀請時，其 Conduit 會顯示這四個詞。在對方連結前，請一起確認這些詞一致。"
          }
        }
      }
    },
