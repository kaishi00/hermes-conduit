    "What helps the room, but nothing sensitive: no health, money, passwords, or what others told you in private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was dem Raum hilft, aber nichts Sensibles: keine Gesundheitsdaten, keine Finanzen, keine Passwörter und nichts, was andere dir privat erzählt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ayude a la sala, pero nada delicado: ni salud, ni dinero, ni contraseñas, ni lo que otros te contaron en privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui aide le salon, mais rien de sensible : ni santé, ni argent, ni mots de passe, ni ce que d'autres vous ont confié en privé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang membantu ruang, tetapi tidak ada yang sensitif: tidak soal kesehatan, uang, kata sandi, atau hal yang diceritakan orang lain kepada Anda secara pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che aiuta la stanza, ma niente di sensibile: niente salute, soldi, password o ciò che altri ti hanno detto in privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループの役に立つことは共有しますが、デリケートなことは共有しません：健康、お金、パスワード、ほかの人が個人的に話してくれたことなど。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방에 도움이 되는 내용만, 민감한 내용은 제외: 건강, 돈, 비밀번호, 다른 사람이 나에게 개인적으로 말한 내용 등."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co pomaga w pokoju, ale nic wrażliwego: żadnych informacji o zdrowiu, pieniądzach, haseł ani tego, co inni powiedzieli Ci prywatnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que ajuda a sala, mas nada sensível: nada de saúde, dinheiro, senhas ou o que outras pessoas contaram a você em particular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что помогает комнате, но ничего чувствительного: ни здоровья, ни денег, ни паролей, ни того, что другие рассказали вам наедине."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaya yardımcı olanlar, ama hassas hiçbir şey yok: sağlık, para, parolalar ya da başkalarının size özel olarak anlattıkları."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享对群聊有帮助的内容，但不涉及敏感信息：健康、财务、密码，以及别人私下告诉你的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享對群組有幫助的內容，但不涉及敏感資訊：健康、財務、密碼，以及別人私下告訴你的事。"
          }
        }
      }
    },
    "What helps" : {
      "localizations" : {
