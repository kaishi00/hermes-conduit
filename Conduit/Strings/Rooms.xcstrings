          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый запрос к модели выбирает, кому адресовано сообщение. @упоминания по-прежнему идут прямо названным участникам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa bir model çağrısı mesajın kime olduğunu seçer. @bahsetmeler yine doğrudan adını verdiğin üyelere gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次快速的模型调用会判断消息是给谁的。@提及仍会直接发给你点名的成员。"
