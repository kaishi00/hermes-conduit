            "value" : "Tidak bisa memilih siapa yang menjawab, jadi semua akan menjawab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile scegliere chi risponde, quindi risponderanno tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答者を選べなかったため、全員が回答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답할 멤버를 고르지 못해 모두가 답해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wybrać, kto odpowie, więc odpowiedzą wszyscy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível escolher quem responde, então todos vão responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выбрать, кто ответит, поэтому ответят все."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimin yanıtlayacağı seçilemedi, bu yüzden herkes yanıtlayacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法选出由谁回答，所以所有人都会回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法選出由誰回答，所以所有人都會回答。"
          }
        }
      }
    },
    "Every member gets a turn on a message that names nobody." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer Nachricht, die niemanden nennt, ist jedes Mitglied an der Reihe."
          }
        },
        "es" : {
