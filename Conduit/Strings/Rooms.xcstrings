    "The most turns it takes in this room each day. Once they're used up, it says so and sits out until tomorrow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstzahl der Durchgänge, die er täglich in diesem Raum übernimmt. Sind sie aufgebraucht, sagt er das und setzt bis morgen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El máximo de turnos que toma en esta sala cada día. Cuando se le acaban, lo dice y no participa hasta mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre maximal de tours qu'il prend chaque jour dans ce salon. Une fois épuisés, il le dit et se met en retrait jusqu'au lendemain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah giliran terbanyak yang diambilnya di ruang ini setiap hari. Jika sudah habis, ia akan memberi tahu dan berhenti ikut sampai besok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero massimo di turni che fa ogni giorno in questa stanza. Quando li ha esauriti, lo dice e resta fuori fino a domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループで1日に担当するターンの上限です。使い切ると、そう伝えて明日まで休みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방에서 하루에 맡는 최대 차례 수예요. 다 쓰면 그렇게 알리고 내일까지 쉬어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba tur, które bierze dziennie w tym pokoju. Gdy się wyczerpią, mówi o tym i pauzuje do jutra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo de turnos que ele faz nesta sala por dia. Quando acabam, ele avisa e fica de fora até amanhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наибольшее число ходов, которые он делает в этой комнате за день. Когда они закончатся, он скажет об этом и пропустит всё до завтра."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu odada her gün alacağı en fazla tur. Turlar bitince bunu söyler ve yarına kadar sırasını atlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它每天在此群聊中的最多回合数。用完后，它会说明并暂停到明天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它每天在此群組中的最多回合數。用完後，它會說明並暫停到明天。"
          }
        }
      }
    },
