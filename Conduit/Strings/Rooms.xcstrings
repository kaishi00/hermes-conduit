    "This Link is gone from your Hermes. Ask %@ for a new invite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verknüpfung ist nicht mehr auf deinem Hermes. Bitte %@ um eine neue Einladung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vínculo ya no está en tu Hermes. Pide a %@ una nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liaison n'est plus sur votre Hermes. Demandez une nouvelle invitation à %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan ini sudah tidak ada di Hermes Anda. Minta undangan baru kepada %@."
