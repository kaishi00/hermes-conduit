    "Rooms can't let %@ use tools: it only talks there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume können %@ keine Werkzeuge nutzen lassen: Er spricht dort nur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las salas no pueden dejar que %@ use herramientas: allí solo conversa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les salons ne peuvent pas laisser %@ utiliser d'outils : il ne fait qu'y discuter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang tidak dapat mengizinkan %@ memakai alat: di sana ia hanya berbicara."
