    "Keep tools that plugins and Hermes updates add out of rooms until you add them here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkzeuge, die Plugins und Hermes-Updates hinzufügen, aus Räumen heraushalten, bis du sie hier hinzufügst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener fuera de las salas las herramientas que añadan los plugins y las actualizaciones de Hermes hasta que las añadas aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder hors des salons les outils qu'ajoutent les plugins et les mises à jour de Hermes, jusqu'à ce que vous les ajoutiez ici"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jauhkan alat yang ditambahkan plugin dan pembaruan Hermes dari ruang sampai Anda menambahkannya di sini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenere fuori dalle stanze gli strumenti che aggiungono i plugin e gli aggiornamenti di Hermes, finché non li aggiungi qui"
          }
        },
        "ja" : {
          "stringUnit" : {
