            "value" : "В одном сообщении комнаты можно отправить до %@ файлов. Остальные отправьте другим сообщением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oda mesajı en fazla %@ dosya alır. Kalanları başka bir mesajla gönder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群聊的一条消息最多可带 %@ 个文件。其余的请用另一条消息发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群組的一則訊息最多可帶 %@ 個檔案。其餘的請用另一則訊息傳送。"
          }
