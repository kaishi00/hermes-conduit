        }
      }
    },
    "A room uses these only when its Custom choice names their tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Raum nutzt diese nur, wenn seine eigene Auswahl ihre Werkzeuge nennt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sala usa estas solo cuando su opción Personalizado nombra sus herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un salon n'utilise ceux-ci que si son choix Personnalisé nomme leurs outils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang memakai ini hanya jika pilihan Kustom-nya menyebut alatnya."
