    "The lead picks who takes a message that names nobody. @mentions and @everyone still go straight to those members." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leitung wählt aus, wer eine Nachricht übernimmt, die niemanden nennt. @Erwähnungen und @everyone gehen weiter direkt an diese Mitglieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El líder elige quién se encarga de un mensaje que no nombra a nadie. Las @menciones y @everyone siguen yendo directamente a esos miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le responsable choisit qui prend un message qui ne nomme personne. Les @mentions et @everyone vont toujours directement à ces membres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemimpin memilih siapa yang mengambil pesan yang tidak menyebut siapa pun. @sebutan dan @everyone tetap langsung ke anggota tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il responsabile sceglie chi prende un messaggio che non nomina nessuno. Le @menzioni e @everyone vanno comunque direttamente a quei membri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も指名していないメッセージは、リーダーが担当者を選びます。@メンションと @everyone は引き続きそのメンバーに直接届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무도 지정하지 않은 메시지는 리더가 맡을 멤버를 골라요. @멘션과 @everyone은 여전히 해당 멤버에게 바로 가요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lider wybiera, kto zajmie się wiadomością, która nikogo nie wskazuje. @wzmianki i @everyone nadal trafiają prosto do tych członków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O líder escolhe quem fica com uma mensagem que não cita ninguém. As @menções e @everyone continuam indo direto para esses membros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведущий выбирает, кто возьмёт сообщение без упоминаний. @упоминания и @everyone по-прежнему идут прямо этим участникам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimseyi anmayan bir mesajı kimin alacağını lider seçer. @bahsetmeler ve @everyone yine doğrudan o üyelere gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有点名任何人的消息由负责人决定交给谁。@提及和 @everyone 仍会直接发给这些成员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有點名任何人的訊息由負責人決定交給誰。@提及和 @everyone 仍會直接傳給這些成員。"
          }
        }
      }
    },
