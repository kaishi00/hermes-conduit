    "This room answers in a way set in a newer app. It stays that way unless you pick another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Raum antwortet auf eine Weise, die in einer neueren App festgelegt wurde. Das bleibt so, bis du etwas anderes wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sala responde de una forma configurada en una app más reciente. Seguirá así a menos que elijas otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce salon répond d’une façon définie dans une app plus récente. Il reste ainsi tant que vous n’en choisissez pas une autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang ini menjawab dengan cara yang diatur di app yang lebih baru. Akan tetap begitu kecuali kamu memilih yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa stanza risponde in un modo impostato in un’app più recente. Resta così finché non ne scegli un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルームは新しいアプリで設定された方法で応答します。別の方法を選ぶまでそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방은 더 새로운 앱에서 설정한 방식으로 답합니다. 다른 방식을 고르기 전까지 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten pokój odpowiada w sposób ustawiony w nowszej aplikacji. Tak zostanie, dopóki nie wybierzesz innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sala responde de um jeito definido em um app mais novo. Continua assim, a menos que você escolha outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта комната отвечает так, как задано в более новом приложении. Так и останется, пока вы не выберете другой вариант."
          }
        },
