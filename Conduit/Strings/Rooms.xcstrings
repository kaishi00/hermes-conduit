    "Your Hermes can't host rooms with people you've linked yet. Update Hermes to invite them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes kann noch keine Räume mit Personen hosten, mit denen du verknüpft bist. Aktualisiere Hermes, um sie einzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Hermes aún no puede alojar salas con las personas con las que te vinculaste. Actualiza Hermes para invitarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Hermes ne peut pas encore héberger de salons avec les personnes auxquelles vous êtes lié. Mettez à jour Hermes pour les inviter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Anda belum dapat menjadi tuan rumah ruang dengan orang yang tertaut dengan Anda. Perbarui Hermes untuk mengundang mereka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Hermes non può ancora ospitare stanze con le persone a cui sei collegato. Aggiorna Hermes per invitarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのHermesは、リンクした相手とのグループをまだホストできません。招待するにはHermesをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 Hermes는 아직 연결한 사람과 함께하는 방을 호스팅할 수 없어요. 초대하려면 Hermes를 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Hermes nie może jeszcze hostować pokojów z połączonymi osobami. Zaktualizuj Hermesa, aby je zaprosić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Hermes ainda não pode hospedar salas com pessoas vinculadas a você. Atualize o Hermes para convidá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш Hermes пока не может размещать комнаты со связанными с вами людьми. Обновите Hermes, чтобы приглашать их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
