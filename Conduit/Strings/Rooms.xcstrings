    "Rooms that look things up or search past chats use these." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume, die etwas nachschlagen oder frühere Chats durchsuchen, nutzen diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las salas que buscan información o buscan en chats anteriores usan estas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les salons qui cherchent des informations ou fouillent les anciennes discussions utilisent ceux-ci."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang yang mencari informasi atau mencari di obrolan lama memakai ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stanze che cercano informazioni o nelle chat passate usano questi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調べものや過去のチャット検索をするグループはこれらを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찾아보기나 지난 채팅 검색을 하는 방은 이 도구를 써요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokoje, które coś sprawdzają albo przeszukują dawne czaty, używają tych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salas que pesquisam coisas ou buscam em chats anteriores usam estas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комнаты, которые что-то ищут или ищут в прошлых чатах, используют эти."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyler araştıran veya geçmiş sohbetlerde arayan odalar bunları kullanır."
