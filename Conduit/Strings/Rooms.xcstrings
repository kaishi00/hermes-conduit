          }
        }
      }
    },
    "Turn %@'s approvals back on, since rooms refuse an agent that runs tools without asking" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigaben von %@ wieder einschalten, da Räume einen Agenten ablehnen, der Werkzeuge ohne Nachfrage ausführt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a activar las aprobaciones de %@, ya que las salas rechazan a un agente que usa herramientas sin preguntar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réactiver les approbations de %@, car les salons refusent un agent qui exécute des outils sans demander"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan lagi persetujuan untuk %@, karena ruang menolak agen yang menjalankan alat tanpa bertanya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riattivare le approvazioni di %@, perché le stanze rifiutano un agente che usa strumenti senza chiedere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の承認をオンに戻す（グループは、確認せずにツールを実行するエージェントを拒否するため）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 승인 다시 켜기 (방은 묻지 않고 도구를 실행하는 에이전트를 거부해요)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz z powrotem zatwierdzenia profilu %@, bo pokoje odrzucają agenta, który uruchamia narzędzia bez pytania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reativar as aprovações de %@, já que as salas recusam um agente que executa ferramentas sem perguntar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снова включить подтверждения для %@, так как комнаты отклоняют агента, который запускает инструменты без вопроса"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için onayları yeniden aç; odalar, sormadan araç çalıştıran bir ajanı reddeder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新开启 %@ 的审批，因为群聊会拒绝不经询问就运行工具的智能体"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新開啟 %@ 的核准，因為群組會拒絕不經詢問就執行工具的代理程式"
          }
        }
      }
    },
    "Turn on Hermes' API server at %@, with a new key that stays on your Hermes" : {
      "localizations" : {
