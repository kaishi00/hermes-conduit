    "Your Hermes gets its four words when it first makes or accepts an invite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes bekommt seine vier Wörter, wenn er zum ersten Mal eine Einladung erstellt oder annimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Hermes recibe sus cuatro palabras la primera vez que crea o acepta una invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
