    "You stop getting this room, and %@ is told. Your copy of it stays until you delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst diesen Raum nicht mehr, und %@ wird informiert. Deine Kopie bleibt, bis du sie löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejas de recibir esta sala y se avisa a %@. Tu copia se queda hasta que la elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevez plus ce salon, et %@ en est informé. Votre copie reste jusqu’à ce que vous la supprimiez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu berhenti menerima ruang ini, dan %@ diberi tahu. Salinanmu tetap ada sampai kamu menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ricevi più questa stanza e %@ viene avvisato. La tua copia resta finché non la elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルームは届かなくなり、%@ に通知されます。コピーは削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방을 더 이상 받지 않으며 %@ 님에게 알립니다. 사본은 삭제할 때까지 남습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestajesz otrzymywać ten pokój, a %@ zostaje powiadomiony. Twoja kopia zostaje, dopóki jej nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você deixa de receber esta sala, e %@ é avisado. Sua cópia fica até você excluí-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта комната больше не будет к вам приходить, и %@ узнает об этом. Ваша копия останется, пока вы её не удалите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oda artık sana gelmez ve %@ bilgilendirilir. Kopyan sen silene kadar kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将不再收到这个房间，%@ 会收到通知。你的副本会保留到你删除为止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將不再收到這個房間，%@ 會收到通知。你的副本會保留到你刪除為止。"
          }
        }
      }
    },
