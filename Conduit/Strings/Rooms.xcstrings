          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルは、ほかの人のエージェントがいるグループで共有できる%1$@ MBを超えています: %2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일들은 다른 사람의 에이전트가 있는 방에서 공유할 수 있는 %1$@MB보다 커요: %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te pliki przekraczają %1$@ MB, które pokój z agentami innych osób może im udostępnić: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes arquivos são maiores que os %1$@ MB que uma sala com agentes de outras pessoas pode compartilhar com elas: %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти файлы больше %1$@ МБ, которыми комната с агентами других людей может с ними поделиться: %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosyalar, başka kişilerin ajanlarının olduğu bir odanın onlarla paylaşabileceği %1$@ MB'tan büyük: %2$@."
