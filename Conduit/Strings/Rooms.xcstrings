    "Chats running on it stop if it restarts now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, die darauf laufen, werden beendet, wenn es jetzt neu startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats que se ejecutan en ella se detienen si se reinicia ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les discussions qui s'y exécutent s'arrêtent si elle redémarre maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan yang berjalan di sana akan berhenti jika dimulai ulang sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chat in esecuzione su di esso si interrompono se si riavvia ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ再起動すると、そこで実行中のチャットは止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 재시작하면 거기서 실행 중인 채팅이 멈춰요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czaty działające na niej zostaną przerwane, jeśli uruchomi się ponownie teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os chats em execução nele param se ele reiniciar agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты, работающие через него, остановятся, если перезапустить его сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi yeniden başlarsa üzerinde çalışan sohbetler durur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果现在重启，在其上运行的聊天会停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果現在重新啟動，在其上執行的聊天會停止。"
          }
        }
      }
    },
