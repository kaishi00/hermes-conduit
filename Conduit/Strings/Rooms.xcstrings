        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些檔案超過了有其他人代理程式的群組可與他們分享的 %1$@ MB：%2$@。"
          }
        }
      }
    },
    "%@'s Conduit plugin is older than yours, so some of what your rooms share won't reach them. Ask them to update it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Conduit-Plugin von %@ ist älter als deins, daher erreicht sie manches nicht, was in euren Räumen geteilt wird. Bitte sie, es zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin de Conduit de %@ es más antiguo que el tuyo, así que parte de lo que se comparte en tus salas no le llegará. Pídele que lo actualice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin Conduit de %@ est plus ancien que le vôtre : une partie de ce que vos salons partagent ne lui parviendra pas. Demandez-lui de le mettre à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin Conduit milik %@ lebih lama dari milikmu, jadi sebagian yang dibagikan di ruangmu tidak akan sampai kepadanya. Minta dia memperbaruinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plugin Conduit di %@ è più vecchio del tuo, quindi parte di ciò che si condivide nelle tue stanze non gli arriverà. Chiedigli di aggiornarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Conduit プラグインはあなたのものより古いため、ルームで共有される内容の一部が届きません。更新するよう頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님의 Conduit 플러그인이 내 것보다 오래되어 방에서 공유하는 내용 일부가 전달되지 않습니다. 업데이트해 달라고 요청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczka Conduit użytkownika %@ jest starsza niż Twoja, więc część tego, co udostępniają Twoje pokoje, do niego nie dotrze. Poproś o jej aktualizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
