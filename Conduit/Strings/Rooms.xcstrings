    "%@ reads this on each of its turns here. It isn't posted to the room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liest das bei jedem Durchgang hier. Es wird nicht im Raum gepostet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lee esto en cada uno de sus turnos aquí. No se publica en la sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lit ceci à chacun de ses tours ici. Ce n'est pas publié dans le salon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ membaca ini di setiap gilirannya di sini. Ini tidak diposting ke ruang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo legge a ogni suo turno qui. Non viene pubblicato nella stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はここでの各ターンでこれを読みます。グループには投稿されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 여기서 차례마다 이 메모를 읽어요. 방에는 게시되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ czyta to przy każdej swojej turze tutaj. Nie jest to publikowane w pokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lê isto em cada um dos seus turnos aqui. Não é publicado na sala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ читает это на каждом своём ходе здесь. В комнату это не публикуется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ buradaki her turunda bunu okur. Odada paylaşılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这里的每个回合都会读取这条备注。它不会发布到群聊中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在這裡的每個回合都會讀取這則備註。它不會發佈到群組中。"
          }
        }
      }
    },
    "Can't be reached. Hermes keeps trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erreichbar. Hermes versucht es weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede contactar. Hermes sigue intentándolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injoignable. Hermes continue d'essayer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat dihubungi. Hermes terus mencoba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non raggiungibile. Hermes continua a provare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続できません。Hermesが再試行を続けています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결할 수 없어요. Hermes가 계속 시도하고 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia. Hermes próbuje dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar. O Hermes continua tentando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет связи. Hermes продолжает попытки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kurulamıyor. Hermes denemeye devam ediyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接。Hermes 会继续尝试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線。Hermes 會繼續嘗試。"
          }
        }
      }
    },
    "It can search your other chats to answer here, other people's messages in them included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kann deine anderen Chats durchsuchen, um hier zu antworten – einschließlich der Nachrichten anderer darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede buscar en tus otros chats para responder aquí, incluidos los mensajes de otras personas en ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il peut chercher dans vos autres discussions pour répondre ici, y compris les messages d'autres personnes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia dapat mencari di obrolan Anda yang lain untuk menjawab di sini, termasuk pesan orang lain di dalamnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può cercare nelle tue altre chat per rispondere qui, compresi i messaggi di altre persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで答えるために、あなたのほかのチャットを検索できます。その中のほかの人のメッセージも含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 답하기 위해 다른 채팅을 검색할 수 있어요. 그 안에 있는 다른 사람의 메시지도 포함돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może przeszukiwać Twoje inne czaty, aby odpowiedzieć tutaj, łącznie z wiadomościami innych osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele pode pesquisar seus outros chats para responder aqui, incluindo as mensagens de outras pessoas neles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Может искать в ваших других чатах, чтобы ответить здесь, включая сообщения других людей в них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada yanıt vermek için diğer sohbetlerinizde arama yapabilir; bunlardaki başkalarının mesajları da dahil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可以搜索你的其他聊天来回答这里的问题，其中也包括其他人的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可以搜尋你的其他聊天來回答這裡的問題，其中也包含其他人的訊息。"
          }
        }
      }
    },
    "The room ends for everyone, and your agents' sessions for it are deleted. Agents on other people's Hermes keep theirs. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Raum endet für alle, und die Sitzungen deiner Agenten dafür werden gelöscht. Agenten auf dem Hermes anderer Personen behalten ihre. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sala termina para todos y se eliminan las sesiones de tus agentes en ella. Los agentes en el Hermes de otras personas conservan las suyas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le salon prend fin pour tout le monde, et les sessions de vos agents pour celui-ci sont supprimées. Les agents sur le Hermes d'autres personnes gardent les leurs. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang berakhir untuk semua orang, dan sesi agen Anda untuk ruang ini dihapus. Agen di Hermes milik orang lain tetap menyimpan sesinya. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stanza termina per tutti e le sessioni dei tuoi agenti per questa stanza vengono eliminate. Gli agenti sull'Hermes di altre persone conservano le loro. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループは全員に対して終了し、このグループでのあなたのエージェントのセッションは削除されます。ほかの人のHermes上のエージェントは自分のセッションを保持します。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방이 모두에게 종료되고, 이 방에 대한 내 에이전트의 세션이 삭제돼요. 다른 사람의 Hermes에 있는 에이전트는 자신의 세션을 유지해요. 이 동작은 되돌릴 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokój kończy się dla wszystkich, a sesje Twoich agentów w nim zostaną usunięte. Agenci na Hermesie innych osób zachowują swoje. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sala termina para todos, e as sessões dos seus agentes nela são excluídas. Os agentes no Hermes de outras pessoas mantêm as deles. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комната завершится для всех, а сеансы ваших агентов в ней будут удалены. Агенты на Hermes других людей сохранят свои. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oda herkes için sona erer ve ajanlarınızın bu odadaki oturumları silinir. Başkalarının Hermes'indeki ajanlar kendi oturumlarını korur. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群聊将对所有人结束，你的智能体在其中的会话会被删除。其他人 Hermes 上的智能体会保留他们自己的会话。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "群組將對所有人結束，你的代理程式在其中的工作階段會被刪除。其他人 Hermes 上的代理程式會保留他們自己的工作階段。此動作無法還原。"
          }
        }
      }
    },
