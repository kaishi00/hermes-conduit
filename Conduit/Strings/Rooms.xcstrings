    "A room holds up to 6 agents: your bots, and at least one for each person." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Raum fasst bis zu 6 Agenten: deine Bots und mindestens einen für jede Person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sala admite hasta 6 agentes: tus bots y al menos uno por cada persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un salon accueille jusqu'à 6 agents : vos bots, et au moins un pour chaque personne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu ruang memuat hingga 6 agen: bot Anda, dan setidaknya satu untuk setiap orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stanza ospita fino a 6 agenti: i tuoi bot e almeno uno per ogni persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのグループに入れるエージェントは最大6つです。あなたのボットと、相手1人につき少なくとも1つです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방 하나에는 에이전트가 최대 6개까지 들어가요. 내 봇과, 초대한 사람마다 적어도 하나씩이에요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokój mieści do 6 agentów: Twoje boty i co najmniej jednego dla każdej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sala comporta até 6 agentes: seus bots e pelo menos um para cada pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В комнате может быть до 6 агентов: ваши боты и хотя бы по одному на каждого человека."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oda en fazla 6 ajan alır: botlarınız ve her kişi için en az bir tane."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个群聊最多容纳 6 个智能体：你的机器人，以及每个人至少一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個群組最多容納 6 個代理程式：你的機器人，以及每個人至少一個。"
          }
        }
      }
    },
