    "A quick model call picks who a message is for. @mentions still go straight to the members you name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Modellaufruf wählt aus, für wen eine Nachricht ist. @Erwähnungen gehen weiter direkt an die genannten Mitglieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una llamada rápida a un modelo elige para quién es un mensaje. Las @menciones siguen yendo directamente a los miembros que nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appel rapide à un modèle choisit à qui s’adresse un message. Les @mentions vont toujours directement aux membres nommés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan model singkat memilih untuk siapa pesan itu. @sebutan tetap langsung ke anggota yang kamu sebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una rapida chiamata a un modello sceglie a chi è rivolto un messaggio. Le @menzioni vanno comunque direttamente ai membri che nomini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いモデル呼び出しで、メッセージが誰宛てかを選びます。@メンションは引き続き指名したメンバーに直接届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 모델 호출로 메시지가 누구에게 온 것인지 골라요. @멘션은 여전히 지정한 멤버에게 바로 가요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkie wywołanie modelu wybiera, do kogo jest wiadomość. @wzmianki nadal trafiają prosto do wskazanych członków."
