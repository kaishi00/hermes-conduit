    "Hosted by %@. Update the Conduit plugin on your Hermes to post in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastgeber: %@. Aktualisiere das Conduit-Plugin auf deinem Hermes, um hier zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
