    "When this many are running, %@ waits for one to finish or sends new work to one that’s already on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufen so viele, wartet %@, bis einer fertig ist, oder gibt neue Arbeit an einen, der schon daran sitzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this many are running, %@ waits for one to finish or sends new work to one that’s already on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hay tantos en marcha, %@ espera a que termine uno o manda el trabajo nuevo a uno que ya se ocupa de ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand il y en a autant en cours, %@ attend qu’un se termine ou confie le nouveau travail à celui qui s’en occupe déjà."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat sebanyak ini berjalan, %@ menunggu salah satunya selesai atau mengirim pekerjaan baru ke yang sudah menanganinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ne sono in corso così tanti, %@ aspetta che uno finisca o affida il nuovo lavoro a uno che se ne sta già occupando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この数が実行中のとき、%@は1つが終わるのを待つか、すでに担当しているものに新しい作業を送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이만큼 실행 중이면 %@이(가) 하나가 끝나길 기다리거나, 이미 맡고 있는 곳에 새 작업을 보내요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy tyle już działa, %@ czeka, aż jeden się skończy, albo przekazuje nową pracę temu, który już się nią zajmuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando há tantos em andamento, %@ espera um terminar ou manda o trabalho novo para um que já cuida disso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда их столько запущено, %@ ждёт, пока один закончит, или отдаёт новую работу тому, кто уже ею занят."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadarı çalışırken %@ birinin bitmesini bekler ya da yeni işi zaten onunla uğraşana gönderir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行数达到这个值时，%@ 会等其中一个完成，或把新工作交给已在处理的那个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行數達到這個值時，%@ 會等其中一個完成，或把新工作交給已在處理的那一個。"
          }
        }
      }
    },
