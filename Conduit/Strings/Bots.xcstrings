    "%@ starts a chat of its own for longer tasks, works on them in the background, and tells you in its Bot Chat when they’re done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startet für längere Aufgaben einen eigenen Chat, arbeitet im Hintergrund daran und sagt dir im Bot-Chat, wenn sie fertig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ starts a chat of its own for longer tasks, works on them in the background, and tells you in its Bot Chat when they’re done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ abre un chat propio para las tareas más largas, trabaja en ellas en segundo plano y te avisa en su chat de bot cuando terminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ouvre une discussion à part pour les tâches plus longues, y travaille en arrière-plan et vous prévient dans sa discussion de bot quand c’est fini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ memulai obrolan sendiri untuk tugas yang lebih panjang, mengerjakannya di latar belakang, dan memberi tahu Anda di Obrolan Bot-nya saat selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ apre una chat a parte per le attività più lunghe, ci lavora in background e ti avvisa nella sua chat del bot quando ha finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は時間のかかるタスクには専用のチャットを開いてバックグラウンドで作業し、終わるとボットチャットで知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 오래 걸리는 작업은 별도의 채팅을 열어 백그라운드에서 처리하고, 끝나면 봇 채팅에서 알려 줘요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zaczyna osobny czat dla dłuższych zadań, pracuje nad nimi w tle i daje znać w czacie z botem, gdy skończy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ abre um chat próprio para tarefas mais longas, trabalha nelas em segundo plano e avisa no Chat de Bot quando terminam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ открывает отдельный чат для задач подольше, работает над ними в фоне и сообщает в чате с ботом, когда всё готово."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uzun görevler için kendi sohbetini açar, arka planda üzerinde çalışır ve bitince Bot Sohbeti’nde size söyler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会为较长的任务单独开一个聊天，在后台处理，完成后在其 Bot Chat 中告诉你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會為較長的任務另開一個聊天，在背景處理，完成後在機器人聊天中告訴你。"
          }
        }
      }
    },
    "%@ does everything in its Bot Chat itself. Work that’s already running carries on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erledigt alles selbst im Bot-Chat. Arbeit, die schon läuft, geht weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does everything in its Bot Chat itself. Work that’s already running carries on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo hace todo en su chat de bot. El trabajo que ya está en marcha continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait tout lui-même dans sa discussion de bot. Le travail déjà en cours continue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengerjakan semuanya sendiri di Obrolan Bot-nya. Pekerjaan yang sudah berjalan tetap berlanjut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fa tutto da sé nella sua chat del bot. Il lavoro già in corso continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすべてをボットチャット内で自分で行います。実行中の作業はそのまま続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 모든 일을 봇 채팅에서 직접 해요. 이미 진행 중인 작업은 계속돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ robi wszystko sam w czacie z botem. Praca, która już trwa, toczy się dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ faz tudo sozinho no Chat de Bot. O trabalho que já está em andamento continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ делает всё сам в чате с ботом. Работа, которая уже идёт, продолжается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ her şeyi Bot Sohbeti’nde kendisi yapar. Zaten çalışan işler sürer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会在其 Bot Chat 中亲自完成所有事。已经在进行的工作会继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會在機器人聊天中自己完成所有事。已在進行的工作會繼續。"
          }
        }
      }
    },
