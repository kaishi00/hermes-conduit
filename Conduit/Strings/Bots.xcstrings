    "It starts when you start it here, and stops after a while nobody uses it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er startet, wenn du ihn hier startest, und stoppt, wenn ihn eine Weile niemand nutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It starts when you start it here, and stops after a while nobody uses it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inicia cuando la inicias aquí y se detiene tras un rato sin que nadie la use."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il démarre quand vous le lancez ici et s’arrête après un moment sans utilisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
