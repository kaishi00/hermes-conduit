    "Tap the screen to click. What you type in this bar lands as you typed it, whatever your keyboard's layout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Bildschirm, um zu klicken. Was du in diese Leiste eingibst, kommt genau so an, egal welches Tastaturlayout du nutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the screen to click. What you type in this bar lands as you typed it, whatever your keyboard's layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la pantalla para hacer clic. Lo que escribas en esta barra llega tal cual, sea cual sea la distribución de tu teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’écran pour cliquer. Ce que vous tapez dans cette barre arrive tel quel, quelle que soit la disposition de votre clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk layar untuk mengeklik. Yang Anda ketik di bilah ini sampai persis seperti yang Anda ketik, apa pun tata letak keyboard Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca lo schermo per fare clic. Ciò che scrivi in questa barra arriva così com’è, qualunque sia il layout della tua tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面をタップするとクリックします。このバーに入力した文字は、キーボードの配列に関係なく、そのまま送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 탭하면 클릭합니다. 이 막대에 입력한 내용은 키보드 배열과 상관없이 입력한 그대로 전송됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij ekranu, aby kliknąć. To, co wpiszesz w tym pasku, trafi dokładnie tak, jak to wpisałeś, niezależnie od układu klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na tela para clicar. O que você digita nesta barra chega exatamente como foi digitado, seja qual for o layout do seu teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь экрана, чтобы нажать. Ввод в этой строке попадает точно так, как вы его набрали, с любой раскладкой клавиатуры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıklamak için ekrana dokunun. Bu çubuğa yazdıklarınız, klavye düzeniniz ne olursa olsun yazdığınız gibi gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点屏幕即可点击。无论你的键盘布局如何，你在此栏输入的内容都会原样发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下螢幕即可按一下。無論你的鍵盤配置為何，你在此列輸入的內容都會原樣傳送。"
          }
        }
      }
    },
    "The bot's open windows close. It starts again the next time it's needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die offenen Fenster des Bots werden geschlossen. Er startet wieder, wenn er das nächste Mal gebraucht wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot's open windows close. It starts again the next time it's needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierran las ventanas abiertas del bot. Vuelve a iniciarse la próxima vez que haga falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres ouvertes du bot se ferment. Il redémarre la prochaine fois qu’il est nécessaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela bot yang terbuka akan ditutup. Layar mulai lagi saat dibutuhkan berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre aperte del bot si chiudono. Si riavvia la prossima volta che serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットの開いているウインドウが閉じます。次に必要になったときに再び起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇의 열린 창이 닫힙니다. 다음에 필요할 때 다시 시작됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwarte okna bota zostaną zamknięte. Uruchomi się ponownie, gdy będzie potrzebny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas abertas do bot fecham. Ela inicia de novo na próxima vez que for necessária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытые окна бота закроются. Экран запустится снова, когда понадобится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botun açık pencereleri kapanır. Bir dahaki gerektiğinde yeniden başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机器人打开的窗口会关闭。下次需要时会再次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機器人開啟的視窗會關閉。下次需要時會再次啟動。"
          }
        }
      }
    },
