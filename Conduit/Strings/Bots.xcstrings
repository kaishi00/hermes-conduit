    "Profile routes pick each subagent's profile, so Delegate model below isn't used. Subagents that pick no profile run as %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilrouten wählen das Profil jedes Subagenten, daher wird „Modell für Delegierung“ unten nicht verwendet. Subagenten, die kein Profil wählen, laufen als %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas de perfil eligen el perfil de cada subagente, así que «Modelo de delegación» de abajo no se usa. Los subagentes que no eligen perfil se ejecutan como %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les routes de profil choisissent le profil de chaque sous-agent, donc « Modèle de délégation » ci-dessous n’est pas utilisé. Les sous-agents qui ne choisissent aucun profil s’exécutent en tant que %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rute profil memilih profil setiap subagen, jadi Model delegasi di bawah tidak dipakai. Subagen yang tidak memilih profil berjalan sebagai %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le route dei profili scelgono il profilo di ogni sottoagente, quindi «Modello per la delega» qui sotto non viene usato. I sottoagenti che non scelgono un profilo funzionano come %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルルートが各サブエージェントのプロファイルを選ぶため、下の「委任用モデル」は使われません。プロファイルを選ばないサブエージェントは %@ として動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 경로가 각 하위 에이전트의 프로필을 고르므로 아래 위임 모델은 사용되지 않습니다. 프로필을 고르지 않은 하위 에이전트는 %@(으)로 실행됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy profili wybierają profil każdego subagenta, więc „Model agentów delegowanych” poniżej nie jest używany. Subagenci, którzy nie wybiorą profilu, działają jako %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas de perfil escolhem o perfil de cada subagente, então “Modelo de delegação” abaixo não é usado. Subagentes que não escolhem perfil rodam como %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршруты профилей выбирают профиль каждого субагента, поэтому «Модель делегатов» ниже не используется. Субагенты, не выбравшие профиль, работают как %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil rotaları her alt ajanın profilini seçer, bu yüzden aşağıdaki Devir modeli kullanılmaz. Profil seçmeyen alt ajanlar %@ olarak çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件路由会为每个子代理选择配置文件，因此不会使用下方的“委派模型”。未选择配置文件的子代理以 %@ 身份运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔路由會為每個子代理程式選擇設定檔，因此不會使用下方的「委派模型」。未選擇設定檔的子代理程式以 %@ 身分執行。"
          }
        }
      }
    },
    "Profile routes pick each subagent's profile, so Delegate model below isn't used. Subagents that pick no profile use the chat's model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilrouten wählen das Profil jedes Subagenten, daher wird „Modell für Delegierung“ unten nicht verwendet. Subagenten, die kein Profil wählen, nutzen das Modell des Chats."
