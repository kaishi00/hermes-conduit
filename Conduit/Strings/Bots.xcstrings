    "A short name tells this %@ account apart from your others, like work or home. You sign in next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Name unterscheidet dieses %@-Konto von deinen anderen, etwa arbeit oder privat. Danach meldest du dich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre corto distingue esta cuenta de %@ de las demás, como trabajo o casa. Después inicias sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom court distingue ce compte %@ de vos autres, comme travail ou maison. Vous vous connectez ensuite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama singkat membedakan akun %@ ini dari akun lainnya, misalnya kerja atau rumah. Setelah itu kamu masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome breve distingue questo account %@ dagli altri, come lavoro o casa. Poi accedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い名前で、この%@アカウントをほかのアカウントと区別します（例: work、home）。このあとサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 이름으로 이 %@ 계정을 다른 계정과 구분합니다(예: work, home). 그다음 로그인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótka nazwa odróżnia to konto %@ od pozostałych, np. praca lub dom. Potem się zalogujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nome curto diferencia esta conta do %@ das outras, como trabalho ou casa. Depois você entra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткое имя отличает этот аккаунт %@ от других, например work или home. Затем вы войдёте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa bir ad bu %@ hesabını diğerlerinden ayırır, örneğin is veya ev. Ardından giriş yaparsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一个简短的名称区分这个 %@ 账户和你的其他账户，例如 work 或 home。接下来登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡短的名稱區分這個 %@ 帳號和你的其他帳號，例如 work 或 home。接著登入。"
          }
        }
      }
    },
