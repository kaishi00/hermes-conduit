    "Hermes stores these in the bot's profile and checks that %@ connects. Leave one empty to set it on Hermes instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes speichert sie im Profil des Bots und prüft, ob %@ sich verbindet. Lass ein Feld leer, um es stattdessen auf Hermes festzulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes las guarda en el perfil del bot y comprueba que %@ se conecta. Deja uno vacío para configurarlo en Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes les enregistre dans le profil du bot et vérifie que %@ se connecte. Laissez-en un vide pour le définir sur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes menyimpannya di profil bot dan memeriksa bahwa %@ terhubung. Biarkan kosong untuk mengaturnya di Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes le salva nel profilo del bot e verifica che %@ si connetta. Lasciane uno vuoto per impostarlo su Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes はこれらをボットのプロファイルに保存し、%@ が接続できるか確認します。空欄にすると Hermes 側で設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 봇 프로필에 저장하고 %@이(가) 연결되는지 확인합니다. 비워 두면 Hermes에서 설정할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes zapisuje je w profilu bota i sprawdza, czy %@ się łączy. Zostaw pole puste, aby ustawić je na Hermesie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes as salva no perfil do bot e verifica se %@ conecta. Deixe uma vazia para definir no Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes сохранит их в профиле бота и проверит, подключается ли %@. Оставьте поле пустым, чтобы задать его на Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bunları botun profilinde saklar ve %@ bağlantısını denetler. Hermes'te ayarlamak için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 会将其保存在机器人的配置文件中，并检查 %@ 能否连接。留空则改在 Hermes 上设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 會將其保存在機器人的設定檔中，並檢查 %@ 能否連線。留空則改在 Hermes 上設定。"
          }
        }
      }
    },
