    },
    "%@ answers and does quick things in its Bot Chat. Anything that takes longer runs in the background, and you’re told there when it’s done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beantwortet und erledigt Schnelles im Bot-Chat. Alles, was länger dauert, läuft im Hintergrund, und du erfährst dort, wenn es fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ answers and does quick things in its Bot Chat. Anything that takes longer runs in the background, and you’re told there when it’s done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ responde y hace las cosas rápidas en su chat del bot. Lo que lleva más tiempo se ejecuta en segundo plano, y allí te avisa cuando termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ répond et fait les choses rapides dans sa discussion du bot. Ce qui prend plus de temps s’exécute en arrière-plan, et tu y es prévenu quand c’est fini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menjawab dan mengerjakan hal-hal cepat di Obrolan Bot-nya. Apa pun yang lebih lama berjalan di latar belakang, dan kamu diberi tahu di sana saat selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ risponde e fa le cose rapide nella sua chat del bot. Ciò che richiede più tempo va in background, e lì ti avvisa quando è finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は簡単な質問や作業をボットチャットでそのまま行います。時間がかかるものはバックグラウンドで進み、終わるとそこで知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 간단한 질문과 작업을 봇 채팅에서 바로 처리합니다. 오래 걸리는 일은 백그라운드에서 실행되고, 끝나면 그곳에서 알려 드립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ odpowiada i załatwia szybkie sprawy w swoim czacie bota. Wszystko, co trwa dłużej, działa w tle, a gdy się skończy, dowiesz się o tym tam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ responde e faz as coisas rápidas no chat do bot. O que leva mais tempo roda em segundo plano, e você fica sabendo ali quando terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отвечает и делает быстрые дела прямо в чате бота. Всё, что дольше, выполняется в фоне, а когда будет готово, вам скажут там же."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hızlı işleri bot sohbetinde kendisi yapar ve yanıtlar. Daha uzun sürenler arka planda çalışır ve bittiğinde orada haber verilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会在机器人聊天里直接回答并做完简单的事。耗时更久的事在后台进行，完成后会在那里告诉你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會在機器人聊天裡直接回答並做完簡單的事。耗時更久的事在背景進行，完成後會在那裡告訴你。"
          }
        }
      }
    },
    "%@ does everything in its Bot Chat, and runs work in the background only when you ask or it’s clearly long. The chat is busy while it works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erledigt alles im Bot-Chat und lässt Arbeit nur im Hintergrund laufen, wenn du darum bittest oder sie eindeutig lange dauert. Während es arbeitet, ist der Chat beschäftigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does everything in its Bot Chat, and runs work in the background only when you ask or it’s clearly long. The chat is busy while it works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo hace todo en su chat del bot y solo ejecuta trabajo en segundo plano cuando se lo pides o cuando claramente va para largo. El chat está ocupado mientras trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait tout dans sa discussion du bot et ne lance du travail en arrière-plan que si tu le demandes ou s’il est clairement long. La discussion est occupée pendant qu’il travaille."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengerjakan semuanya di Obrolan Bot-nya, dan menjalankan pekerjaan di latar belakang hanya jika kamu memintanya atau jelas akan lama. Obrolan sibuk selama ia bekerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fa tutto nella sua chat del bot e manda il lavoro in background solo quando lo chiedi o quando è chiaramente lungo. La chat resta occupata mentre lavora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすべてをボットチャットで行い、頼まれたときや明らかに時間がかかるときだけバックグラウンドで作業します。作業中はチャットがふさがります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 모든 일을 봇 채팅에서 하고, 요청하거나 분명히 오래 걸릴 때만 백그라운드에서 작업합니다. 작업하는 동안 채팅은 사용 중입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ robi wszystko w swoim czacie bota, a pracę w tle uruchamia tylko na twoją prośbę albo gdy wyraźnie potrwa długo. Czat jest zajęty, gdy pracuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ faz tudo no chat do bot e só roda trabalho em segundo plano quando você pede ou quando claramente vai demorar. O chat fica ocupado enquanto trabalha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ делает всё в чате бота и запускает работу в фоне, только если вы попросите или она явно надолго. Пока идёт работа, чат занят."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ her şeyi bot sohbetinde yapar; işi yalnızca sen istediğinde ya da açıkça uzun sürecekse arka planda çalıştırır. Çalışırken sohbet meşgul olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会在机器人聊天里做完所有事，只有在你要求或明显耗时很久时才放到后台。它工作时聊天会被占用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會在機器人聊天裡做完所有事，只有在你要求或明顯耗時很久時才放到背景。它工作時聊天會被佔用。"
          }
        }
      }
    },
    "Everything but cards, maps, notifications, memories and its questions to you runs in the background, so its Bot Chat is always free to talk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles außer Karten, Landkarten, Mitteilungen, Erinnerungen und seinen Fragen an dich läuft im Hintergrund, damit der Bot-Chat immer frei zum Reden bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything but cards, maps, notifications, memories and its questions to you runs in the background, so its Bot Chat is always free to talk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo salvo las tarjetas, los mapas, las notificaciones, los recuerdos y sus preguntas para ti se ejecuta en segundo plano, así su chat del bot siempre está libre para hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout sauf les cartes, les plans, les notifications, les souvenirs et ses questions pour toi s’exécute en arrière-plan, pour que sa discussion du bot reste toujours libre pour parler."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua kecuali kartu, peta, notifikasi, ingatan, dan pertanyaannya untukmu berjalan di latar belakang, jadi Obrolan Bot-nya selalu bebas untuk mengobrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto tranne le schede, le mappe, le notifiche, i ricordi e le sue domande per te va in background, così la sua chat del bot è sempre libera per parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード、地図、通知、記憶、あなたへの質問以外はすべてバックグラウンドで行うので、ボットチャットはいつでも話せる状態のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드, 지도, 알림, 기억, 사용자에게 하는 질문을 뺀 모든 일은 백그라운드에서 실행되므로 봇 채팅은 언제나 대화할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko poza kartami, mapami, powiadomieniami, wspomnieniami i pytaniami do ciebie działa w tle, więc czat bota jest zawsze wolny do rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo, menos cartões, mapas, notificações, memórias e as perguntas para você, roda em segundo plano, então o chat do bot fica sempre livre para conversar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, кроме карточек, карт, уведомлений, воспоминаний и вопросов к вам, выполняется в фоне, поэтому чат бота всегда свободен для разговора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartlar, haritalar, bildirimler, anılar ve sana soruları dışında her şey arka planda çalışır, böylece bot sohbeti konuşmak için hep boş kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了卡片、地图、通知、记忆和问你的问题，其余都在后台进行，所以机器人聊天始终可以随时交谈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了卡片、地圖、通知、記憶和問你的問題，其餘都在背景進行，所以機器人聊天始終可以隨時交談。"
          }
        }
      }
    },
