    "%@ decides each subagent's model, so Delegate model below isn't used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ legt das Modell jedes Subagenten fest, daher wird „Modell für Delegierung“ unten nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ decide el modelo de cada subagente, así que «Modelo de delegación» de abajo no se usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ choisit le modèle de chaque sous-agent, donc « Modèle de délégation » ci-dessous n’est pas utilisé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menentukan model setiap subagen, jadi Model delegasi di bawah tidak dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ decide il modello di ogni sottoagente, quindi «Modello per la delega» qui sotto non viene usato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が各サブエージェントのモデルを決めるため、下の「委任用モデル」は使われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 각 하위 에이전트의 모델을 정하므로 아래 위임 모델은 사용되지 않습니다."
