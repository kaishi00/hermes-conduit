    "Ask Hermes to add an MCP server, or install one from the catalog when it lists some." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Hermes, einen MCP-Server hinzuzufügen, oder installiere einen aus dem Katalog, sobald er welche anbietet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele a Hermes que añada un servidor MCP o instala uno del catálogo cuando ofrezca alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Hermes d'ajouter un serveur MCP, ou installez-en un depuis le catalogue lorsqu'il en propose."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta Hermes menambahkan server MCP, atau pasang dari katalog jika ada yang tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Hermes di aggiungere un server MCP, oppure installane uno dal catalogo quando ne elenca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes に MCP サーバーの追加を頼むか、カタログに掲載されていればそこからインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes에게 MCP 서버를 추가해 달라고 요청하거나, 카탈로그에 있으면 거기서 설치하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś Hermesa o dodanie serwera MCP albo zainstaluj go z katalogu, gdy jakieś się w nim pojawią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao Hermes para adicionar um servidor MCP ou instale um do catálogo quando houver algum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите Hermes добавить MCP-сервер или установите его из каталога, когда там что-то появится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'ten bir MCP sunucusu eklemesini isteyin ya da katalogda varsa oradan yükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Hermes 添加一个 MCP 服务器，或在目录中有可用项时从中安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請 Hermes 新增一個 MCP 伺服器，或在目錄中有可用項目時從中安裝。"
          }
        }
      }
    },
