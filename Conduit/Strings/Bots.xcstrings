    "Installing adds a small desktop and its packages on the Hermes host (about 1 GB of disk). Hermes asks for the host's password if it needs one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation fügt dem Hermes-Host einen kleinen Desktop und seine Pakete hinzu (etwa 1 GB Speicher). Hermes fragt nach dem Passwort des Hosts, falls es eins braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing adds a small desktop and its packages on the Hermes host (about 1 GB of disk). Hermes asks for the host's password if it needs one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instalación añade un pequeño escritorio y sus paquetes al host de Hermes (alrededor de 1 GB de disco). Hermes pide la contraseña del host si la necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation ajoute un petit bureau et ses paquets sur l’hôte Hermes (environ 1 Go de disque). Hermes demande le mot de passe de l’hôte s’il en a besoin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalasi menambahkan desktop kecil beserta paketnya di host Hermes (sekitar 1 GB disk). Hermes akan meminta kata sandi host jika diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installazione aggiunge un piccolo desktop e i suoi pacchetti sull’host Hermes (circa 1 GB di disco). Hermes chiede la password dell’host se serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールすると、Hermesホストに小さなデスクトップとそのパッケージが追加されます（ディスク約1 GB）。必要な場合、Hermesがホストのパスワードを尋ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치하면 Hermes 호스트에 작은 데스크톱과 패키지가 추가됩니다(디스크 약 1GB). 필요하면 Hermes가 호스트 암호를 묻습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacja dodaje na hoście Hermesa mały pulpit i jego pakiety (około 1 GB miejsca). Hermes poprosi o hasło hosta, jeśli będzie potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instalação adiciona uma pequena área de trabalho e seus pacotes ao host do Hermes (cerca de 1 GB de disco). O Hermes pede a senha do host se precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка добавит на хост Hermes небольшой рабочий стол и его пакеты (около 1 ГБ на диске). Если нужно, Hermes спросит пароль хоста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum, Hermes sunucusuna küçük bir masaüstü ve paketlerini ekler (yaklaşık 1 GB disk). Gerekirse Hermes sunucunun parolasını sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装会在 Hermes 主机上添加一个小型桌面及其软件包（约 1 GB 磁盘空间）。如有需要，Hermes 会询问主机密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
