          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela inicia quando você a inicia aqui e para depois de um tempo sem uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он запускается, когда вы запускаете его здесь, и останавливается, если им какое-то время никто не пользуется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradan başlattığınızda başlar, bir süre kimse kullanmazsa durur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
