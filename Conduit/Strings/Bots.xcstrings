    "Update the gateway, then come back to chat with your bots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere das Gateway und komm dann zurück, um mit deinen Bots zu chatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza la pasarela y vuelve para chatear con tus bots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour la passerelle, puis revenez discuter avec vos bots."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui gateway, lalu kembali untuk mengobrol dengan bot Anda."
          }
        },
        "it" : {
          "stringUnit" : {
