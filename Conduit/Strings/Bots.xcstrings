    "Touch and hold a bot for its menu. Drag it to move it, or hold it over another bot to start a room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Bot gedrückt, um sein Menü zu öffnen. Zieh ihn, um ihn zu verschieben, oder halte ihn über einen anderen Bot, um einen Raum zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold a bot for its menu. Drag it to move it, or hold it over another bot to start a room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un bot para ver su menú. Arrástralo para moverlo o mantenlo sobre otro bot para iniciar una sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un bot pour son menu. Faites-le glisser pour le déplacer, ou maintenez-le sur un autre bot pour lancer un salon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan bot untuk menunya. Seret untuk memindahkannya, atau tahan di atas bot lain untuk memulai ruang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un bot per il suo menu. Trascinalo per spostarlo, o tienilo sopra un altro bot per avviare una stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットを長押しするとメニューが開きます。ドラッグで移動、別のボットの上で止めるとルームを始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇을 길게 누르면 메뉴가 열립니다. 드래그해서 옮기거나, 다른 봇 위에 잠시 두면 방을 시작합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj bota, aby otworzyć jego menu. Przeciągnij, aby go przenieść, lub przytrzymaj nad innym botem, aby założyć pokój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure um bot para ver o menu. Arraste para movê-lo ou segure sobre outro bot para iniciar uma sala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте бота, чтобы открыть меню. Перетащите, чтобы переместить, или задержите над другим ботом, чтобы создать комнату."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüsü için bir bota dokunup basılı tutun. Taşımak için sürükleyin veya oda başlatmak için başka bir botun üzerinde tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住机器人可打开菜单。拖动可移动它，停在另一个机器人上可开始一个房间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住機器人可打開選單。拖移可移動它，停在另一個機器人上可開始一個房間。"
          }
        }
      }
    },
