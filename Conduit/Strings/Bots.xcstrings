    "Signed in through Nous Portal. Hermes keeps the sign-ins; changes apply to new chats." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet über Nous Portal. Hermes behält die Anmeldungen; Änderungen gelten für neue Chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión iniciada mediante Nous Portal. Hermes guarda las sesiones; los cambios se aplican a los chats nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté via Nous Portal. Hermes garde les connexions ; les changements s'appliquent aux nouveaux chats."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk melalui Nous Portal. Hermes menyimpan proses masuknya; perubahan berlaku untuk chat baru."
          }
        },
        "it" : {
          "stringUnit" : {
