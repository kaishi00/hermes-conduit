          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 시작하면 켜지고, 한동안 아무도 사용하지 않으면 멈춥니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
