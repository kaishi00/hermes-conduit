    "This Hermes can't change servers yet. Update Hermes and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes kann Server noch nicht ändern. Aktualisiere Hermes und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes aún no puede cambiar servidores. Actualiza Hermes y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Hermes ne peut pas encore modifier les serveurs. Mettez Hermes à jour et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
