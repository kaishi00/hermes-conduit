    "Use lowercase letters, digits and dashes, up to 32, starting with a letter or digit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Kleinbuchstaben, Ziffern und Bindestriche, bis zu 32, beginnend mit einem Buchstaben oder einer Ziffer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa minúsculas, dígitos y guiones, hasta 32, empezando por una letra o un dígito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des minuscules, des chiffres et des tirets, jusqu'à 32, en commençant par une lettre ou un chiffre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan huruf kecil, angka, dan tanda hubung, maksimal 32, diawali huruf atau angka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lettere minuscole, cifre e trattini, fino a 32, iniziando con una lettera o una cifra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小文字、数字、ハイフンを32文字まで使い、先頭は文字か数字にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소문자, 숫자, 하이픈을 32자까지 쓰고, 문자나 숫자로 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj małych liter, cyfr i myślników, do 32 znaków, zaczynając od litery lub cyfry."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use letras minúsculas, dígitos e hifens, até 32, começando com uma letra ou um dígito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте строчные буквы, цифры и дефисы, до 32 символов, начиная с буквы или цифры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük harf, rakam ve tire kullan, en çok 32, harf veya rakamla başlasın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用小写字母、数字和连字符，最多 32 个，以字母或数字开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用小寫字母、數字和連字號，最多 32 個，以字母或數字開頭。"
          }
        }
      }
    },
