    "This permanently removes the bot's profile, chats, memory and skills from the gateway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Profil, Chats, Gedächtnis und Skills des Bots dauerhaft vom Gateway entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente de la pasarela el perfil, los chats, la memoria y las habilidades del bot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement de la passerelle le profil, les discussions, la mémoire et les compétences du bot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghapus profil, obrolan, memori, dan skill bot dari gateway secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione rimuove definitivamente dal gateway il profilo, le chat, la memoria e le skill del bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットのプロファイル、チャット、メモリ、スキルがゲートウェイから完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇의 프로필, 채팅, 메모리, 스킬이 게이트웨이에서 영구적으로 삭제돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie profilu, czatów, pamięci i umiejętności bota z bramy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente do gateway o perfil, os chats, a memória e as habilidades do bot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль бота, его чаты, память и навыки будут безвозвратно удалены со шлюза."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
