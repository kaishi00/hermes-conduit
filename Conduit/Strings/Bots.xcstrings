    "Say what the route is for: the agent reads it to choose one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe, wofür die Route da ist: Der Agent liest das, um eine zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di para qué sirve la ruta: el agente lo lee para elegir una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites à quoi sert la route : l’agent le lit pour en choisir une."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan untuk apa rute ini: agen membacanya untuk memilih rute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' a cosa serve la route: l'agente lo legge per sceglierne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートの用途を書いてください。エージェントはこれを読んで選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로의 용도를 적으세요. 에이전트가 이를 읽고 경로를 고릅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz, do czego służy trasa: agent czyta to, aby ją wybrać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga para que serve a rota: o agente lê isso para escolher uma."
          }
        },
        "ru" : {
          "stringUnit" : {
