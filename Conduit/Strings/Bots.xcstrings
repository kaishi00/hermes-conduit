    "Hermes couldn't read your organization's rules just now, so it can't tell yet whether %@ is allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte die Regeln deiner Organisation gerade nicht lesen und kann daher noch nicht sagen, ob %@ erlaubt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
