    "Pinch to zoom in. Drag with two fingers to look around." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Vergrößern zwei Finger auseinanderziehen. Mit zwei Fingern ziehen, um sich umzusehen."
          }
