            "state" : "translated",
            "value" : "Die Schalter wurden anderswo geändert. Sie zeigen jetzt den aktuellen Stand; versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los interruptores cambiaron en otro sitio. Muestran lo que hay ahora; inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les interrupteurs ont changé ailleurs. Ils montrent l'état actuel ; réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakelar diubah di tempat lain. Sekarang menampilkan pengaturan terbaru; coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli interruttori sono cambiati altrove. Mostrano lo stato attuale; riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイッチがほかの場所で変更されました。現在の設定を表示しています。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스위치가 다른 곳에서 변경되었습니다. 지금 설정을 보여 줍니다. 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełączniki zmieniono gdzie indziej. Pokazują obecny stan; spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões mudaram em outro lugar. Eles mostram o que está definido agora; tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключатели изменили в другом месте. Сейчас они показывают текущие настройки; попробуйте ещё раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtarlar başka bir yerde değişti. Şu anki ayarları gösteriyorlar; yeniden dene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开关已在别处更改。现在显示的是当前设置；请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開關已在別處更改。現在顯示的是目前設定；請再試一次。"
          }
        }
      }
    },
