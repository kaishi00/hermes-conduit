            "value" : "Czyta, co wątki pracy bota zgłaszają w trakcie pracy, i mówi jego Bot Chat, gdy jeden może wpłynąć na inny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê o que os fluxos de trabalho de um bot relatam enquanto trabalham e avisa o Bot Chat dele quando um pode afetar outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читает, что сообщают рабочие потоки бота во время работы, и говорит его Bot Chat, когда один может повлиять на другой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir botun iş akışlarının çalışırken bildirdiklerini okur ve biri diğerini etkileyebilecekse botun Bot Chat'ine söyler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取机器人的工作流在工作时的报告，并在某个工作流可能影响另一个时告诉它的 Bot Chat。"
