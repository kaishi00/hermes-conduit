    "Work cut off during a step that can change things always waits for you. This is for the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit, die mitten in einem Schritt abbrach, der etwas ändern kann, wartet immer auf dich. Das hier gilt für den Rest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work cut off during a step that can change things always waits for you. This is for the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo cortado en un paso que puede cambiar cosas siempre te espera. Esto es para el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un travail interrompu pendant une étape qui peut changer des choses vous attend toujours. Ce réglage vaut pour le reste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan yang terputus saat langkah yang bisa mengubah sesuatu selalu menunggu Anda. Ini untuk sisanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro interrotto durante un passaggio che può cambiare le cose aspetta sempre te. Questo vale per il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かを変更しうるステップの途中で止まった作業は、必ずあなたの判断を待ちます。これはそれ以外の作業の設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가를 바꿀 수 있는 단계 도중에 끊긴 작업은 항상 사용자를 기다려요. 이 설정은 나머지에 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca przerwana w kroku, który może coś zmienić, zawsze czeka na Ciebie. To ustawienie dotyczy reszty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho interrompido durante uma etapa que pode mudar algo sempre espera por você. Isto vale para o resto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа, прерванная на шаге, который может что-то изменить, всегда ждёт вас. Эта настройка — для остальной."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyleri değiştirebilecek bir adımda kesilen iş her zaman sizi bekler. Bu ayar geri kalanı içindir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可能改变内容的步骤中途被打断的工作总会等你决定。此设置适用于其余工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可能改變內容的步驟中途被中斷的工作一定會等你決定。此設定適用於其餘工作。"
          }
        }
      }
    },
