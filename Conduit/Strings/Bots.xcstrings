          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡啟動後它就會執行，一段時間沒人使用就會停止。"
          }
        }
      }
    },
    "Its sandbox runs %@. The screen needs %@. Switching keeps its files; packages installed inside it come back on use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Sandbox nutzt %@. Der Bildschirm braucht %@. Beim Wechsel bleiben seine Dateien erhalten; darin installierte Pakete kommen bei Bedarf zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its sandbox runs %@. The screen needs %@. Switching keeps its files; packages installed inside it come back on use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su sandbox usa %@. La pantalla necesita %@. Al cambiar se conservan sus archivos; los paquetes instalados dentro vuelven al usarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son bac à sable utilise %@. L’écran nécessite %@. Le changement conserve ses fichiers ; les paquets installés dedans reviennent à l’usage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox-nya memakai %@. Layar memerlukan %@. Beralih tetap menyimpan filenya; paket yang terpasang di dalamnya kembali saat dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua sandbox usa %@. Lo schermo richiede %@. Il cambio mantiene i suoi file; i pacchetti installati al suo interno tornano all’uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンドボックスは%@で動作しています。画面には%@が必要です。切り替えてもファイルは残り、中にインストールしたパッケージは使うときに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샌드박스가 %@(으)로 실행 중입니다. 화면에는 %@이(가) 필요합니다. 전환해도 파일은 유지되며, 안에 설치한 패키지는 사용할 때 다시 설치됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego piaskownica działa na %@. Ekran wymaga %@. Zmiana zachowuje pliki; zainstalowane w niej pakiety wrócą przy użyciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sandbox dele usa %@. A tela precisa de %@. A troca mantém os arquivos; pacotes instalados dentro dele voltam quando usados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его песочница работает на %@. Экрану нужен %@. При переключении файлы сохраняются, а установленные внутри пакеты вернутся при использовании."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korumalı alanı %@ çalıştırıyor. Ekran için %@ gerekir. Geçiş dosyalarını korur; içine kurulan paketler kullanıldığında geri gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的沙盒运行 %@。屏幕需要 %@。切换会保留文件；沙盒内安装的软件包会在使用时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的沙盒執行 %@。螢幕需要 %@。切換會保留檔案；沙盒內安裝的套件會在使用時恢復。"
          }
        }
      }
    },
