    "Reads what a bot’s workstreams report while they work and tells its Bot Chat when one may affect another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest, was die Workstreams eines Bots während der Arbeit melden, und sagt seinem Bot Chat, wenn einer einen anderen betreffen könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads what a bot’s workstreams report while they work and tells its Bot Chat when one may affect another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee lo que informan los flujos de trabajo de un bot mientras trabajan y avisa a su Bot Chat cuando uno puede afectar a otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit ce que les tâches de fond d’un bot signalent pendant leur travail et prévient son Bot Chat quand l’une peut en affecter une autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membaca laporan workstream sebuah bot selama bekerja dan memberi tahu Bot Chat-nya jika satu workstream bisa memengaruhi yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge ciò che i flussi di lavoro di un bot riportano mentre lavorano e avvisa la sua Bot Chat quando uno può influire su un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットのワークストリームが作業中に報告する内容を読み、別のワークストリームに影響しそうなときにそのBot Chatに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇의 워크스트림이 작업 중에 보고하는 내용을 읽고, 하나가 다른 워크스트림에 영향을 줄 수 있으면 그 봇의 Bot Chat에 알립니다."
          }
        },
        "pl" : {
