    "Decides which commands are safe to run without asking you, when smart approvals are on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheidet bei aktivierten intelligenten Freigaben, welche Befehle ohne Nachfrage laufen dürfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con las aprobaciones inteligentes activadas, decide qué comandos son seguros sin preguntarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec les approbations intelligentes, décide quelles commandes peuvent s’exécuter sans vous demander."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat persetujuan pintar aktif, memutuskan perintah mana yang aman dijalankan tanpa bertanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le approvazioni intelligenti attive, decide quali comandi eseguire senza chiederti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマート承認がオンのとき、確認なしで実行してよいコマンドを判断します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 승인이 켜져 있으면 묻지 않고 실행해도 안전한 명령을 판단합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy włączonych inteligentnych zgodach decyduje, które polecenia można uruchomić bez pytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com as aprovações inteligentes ativadas, decide quais comandos podem rodar sem perguntar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включены умные подтверждения, решает, какие команды можно выполнять без вопроса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı onaylar açıkken, hangi komutların size sormadan çalıştırılabileceğine karar verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启智能批准时，判断哪些命令无需询问即可安全运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟智慧核准時，判斷哪些指令不必詢問即可安全執行。"
          }
        }
      }
    },
