          }
        }
      }
    },
    "Replies are spoken with the voices built into iOS, on this iPhone. Nothing to set up or pay for on Hermes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten werden mit den in iOS integrierten Stimmen auf diesem iPhone gesprochen. Auf Hermes musst du nichts einrichten oder bezahlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas se dicen con las voces integradas en iOS, en este iPhone. No hay nada que configurar ni pagar en Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses sont lues avec les voix intégrées à iOS, sur cet iPhone. Rien à configurer ni à payer sur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balasan diucapkan dengan suara bawaan iOS, di iPhone ini. Tidak ada yang perlu diatur atau dibayar di Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte vengono lette con le voci integrate in iOS, su questo iPhone. Niente da configurare o pagare su Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返答はこのiPhone上で、iOSに内蔵された声で読み上げられます。Hermes側での設定や費用は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 이 iPhone에서 iOS에 내장된 음성으로 읽어 줍니다. Hermes에서 설정하거나 비용을 낼 필요가 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi są czytane głosami wbudowanymi w iOS, na tym iPhonie. Na Hermesie nie trzeba nic konfigurować ani płacić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas são faladas com as vozes integradas ao iOS, neste iPhone. Nada para configurar ou pagar no Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы озвучиваются встроенными голосами iOS на этом iPhone. На Hermes ничего не нужно настраивать или оплачивать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtlar bu iPhone'da iOS'un yerleşik sesleriyle seslendirilir. Hermes'te ayarlanacak ya da ödenecek bir şey yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复会在这台 iPhone 上用 iOS 内置的声音朗读。Hermes 上无需设置，也无需付费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆會在這支 iPhone 上用 iOS 內建的聲音朗讀。Hermes 上無需設定，也無需付費。"
          }
        }
      }
    },
    "Replies in your speech server's own voice, so one server listens and speaks. Needs plugin 0.42 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwortet mit der eigenen Stimme deines Sprachservers, sodass ein Server zuhört und spricht. Erfordert Plugin 0.42 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde con la voz propia de tu servidor de voz, así un solo servidor escucha y habla. Requiere el plugin 0.42 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répond avec la voix de votre serveur vocal : un seul serveur écoute et parle. Nécessite le plugin 0.42 ou ultérieur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membalas dengan suara server suaramu sendiri, jadi satu server mendengar dan berbicara. Perlu plugin 0.42 atau lebih baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risponde con la voce del tuo server vocale, così un solo server ascolta e parla. Richiede il plugin 0.42 o successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバー自身の声で返答するので、1 台のサーバーで聞き取りと読み上げができます。プラグイン 0.42 以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버의 목소리로 답장하므로 서버 하나가 듣고 말합니다. 플러그인 0.42 이상이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiada własnym głosem serwera mowy, więc jeden serwer słucha i mówi. Wymaga wtyczki 0.42 lub nowszej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde com a voz do seu servidor de voz, então um só servidor ouve e fala. Requer o plugin 0.42 ou posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечает собственным голосом вашего голосового сервера: один сервер и слушает, и говорит. Нужен плагин 0.42 или новее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sunucunuzun kendi sesiyle yanıt verir, böylece tek sunucu hem dinler hem konuşur. Eklenti 0.42 veya üstü gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的语音服务器自己的声音回复，一台服务器即可听和说。需要插件 0.42 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的語音伺服器自己的聲音回覆，一台伺服器即可聽和說。需要外掛 0.42 或更新版本。"
          }
        }
      }
    },
