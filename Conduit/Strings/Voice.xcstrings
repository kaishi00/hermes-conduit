    },
    "Call stopped. Tap to see why." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anruf beendet. Tippe, um den Grund zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llamada detenida. Toca para ver por qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appel arrêté. Touchez pour savoir pourquoi."
          }
        },
        "id" : {
