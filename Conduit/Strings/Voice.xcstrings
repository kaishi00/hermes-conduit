        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버의 Conduit 플러그인이 선택한 목소리를 확인하지 않았어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
