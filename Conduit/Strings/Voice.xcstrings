        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の新しい音声モデルはまだお使いの言語に対応していません。音声設定で Apple を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 새 음성 모델은 아직 사용 중인 언어를 지원하지 않습니다. 음성 설정에서 Apple을 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy model mowy Apple nie obsługuje jeszcze Twojego języka. Wybierz Apple w ustawieniach głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo modelo de voz da Apple ainda não é compatível com seu idioma. Escolha Apple nos ajustes de Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая речевая модель Apple пока не поддерживает ваш язык. Выберите Apple в настройках голоса."
