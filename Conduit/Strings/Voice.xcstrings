          }
        }
      }
    },
    "Records a voice message. Or touch and hold to record, and let go to send." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt eine Sprachnachricht auf. Oder gedrückt halten zum Aufnehmen und loslassen zum Senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba un mensaje de voz. O mantén pulsado para grabar y suelta para enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un message vocal. Ou touchez longuement pour enregistrer, et relâchez pour envoyer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merekam pesan suara. Atau sentuh lama untuk merekam, lalu lepaskan untuk mengirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un messaggio vocale. Oppure tieni premuto per registrare e rilascia per inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボイスメッセージを録音します。長押しで録音し、指を離すと送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메시지를 녹음해요. 길게 눌러 녹음하고 손을 떼면 보낼 수도 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywa wiadomość głosową. Możesz też przytrzymać, aby nagrywać, i puścić, aby wysłać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava uma mensagem de voz. Ou toque e segure para gravar e solte para enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает голосовое сообщение. Или нажмите и удерживайте для записи и отпустите, чтобы отправить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli mesaj kaydeder. Ya da kaydetmek için dokunup basılı tutun, göndermek için bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制一条语音消息。也可以按住录音，松开即发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製一則語音訊息。也可以按住錄音，放開即傳送。"
          }
        }
      }
    },
