        }
      }
    },
    "Apple speech recognition stopped. Try again, or choose another speech-to-text option in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apple-Spracherkennung wurde beendet. Versuche es erneut oder wähle unter „Einstellungen“ > „Sprachmodus“ eine andere Option für Sprache zu Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz de Apple se detuvo. Vuelve a intentarlo o elige otra opción de voz a texto en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale d'Apple s'est arrêtée. Réessayez, ou choisissez une autre option de transcription vocale dans Réglages > Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan ucapan Apple berhenti. Coba lagi, atau pilih opsi ucapan ke teks lain di Pengaturan > Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale di Apple si è interrotto. Riprova o scegli un'altra opzione di trascrizione vocale in Impostazioni > Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの音声認識が停止しました。もう一度試すか、「設定」>「音声」で別の音声入力方法を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 음성 인식이 중지됐어요. 다시 시도하거나 ‘설정’ > ‘음성’에서 다른 음성 텍스트 변환 옵션을 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy Apple zostało zatrzymane. Spróbuj ponownie lub wybierz inną opcję zamiany mowy na tekst w sekcji Ustawienia > Głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de fala da Apple parou. Tente novamente ou escolha outra opção de fala para texto em Ajustes > Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи Apple остановилось. Повторите попытку или выберите другой вариант распознавания речи в разделе «Настройки › Голос»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konuşma tanıma durdu. Yeniden deneyin veya Ayarlar > Ses bölümünden başka bir konuşmadan metne seçeneği seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 语音识别已停止。请重试，或在“设置 > 语音”中选择其他语音转文字选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 語音辨識已停止。請再試一次，或在「設定」>「語音」中選擇其他語音轉文字選項。"
          }
        }
      }
    },
    "Apple's dictation, on this iPhone when your language allows. Words appear as you speak." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Diktierfunktion, auf diesem iPhone, wenn deine Sprache es zulässt. Die Wörter erscheinen, während du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado de Apple, en este iPhone cuando tu idioma lo permite. Las palabras aparecen mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée d’Apple, sur cet iPhone quand votre langue le permet. Les mots s’affichent pendant que vous parlez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte Apple, di iPhone ini jika bahasa Anda mendukung. Kata-kata muncul saat Anda berbicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dettatura di Apple, su questo iPhone quando la lingua lo consente. Le parole appaiono mentre parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の音声入力です。言語が対応していればこの iPhone 上で処理します。話すそばから文字が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 받아쓰기로, 언어가 지원되면 이 iPhone에서 처리합니다. 말하는 동안 글자가 나타납니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyktowanie Apple, na tym iPhonie, jeśli pozwala na to język. Słowa pojawiają się w trakcie mówienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado da Apple, neste iPhone quando seu idioma permite. As palavras aparecem enquanto você fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктовка Apple, на этом iPhone, если язык это позволяет. Слова появляются по мере речи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dikte özelliği; diliniz destekliyorsa bu iPhone’da çalışır. Siz konuştukça sözcükler görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的听写，语言支持时在这台 iPhone 上处理。说话时文字会随即出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的聽寫，語言支援時在這部 iPhone 上處理。說話時文字會隨即出現。"
          }
        }
      }
    },
    "Apple's new speech model couldn't be downloaded. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples neues Sprachmodell konnte nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo descargar el nuevo modelo de voz de Apple. Revisa tu conexión e inténtalo de nuevo."
