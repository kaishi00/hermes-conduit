    "Release to send, slide away to cancel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loslassen zum Senden, wegziehen zum Abbrechen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta para enviar, desliza para cancelar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez pour envoyer, glissez pour annuler"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepaskan untuk mengirim, geser menjauh untuk membatalkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascia per inviare, trascina via per annullare"
          }
        },
        "ja" : {
