    "%@ is waiting for your approval or an answer. Open it in Conduit to respond." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wartet auf deine Freigabe oder eine Antwort. Antworten kannst du in Conduit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is waiting for your approval or an answer. Open it in Conduit to respond."
          }
