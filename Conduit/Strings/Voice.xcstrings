        }
      }
    },
    "Dictation needs microphone access. You can allow it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Diktieren braucht Conduit Zugriff auf das Mikrofon. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado necesita acceso al micrófono. Puedes permitirlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée a besoin d’accéder au micro. Vous pouvez l’autoriser dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte memerlukan akses mikrofon. Anda dapat mengizinkannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dettatura richiede l’accesso al microfono. Puoi consentirlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力にはマイクへのアクセスが必要です。設定で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기에는 마이크 접근 권한이 필요합니다. 설정에서 허용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyktowanie wymaga dostępu do mikrofonu. Możesz na to zezwolić w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado precisa de acesso ao microfone. Você pode permitir em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для диктовки нужен доступ к микрофону. Его можно разрешить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte için mikrofon erişimi gerekir. Ayarlar’dan izin verebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写需要麦克风权限。你可以在“设置”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽寫需要麥克風權限。你可以在「設定」中允許。"
          }
        }
      }
    },
    "Dictation needs microphone and speech recognition access. You can allow them in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktieren benötigt Zugriff auf Mikrofon und Spracherkennung. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado necesita acceso al micrófono y al reconocimiento de voz. Puedes permitirlos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée nécessite l'accès au micro et à la reconnaissance vocale. Vous pouvez les autoriser dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte memerlukan akses mikrofon dan pengenalan ucapan. Anda dapat mengizinkannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dettatura richiede l'accesso al microfono e al riconoscimento vocale. Puoi consentirli in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力にはマイクと音声認識へのアクセスが必要です。「設定」で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기를 하려면 마이크 및 음성 인식 접근 권한이 필요해요. ‘설정’에서 허용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyktowanie wymaga dostępu do mikrofonu i rozpoznawania mowy. Możesz na to zezwolić w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado precisa de acesso ao microfone e ao reconhecimento de fala. Você pode permitir isso em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для диктовки нужен доступ к микрофону и распознаванию речи. Его можно разрешить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte için mikrofon ve konuşma tanıma erişimi gerekir. Bunlara Ayarlar'dan izin verebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写需要麦克风和语音识别权限。你可以在“设置”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽寫需要麥克風和語音辨識的取用權限。你可以在「設定」中允許。"
          }
        }
      }
    },
    "During a %@ call, Conduit sends your microphone audio, the transcript, and the context and tool results Hermes adds to %@. Their terms and privacy policy apply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während eines %1$@-Anrufs sendet Conduit dein Mikrofon-Audio, das Transkript sowie den Kontext und die Tool-Ergebnisse, die Hermes hinzufügt, an %2$@. Es gelten deren Nutzungsbedingungen und Datenschutzrichtlinie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una llamada de %1$@, Conduit envía a %2$@ el audio de tu micrófono, la transcripción y el contexto y los resultados de herramientas que añade Hermes. Se aplican sus condiciones y su política de privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un appel %1$@, Conduit envoie à %2$@ l’audio de votre micro, la transcription, ainsi que le contexte et les résultats d’outils ajoutés par Hermes. Leurs conditions et leur politique de confidentialité s’appliquent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selama panggilan %1$@, Conduit mengirim audio mikrofon Anda, transkrip, serta konteks dan hasil alat yang ditambahkan Hermes ke %2$@. Ketentuan dan kebijakan privasi mereka berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una chiamata %1$@, Conduit invia a %2$@ l’audio del microfono, la trascrizione e il contesto e i risultati degli strumenti aggiunti da Hermes. Si applicano i loro termini e la loro informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の通話中、Conduitはマイクの音声、文字起こし、Hermesが追加するコンテキストとツールの結果を%2$@に送信します。同社の利用規約とプライバシーポリシーが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 통화 중에 Conduit은 마이크 오디오, 대화 기록, 그리고 Hermes가 추가하는 맥락과 도구 결과를 %2$@에 보내요. 해당 회사의 약관과 개인정보 처리방침이 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas rozmowy %1$@ Conduit wysyła do %2$@ dźwięk z mikrofonu, transkrypcję oraz kontekst i wyniki narzędzi dodane przez Hermesa. Obowiązują ich warunki i polityka prywatności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante uma chamada do %1$@, o Conduit envia para a %2$@ o áudio do seu microfone, a transcrição e o contexto e os resultados de ferramentas que o Hermes adiciona. Os termos e a política de privacidade deles se aplicam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время звонка %1$@ Conduit отправляет в %2$@ звук с микрофона, расшифровку, а также контекст и результаты инструментов, которые добавляет Hermes. Действуют их условия и политика конфиденциальности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ araması sırasında Conduit mikrofon sesinizi, dökümü ve Hermes’in eklediği bağlamı ve araç sonuçlarını %2$@ şirketine gönderir. Onların koşulları ve gizlilik politikası geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 通话期间，Conduit 会将你的麦克风音频、转写文字，以及 Hermes 添加的上下文和工具结果发送给 %2$@。其服务条款和隐私政策适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 通話期間，Conduit 會將你的麥克風音訊、逐字稿，以及 Hermes 加入的情境和工具結果傳送給 %2$@。其服務條款和隱私權政策適用。"
          }
        }
      }
    },
