{
  "sourceLanguage" : "en",
  "strings" : {
    "The Conduit plugin on your Hermes server didn't confirm the voice you chose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Conduit-Plug-in auf deinem Hermes-Server hat die gewählte Stimme nicht bestätigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin de Conduit de tu servidor Hermes no confirmó la voz que elegiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin Conduit de votre serveur Hermes n'a pas confirmé la voix choisie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin Conduit di server Hermes Anda tidak mengonfirmasi suara yang Anda pilih."
