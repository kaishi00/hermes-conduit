    "Wake listening couldn't use the microphone. Close other apps using it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktivierung konnte das Mikrofon nicht nutzen. Schließe andere Apps, die es verwenden, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escucha de activación no pudo usar el micrófono. Cierra las demás apps que lo estén usando y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écoute d'activation n'a pas pu utiliser le micro. Fermez les autres apps qui l'utilisent, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendengaran frasa pemicu tidak dapat menggunakan mikrofon. Tutup app lain yang menggunakannya, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ascolto per l'attivazione vocale non ha potuto usare il microfono. Chiudi le altre app che lo usano, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクフレーズの待ち受けでマイクを使用できませんでした。マイクを使用しているほかのアプリを閉じてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출어 감지가 마이크를 사용할 수 없었어요. 마이크를 사용 중인 다른 앱을 닫은 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasłuchiwanie frazy aktywującej nie mogło użyć mikrofonu. Zamknij inne aplikacje, które z niego korzystają, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escuta de ativação não conseguiu usar o microfone. Feche outros apps que o estejam usando e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожиданию фразы активации не удалось использовать микрофон. Закройте другие приложения, которые его используют, и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyandırma dinlemesi mikrofonu kullanamadı. Mikrofonu kullanan diğer uygulamaları kapatıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唤醒监听无法使用麦克风。请关闭正在使用麦克风的其他应用，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聆聽喚醒詞時無法使用麥克風。請關閉其他正在使用麥克風的 App，然後再試一次。"
          }
        }
      }
    },
