    "Enable Speech Recognition in Settings > Conduit > Speech Recognition, then retry selecting \"On this iPhone\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Spracherkennung unter „Einstellungen“ > „Conduit“ > „Spracherkennung“ und wähle dann erneut „Auf diesem iPhone“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Reconocimiento de voz en Ajustes > Conduit > Reconocimiento de voz y vuelve a seleccionar «En este iPhone»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la reconnaissance vocale dans Réglages > Conduit > Reconnaissance vocale, puis sélectionnez à nouveau « Sur cet iPhone »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Pengenalan Ucapan di Pengaturan > Conduit > Pengenalan Ucapan, lalu coba pilih “Di iPhone ini” lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Riconoscimento vocale in Impostazioni > Conduit > Riconoscimento vocale, poi riprova a selezionare “Su questo iPhone”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」>「Conduit」>「音声認識」で音声認識を有効にしてから、もう一度「このiPhone上」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘설정’ > ‘Conduit’ > ‘음성 인식’에서 음성 인식을 켠 다음 ‘이 iPhone에서’를 다시 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz rozpoznawanie mowy w Ustawieniach > Conduit > Rozpoznawanie mowy, a następnie ponownie wybierz „Na tym iPhonie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Reconhecimento de Fala em Ajustes > Conduit > Reconhecimento de Fala e tente selecionar “Neste iPhone” novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите распознавание речи в «Настройки» > Conduit > «Распознавание речи», затем снова выберите «На этом iPhone»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar > Conduit > Konuşma Tanıma bölümünden Konuşma Tanıma'yı etkinleştirin, ardından “Bu iPhone'da” seçeneğini yeniden seçmeyi deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「设置」>「Conduit」>「语音识别」中启用语音识别，然后重新选择「在这台 iPhone 上」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」>「Conduit」>「語音辨識」中啟用語音辨識，然後再試著選擇「在這部 iPhone 上」。"
          }
        }
      }
    },
    "Enable Speech Recognition in System Settings → Privacy & Security → Speech Recognition, then retry selecting \"On this iPhone\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Spracherkennung unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Spracherkennung“ und wähle dann erneut „Auf diesem iPhone“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Reconocimiento de voz en Ajustes del Sistema → Privacidad y seguridad → Reconocimiento de voz y vuelve a seleccionar «En este iPhone»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la reconnaissance vocale dans Réglages Système → Confidentialité et sécurité → Reconnaissance vocale, puis sélectionnez à nouveau « Sur cet iPhone »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Pengenalan Ucapan di Pengaturan Sistem → Privasi & Keamanan → Pengenalan Ucapan, lalu coba pilih “Di iPhone ini” lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Riconoscimento vocale in Impostazioni di Sistema → Privacy e sicurezza → Riconoscimento vocale, poi riprova a selezionare “Su questo iPhone”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」→「プライバシーとセキュリティ」→「音声認識」で音声認識を有効にしてから、もう一度「このiPhone上」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘시스템 설정’ → ‘개인정보 보호 및 보안’ → ‘음성 인식’에서 음성 인식을 켠 다음 ‘이 iPhone에서’를 다시 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz rozpoznawanie mowy w Ustawieniach systemowych → Prywatność i ochrona → Rozpoznawanie mowy, a następnie ponownie wybierz „Na tym iPhonie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Reconhecimento de Fala em Ajustes do Sistema → Privacidade e Segurança → Reconhecimento de Fala e tente selecionar “Neste iPhone” novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите распознавание речи в «Системные настройки» → «Конфиденциальность и безопасность» → «Распознавание речи», затем снова выберите «На этом iPhone»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları → Gizlilik ve Güvenlik → Konuşma Tanıma bölümünden Konuşma Tanıma'yı etkinleştirin, ardından “Bu iPhone'da” seçeneğini yeniden seçmeyi deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系统设置」→「隐私与安全性」→「语音识别」中启用语音识别，然后重新选择「在这台 iPhone 上」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」→「隱私權與安全性」→「語音辨識」中啟用語音辨識，然後再試著選擇「在這部 iPhone 上」。"
          }
        }
      }
    },
