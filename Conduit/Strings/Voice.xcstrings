    "No fast model is set, so Hermes answers each turn itself, which is slower to start talking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein schnelles Modell eingerichtet, daher beantwortet Hermes jeden Zug selbst und fängt langsamer an zu sprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un modelo rápido configurado, así que Hermes responde cada turno por sí mismo y tarda más en empezar a hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun modèle rapide n’est défini : Hermes répond lui-même à chaque tour et met plus de temps à commencer à parler."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada model cepat, jadi Hermes menjawab setiap giliran sendiri dan lebih lambat mulai berbicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun modello veloce impostato, quindi Hermes risponde da sé a ogni turno e inizia a parlare più lentamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速モデルが設定されていないため、Hermes が各ターンに自分で答えます。話し始めるまでに時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 모델이 설정되지 않아 Hermes가 매 턴을 직접 답하므로 말을 시작하기까지 더 오래 걸립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ustawiono szybkiego modelu, więc Hermes sam odpowiada na każdą turę i później zaczyna mówić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
