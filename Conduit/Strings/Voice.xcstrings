          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a leggere l'audio da questo microfono. Riprova o passa a un altro microfono o auricolare."
          }
        },
        "ja" : {
          "stringUnit" : {
