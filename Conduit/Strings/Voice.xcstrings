        }
      }
    },
    "Calls answer with %@ and hand the work to Hermes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe antworten mit %@ und übergeben die Arbeit an Hermes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas responden con %@ y pasan el trabajo a Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels répondent avec %@ et confient le travail à Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan dijawab dengan %@ dan pekerjaannya diserahkan ke Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
