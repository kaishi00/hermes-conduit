          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu host Hermes não enviou uma chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хост Hermes не прислал ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ana bilgisayarınız anahtar göndermedi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 主机没有发送密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 主機沒有傳送密鑰。"
          }
        }
      }
    },
    "Your Hermes server can't save voice calls yet. Install or update the Hermes notifier plugin on your Hermes server, then tap Save Now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes-Server kann noch keine Sprachanrufe sichern. Installiere oder aktualisiere das Hermes-Notifier-Plug-in auf deinem Hermes-Server und tippe dann auf „Jetzt sichern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor Hermes aún no puede guardar llamadas de voz. Instala o actualiza el plugin de notificaciones de Hermes en tu servidor Hermes y luego toca Guardar ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Hermes ne peut pas encore enregistrer les appels vocaux. Installez ou mettez à jour le plugin de notification Hermes sur votre serveur Hermes, puis touchez Enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Hermes Anda belum dapat menyimpan panggilan suara. Instal atau perbarui plugin notifier Hermes di server Hermes Anda, lalu ketuk Simpan Sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server Hermes non può ancora salvare le chiamate vocali. Installa o aggiorna il plugin di notifica di Hermes sul tuo server Hermes, poi tocca Salva ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのHermesサーバはまだ音声通話を保存できません。HermesサーバにHermes通知プラグインをインストールまたはアップデートしてから、「今すぐ保存」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버가 아직 음성 통화를 저장할 수 없어요. Hermes 서버에 Hermes 알림 플러그인을 설치하거나 업데이트한 다음 ‘지금 저장’을 탭하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój serwer Hermes nie może jeszcze zapisywać połączeń głosowych. Zainstaluj lub zaktualizuj wtyczkę powiadomień Hermes na swoim serwerze Hermes, a następnie stuknij „Zapisz teraz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor Hermes ainda não pode salvar chamadas de voz. Instale ou atualize o plugin notificador do Hermes no seu servidor Hermes e toque em Salvar Agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш сервер Hermes пока не может сохранять голосовые звонки. Установите или обновите плагин уведомлений Hermes на сервере Hermes, затем нажмите «Сохранить сейчас»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sunucunuz henüz sesli aramaları kaydedemiyor. Hermes sunucunuza Hermes bildirim eklentisini yükleyin veya güncelleyin, ardından Şimdi Kaydet'e dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 服务器暂时无法保存语音通话。请在 Hermes 服务器上安装或更新 Hermes notifier 插件，然后轻点“立即保存”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 伺服器目前無法儲存語音通話。請在 Hermes 伺服器上安裝或更新 Hermes 通知外掛程式，然後點一下「立即儲存」。"
          }
        }
      }
    },
