        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zgody. Zezwól aplikacji Conduit na dostęp do mikrofonu w Ustawieniach iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não permitido. Permita o microfone para o Conduit nos Ajustes do iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не разрешено. Разрешите Conduit доступ к микрофону в Настройках iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verilmedi. iPhone Ayarları'nda Conduit için mikrofona izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允许。请在 iPhone 设置中允许 Conduit 使用麦克风。"
          }
