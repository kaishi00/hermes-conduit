          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始聆聽前，請至少選擇一個有效的喚醒詞。"
          }
        }
      }
    },
    "Choose on-device Apple speech or a provider reported by Hermes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
