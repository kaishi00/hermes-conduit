    "%@ isn't set up on your Hermes server. Settings > Voice shows what it needs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf deinem Hermes-Server nicht eingerichtet. Unter „Einstellungen“ > „Sprachmodus“ siehst du, was dafür nötig ist."
          }
        },
        "es" : {
          "stringUnit" : {
