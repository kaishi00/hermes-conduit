          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesの%@は準備ができていません（%@）。代わりにこのiPhoneで処理でき、インストールは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes의 %@ 사용 준비가 되지 않았어요(%@). 대신 이 iPhone에서 처리할 수 있으며 따로 설치할 것은 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca %@ w Hermesie nie jest gotowy (%@). Zamiast niego może to robić ten iPhone, bez instalowania czegokolwiek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no Hermes não está pronto (%@). Este iPhone pode fazer isso no lugar dele, sem instalar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
