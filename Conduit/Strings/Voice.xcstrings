    "Call me now to test calls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruf mich jetzt an, um Anrufe zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llámame ahora para probar las llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
