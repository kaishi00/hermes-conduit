    "Apple speech recognition is temporarily unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung von Apple ist vorübergehend nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz de Apple no está disponible temporalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale d'Apple est temporairement indisponible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan ucapan Apple untuk sementara tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale di Apple non è temporaneamente disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
