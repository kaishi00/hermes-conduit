    "Connect to Hermes before reading responses aloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich mit Hermes, bevor du dir Antworten vorlesen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a Hermes antes de leer respuestas en voz alta."
