    "You already have %lld background jobs running. Cancel them before starting another." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Du hast bereits %lld laufenden Hintergrundjob. Brich ihn ab, bevor du einen weiteren startest."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Du hast bereits %lld laufende Hintergrundjobs. Brich sie ab, bevor du einen weiteren startest."
                }
