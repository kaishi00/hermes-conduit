    "Built-in voices are suggestions; custom voice IDs remain supported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Stimmen sind Vorschläge; eigene Stimmen-IDs werden weiterhin unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las voces integradas son sugerencias; se siguen admitiendo ID de voz personalizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voix intégrées sont des suggestions ; les identifiants de voix personnalisés restent pris en charge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara bawaan hanyalah saran; ID suara khusus tetap didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci integrate sono suggerimenti; gli ID voce personalizzati restano supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みの音声は一例です。カスタムの音声IDも引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 제공 목소리는 제안일 뿐이며, 사용자 지정 목소리 ID도 계속 지원돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wbudowane głosy to tylko propozycje; nadal można podać własne identyfikatory głosów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
