        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 伺服器上的 Conduit 外掛程式沒有確認你選擇的聲音。"
          }
        }
      }
    },
    "Your Hermes server can't save voice calls yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes-Server kann noch keine Sprachanrufe sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor Hermes aún no puede guardar llamadas de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Hermes ne peut pas encore enregistrer les appels vocaux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Hermes Anda belum dapat menyimpan panggilan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server Hermes non può ancora salvare le chiamate vocali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのHermesサーバはまだ音声通話を保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
