    "Records a short sample and shows what speech to text heard" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt eine kurze Probe auf und zeigt, was die Spracherkennung verstanden hat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba una muestra corta y muestra lo que entendió la voz a texto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un court extrait et affiche ce que la transcription vocale a entendu"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merekam contoh singkat dan menampilkan apa yang didengar oleh ucapan ke teks"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un breve campione e mostra cosa ha sentito la trascrizione vocale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いサンプルを録音し、音声認識が聞き取った内容を表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 샘플을 녹음하고 음성 텍스트 변환이 알아들은 내용을 보여 줘요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywa krótką próbkę i pokazuje, co rozpoznała zamiana mowy na tekst"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava uma breve amostra e mostra o que a fala para texto ouviu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает короткий образец и показывает, что было распознано"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
