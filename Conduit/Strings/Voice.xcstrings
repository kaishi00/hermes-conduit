    "%@ sends your voice to %@. Allow it in Conduit on your iPhone to start the call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sendet deine Stimme an %2$@. Erlaube es in Conduit auf deinem iPhone, um den Anruf zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ envía tu voz a %2$@. Permítelo en Conduit en tu iPhone para iniciar la llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
