    "Choose OpenAI Codex when prompted. The sign-in stays on your Hermes server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle OpenAI Codex, wenn du dazu aufgefordert wirst. Die Anmeldung bleibt auf deinem Hermes-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige OpenAI Codex cuando se te pida. El inicio de sesión se queda en tu servidor Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez OpenAI Codex quand vous y êtes invité. La connexion reste sur votre serveur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih OpenAI Codex saat diminta. Login tetap di server Hermes Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli OpenAI Codex quando richiesto. L'accesso resta sul tuo server Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択を求められたらOpenAI Codexを選んでください。サインイン情報はHermesサーバに保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지가 표시되면 OpenAI Codex를 선택하세요. 로그인 정보는 Hermes 서버에 그대로 남아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy pojawi się monit, wybierz OpenAI Codex. Logowanie pozostaje na Twoim serwerze Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha OpenAI Codex quando solicitado. O login fica no seu servidor Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При запросе выберите OpenAI Codex. Данные входа остаются на вашем сервере Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstendiğinde OpenAI Codex'i seçin. Giriş Hermes sunucunuzda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出现提示时请选择 OpenAI Codex。登录信息保留在 Hermes 服务器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出現提示時，請選擇 OpenAI Codex。登入資訊會保留在你的 Hermes 伺服器上。"
          }
        }
      }
    },
    "Choose at least one valid wake phrase before listening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens eine gültige Aktivierungsphrase, bevor du das Zuhören startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos una frase de activación válida antes de escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez au moins une phrase d'activation valide avant d'écouter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih setidaknya satu frasa pemicu yang valid sebelum mendengarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli almeno una frase di attivazione valida prima di avviare l'ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待ち受けを開始する前に、有効なウェイクフレーズを1つ以上選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 전에 유효한 호출어를 하나 이상 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed rozpoczęciem nasłuchiwania wybierz co najmniej jedną prawidłową frazę aktywującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pelo menos uma frase de ativação válida antes de ouvir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед прослушиванием выберите хотя бы одну допустимую фразу активации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlemeden önce en az bir geçerli uyandırma ifadesi seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
