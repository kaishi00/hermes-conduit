    "Say the number of your choice, or answer in your own words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag die Nummer deiner Wahl oder antworte in deinen eigenen Worten."
          }
        },
        "es" : {
