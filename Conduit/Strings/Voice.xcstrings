          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes devam etmek için onayınızı bekliyor: %@. Bir kez izin vermek için evet, vermemek için hayır deyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 需要你同意才能继续：%@。说“是”允许这一次，或说“不”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
