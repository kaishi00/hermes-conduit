    },
    "%@ must be a number between %@ and %@, or leave blank to remove the override." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss eine Zahl zwischen %@ und %@ sein. Lass das Feld leer, um die Überschreibung zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debe ser un número entre %@ y %@, o déjalo en blanco para quitar la anulación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doit être un nombre compris entre %@ et %@, ou laissez le champ vide pour supprimer la valeur de remplacement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ harus berupa angka antara %@ dan %@, atau biarkan kosong untuk menghapus penimpaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve essere un numero compreso tra %@ e %@, oppure lascia vuoto per rimuovere l'override."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には%@から%@までの数値を入力してください。オーバーライドを削除する場合は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) %@에서 %@ 사이의 숫자여야 해요. 재정의를 제거하려면 비워 두세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ musi być liczbą od %@ do %@. Pozostaw puste, aby usunąć nadpisanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve ser um número entre %@ e %@, ou deixe em branco para remover a substituição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ должно быть числом от %@ до %@. Оставьте поле пустым, чтобы убрать переопределение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ ile %@ arasında bir sayı olmalıdır; geçersiz kılmayı kaldırmak için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必须是介于 %@ 和 %@ 之间的数字；留空则移除覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必須是介於 %@ 和 %@ 之間的數字；留空即移除覆寫。"
          }
        }
      }
    },
    "%@ must be between %@ and %@. Hermes clamps values into this range; Conduit refuses them instead of saving something upstream would silently rewrite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss zwischen %@ und %@ liegen. Hermes begrenzt Werte auf diesen Bereich; Conduit lehnt sie ab, statt etwas zu speichern, das Hermes stillschweigend ändern würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debe estar entre %@ y %@. Hermes ajusta los valores a este rango; Conduit los rechaza en lugar de guardar algo que Hermes cambiaría sin avisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doit être compris entre %@ et %@. Hermes ramène les valeurs dans cette plage ; Conduit les refuse plutôt que d'enregistrer une valeur qu'Hermes modifierait sans le signaler."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ harus berada di antara %@ dan %@. Hermes membatasi nilai ke rentang ini; Conduit menolaknya alih-alih menyimpan sesuatu yang akan diubah Hermes tanpa pemberitahuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve essere compreso tra %@ e %@. Hermes riporta i valori in questo intervallo; Conduit li rifiuta invece di salvare qualcosa che Hermes modificherebbe senza avvisare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は%@から%@の範囲で指定してください。Hermesは値をこの範囲に丸めますが、Conduitは、Hermes側で知らないうちに書き換えられる値を保存せずに拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) %@에서 %@ 사이여야 해요. Hermes는 값을 이 범위로 조정하지만, Conduit은 Hermes가 몰래 바꿔 버릴 값을 저장하지 않고 거부해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ musi mieścić się w zakresie od %@ do %@. Hermes przycina wartości do tego zakresu; Conduit je odrzuca, zamiast zapisywać coś, co Hermes po cichu by zmienił."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve estar entre %@ e %@. O Hermes ajusta os valores a esse intervalo; o Conduit os recusa em vez de salvar algo que o Hermes alteraria sem avisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ должно быть в диапазоне от %@ до %@. Hermes приводит значения к этому диапазону; Conduit отклоняет их, а не сохраняет то, что Hermes молча изменил бы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ ile %@ arasında olmalıdır. Hermes değerleri bu aralığa sıkıştırır; Conduit, Hermes'in sessizce değiştireceği bir değeri kaydetmek yerine reddeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必须介于 %@ 和 %@ 之间。Hermes 会将值限制在此范围内；Conduit 会直接拒绝，而不是保存一个会被 Hermes 悄悄改写的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必須介於 %@ 和 %@ 之間。Hermes 會將值限制在此範圍內；Conduit 會直接拒絕，而不是儲存一個會被 Hermes 悄悄改寫的值。"
          }
        }
      }
    },
    "%@ needs your OK to go on: %@. Say yes to allow it once, or no." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht dein OK, um weiterzumachen: %@. Sag Ja, um es einmal zu erlauben, oder Nein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ needs your OK to go on: %@. Say yes to allow it once, or no."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita tu visto bueno para seguir: %@. Di sí para permitirlo una vez, o no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a besoin de votre accord pour continuer : %@. Dites oui pour l’autoriser une fois, ou non."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perlu persetujuan Anda untuk lanjut: %@. Katakan ya untuk mengizinkannya sekali, atau tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il job %@ ha bisogno del tuo OK per continuare: %@. Di' sì per consentirlo una volta, oppure no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を続けるにはあなたの許可が必要です：%@。1回だけ許可するなら「はい」、しないなら「いいえ」と言ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 작업을 계속하려면 승인이 필요해요: %@. 한 번 허용하려면 '네', 아니면 '아니요'라고 말하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlecenie „%@” potrzebuje Twojej zgody, by kontynuować: %@. Powiedz „tak”, aby zezwolić jednorazowo, albo „nie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trabalho %@ precisa do seu OK para continuar: %@. Diga sim para permitir uma vez, ou não."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заданию «%@» нужно ваше разрешение, чтобы продолжить: %@. Скажите «да», чтобы разрешить один раз, или «нет»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ devam etmek için onayınızı bekliyor: %@. Bir kez izin vermek için evet, vermemek için hayır deyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要你同意才能继续：%@。说“是”允许这一次，或说“不”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要你同意才能繼續：%@。說「是」允許這一次，或說「不」。"
          }
        }
      }
    },
