        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось получить звук с этого микрофона. Повторите попытку или переключитесь на другой микрофон или гарнитуру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu mikrofondan ses okuyamadı. Yeniden deneyin veya başka bir mikrofona ya da kulaklığa geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法读取此麦克风的音频。请重试，或换用其他麦克风或耳机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法從此麥克風讀取音訊。請再試一次，或改用其他麥克風或耳機。"
          }
        }
      }
    },
    "Conduit listens for “%@” in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hört auf „%@“ in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit escucha «%@» en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit écoute « %@ » en %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit mendengarkan “%@” dalam %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ascolta “%@” in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは「%1$@」を%2$@で聞き取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 “%@”을(를) %@로 들어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nasłuchuje „%@” w języku %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit escuta “%@” em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit слушает «%@» на языке %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit “%@” ifadesini %@ dilinde dinler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 会用%2$@聆听“%1$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 會用%2$@聆聽「%1$@」。"
          }
        }
      }
    },
    "Conduit lost the connection to Hermes, so voice did not start. Say the wake phrase again after the connection is restored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hat die Verbindung zu Hermes verloren, daher wurde die Sprachunterhaltung nicht gestartet. Sag die Aktivierungsphrase erneut, sobald die Verbindung wiederhergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit perdió la conexión con Hermes, así que la voz no se inició. Vuelve a decir la frase de activación cuando se restablezca la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit a perdu la connexion à Hermes, la voix n'a donc pas démarré. Redites la phrase d'activation une fois la connexion rétablie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kehilangan koneksi ke Hermes, jadi suara tidak dimulai. Ucapkan frasa pemicu lagi setelah koneksi pulih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ha perso la connessione a Hermes, quindi la voce non si è avviata. Ripeti la frase di attivazione quando la connessione sarà ripristinata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ConduitとHermesの接続が切れたため、音声は開始されませんでした。接続が回復してから、もう一度ウェイクフレーズを話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit과 Hermes의 연결이 끊어져서 음성이 시작되지 않았어요. 연결이 복구된 후 호출어를 다시 말하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit utracił połączenie z Hermesem, więc głos nie został uruchomiony. Po przywróceniu połączenia ponownie wypowiedz frazę aktywującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit perdeu a conexão com o Hermes, então a voz não foi iniciada. Diga a frase de ativação novamente depois que a conexão for restabelecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit потерял подключение к Hermes, поэтому голосовой режим не запущен. Произнесите фразу активации снова после восстановления подключения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'in Hermes ile bağlantısı kesildiği için ses başlatılmadı. Bağlantı yeniden kurulduktan sonra uyandırma ifadesini tekrar söyleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 与 Hermes 的连接已断开，因此语音未启动。请在连接恢复后再次说出唤醒词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 與 Hermes 的連線已中斷，因此語音未啟動。請在連線恢復後再次說出喚醒詞。"
          }
        }
      }
    },
    "Conduit needs the microphone for voice. Allow it in iPhone Settings > Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit benötigt das Mikrofon für den Sprachmodus. Erlaube den Zugriff unter „iPhone-Einstellungen“ > „Conduit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit necesita el micrófono para la voz. Permítelo en Ajustes del iPhone > Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit a besoin du micro pour la voix. Autorisez-le dans Réglages de l'iPhone > Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit memerlukan mikrofon untuk suara. Izinkan di Pengaturan iPhone > Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ha bisogno del microfono per la voce. Consentilo in Impostazioni di iPhone > Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitの音声機能にはマイクへのアクセスが必要です。iPhoneの「設定」>「Conduit」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit에서 음성을 사용하려면 마이크가 필요해요. iPhone ‘설정’ > ‘Conduit’에서 허용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
