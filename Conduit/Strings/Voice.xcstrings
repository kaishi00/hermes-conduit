    "Ends a running call on this iPhone. The next call asks again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet einen laufenden Anruf auf diesem iPhone. Der nächste Anruf fragt erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una llamada en curso en este iPhone. La próxima llamada volverá a preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met fin à un appel en cours sur cet iPhone. Le prochain appel redemandera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengakhiri panggilan yang sedang berlangsung di iPhone ini. Panggilan berikutnya akan bertanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una chiamata in corso su questo iPhone. La prossima chiamata chiederà di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneで進行中の通話を終了します。次回の通話で再度確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 진행 중인 통화를 종료해요. 다음 통화에서 다시 물어봐요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kończy trwającą rozmowę na tym iPhonie. Następna rozmowa zapyta ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra uma chamada em andamento neste iPhone. A próxima chamada vai perguntar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершает текущий звонок на этом iPhone. Следующий звонок спросит снова."
          }
