        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non consentito. Consenti l'accesso al microfono per Conduit nelle Impostazioni di iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可されていません。iPhoneの「設定」でConduitにマイクへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용되지 않았어요. iPhone ‘설정’에서 Conduit의 마이크 접근을 허용하세요."
