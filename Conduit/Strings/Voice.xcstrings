    "Not allowed. Allow the microphone for Conduit in iPhone Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erlaubt. Erlaube das Mikrofon für Conduit in den iPhone-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No permitido. Permite el acceso al micrófono para Conduit en los Ajustes del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non autorisé. Autorisez le micro pour Conduit dans les Réglages de l'iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak diizinkan. Izinkan mikrofon untuk Conduit di Pengaturan iPhone."
