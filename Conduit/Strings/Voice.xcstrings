          }
        }
      }
    },
    "%@. %@ Voice did not start — ask Siri again after reconnecting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ Die Sprachunterhaltung wurde nicht gestartet – frag Siri erneut, sobald die Verbindung wiederhergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ La voz no se inició; vuelve a pedírselo a Siri cuando te reconectes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ La voix n'a pas démarré : redemandez à Siri après la reconnexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ Suara tidak dimulai — minta Siri lagi setelah tersambung kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ La voce non si è avviata: chiedi di nuovo a Siri dopo esserti riconnesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。%@ 音声は開始されませんでした。再接続後にもう一度Siriに頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ 음성이 시작되지 않았어요. 다시 연결한 후 Siri에게 다시 요청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ Głos nie został uruchomiony — po ponownym połączeniu poproś Siri jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ A voz não foi iniciada — peça à Siri novamente depois de reconectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ Голосовой режим не запущен — после восстановления подключения снова обратитесь к Siri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ Ses başlatılmadı — yeniden bağlandıktan sonra Siri'ye tekrar sorun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。%@ 语音未启动——重新连接后请再次询问 Siri。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。%@ 語音未啟動。重新連線後，請再問一次 Siri。"
          }
        }
      }
    },
