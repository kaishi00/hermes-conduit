        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit precisa do microfone para a voz. Permita-o nos Ajustes do iPhone > Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit нужен микрофон для голоса. Разрешите доступ в «Настройки» iPhone > Conduit."
