    "%@ isn't ready on Hermes. This iPhone can speak the replies instead, with nothing to set up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf Hermes nicht bereit. Stattdessen kann dieses iPhone die Antworten sprechen, ohne dass du etwas einrichten musst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está listo en Hermes. Este iPhone puede decir las respuestas en su lugar, sin configurar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas prêt sur Hermes. Cet iPhone peut lire les réponses à la place, sans rien configurer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ belum siap di Hermes. iPhone ini bisa mengucapkan balasan sebagai gantinya, tanpa perlu mengatur apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è pronto su Hermes. Questo iPhone può leggere le risposte al suo posto, senza configurare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はHermesで準備ができていません。代わりにこのiPhoneが返答を読み上げられます。設定は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) Hermes에서 준비되지 않았습니다. 대신 이 iPhone이 설정 없이 답변을 읽어 줄 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie jest gotowy na Hermesie. Ten iPhone może zamiast tego czytać odpowiedzi, bez żadnej konfiguracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está pronto no Hermes. Este iPhone pode falar as respostas no lugar, sem configurar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
