    "Not used while push to talk is on: each turn starts when you hold the button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird bei Push-to-Talk nicht verwendet: Jeder Beitrag beginnt, wenn du die Taste gedrückt hältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se usa con Pulsar para hablar activado: cada turno empieza al mantener pulsado el botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutilisé quand Appuyer pour parler est activé : chaque tour commence quand vous maintenez le bouton."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dipakai saat Tekan untuk bicara aktif: setiap giliran dimulai saat Anda menahan tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non usato con Premi per parlare attivo: ogni turno inizia quando tieni premuto il pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュ・トゥ・トークがオンの間は使われません：ボタンを押し続けると各ターンが始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눌러서 말하기가 켜져 있으면 사용되지 않습니다: 버튼을 누르고 있을 때 각 차례가 시작됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieużywane przy włączonym Naciśnij i mów: każda tura zaczyna się, gdy przytrzymasz przycisk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é usado com Apertar para falar ativado: cada vez começa quando você segura o botão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не используется, когда включена «Нажми и говори»: каждая реплика начинается, когда вы удерживаете кнопку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas konuş açıkken kullanılmaz: her sıra düğmeyi basılı tuttuğunuzda başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住说话开启时不使用：每次发言在你按住按钮时开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住說話開啟時不使用：每次發言在你按住按鈕時開始。"
          }
        }
      }
    },
