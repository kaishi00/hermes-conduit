    "Voice is off for this profile. Turn on \"Enable voice on this device\" in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sprachmodus ist für dieses Profil aus. Schalte „Sprachmodus auf diesem Gerät aktivieren“ unter „Einstellungen“ > „Sprachmodus“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz está desactivada para este perfil. Activa la opción «Activar la voz en este dispositivo» en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix est désactivée pour ce profil. Activez « Activer la voix sur cet appareil » dans Réglages > Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara mati untuk profil ini. Nyalakan “Aktifkan suara di perangkat ini” di Pengaturan > Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce è disattivata per questo profilo. Attiva “Attiva la voce su questo dispositivo” in Impostazioni > Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルでは音声がオフになっています。「設定」>「音声」で「このデバイスで音声を有効にする」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필에서 음성이 꺼져 있어요. ‘설정’ > ‘음성’에서 ‘이 기기에서 음성 켜기’를 켜세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głos jest wyłączony dla tego profilu. Włącz opcję „Włącz głos na tym urządzeniu” w sekcji Ustawienia > Głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz está desativada para este perfil. Ative “Ativar voz neste aparelho” em Ajustes > Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос выключен для этого профиля. Включите параметр «Включить голос на этом устройстве» в разделе «Настройки › Голос»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profil için ses kapalı. Ayarlar > Ses bölümünde “Bu cihazda sesi etkinleştir” seçeneğini açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置的语音已关闭。请在「设置」>「语音」中开启「在此设备上启用语音」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定檔的語音已關閉。請在「設定」>「語音」中開啟「在此裝置上啟用語音」。"
          }
        }
      }
    },
