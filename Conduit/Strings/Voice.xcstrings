        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un unico blocco con indirizzo, chiave e opzioni, scritto per chi configura il server, come il tuo agente Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレス、キー、フラグをまとめた1つのブロックです。Hermes エージェントなど、サーバーを設定する人向けに書かれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소, 키, 플래그를 한 블록에 담았어요. Hermes 에이전트처럼 서버를 설정하는 쪽을 위해 쓰였어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden blok z adresem, kluczem i flagami, napisany dla tego, kto konfiguruje serwer, na przykład twojego agenta Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
