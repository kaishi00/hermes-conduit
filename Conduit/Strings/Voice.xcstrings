    "Update Hermes to use Voice. This version can't tell Conduit whether voice is ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Hermes, um den Sprachmodus zu nutzen. Diese Version kann Conduit nicht mitteilen, ob der Sprachmodus bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Hermes para usar la voz. Esta versión no puede indicar a Conduit si la voz está lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Hermes pour utiliser la voix. Cette version ne peut pas indiquer à Conduit si la voix est prête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui Hermes untuk menggunakan Suara. Versi ini tidak dapat memberi tahu Conduit apakah suara sudah siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Hermes per usare la voce. Questa versione non può comunicare a Conduit se la voce è pronta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声を使用するにはHermesをアップデートしてください。このバージョンでは音声の準備ができているかどうかをConduitに伝えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성을 사용하려면 Hermes를 업데이트하세요. 이 버전은 음성이 준비됐는지 Conduit에 알려 줄 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj Hermesa, aby korzystać z trybu głosowego. Ta wersja nie potrafi przekazać Conduit, czy głos jest gotowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Hermes para usar a voz. Esta versão não consegue informar ao Conduit se a voz está pronta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите Hermes, чтобы пользоваться голосом. Эта версия не сообщает Conduit, готов ли голос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses'i kullanmak için Hermes'i güncelleyin. Bu sürüm, sesin hazır olup olmadığını Conduit'e bildiremiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 以使用语音。此版本无法告诉 Conduit 语音是否就绪。"
