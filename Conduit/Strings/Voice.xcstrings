    "Use at least two words, such as \"%@\". Add a second spelling if Conduit mishears a name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende mindestens zwei Wörter, zum Beispiel „%@“. Füge eine zweite Schreibweise hinzu, wenn Conduit einen Namen falsch versteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa al menos dos palabras, como «%@». Añade una segunda forma de escribirla si Conduit entiende mal un nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez au moins deux mots, comme « %@ ». Ajoutez une deuxième orthographe si Conduit comprend mal un nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan setidaknya dua kata, seperti “%@”. Tambahkan ejaan kedua jika Conduit salah mendengar sebuah nama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa almeno due parole, come “%@”. Aggiungi una seconda grafia se Conduit capisce male un nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のように、2語以上にしてください。Conduitが名前を聞き間違える場合は、別の表記を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”처럼 두 단어 이상을 사용하세요. Conduit이 이름을 잘못 알아들으면 다른 철자를 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj co najmniej dwóch słów, np. „%@”. Dodaj drugi zapis, jeśli Conduit źle słyszy imię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use pelo menos duas palavras, como “%@”. Adicione uma segunda grafia se o Conduit entender um nome errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте не менее двух слов, например «%@». Добавьте второе написание, если Conduit неправильно распознаёт имя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gibi en az iki sözcük kullanın. Conduit bir adı yanlış duyuyorsa ikinci bir yazım ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少使用两个词，例如“%@”。如果 Conduit 听错了名字，可以再添加一种拼写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請至少使用兩個字詞，例如「%@」。如果 Conduit 聽錯名稱，可以再加入一種拼法。"
          }
        }
      }
    },
