    "Pause only affects the microphone. Close ends the voice session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pausieren“ betrifft nur das Mikrofon. „Schließen“ beendet die Sprachsitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar solo afecta al micrófono. Cerrar finaliza la sesión de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause n'agit que sur le micro. Fermer met fin à la session vocale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda hanya memengaruhi mikrofon. Tutup mengakhiri sesi suara."
