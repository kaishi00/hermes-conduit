          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая модель не задана, поэтому Hermes сам отвечает на каждый ход и начинает говорить медленнее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
