    "Update Hermes runs hermes update on your host. Hermes restarts on the new version, and Conduit reconnects when it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hermes aktualisieren“ führt hermes update auf deinem Host aus. Hermes startet mit der neuen Version neu, und Conduit verbindet sich wieder, sobald er zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar Hermes ejecuta hermes update en tu host. Hermes se reinicia con la nueva versión y Conduit se vuelve a conectar cuando regresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour Hermes exécute hermes update sur votre hôte. Hermes redémarre sur la nouvelle version et Conduit se reconnecte à son retour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui Hermes menjalankan hermes update di host Anda. Hermes memulai ulang dengan versi baru, dan Conduit tersambung kembali saat kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Hermes esegue hermes update sul tuo host. Hermes si riavvia con la nuova versione e Conduit si riconnette quando torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Hermesを更新」はホストでhermes updateを実行します。Hermesは新しいバージョンで再起動し、戻るとConduitが再接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 업데이트는 호스트에서 hermes update를 실행합니다. Hermes가 새 버전으로 다시 시작하고, 돌아오면 Conduit가 다시 연결합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj Hermesa uruchamia hermes update na Twoim hoście. Hermes uruchomi się ponownie w nowej wersji, a Conduit połączy się ponownie po jego powrocie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
