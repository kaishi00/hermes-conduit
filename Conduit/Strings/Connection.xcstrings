    "When the sign-in page opens, it starts fresh and shows every way to sign in, such as a login code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich die Anmeldeseite öffnet, beginnt sie neu und zeigt alle Anmeldemöglichkeiten, etwa einen Anmeldecode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se abre la página de inicio de sesión, empieza de cero y muestra todas las formas de iniciar sesión, como un código de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la page de connexion s’ouvre, elle repart de zéro et affiche toutes les façons de se connecter, comme un code de connexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat halaman masuk terbuka, halaman itu dimulai dari awal dan menampilkan semua cara masuk, seperti kode masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si apre la pagina di accesso, riparte da zero e mostra tutti i modi per accedere, come un codice di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインページが開くと、最初から始まり、ログインコードなど、サインインのすべての方法が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 페이지가 열리면 새로 시작하며 로그인 코드 등 모든 로그인 방법이 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy otworzy się strona logowania, zaczyna od nowa i pokazuje wszystkie sposoby logowania, np. kod logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a página de login abre, ela começa do zero e mostra todas as formas de entrar, como um código de login."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда открывается страница входа, она начинается заново и показывает все способы входа, например код входа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma sayfası açıldığında sıfırdan başlar ve giriş kodu gibi tüm oturum açma yollarını gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
