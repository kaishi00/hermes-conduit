          }
        }
      }
    },
    "This address is your saved dashboard “%@”. Repair won't change its sign-in; switch to it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse gehört zu deinem gespeicherten Dashboard „%@“. Die Reparatur ändert seine Anmeldung nicht; wechsle stattdessen dorthin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección es tu panel guardado «%@». La reparación no cambiará su inicio de sesión; cambia a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse est celle de votre tableau de bord enregistré « %@ ». La réparation ne modifiera pas sa connexion ; basculez plutôt vers celui-ci."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat ini adalah dasbor tersimpan Anda “%@”. Perbaikan tidak akan mengubah info masuknya; beralihlah ke dasbor itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo indirizzo è la tua dashboard salvata “%@”. La riparazione non cambierà il suo accesso; passa a quella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスは保存済みのダッシュボード「%@」のものです。修復ではそのサインインは変更されません。そちらに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 저장된 대시보드 “%@”의 주소예요. 복구해도 그 로그인은 바뀌지 않으니 그 대시보드로 전환하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten adres należy do zapisanego panelu „%@”. Naprawa nie zmieni jego logowania; zamiast tego przełącz się na niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este endereço é do seu painel salvo “%@”. O reparo não altera o login dele; mude para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот адрес принадлежит сохранённому дашборду «%@». Восстановление не изменит его вход; переключитесь на него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adres kayıtlı panelin “%@” adresi. Onarım onun girişini değiştirmez; bunun yerine ona geç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址属于你已保存的仪表板“%@”。修复不会更改它的登录信息，请改为切换到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位址屬於你已儲存的儀表板「%@」。修復不會變更它的登入資訊，請改為切換到它。"
          }
        }
      }
    },
    "This address only works on the computer running Hermes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse funktioniert nur auf dem Computer, auf dem Hermes läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección solo funciona en el ordenador donde se ejecuta Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse ne fonctionne que sur l'ordinateur où tourne Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat ini hanya berfungsi di komputer yang menjalankan Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo indirizzo funziona solo sul computer su cui è in esecuzione Hermes."
          }
        },
        "ja" : {
