    "Hermes pulls the new version and restarts. Chats and messaging channels pause until it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lädt die neue Version und startet neu. Chats und Messaging-Kanäle pausieren, bis er zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes descarga la nueva versión y se reinicia. Los chats y canales de mensajería se pausan hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes récupère la nouvelle version et redémarre. Les discussions et canaux de messagerie sont en pause jusqu’à son retour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes mengambil versi baru lalu memulai ulang. Chat dan saluran pesan dijeda sampai kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes scarica la nuova versione e si riavvia. Chat e canali di messaggistica restano in pausa finché non torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesは新しいバージョンを取得して再起動します。戻るまでチャットとメッセージングチャンネルは一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 새 버전을 받아 다시 시작합니다. 돌아올 때까지 채팅과 메시징 채널이 일시정지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes pobierze nową wersję i uruchomi się ponownie. Czaty i kanały wiadomości wstrzymają się do jego powrotu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes baixa a nova versão e reinicia. Chats e canais de mensagens pausam até ele voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes загрузит новую версию и перезапустится. Чаты и каналы сообщений приостановятся до его возвращения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes yeni sürümü çeker ve yeniden başlar. Geri gelene kadar sohbetler ve mesajlaşma kanalları duraklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
