          }
        }
      }
    },
    "Detected. Hermes asks you to unlock it when it needs a login, or unlock it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannt. Hermes bittet dich ums Entsperren, wenn es ein Login braucht, oder entsperre jetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectado. Hermes te pide desbloquearlo cuando necesita un inicio de sesión, o desbloquéalo ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecté. Hermes vous demande de le déverrouiller quand il a besoin d'un identifiant, ou déverrouillez-le maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terdeteksi. Hermes memintamu membukanya saat membutuhkan login, atau buka sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevato. Hermes ti chiede di sbloccarlo quando gli serve un accesso, oppure sbloccalo ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出されました。Hermes はログインが必要になるとロック解除を求めます。今すぐ解除することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감지됨. Hermes가 로그인이 필요할 때 잠금 해제를 요청합니다. 지금 잠금 해제할 수도 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykryto. Hermes poprosi o odblokowanie, gdy będzie potrzebować loginu, albo odblokuj teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectado. O Hermes pede para desbloqueá-lo quando precisa de um login, ou desbloqueie agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаружен. Hermes попросит разблокировать его, когда понадобится вход, или разблокируйте сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algılandı. Hermes bir girişe ihtiyaç duyduğunda kilidi açmanızı ister; isterseniz şimdi açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已检测到。Hermes 需要登录信息时会请你解锁，也可以现在解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已偵測到。Hermes 需要登入資訊時會請你解鎖，也可以現在解鎖。"
          }
        }
      }
    },
