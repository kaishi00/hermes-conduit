    "Sent with every request to this server, for reverse proxies such as Pangolin, Traefik, or nginx that check a header. Values stay in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird mit jeder Anfrage an diesen Server gesendet, für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Die Werte bleiben im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envían con cada solicitud a este servidor, para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Los valores se guardan en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyés avec chaque requête à ce serveur, pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Les valeurs restent dans le trousseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikirim dengan setiap permintaan ke server ini, untuk reverse proxy seperti Pangolin, Traefik, atau nginx yang memeriksa header. Nilai disimpan di Rantai Kunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviate con ogni richiesta a questo server, per i reverse proxy come Pangolin, Traefik o nginx che controllano un'intestazione. I valori restano nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けに、このサーバへのすべてのリクエストとともに送信されます。値はキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤더를 확인하는 Pangolin, Traefik, nginx 같은 리버스 프록시를 위해 이 서버로 보내는 모든 요청에 포함돼요. 값은 키체인에 저장돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane z każdym żądaniem do tego serwera — dla odwrotnych serwerów proxy, takich jak Pangolin, Traefik czy nginx, które sprawdzają nagłówek. Wartości są przechowywane w pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviados em todas as solicitações a este servidor, para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Os valores ficam nas Chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются с каждым запросом к этому серверу — для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Значения хранятся в Связке ключей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin, Traefik veya nginx gibi bir üstbilgiyi denetleyen ters proxy'ler için bu sunucuya yapılan her istekle gönderilir. Değerler Anahtar Zinciri'nde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随发往此服务器的每个请求一起发送，用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。值保存在钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會隨著每個傳送到此伺服器的請求一起送出，適用於會檢查標頭的反向代理伺服器，例如 Pangolin、Traefik 或 nginx。值會保存在鑰匙圈中。"
          }
        }
      }
    },
