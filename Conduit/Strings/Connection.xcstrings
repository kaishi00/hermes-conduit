            "value" : "O Hermes recusou %@ (%@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes отклонил %@ (%@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes %@ isteğini reddetti (%@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 拒绝了 %@（%@）"
          }
        },
        "zh-Hant" : {
