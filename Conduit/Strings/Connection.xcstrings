    "Your Hermes server doesn't support this yet. Update Hermes, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes-Server unterstützt das noch nicht. Aktualisiere Hermes und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor Hermes aún no admite esto. Actualiza Hermes y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Hermes ne prend pas encore cela en charge. Mettez à jour Hermes, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
