    "Your dashboard couldn't reach Hermes. Hermes may be restarting, so try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dashboard konnte Hermes nicht erreichen. Hermes startet möglicherweise gerade neu – versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu panel no pudo conectar con Hermes. Puede que Hermes se esté reiniciando, así que vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre tableau de bord n'a pas pu joindre Hermes. Hermes est peut-être en train de redémarrer : réessayez dans un instant."
