            "state" : "translated",
            "value" : "Instálalo en Ajustes del Sistema → General → Gestión de dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-le dans Réglages Système → Général → Gestion des appareils."
          }
        },
        "id" : {
