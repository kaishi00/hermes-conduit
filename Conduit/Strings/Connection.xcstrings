    "The connection to Hermes dropped. Conduit reconnects on its own, so try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zu Hermes ist abgebrochen. Conduit verbindet sich automatisch neu – versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cortó la conexión con Hermes. Conduit se reconecta solo, así que vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à Hermes a été coupée. Conduit se reconnecte tout seul : réessayez dans un instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ke Hermes terputus. Conduit akan terhubung ulang dengan sendirinya, jadi coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione a Hermes si è interrotta. Conduit si riconnette da solo, quindi riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesとの接続が切断されました。Conduitは自動的に再接続するので、しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes와의 연결이 끊어졌어요. Conduit이 자동으로 다시 연결되니 잠시 후 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie z Hermesem zostało przerwane. Conduit połączy się ponownie samodzielnie, więc spróbuj za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o Hermes caiu. O Conduit reconecta sozinho, então tente novamente daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с Hermes прервалось. Conduit переподключится сам — повторите попытку чуть позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bağlantısı koptu. Conduit kendiliğinden yeniden bağlanır; biraz sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Hermes 的连接已断开。Conduit 会自动重新连接，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 Hermes 的連線已中斷。Conduit 會自動重新連線，請稍後再試。"
          }
        }
      }
    },
    "The dashboard address isn't valid. Check it in Settings > Connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
