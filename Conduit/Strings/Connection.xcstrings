          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l'appareil photo vers le code affiché par Hermes. Pour une adresse affichée en texte, touchez-la."
          }
        },
        "id" : {
          "stringUnit" : {
