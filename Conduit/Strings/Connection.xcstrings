    "Server refused access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server hat den Zugriff verweigert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor denegó el acceso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé l’accès"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server menolak akses"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha negato l’accesso"
          }
        },
