    "Pick how Conduit should reach your self-hosted Hermes dashboard. You can change this later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Conduit dein selbst gehostetes Hermes-Dashboard erreichen soll. Du kannst das später ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo debe acceder Conduit a tu panel de Hermes autoalojado. Puedes cambiarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez comment Conduit doit joindre votre tableau de bord Hermes auto-hébergé. Vous pourrez modifier ce choix plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih cara Conduit menjangkau dasbor Hermes yang Anda hosting sendiri. Anda dapat mengubahnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
