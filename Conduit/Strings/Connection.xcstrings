            "value" : "W Hermesie wtyczka %1$@ jest wyłączona. Na hoście Hermesa uruchom hermes plugins enable %2$@, a potem uruchom Hermesa ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes está com o plugin %1$@ desativado. No host do Hermes, execute hermes plugins enable %2$@ e reinicie o Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Hermes плагин %1$@ выключен. На хосте Hermes выполните hermes plugins enable %2$@, затем перезапустите Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'te %1$@ eklentisi kapalı. Hermes ana makinesinde hermes plugins enable %2$@ komutunu çalıştırın, ardından Hermes'i yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 已关闭 %1$@ 插件。请在 Hermes 主机上运行 hermes plugins enable %2$@，然后重启 Hermes。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 已關閉 %1$@ 外掛。請在 Hermes 主機上執行 hermes plugins enable %2$@，然後重新啟動 Hermes。"
          }
