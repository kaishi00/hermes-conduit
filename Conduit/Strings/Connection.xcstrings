    "Need access away from home without existing remote access? Choose Tailscale — the simplest secure option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauchst du Zugriff von unterwegs, ohne bereits einen Fernzugriff zu haben? Wähle Tailscale – die einfachste sichere Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Necesitas acceso fuera de casa y no tienes acceso remoto? Elige Tailscale, la opción segura más sencilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besoin d'un accès hors de chez vous sans accès à distance existant ? Choisissez Tailscale, l'option sécurisée la plus simple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlu akses dari luar rumah tanpa akses jarak jauh yang sudah ada? Pilih Tailscale — opsi aman yang paling sederhana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti serve l'accesso fuori casa senza un accesso remoto già attivo? Scegli Tailscale, l'opzione sicura più semplice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出先からアクセスする必要があり、リモートアクセスの環境がまだない場合は、Tailscaleを選んでください。最も簡単で安全な方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 원격 접속 없이 집 밖에서 접근해야 하나요? 가장 간단하고 안전한 옵션인 Tailscale을 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebujesz dostępu poza domem, a nie masz zdalnego dostępu? Wybierz Tailscale — najprostszą bezpieczną opcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa de acesso fora de casa e não tem acesso remoto? Escolha o Tailscale — a opção segura mais simples."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен доступ вне дома, а удалённого доступа ещё нет? Выберите Tailscale — самый простой безопасный вариант."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut bir uzaktan erişiminiz olmadan evden uzakta erişim mi gerekiyor? En basit güvenli seçenek olan Tailscale'i seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出时需要访问、又没有现成的远程访问？选择 Tailscale——最简单的安全方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不在家時需要存取，又沒有現成的遠端存取方式嗎？請選擇 Tailscale：最簡單的安全選項。"
          }
        }
      }
    },
    "Network & reachability" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
