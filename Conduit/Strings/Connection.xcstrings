    "The sign-in page can remember your account. Turn this on if you need another way to sign in, such as a login code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldeseite kann sich dein Konto merken. Schalte dies ein, wenn du dich anders anmelden musst, etwa mit einem Anmeldecode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página de inicio de sesión puede recordar tu cuenta. Actívalo si necesitas iniciar sesión de otra forma, como con un código de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page de connexion peut mémoriser votre compte. Activez ceci s’il vous faut une autre façon de vous connecter, comme un code de connexion."
