    "Unlocked for this session. Locks itself after 30 minutes idle or when Hermes closes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Sitzung entsperrt. Sperrt sich nach 30 Minuten Inaktivität oder wenn Hermes beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueado para esta sesión. Se bloquea solo tras 30 minutos sin uso o al cerrarse Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillé pour cette session. Se verrouille après 30 minutes d'inactivité ou à la fermeture de Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terbuka untuk sesi ini. Terkunci sendiri setelah 30 menit tidak aktif atau saat Hermes ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbloccato per questa sessione. Si blocca da solo dopo 30 minuti di inattività o alla chiusura di Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションの間はロック解除されています。30 分間操作がないか、Hermes が終了すると自動的にロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션 동안 잠금 해제되었습니다. 30분 동안 사용하지 않거나 Hermes가 종료되면 자동으로 잠깁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokowany na tę sesję. Zablokuje się sam po 30 minutach bezczynności lub po zamknięciu Hermesa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueado nesta sessão. Bloqueia sozinho após 30 minutos sem uso ou quando o Hermes fecha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокирован на этот сеанс. Заблокируется сам через 30 минут бездействия или при закрытии Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum için kilidi açık. 30 dakika boşta kalınca veya Hermes kapanınca kendiliğinden kilitlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次会话已解锁。闲置 30 分钟或 Hermes 关闭时会自动锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次工作階段已解鎖。閒置 30 分鐘或 Hermes 關閉時會自動鎖定。"
          }
        }
      }
    },
