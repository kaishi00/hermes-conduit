    "The certificate must name the exact address you entered, as a host name or IP address in its Subject Alternative Name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat muss genau die eingegebene Adresse nennen, als Hostname oder IP-Adresse im Subject Alternative Name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado debe incluir exactamente la dirección que escribiste, como nombre de host o dirección IP en su Subject Alternative Name."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat doit indiquer exactement l’adresse saisie, sous forme de nom d’hôte ou d’adresse IP dans son Subject Alternative Name."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertifikat harus mencantumkan alamat persis yang Anda masukkan, sebagai nama host atau alamat IP di Subject Alternative Name-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il certificato deve indicare esattamente l’indirizzo inserito, come nome host o indirizzo IP nel suo Subject Alternative Name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書には、入力したアドレスそのものが、Subject Alternative Nameのホスト名またはIPアドレスとして含まれている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증서에는 입력한 주소가 Subject Alternative Name의 호스트 이름이나 IP 주소로 정확히 포함되어야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certyfikat musi zawierać dokładnie wpisany adres, jako nazwę hosta lub adres IP w polu Subject Alternative Name."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado precisa conter exatamente o endereço digitado, como nome de host ou endereço IP no Subject Alternative Name."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат должен содержать именно тот адрес, который вы ввели, как имя хоста или IP-адрес в Subject Alternative Name."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertifika, girdiğiniz adresi tam olarak, Subject Alternative Name içinde ana bilgisayar adı veya IP adresi olarak içermelidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证书必须在其 Subject Alternative Name 中以主机名或 IP 地址的形式包含你输入的确切地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑證必須在其 Subject Alternative Name 中，以主機名稱或 IP 位址的形式包含你輸入的確切位址。"
          }
        }
      }
    },
