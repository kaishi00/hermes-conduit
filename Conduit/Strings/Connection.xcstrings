          }
        }
      }
    },
    "Not detected. Install the %@ command-line tool on the Hermes computer and sign in to it; Hermes picks it up automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erkannt. Installiere das Befehlszeilentool von %@ auf dem Hermes-Computer und melde dich dort an; Hermes erkennt es automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No detectado. Instala la herramienta de línea de comandos de %@ en el ordenador de Hermes e inicia sesión en ella; Hermes la detecta automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non détecté. Installez l'outil en ligne de commande de %@ sur l'ordinateur de Hermes et connectez-vous-y ; Hermes le détecte automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak terdeteksi. Pasang alat baris perintah %@ di komputer Hermes dan masuk ke dalamnya; Hermes akan mengenalinya otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non rilevato. Installa lo strumento da riga di comando di %@ sul computer di Hermes e accedi; Hermes lo rileva da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未検出です。Hermes のコンピュータに %@ のコマンドラインツールをインストールしてサインインすると、Hermes が自動的に検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감지되지 않았습니다. Hermes 컴퓨터에 %@ 명령줄 도구를 설치하고 로그인하면 Hermes가 자동으로 감지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wykryto. Zainstaluj narzędzie wiersza poleceń %@ na komputerze Hermesa i zaloguj się w nim; Hermes wykryje je automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não detectado. Instale a ferramenta de linha de comando do %@ no computador do Hermes e entre nela; o Hermes a reconhece automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не обнаружен. Установите инструмент командной строки %@ на компьютер Hermes и войдите в него — Hermes найдёт его сам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algılanmadı. %@ komut satırı aracını Hermes bilgisayarına kurun ve oturum açın; Hermes onu kendiliğinden algılar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未检测到。请在 Hermes 的电脑上安装 %@ 命令行工具并登录；Hermes 会自动识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未偵測到。請在 Hermes 的電腦上安裝 %@ 命令列工具並登入；Hermes 會自動辨識。"
          }
        }
      }
    },
    "Nothing saved yet. You don't have to add anything: Hermes asks for a login the first time it needs one. Use Add to enter one ahead of time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts gespeichert. Du musst nichts hinzufügen: Hermes fragt nach einem Login, wenn es zum ersten Mal eines braucht. Mit Hinzufügen kannst du eines vorab eintragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada guardado. No tienes que añadir nada: Hermes pide un inicio de sesión la primera vez que lo necesita. Usa Añadir para introducir uno por adelantado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d'enregistré pour l'instant. Vous n'avez rien à ajouter : Hermes demande un identifiant la première fois qu'il en a besoin. Utilisez Ajouter pour en saisir un à l'avance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada yang tersimpan. Kamu tidak perlu menambahkan apa pun: Hermes meminta login saat pertama kali membutuhkannya. Gunakan Tambah untuk memasukkannya lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente di salvato. Non devi aggiungere nulla: Hermes chiede un accesso la prima volta che gli serve. Usa Aggiungi per inserirne uno in anticipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も保存されていません。追加は必須ではありません。Hermes は初めてログインが必要になったときに尋ねます。事前に入力するには「追加」を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 저장된 항목이 없습니다. 아무것도 추가하지 않아도 됩니다. Hermes는 처음으로 로그인이 필요할 때 물어봅니다. 미리 입력하려면 추가를 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jeszcze nie zapisano. Nie musisz niczego dodawać: Hermes zapyta o login, gdy pierwszy raz będzie go potrzebować. Użyj Dodaj, aby wpisać go wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada salvo ainda. Você não precisa adicionar nada: o Hermes pede um login na primeira vez que precisa. Use Adicionar para cadastrar um antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не сохранено. Добавлять ничего не нужно: Hermes спросит данные для входа, когда они впервые понадобятся. Кнопка «Добавить» позволяет ввести их заранее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz kayıtlı bir şey yok. Bir şey eklemeniz gerekmez: Hermes ilk kez ihtiyaç duyduğunda giriş bilgisini sorar. Önceden girmek için Ekle'yi kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有保存任何内容。你无需添加：Hermes 第一次需要登录信息时会询问你。如需提前填写，请使用“添加”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有儲存任何內容。你不必新增：Hermes 第一次需要登入資訊時會詢問你。如需事先填寫，請使用「新增」。"
          }
        }
      }
    },
