    },
    "Conduit manages this header itself, so it can't be set here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verwaltet diesen Header selbst, daher kann er hier nicht festgelegt werden."
