    "Tailscale gives you secure access from anywhere, including the recommended Tailscale Serve path:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale bietet dir sicheren Zugriff von überall, einschließlich des empfohlenen Wegs über Tailscale Serve:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale te da acceso seguro desde cualquier lugar, incluida la ruta recomendada de Tailscale Serve:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale vous offre un accès sécurisé depuis n'importe où, notamment via la méthode Tailscale Serve recommandée :"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale memberi Anda akses aman dari mana saja, termasuk jalur Tailscale Serve yang direkomendasikan:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale ti offre un accesso sicuro da ovunque, incluso il percorso consigliato Tailscale Serve:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscaleを使うと、推奨されるTailscale Serve経由も含め、どこからでも安全にアクセスできます："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale을 사용하면 권장되는 Tailscale Serve 경로를 포함해 어디서든 안전하게 접근할 수 있어요:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale zapewnia bezpieczny dostęp z dowolnego miejsca, także przez zalecaną ścieżkę Tailscale Serve:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tailscale oferece acesso seguro de qualquer lugar, incluindo o caminho recomendado com o Tailscale Serve:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale даёт безопасный доступ откуда угодно, в том числе через рекомендуемый вариант Tailscale Serve:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale, önerilen Tailscale Serve yolu da dahil olmak üzere her yerden güvenli erişim sağlar:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 让你从任何地点安全访问，包括推荐的 Tailscale Serve 路径："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 讓你從任何地方都能安全存取，包括建議的 Tailscale Serve 方式："
          }
        }
      }
    },
