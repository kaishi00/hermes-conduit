    "Saved encrypted on the Hermes computer. Conduit keeps none of it and never shows it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselt auf dem Hermes-Computer gespeichert. Conduit behält nichts davon und zeigt es nie wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda cifrado en el ordenador de Hermes. Conduit no conserva nada y no vuelve a mostrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré chiffré sur l'ordinateur de Hermes. Conduit n'en garde rien et ne l'affiche plus jamais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan terenkripsi di komputer Hermes. Conduit tidak menyimpan apa pun darinya dan tidak pernah menampilkannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato cifrato sul computer di Hermes. Conduit non ne conserva nulla e non lo mostra più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes のコンピュータに暗号化して保存されます。Conduit は何も保持せず、二度と表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 컴퓨터에 암호화되어 저장됩니다. Conduit는 아무것도 보관하지 않으며 다시 표시하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane w postaci zaszyfrowanej na komputerze Hermesa. Conduit niczego nie zachowuje i nigdy więcej tego nie pokazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo com criptografia no computador do Hermes. O Conduit não guarda nada e nunca mais mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится в зашифрованном виде на компьютере Hermes. Conduit ничего не сохраняет и больше это не показывает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bilgisayarında şifreli olarak saklanır. Conduit hiçbirini tutmaz ve bir daha göstermez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以加密形式保存在 Hermes 的电脑上。Conduit 不保留任何内容，也不会再次显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以加密形式保存在 Hermes 的電腦上。Conduit 不保留任何內容，也不會再次顯示。"
          }
        }
      }
    },
