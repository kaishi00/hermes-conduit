    "Install it in System Settings → General → Device Management." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere es unter Systemeinstellungen → Allgemein → Geräteverwaltung."
          }
        },
        "es" : {
