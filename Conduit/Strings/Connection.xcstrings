        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin %1$@ dinonaktifkan di Hermes. Di host Hermes, jalankan hermes plugins enable %2$@, lalu mulai ulang Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Hermes il plugin %1$@ è disattivato. Sull'host di Hermes esegui hermes plugins enable %2$@, poi riavvia Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes で %1$@ プラグインがオフになっています。Hermes のホストで hermes plugins enable %2$@ を実行してから、Hermes を再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes에서 %1$@ 플러그인이 꺼져 있습니다. Hermes 호스트에서 hermes plugins enable %2$@을(를) 실행한 다음 Hermes를 다시 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
