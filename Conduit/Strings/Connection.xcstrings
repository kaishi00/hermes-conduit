          }
        }
      }
    },
    "Hermes Conduit connects to a Hermes dashboard you (or your assistant) run yourself. The dashboard has to be up before Conduit can reach it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit verbindet sich mit einem Hermes-Dashboard, das du (oder dein Assistent) selbst betreibst. Das Dashboard muss laufen, bevor Conduit es erreichen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit se conecta a un panel de Hermes que ejecutas tú mismo (o tu asistente). El panel tiene que estar en marcha para que Conduit pueda acceder a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit se connecte à un tableau de bord Hermes que vous (ou votre assistant) exécutez vous-même. Le tableau de bord doit être actif pour que Conduit puisse le joindre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit terhubung ke dasbor Hermes yang Anda (atau asisten Anda) jalankan sendiri. Dasbor harus aktif sebelum Conduit dapat menjangkaunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit si connette a una dashboard Hermes che esegui tu (o il tuo assistente). La dashboard deve essere attiva prima che Conduit possa raggiungerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduitは、ご自身（またはアシスタント）が運用するHermesダッシュボードに接続します。Conduitから接続するには、ダッシュボードが起動している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit은 사용자(또는 사용자의 어시스턴트)가 직접 운영하는 Hermes 대시보드에 연결해요. Conduit이 접근하려면 대시보드가 실행 중이어야 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit łączy się z panelem Hermes, który uruchamiasz samodzielnie (lub robi to Twój asystent). Panel musi działać, zanim Conduit będzie mógł się z nim połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes Conduit se conecta a um painel do Hermes que você (ou seu assistente) executa. O painel precisa estar no ar para que o Conduit consiga acessá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit подключается к дашборду Hermes, который вы (или ваш ассистент) запускаете сами. Дашборд должен работать, чтобы Conduit мог к нему подключиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit, sizin (veya asistanınızın) kendi çalıştırdığı bir Hermes paneline bağlanır. Conduit'in ona ulaşabilmesi için panelin çalışıyor olması gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit 连接的是你自己（或你的智能体）运行的 Hermes 仪表盘。仪表盘必须先启动，Conduit 才能访问它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit 會連線到由你（或你的助理）自行執行的 Hermes 儀表板。儀表板必須先啟動，Conduit 才能連上。"
          }
        }
      }
    },
