            "value" : "Conduit verwendet Face ID, um gespeicherte Hermes-Zugangsdaten zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses Face ID to unlock saved Hermes credentials."
          }
        },
