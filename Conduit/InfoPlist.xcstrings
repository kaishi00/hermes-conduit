    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sichert Bilder und Videos aus deinen Chats in „Fotos“, wenn du im Teilen-Menü „Bild sichern“ oder „Video sichern“ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit saves images and videos from your chats to Photos when you choose Save in the share sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit guarda en Fotos las imágenes y los videos de tus chats cuando eliges «Guardar» en el menú Compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit enregistre les images et vidéos de vos discussions dans Photos lorsque vous choisissez Enregistrer dans le menu de partage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有シートで「保存」を選ぶと、Conduitはチャット内の画像やビデオを「写真」に保存します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit salva imagens e vídeos dos seus chats em Fotos quando você escolhe Salvar no menu Compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit сохраняет фото и видео из ваших чатов в «Фото», когда вы выбираете «Сохранить» в меню «Поделиться»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在分享菜单中选择存储时，Conduit 会将聊天中的图片和视频保存到“照片”。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verwendet die Apple-Spracherkennung auf dem Gerät, um deine Sprache in Text umzuwandeln, wenn du „Auf diesem iPhone“ auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses on-device Apple speech recognition to turn your voice into text when you select On this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa el reconocimiento de voz de Apple en el dispositivo para convertir tu voz en texto cuando eliges «En este iPhone»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit utilise la reconnaissance vocale d'Apple sur l'appareil pour transformer votre voix en texte lorsque vous sélectionnez Sur cet iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このiPhone上」を選択すると、ConduitはデバイスでAppleの音声認識を使用して、話した内容をテキストに変換します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit usa o reconhecimento de fala da Apple no aparelho para transformar sua voz em texto quando você seleciona Neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit использует распознавание речи Apple на устройстве, чтобы преобразовывать ваш голос в текст, если выбран вариант «На этом iPhone»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择「在这台 iPhone 上」时，Conduit 使用 Apple 设备端语音识别将你的语音转换为文字。"
          }
        }
      }
    }
