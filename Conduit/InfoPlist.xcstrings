          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses Face ID to unlock saved Hermes credentials."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 使用面容 ID 解锁已保存的 Hermes 凭据。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses the microphone for voice conversations and foreground wake phrases."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 在语音对话和前台唤醒词场景中使用麦克风。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit saves images and videos from your chats to Photos when you choose Save in the share sheet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在分享菜单中选择存储时，Conduit 会将聊天中的图片和视频保存到“照片”。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses on-device Apple speech recognition to turn your voice into text when you select On this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择「在这台 iPhone 上」时，Conduit 使用 Apple 设备端语音识别将你的语音转换为文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
