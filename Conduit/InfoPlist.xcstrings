    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Erinnerungen teilst, sendet Conduit die von dir gewählten Listen an deinen eigenen Hermes-Server, damit dein Agent sieht, was darauf steht, und fügt Erinnerungen hinzu oder erledigt sie, wenn du zustimmst. Nichts davon geht an den Entwickler von Conduit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you share reminders, Conduit sends the lists you choose to your own Hermes server so your agent can see what's on them, and adds or completes reminders when you approve them. Nothing goes to Conduit's developer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando compartes recordatorios, Conduit envía las listas que elijas a tu propio servidor Hermes para que tu agente pueda ver lo que contienen, y añade o completa recordatorios cuando los apruebas. Nada se envía al desarrollador de Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous partagez vos rappels, Conduit envoie les listes que vous choisissez à votre propre serveur Hermes pour que votre agent puisse voir leur contenu, et ajoute ou termine des rappels lorsque vous les approuvez. Rien n'est envoyé au développeur de Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda membagikan pengingat, Conduit mengirim daftar yang Anda pilih ke server Hermes Anda sendiri agar agen Anda dapat melihat isinya, serta menambahkan atau menyelesaikan pengingat saat Anda menyetujuinya. Tidak ada yang dikirim ke developer Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando condividi i promemoria, Conduit invia gli elenchi che scegli al tuo server Hermes per permettere al tuo agente di vederne il contenuto, e aggiunge o completa promemoria quando li approvi. Nulla viene inviato allo sviluppatore di Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーを共有すると、Conduitは選択したリストをあなた自身のHermesサーバに送信し、エージェントがその内容を確認できるようにします。また、あなたが承認したリマインダーを追加または完了にします。Conduitの開発者には何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림을 공유하면 Conduit이 선택한 목록을 사용자의 Hermes 서버로 보내 에이전트가 내용을 볼 수 있게 하고, 승인한 미리 알림을 추가하거나 완료해요. Conduit 개발자에게는 아무것도 전송되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy udostępniasz przypomnienia, Conduit wysyła wybrane listy na Twój własny serwer Hermes, aby agent widział, co na nich jest, oraz dodaje lub oznacza przypomnienia jako wykonane, gdy je zatwierdzisz. Nic nie trafia do dewelopera Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você compartilha lembretes, o Conduit envia as listas que você escolher para o seu próprio servidor Hermes para que seu agente possa ver o que há nelas, e adiciona ou conclui lembretes quando você os aprova. Nada é enviado ao desenvolvedor do Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы делитесь напоминаниями, Conduit отправляет выбранные списки на ваш собственный сервер Hermes, чтобы агент видел их содержимое, а также добавляет или завершает напоминания, когда вы это одобряете. Разработчику Conduit ничего не передаётся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anımsatıcılarınızı paylaştığınızda Conduit, ajanınızın içeriklerini görebilmesi için seçtiğiniz listeleri kendi Hermes sunucunuza gönderir ve onayladığınız anımsatıcıları ekler veya tamamlar. Conduit'in geliştiricisine hiçbir şey gitmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你共享提醒事项时，Conduit 会将你选择的列表发送到你自己的 Hermes 服务器，以便你的代理查看其中的内容，并在你批准后添加或完成提醒事项。不会向 Conduit 的开发者发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你分享提醒事項時，Conduit 會將你選擇的列表傳送到你自己的 Hermes 伺服器，讓你的代理查看其中的內容，並在你核准後加入或完成提醒事項。不會傳送任何內容給 Conduit 的開發者。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verwendet die Apple-Spracherkennung auf dem Gerät, um deine Sprache in Text umzuwandeln, wenn du „Auf diesem iPhone“ auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses on-device Apple speech recognition to turn your voice into text when you select On this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa el reconocimiento de voz de Apple en el dispositivo para convertir tu voz en texto cuando eliges «En este iPhone»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit utilise la reconnaissance vocale d'Apple sur l'appareil pour transformer votre voix en texte lorsque vous sélectionnez Sur cet iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit menggunakan pengenalan ucapan Apple di perangkat untuk mengubah suara Anda menjadi teks saat Anda memilih Di iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa il riconoscimento vocale di Apple sul dispositivo per trasformare la tua voce in testo quando selezioni Su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このiPhone上」を選択すると、ConduitはデバイスでAppleの音声認識を使用して、話した内容をテキストに変換します。"
