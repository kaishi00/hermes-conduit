    "Speech Recognition permission was denied. Please enable it in Settings > Conduit > Speech Recognition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigung für Spracherkennung wurde verweigert. Aktiviere sie unter „Einstellungen“ > „Conduit“ > „Spracherkennung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
