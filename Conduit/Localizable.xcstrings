    "These questions are no longer active — Hermes timed them out and continued." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fragen sind nicht mehr aktiv – Hermes hat das Zeitlimit erreicht und weitergemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas preguntas ya no están activas: Hermes agotó su tiempo de espera y continuó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces questions ne sont plus actives : Hermes a cessé d'attendre et a continué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertanyaan-pertanyaan ini sudah tidak aktif — waktu tunggu Hermes habis dan Hermes melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste domande non sono più attive: il tempo è scaduto e Hermes ha continuato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの質問は無効になりました。Hermesがタイムアウトにして処理を続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 질문들은 더 이상 활성 상태가 아니에요 — Hermes가 시간 초과 처리하고 계속 진행했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te pytania nie są już aktywne — czas na odpowiedź minął i Hermes kontynuował."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas perguntas não estão mais ativas — o tempo delas esgotou e o Hermes continuou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти вопросы больше не активны — время ожидания истекло, и Hermes продолжил работу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sorular artık etkin değil — Hermes süreyi doldurdu ve devam etti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些问题已失效——Hermes 已超时并继续执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些問題已失效：Hermes 已逾時並繼續進行。"
          }
        }
      }
    },
    "These settings can’t be used yet. Go Back to edit them, then return here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen können noch nicht verwendet werden. Gehe „Zurück“, um sie zu bearbeiten, und kehre dann hierher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes aún no se pueden usar. Vuelve Atrás para editarlos y luego regresa aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages ne peuvent pas encore être utilisés. Revenez en arrière pour les modifier, puis revenez ici."
          }
        },
        "id" : {
          "stringUnit" : {
