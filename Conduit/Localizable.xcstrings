    "Small things too: six reminders a day, and promises checked sooner." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Kleinigkeiten: sechs Erinnerungen am Tag, Versprechen früher geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También lo pequeño: seis recordatorios al día y promesas revisadas antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petites choses aussi : six rappels par jour, promesses vérifiées plus tôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal kecil juga: enam pengingat sehari, janji dicek lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche le piccole cose: sei promemoria al giorno, promesse controllate prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなことも：リマインダーは1日6件、約束を早めに確認。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 일도: 하루 6개의 리마인더, 약속을 더 일찍 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Także drobiazgi: sześć przypomnień dziennie, obietnice sprawdzane wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coisas pequenas também: seis lembretes por dia e promessas verificadas mais cedo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "И мелочи тоже: шесть напоминаний в день, обещания проверяются раньше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük şeyler de: günde altı hatırlatma, sözler daha erken kontrol edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小事也提：每天六条提醒，承诺检查得更早。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小事也提：每天六則提醒，承諾檢查得更早。"
          }
        }
      }
