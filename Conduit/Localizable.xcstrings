    "Enter the Tailscale hostname or address Hermes gave you. Tailscale Serve hostnames use HTTPS; leave the port blank unless Hermes supplied one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den Tailscale-Hostnamen oder die Adresse ein, die Hermes dir genannt hat. Tailscale-Serve-Hostnamen verwenden HTTPS; lass den Port leer, sofern Hermes keinen angegeben hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el nombre de host o la dirección de Tailscale que te dio Hermes. Los nombres de host de Tailscale Serve usan HTTPS; deja el puerto vacío a menos que Hermes te haya dado uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le nom d'hôte ou l'adresse Tailscale fournis par Hermes. Les noms d'hôte Tailscale Serve utilisent HTTPS ; laissez le port vide sauf si Hermes vous en a fourni un."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesから提供されたTailscaleのホスト名またはアドレスを入力してください。Tailscale Serveのホスト名はHTTPSを使用します。Hermesからポートが提供されていない限り、ポートは空欄のままにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o nome do host ou o endereço do Tailscale que o Hermes informou. Os nomes de host do Tailscale Serve usam HTTPS; deixe a porta em branco, a menos que o Hermes tenha informado uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
