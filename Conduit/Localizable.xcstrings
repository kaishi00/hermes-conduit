          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como IDEA.md na primeira pasta, igual ao Hermes Desktop."
          }
        },
        "ru" : {
          "stringUnit" : {
