    "Automatically listens again after each response. Turn off to start each listening turn manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört nach jeder Antwort automatisch wieder zu. Schalte dies aus, um jedes Zuhören manuell zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a escuchar automáticamente tras cada respuesta. Desactívalo para iniciar cada turno de escucha manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se remet à écouter automatiquement après chaque réponse. Désactivez cette option pour lancer chaque tour d'écoute manuellement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendengarkan lagi secara otomatis setelah setiap respons. Matikan untuk memulai setiap giliran mendengarkan secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende automaticamente ad ascoltare dopo ogni risposta. Disattiva l'opzione per avviare manualmente ogni turno di ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答のたびに自動で聞き取りを再開します。オフにすると、毎回手動で聞き取りを開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답할 때마다 자동으로 다시 들어요. 끄면 듣기 턴을 매번 직접 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie zaczyna ponownie słuchać po każdej odpowiedzi. Wyłącz, aby za każdym razem uruchamiać słuchanie ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta a ouvir automaticamente após cada resposta. Desative para iniciar cada turno de escuta manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически снова слушает после каждого ответа. Выключите, чтобы начинать каждое прослушивание вручную."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yanıttan sonra otomatik olarak yeniden dinler. Her dinleme turunu elle başlatmak için kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次回复后自动重新聆听。关闭后，每轮聆听需手动开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次回應後自動再次聆聽。關閉後，每次聆聽都需要手動開始。"
          }
        }
      }
    },
