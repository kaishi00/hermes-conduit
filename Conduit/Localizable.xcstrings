    "Applying saves these settings for your next reconnect. Your current session stays connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Anwenden werden diese Einstellungen für deine nächste Neuverbindung gesichert. Deine aktuelle Sitzung bleibt verbunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aplicar, estos ajustes se guardan para tu próxima reconexión. Tu sesión actual sigue conectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer enregistre ces réglages pour votre prochaine reconnexion. Votre session actuelle reste connectée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerapkan akan menyimpan pengaturan ini untuk koneksi ulang berikutnya. Sesi Anda saat ini tetap terhubung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicando, queste impostazioni vengono salvate per la prossima riconnessione. La sessione attuale resta connessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用すると、これらの設定は次回の再接続時に使用されます。現在のセッションは接続されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적용하면 이 설정은 다음 재연결 때 사용돼요. 현재 세션은 연결된 상태로 유지돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastosowanie zapisuje te ustawienia na potrzeby następnego ponownego połączenia. Bieżąca sesja pozostaje połączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar salva estes ajustes para a próxima reconexão. Sua sessão atual continua conectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При применении эти настройки сохраняются для следующего переподключения. Текущий сеанс остаётся подключённым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamak, bu ayarları sonraki yeniden bağlanmanız için kaydeder. Mevcut oturumunuz bağlı kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用后将保存这些设置，供下次重连使用。当前会话保持连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
