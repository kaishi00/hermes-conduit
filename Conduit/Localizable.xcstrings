    "This removes %@ from Hermes. Its folders, files and conversations are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird %@ aus Hermes entfernt. Ordner, Dateien und Unterhaltungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita %@ de Hermes. Sus carpetas, archivos y conversaciones se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action retire %@ d'Hermes. Ses dossiers, fichiers et conversations sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghapus %@ dari Hermes. Folder, file, dan percakapannya tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione rimuove %@ da Hermes. Le sue cartelle, i file e le conversazioni vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesから「%@」を削除します。フォルダ、ファイル、チャットは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes에서 %@ 프로젝트를 제거해요. 폴더, 파일, 대화는 그대로 유지돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie projektu „%@” z Hermesa. Jego foldery, pliki i rozmowy zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove %@ do Hermes. As pastas, os arquivos e as conversas dele são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проект %@ будет удалён из Hermes. Его папки, файлы и чаты сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %@ projesini Hermes'ten kaldırır. Klasörleri, dosyaları ve konuşmaları korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从 Hermes 中移除“%@”。其文件夹、文件和对话都会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 Hermes 移除「%@」。其資料夾、檔案和對話都會保留。"
          }
        }
      }
    },
    "Opens the conversations in this project. Swipe or touch and hold to rename or delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Unterhaltungen in diesem Projekt. Streiche oder halte gedrückt, um es umzubenennen oder zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre las conversaciones de este proyecto. Desliza o mantén pulsado para cambiarle el nombre o eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre les conversations de ce projet. Balayez ou maintenez le doigt dessus pour le renommer ou le supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka percakapan di proyek ini. Gesek atau sentuh dan tahan untuk mengganti nama atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre le conversazioni di questo progetto. Scorri o tieni premuto per rinominarlo o eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクト内のチャットを開きます。スワイプまたは長押しで名前の変更や削除ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트의 대화를 열어요. 이름을 변경하거나 삭제하려면 쓸어넘기거나 길게 터치하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera rozmowy w tym projekcie. Przesuń lub dotknij i przytrzymaj, aby zmienić jego nazwę lub go usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre as conversas deste projeto. Deslize ou mantenha pressionado para renomeá-lo ou apagá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает чаты этого проекта. Смахните или коснитесь и удерживайте, чтобы переименовать или удалить его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu projedeki konuşmaları açar. Yeniden adlandırmak veya silmek için kaydırın ya da basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开此项目中的对话。轻扫或长按可重命名或删除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開此專案中的對話。滑動或按住即可重新命名或刪除。"
          }
        }
      }
    },
    "Could not delete %@: Conduit is not connected to Hermes." : {
      "localizations" : {
