    "Conduit couldn't reach Hermes. Your screenshot is kept and will be attached to a chat when Hermes is back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte Hermes nicht erreichen. Dein Bildschirmfoto bleibt erhalten und wird an einen Chat angehängt, sobald Hermes wieder da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo conectar con Hermes. Tu captura de pantalla se conserva y se adjuntará a un chat cuando Hermes vuelva a estar disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu joindre Hermes. Votre capture d'écran est conservée et sera jointe à une discussion dès qu'Hermes sera de retour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat menghubungi Hermes. Jepretan layar Anda disimpan dan akan dilampirkan ke obrolan saat Hermes tersedia kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a raggiungere Hermes. La tua istantanea è conservata e verrà allegata a una chat quando Hermes sarà di nuovo disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ConduitがHermesに接続できませんでした。スクリーンショットは保持され、Hermesが復帰したらチャットに添付されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 Hermes에 연결할 수 없어요. 스크린샷은 그대로 유지되며 Hermes가 다시 연결되면 채팅에 첨부돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł połączyć się z Hermesem. Zrzut ekranu został zachowany i zostanie załączony do czatu, gdy Hermes wróci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu acessar o Hermes. Sua captura de tela foi guardada e será anexada a um chat quando o Hermes voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось связаться с Hermes. Снимок экрана сохранён и будет прикреплён к чату, когда Hermes снова станет доступен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, Hermes'e ulaşamadı. Ekran görüntünüz saklanıyor ve Hermes geri geldiğinde bir sohbete eklenecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法连接 Hermes。你的截图已保留，Hermes 恢复后会附加到对话中。"
