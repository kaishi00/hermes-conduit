          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 문구가 입력된 새 채팅을 열어요. 보내면 Hermes가 답할 때 iPhone이 울려요."
          }
        },
        "pl" : {
