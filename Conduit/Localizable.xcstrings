    "Used if you dismiss the session list without choosing another conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, wenn du die Sitzungsliste schließt, ohne eine andere Unterhaltung zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa si cierras la lista de sesiones sin elegir otra conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé si vous fermez la liste des sessions sans choisir une autre conversation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan jika Anda menutup daftar sesi tanpa memilih percakapan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usa se chiudi l'elenco delle sessioni senza scegliere un'altra conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のチャットを選ばずにセッションリストを閉じた場合に使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 대화를 선택하지 않고 세션 목록을 닫으면 이 설정이 사용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane, jeśli zamkniesz listę sesji bez wybrania innej rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado se você fechar a lista de sessões sem escolher outra conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, если вы закроете список сеансов, не выбрав другой разговор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum listesini başka bir konuşma seçmeden kapatırsanız kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在未选择其他对话的情况下关闭会话列表时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若你沒有選擇其他對話就關閉工作階段列表，則使用此設定。"
          }
        }
      }
    },
    "Used only to reach this Cloudflare-protected dashboard; the secret stays in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur verwendet, um dieses durch Cloudflare geschützte Dashboard zu erreichen; das Secret bleibt im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usa para acceder a este panel protegido por Cloudflare; el secreto se queda en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement pour joindre ce tableau de bord protégé par Cloudflare ; le secret reste dans le trousseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya digunakan untuk menjangkau dasbor yang dilindungi Cloudflare ini; rahasianya tetap di Rantai Kunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usa solo per raggiungere questa dashboard protetta da Cloudflare; il segreto resta nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このCloudflareで保護されたダッシュボードへのアクセスにのみ使用されます。シークレットはキーチェーンに保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare로 보호되는 이 대시보드에 접속할 때만 사용돼요. 시크릿은 키체인에 보관돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane tylko do łączenia z tym panelem chronionym przez Cloudflare; sekret pozostaje w pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado apenas para acessar este painel protegido pela Cloudflare; o segredo fica nas Chaves."
