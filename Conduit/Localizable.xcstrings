        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 Conduit 打开以来，尚未记录任何连接耗时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
