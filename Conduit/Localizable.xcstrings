    "Shows audio reaching Conduit while the microphone is live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Ton, der bei Conduit ankommt, solange das Mikrofon aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el audio que llega a Conduit mientras el micrófono está activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le son qui parvient à Conduit pendant que le micro est actif."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan audio yang diterima Conduit saat mikrofon aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'audio che arriva a Conduit mentre il microfono è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクがオンの間、Conduitに届いている音声を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크가 켜져 있는 동안 Conduit에 들어오는 소리를 보여 줘요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje dźwięk docierający do Conduit, gdy mikrofon jest włączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o áudio que chega ao Conduit enquanto o microfone está ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает звук, поступающий в Conduit, пока микрофон включен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon açıkken Conduit'e ulaşan sesi gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风开启时，显示传入 Conduit 的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風開啟時，顯示傳入 Conduit 的音訊。"
          }
        }
      }
    },
