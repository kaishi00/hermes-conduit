            "value" : "Preguntar a Hermes sobre ${screenshot}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interroger Hermes sur ${screenshot}"
          }
        },
        "id" : {
