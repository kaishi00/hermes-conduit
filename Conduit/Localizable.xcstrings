    "No profile is attached and Hermes has no default assignee configured, so this task will not run until someone assigns it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein Profil zugeordnet und Hermes hat keine Standardzuständigkeit konfiguriert, daher läuft diese Aufgabe erst, wenn jemand sie zuweist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún perfil asociado y Hermes no tiene configurado un responsable predeterminado, así que esta tarea no se ejecutará hasta que alguien la asigne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun profil n'est associé et Hermes n'a aucun responsable par défaut configuré : cette tâche ne s'exécutera pas tant que quelqu'un ne l'aura pas assignée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada profil yang terlampir dan Hermes tidak memiliki penanggung jawab default yang dikonfigurasi, jadi tugas ini tidak akan berjalan sampai seseorang menugaskannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun profilo associato e Hermes non ha un assegnatario predefinito configurato, quindi questa attività non verrà eseguita finché qualcuno non la assegna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルが割り当てられておらず、Hermesにデフォルトの担当者も設定されていないため、誰かが割り当てるまでこのタスクは実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 프로필이 없고 Hermes에 기본 담당자도 구성되지 않아서, 누군가 할당할 때까지 이 태스크는 실행되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przypisano profilu, a Hermes nie ma skonfigurowanego domyślnego wykonawcy, więc to zadanie nie zostanie uruchomione, dopóki ktoś go nie przypisze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum perfil está vinculado e o Hermes não tem um responsável padrão configurado, então esta tarefa não será executada até que alguém a atribua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль не привязан, а исполнитель по умолчанию в Hermes не настроен, поэтому задача не будет выполнена, пока её кто-нибудь не назначит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı bir profil yok ve Hermes'te varsayılan atanan yapılandırılmamış; bu nedenle biri atayana kadar bu görev çalışmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未附加档案，且 Hermes 未配置默认负责人，因此在有人指派之前，此任务不会运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
