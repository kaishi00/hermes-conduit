    "This Hermes profile has no ready speech-to-text provider. Set one up in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes-Profil hat keinen bereiten Anbieter für Sprache zu Text. Richte unter „Einstellungen“ > „Sprachmodus“ einen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil de Hermes no tiene ningún proveedor de voz a texto listo. Configura uno en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil Hermes n'a aucun fournisseur de transcription vocale prêt. Configurez-en un dans Réglages > Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil Hermes ini tidak memiliki penyedia ucapan ke teks yang siap. Siapkan di Pengaturan > Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo Hermes non ha un provider di trascrizione vocale pronto. Configurane uno in Impostazioni > Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesプロファイルには、使用可能な音声入力（文字起こし）プロバイダがありません。「設定」>「音声」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes 프로필에 준비된 음성 텍스트 변환 제공자가 없어요. ‘설정’ > ‘음성’에서 설정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil Hermes nie ma gotowego dostawcy zamiany mowy na tekst. Skonfiguruj go w sekcji Ustawienia > Głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil do Hermes não tem um provedor de fala para texto pronto. Configure um em Ajustes > Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом профиле Hermes нет готового провайдера распознавания речи. Настройте его в разделе «Настройки › Голос»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes profilinde hazır bir konuşmadan metne sağlayıcısı yok. Ayarlar > Ses bölümünden bir tane ayarlayın."
