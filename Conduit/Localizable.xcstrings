        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 아직 대시보드에 연결하는 중이에요. 잠시 후 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit wciąż łączy się z Twoim panelem. Spróbuj ponownie za chwilę."
