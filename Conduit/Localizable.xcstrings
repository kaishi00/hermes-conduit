    },
    "The task was created%@, but Hermes could not move it to %@. It was not duplicated; close this form and refresh the board. %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクは作成されました%@。ただし、Hermesで%@に移動できませんでした。重複して作成されてはいません。このフォームを閉じてボードを更新してください。%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务已创建%@，但 Hermes 无法将其移动到 %@。未创建重复任务；请关闭此表单并刷新看板。%@"
          }
        }
      }
    },
    "The worker loops until a judge agrees the goal is met. Leave unlimited only with caution." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワーカーは、判定役が目標達成を認めるまでループします。無制限のままにする場合は注意してください。"
          }
