    "Press Return to send. Use Shift-Return for a new line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die Eingabetaste zum Senden. Verwende Umschalt-Eingabetaste für eine neue Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Intro para enviar. Usa Mayúsculas + Intro para una nueva línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Retour pour envoyer. Utilisez Maj + Retour pour aller à la ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan Return untuk mengirim. Gunakan Shift-Return untuk baris baru."
