    "On the speech server, set its language model to this address and key, with the model name %@. It then reads Hermes' replies aloud instead of writing its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle auf dem Sprachserver sein Sprachmodell auf diese Adresse und diesen Schlüssel ein, mit dem Modellnamen %@. Dann liest er die Antworten von Hermes vor, statt eigene zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el servidor de voz, configura su modelo de lenguaje con esta dirección y clave, y el nombre de modelo %@. Así leerá en voz alta las respuestas de Hermes en lugar de escribir las suyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le serveur vocal, réglez son modèle de langage sur cette adresse et cette clé, avec le nom de modèle %@. Il lira alors les réponses de Hermes au lieu d'écrire les siennes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di server suara, atur model bahasanya ke alamat dan kunci ini, dengan nama model %@. Server itu lalu membacakan balasan Hermes, bukan menulis balasannya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul server vocale, imposta il modello linguistico su questo indirizzo e questa chiave, con il nome modello %@. Così leggerà ad alta voce le risposte di Hermes invece di scriverne di proprie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバーで、言語モデルをこのアドレスとキー、モデル名 %@ に設定してください。音声サーバーは自分で返答を書かず、Hermes の返答を読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버에서 언어 모델을 이 주소와 키, 모델 이름 %@(으)로 설정하세요. 그러면 직접 답을 쓰지 않고 Hermes의 답장을 읽어 줍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na serwerze mowy ustaw jego model językowy na ten adres i klucz, z nazwą modelu %@. Wtedy będzie czytać odpowiedzi Hermesa zamiast pisać własne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No servidor de voz, configure o modelo de linguagem com este endereço e chave, e o nome de modelo %@. Assim ele lê em voz alta as respostas do Hermes em vez de escrever as próprias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На голосовом сервере укажите для языковой модели этот адрес и ключ, а имя модели — %@. Тогда он будет зачитывать ответы Hermes, а не писать свои."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sunucusunda dil modelini bu adres ve anahtara, model adını %@ olarak ayarlayın. Böylece kendi yanıtını yazmak yerine Hermes'in yanıtlarını sesli okur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在语音服务器上，将其语言模型设为此地址和密钥，模型名称为 %@。这样它会朗读 Hermes 的回复，而不是自己写回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在語音伺服器上，將其語言模型設為此位址和密鑰，模型名稱為 %@。這樣它會朗讀 Hermes 的回覆，而不是自己寫回覆。"
          }
        }
      }
    },
    "Replies in your speech server's own voice, so one server listens and speaks. Needs plugin 0.42 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwortet mit der eigenen Stimme deines Sprachservers, sodass ein Server zuhört und spricht. Erfordert Plugin 0.42 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde con la voz propia de tu servidor de voz, así un solo servidor escucha y habla. Requiere el plugin 0.42 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répond avec la voix de votre serveur vocal : un seul serveur écoute et parle. Nécessite le plugin 0.42 ou ultérieur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membalas dengan suara server suaramu sendiri, jadi satu server mendengar dan berbicara. Perlu plugin 0.42 atau lebih baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risponde con la voce del tuo server vocale, così un solo server ascolta e parla. Richiede il plugin 0.42 o successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバー自身の声で返答するので、1 台のサーバーで聞き取りと読み上げができます。プラグイン 0.42 以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버의 목소리로 답장하므로 서버 하나가 듣고 말합니다. 플러그인 0.42 이상이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiada własnym głosem serwera mowy, więc jeden serwer słucha i mówi. Wymaga wtyczki 0.42 lub nowszej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde com a voz do seu servidor de voz, então um só servidor ouve e fala. Requer o plugin 0.42 ou posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечает собственным голосом вашего голосового сервера: один сервер и слушает, и говорит. Нужен плагин 0.42 или новее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sunucunuzun kendi sesiyle yanıt verir, böylece tek sunucu hem dinler hem konuşur. Eklenti 0.42 veya üstü gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的语音服务器自己的声音回复，一台服务器即可听和说。需要插件 0.42 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的語音伺服器自己的聲音回覆，一台伺服器即可聽和說。需要外掛 0.42 或更新版本。"
          }
        }
      }
    },
    "Run it with two pipelines so it can listen and speak at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte ihn mit zwei Pipelines, damit er gleichzeitig zuhören und sprechen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecútalo con dos pipelines para que pueda escuchar y hablar a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez-le avec deux pipelines pour qu'il puisse écouter et parler en même temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalankan dengan dua pipeline agar bisa mendengar dan berbicara bersamaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvialo con due pipeline perché possa ascoltare e parlare insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞き取りと読み上げを同時にできるよう、パイプライン 2 つで起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기와 말하기를 동시에 할 수 있도록 파이프라인 두 개로 실행하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom go z dwoma potokami, aby mógł jednocześnie słuchać i mówić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute-o com dois pipelines para que ele possa ouvir e falar ao mesmo tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите его с двумя конвейерами, чтобы он мог слушать и говорить одновременно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda dinleyip konuşabilmesi için iki işlem hattıyla çalıştırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
