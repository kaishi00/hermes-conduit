    "Hermes never sees your keys, wake phrase, call permissions or Apple Watch access, and can't change this choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sieht nie deine Schlüssel, dein Aktivierungswort, deine Anrufberechtigungen oder den Apple-Watch-Zugriff und kann diese Wahl nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nunca ve tus claves, tu frase de activación, los permisos de llamada ni el acceso del Apple Watch, y no puede cambiar esta opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne voit jamais vos clés, votre phrase d’activation, vos autorisations d’appel ni l’accès de l’Apple Watch, et ne peut pas modifier ce choix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak pernah melihat kunci, frasa pemicu, izin panggilan, atau akses Apple Watch Anda, dan tidak dapat mengubah pilihan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non vede mai le tue chiavi, la frase di attivazione, i permessi di chiamata o l’accesso dell’Apple Watch, e non può cambiare questa scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがキー、ウェイクフレーズ、通話の許可、Apple Watchのアクセスを見ることはなく、この選択を変更することもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes는 키, 호출 문구, 통화 권한, Apple Watch 접근 권한을 볼 수 없으며 이 선택을 변경할 수도 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nigdy nie widzi Twoich kluczy, frazy wybudzającej, uprawnień do połączeń ani dostępu Apple Watch i nie może zmienić tego wyboru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes nunca vê suas chaves, sua frase de ativação, as permissões de chamada nem o acesso do Apple Watch, e não pode mudar esta escolha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes никогда не видит ваши ключи, фразу пробуждения, разрешения на звонки и доступ Apple Watch и не может изменить этот выбор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes anahtarlarınızı, uyandırma ifadenizi, arama izinlerinizi veya Apple Watch erişimini asla görmez ve bu seçimi değiştiremez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 永远看不到你的密钥、唤醒短语、通话权限或 Apple Watch 访问权限，也不能更改此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 永遠看不到你的金鑰、喚醒短語、通話權限或 Apple Watch 存取權限，也不能變更此選項。"
          }
        }
      }
    },
