    "Wait for the workspace switch to finish before starting a conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis der Wechsel des Arbeitsbereichs abgeschlossen ist, bevor du eine Unterhaltung beginnst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine el cambio de espacio de trabajo antes de iniciar una conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin du changement d'espace de travail avant de démarrer une conversation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu hingga peralihan ruang kerja selesai sebelum memulai percakapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi il completamento del cambio di spazio di lavoro prima di iniziare una conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースの切り替えが完了してからチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화를 시작하기 전에 작업 공간 전환이 끝날 때까지 기다리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj na zakończenie przełączania obszaru roboczego przed rozpoczęciem rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a troca de espaço de trabalho terminar antes de iniciar uma conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь завершения смены рабочего пространства, прежде чем начинать разговор."
          }
        },
        "tr" : {
          "stringUnit" : {
