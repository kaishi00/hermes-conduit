    },
    "Hermes sent a reply Conduit didn't understand. Updating Hermes and Conduit usually fixes this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat eine Antwort gesendet, die Conduit nicht verstanden hat. Meist hilft es, Hermes und Conduit zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes envió una respuesta que Conduit no entendió. Normalmente se soluciona actualizando Hermes y Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a envoyé une réponse que Conduit n'a pas comprise. Mettre à jour Hermes et Conduit règle généralement le problème."
