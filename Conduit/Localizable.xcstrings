    },
    "The model Hermes answers you with in a voice conversation. Reasoning is off by default so replies start sooner; typed messages keep the chat's model. Hermes Desktop uses this setting too." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声会話で Hermes が返答に使うモデルです。返答が早く始まるよう、推論は既定でオフです。入力したメッセージにはチャットのモデルが使われます。Hermes Desktop もこの設定を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 在语音对话中回复你时使用的模型。推理默认关闭，以便更快开始回复；输入的消息仍使用聊天的模型。Hermes Desktop 也使用此设置。"
          }
