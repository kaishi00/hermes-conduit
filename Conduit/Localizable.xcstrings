    },
    "Hermes could not start a new chat, so the screenshot is still in this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte keinen neuen Chat starten, daher ist das Bildschirmfoto noch in diesem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo iniciar un chat nuevo, así que la captura de pantalla sigue en este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n'a pas pu démarrer de nouvelle discussion ; la capture d'écran reste donc dans celle-ci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesが新しいチャットを開始できなかったため、スクリーンショットはこのチャットに残っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu iniciar um novo chat, então a captura de tela continua neste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не удалось начать новый чат, поэтому снимок экрана остался в этом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法新建聊天，截图仍在当前聊天中。"
          }
        }
      }
    },
