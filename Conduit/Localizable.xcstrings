    "Enable voice for this profile before running a speech playback test." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Sprachmodus für dieses Profil, bevor du einen Test der Sprachwiedergabe startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la voz para este perfil antes de hacer una prueba de reproducción de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la voix pour ce profil avant de lancer un test de lecture vocale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan suara untuk profil ini sebelum menjalankan uji pemutaran ucapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la voce per questo profilo prima di eseguire un test di riproduzione vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声再生テストを実行する前に、このプロファイルの音声を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 재생 테스트를 실행하기 전에 이 프로필의 음성을 켜세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz głos dla tego profilu, zanim uruchomisz test odtwarzania mowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a voz para este perfil antes de executar um teste de reprodução de fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите голос для этого профиля, прежде чем проверять воспроизведение речи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma oynatma testi çalıştırmadan önce bu profil için sesi etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
