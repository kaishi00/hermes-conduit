          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請用兩個管線執行它，以便同時聽和說。"
          }
        }
      }
    },
    "Update the Conduit plugin on your Hermes host to have your speech server speak the replies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere das Conduit-Plugin auf deinem Hermes-Host, damit dein Sprachserver die Antworten spricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza el plugin de Conduit en tu host de Hermes para que tu servidor de voz lea las respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour le plugin Conduit sur votre hôte Hermes pour que votre serveur vocal lise les réponses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui plugin Conduit di host Hermes agar server suaramu membacakan balasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna il plugin Conduit sul tuo host Hermes perché il server vocale legga le risposte."
          }
        },
        "ja" : {
          "stringUnit" : {
