    "Ask Hermes about ${screenshot}" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes zu ${screenshot} fragen"
          }
        },
        "es" : {
          "stringUnit" : {
