    "Extra headers are only sent over HTTPS. Enter an https:// server address first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliche Header werden nur über HTTPS gesendet. Gib zuerst eine https://-Serveradresse ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los encabezados adicionales solo se envían por HTTPS. Escribe primero una dirección de servidor https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en-têtes supplémentaires ne sont envoyés qu'en HTTPS. Saisissez d'abord une adresse de serveur en https://."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Header tambahan hanya dikirim melalui HTTPS. Masukkan alamat server https:// terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le intestazioni aggiuntive vengono inviate solo tramite HTTPS. Inserisci prima un indirizzo server https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加ヘッダはHTTPS経由でのみ送信されます。先にhttps://で始まるサーバアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 헤더는 HTTPS로만 전송돼요. 먼저 https:// 서버 주소를 입력하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatkowe nagłówki są wysyłane tylko przez HTTPS. Najpierw wpisz adres serwera zaczynający się od https://."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeçalhos extras só são enviados por HTTPS. Digite primeiro um endereço de servidor https://."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дополнительные заголовки отправляются только по HTTPS. Сначала введите адрес сервера https://."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek üstbilgiler yalnızca HTTPS üzerinden gönderilir. Önce bir https:// sunucu adresi girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外请求头仅通过 HTTPS 发送。请先输入 https:// 服务器地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "額外標頭只會透過 HTTPS 傳送。請先輸入 https:// 伺服器位址。"
          }
        }
      }
    },
    "For reverse proxies such as Pangolin, Traefik, or nginx that check a header. Sent only to this server, over HTTPS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Wird nur an diesen Server gesendet, über HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Solo se envían a este servidor, por HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Envoyés uniquement à ce serveur, en HTTPS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk reverse proxy seperti Pangolin, Traefik, atau nginx yang memeriksa header. Hanya dikirim ke server ini, melalui HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i reverse proxy come Pangolin, Traefik o nginx che controllano un'intestazione. Inviate solo a questo server, tramite HTTPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けです。HTTPS経由でこのサーバにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤더를 확인하는 Pangolin, Traefik, nginx 같은 리버스 프록시용이에요. HTTPS를 통해 이 서버에만 전송돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla odwrotnych serwerów proxy, takich jak Pangolin, Traefik czy nginx, które sprawdzają nagłówek. Wysyłane tylko do tego serwera, przez HTTPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Enviados só para este servidor, por HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Отправляются только на этот сервер по HTTPS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin, Traefik veya nginx gibi bir üstbilgiyi denetleyen ters proxy'ler için. Yalnızca bu sunucuya, HTTPS üzerinden gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。仅通过 HTTPS 发送到此服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
