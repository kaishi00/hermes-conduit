            "value" : "Udostępniać kalendarz i iPhone’a Hermesowi?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhar seu calendário e iPhone com o Hermes?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делиться календарём и данными iPhone с Hermes?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takviminiz ve iPhone'unuz Hermes ile paylaşılsın mı?"
          }
        },
        "zh-Hans" : {
