        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa da una dashboard Hermes salvata all'altra. Ogni dashboard mantiene accesso e cookie propri su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのHermesダッシュボードを切り替えます。各ダッシュボードのサインイン情報とCookieは、このデバイス上で個別に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 Hermes 대시보드 간에 전환해요. 각 대시보드는 이 기기에서 자체 로그인 정보와 쿠키를 유지해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełączaj się między zapisanymi panelami Hermes. Każdy panel ma na tym urządzeniu własne logowanie i pliki cookie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne entre seus painéis do Hermes salvos. Cada painel mantém o próprio login e os próprios cookies neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайтесь между сохранёнными дашбордами Hermes. Каждый дашборд хранит на этом устройстве собственные данные входа и cookie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı Hermes panelleriniz arasında geçiş yapın. Her panel bu cihazda kendi girişini ve çerezlerini saklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已保存的 Hermes 仪表板之间切换。每个仪表板在此设备上保留各自的登录状态和 Cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已儲存的 Hermes 儀表板之間切換。每個儀表板在此裝置上都有各自的登入資訊和 Cookie。"
          }
        }
      }
    },
