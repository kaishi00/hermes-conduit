    "Sessions and settings follow the active profile. Photos stay only on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen und Einstellungen folgen dem aktiven Profil. Fotos bleiben nur auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones y los ajustes siguen al perfil activo. Las fotos se quedan solo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions et les réglages suivent le profil actif. Les photos restent uniquement sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi dan pengaturan mengikuti profil aktif. Foto hanya disimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioni e impostazioni seguono il profilo attivo. Le foto restano solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションと設定はアクティブなプロファイルに従います。写真はこのデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션과 설정은 사용 중인 프로필을 따라요. 사진은 이 기기에만 저장돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje i ustawienia zależą od aktywnego profilu. Zdjęcia pozostają tylko na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões e os ajustes seguem o perfil ativo. As fotos ficam apenas neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы и настройки относятся к активному профилю. Фото хранятся только на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlar ve ayarlar etkin profili izler. Fotoğraflar yalnızca bu cihazda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话与设置跟随当前档案。照片仅保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段和設定會跟隨目前的設定檔。照片只會保留在此裝置上。"
          }
        }
      }
    },
