        }
      }
    },
    "%@ is larger than the %@ MB attachment limit. You can raise the limit in Settings › Chat." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は添付ファイルの上限（%@MB）を超えています。上限は「設定」>「チャット」で引き上げられます。"
