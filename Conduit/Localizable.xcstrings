    "Keys stay on your Hermes host. Conduit only shows the masked key Hermes reports, never the whole key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel bleiben auf deinem Hermes-Host. Conduit zeigt nur den maskierten Schlüssel, den Hermes meldet, nie den ganzen Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se quedan en tu host de Hermes. Conduit solo muestra la clave enmascarada que indica Hermes, nunca la clave completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés restent sur votre hôte Hermes. Conduit n’affiche que la clé masquée indiquée par Hermes, jamais la clé entière."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci tetap di host Hermes Anda. Conduit hanya menampilkan kunci tersamar yang dilaporkan Hermes, tidak pernah kunci lengkapnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi restano sul tuo host Hermes. Conduit mostra solo la chiave mascherata indicata da Hermes, mai la chiave intera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはHermesホストに保存されたままです。ConduitはHermesが返すマスク済みのキーだけを表示し、キー全体は表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 Hermes 호스트에 그대로 남습니다. Conduit는 Hermes가 알려주는 가려진 키만 보여주며 전체 키는 절대 보여주지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze zostają na Twoim hoście Hermes. Conduit pokazuje tylko zamaskowany klucz zgłoszony przez Hermesa, nigdy cały klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves ficam no seu host do Hermes. O Conduit só mostra a chave mascarada que o Hermes informa, nunca a chave inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи остаются на вашем хосте Hermes. Conduit показывает только замаскированный ключ, который сообщает Hermes, и никогда весь ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtarlar Hermes ana makinenizde kalır. Conduit yalnızca Hermes'in bildirdiği maskelenmiş anahtarı gösterir, asla anahtarın tamamını göstermez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥保留在你的 Hermes 主机上。Conduit 只显示 Hermes 报告的遮盖后密钥，绝不显示完整密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰會保留在你的 Hermes 主機上。Conduit 只顯示 Hermes 回報的遮蔽金鑰，絕不顯示完整金鑰。"
          }
        }
      }
    },
    "Hermes didn’t report any voice keys for this profile." : {
