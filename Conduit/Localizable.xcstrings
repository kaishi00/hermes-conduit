        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносит подзадачи после разбиения, не ожидающие родительской задачи, в «Готово к работе»"
          }
        },
        "tr" : {
          "stringUnit" : {
