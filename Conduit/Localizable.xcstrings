    "Confirm this device’s date and time are correct." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob Datum und Uhrzeit auf diesem Gerät stimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma que la fecha y la hora de este dispositivo son correctas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que la date et l'heure de cet appareil sont correctes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan tanggal dan waktu perangkat ini benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica che data e ora di questo dispositivo siano corrette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの日付と時刻が正しいことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
