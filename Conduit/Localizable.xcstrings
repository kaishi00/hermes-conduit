    },
    "Timings and connection events from Watch calls, without what was said. Share it when reporting a problem." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 通話のタイミングと接続イベントです（会話内容は含みません）。問題を報告するときに共有してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
