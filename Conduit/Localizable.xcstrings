    "(What your Hermes agent remembers about you, read when the call starts.)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Was dein Hermes-Agent über dich weiß, gelesen zu Beginn des Anrufs.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Lo que tu agente Hermes recuerda de ti, leído al empezar la llamada)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Ce que votre agent Hermes sait de vous, lu au début de l'appel.)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Apa yang diingat agen Hermes Anda tentang Anda, dibaca saat panggilan dimulai.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Ciò che il tuo agente Hermes ricorda di te, letto all'inizio della chiamata.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（Hermesエージェントが記憶しているあなたに関する情報。通話の開始時に読み込まれます。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Hermes 에이전트가 사용자에 대해 기억하는 내용으로, 통화가 시작될 때 읽어 와요.)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(To, co Twój agent Hermes pamięta o Tobie, odczytywane na początku połączenia.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
