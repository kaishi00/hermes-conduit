    "How live calls sound. Model default keeps the voice model's tone and your Hermes server's persona. Applies to the next call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Live-Anrufe klingen. „Modellstandard“ behält den Tonfall des Sprachmodells und die Persona deines Hermes-Servers bei. Gilt ab dem nächsten Anruf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo suenan las llamadas en vivo. Predeterminado del modelo mantiene el tono del modelo de voz y la persona de tu servidor Hermes. Se aplica a la próxima llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ton des appels en direct. Par défaut du modèle conserve le ton du modèle vocal et le persona de votre serveur Hermes. S'applique au prochain appel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ通話の話し方です。「モデルのデフォルト」では、音声モデルのトーンとHermesサーバのペルソナがそのまま使われます。次の通話から適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como soam as chamadas ao vivo. Padrão do modelo mantém o tom do modelo de voz e a persona do seu servidor Hermes. Vale a partir da próxima chamada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как звучат Live-звонки. «Как у модели» сохраняет тон голосовой модели и персону вашего сервера Hermes. Действует со следующего звонка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时通话的说话风格。“模型默认”保留语音模型的语气和 Hermes 服务器的人设。下次通话生效。"
          }
        }
      }
    },
    "Backchannels" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
