        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Conduit이 이해할 수 없는 Kanban 응답을 보냈어요. 보통 Hermes와 Conduit을 업데이트하면 해결돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes wysłał odpowiedź Kanban, której Conduit nie rozumie. Zwykle pomaga aktualizacja Hermesa i Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes enviou uma resposta do Kanban que o Conduit não entendeu. Atualizar o Hermes e o Conduit geralmente resolve isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes прислал ответ Kanban, который Conduit не понял. Обычно помогает обновление Hermes и Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, Conduit'in anlamadığı bir Kanban yanıtı gönderdi. Hermes'i ve Conduit'i güncellemek genellikle sorunu çözer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 返回了 Conduit 无法识别的看板回复。更新 Hermes 和 Conduit 通常可以解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 傳送了 Conduit 無法理解的 Kanban 回應。更新 Hermes 和 Conduit 通常可以解決此問題。"
          }
        }
      }
    },
