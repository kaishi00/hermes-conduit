          }
        }
      }
    },
    "Your previous message is still pending. Retry it from the room, or wait for it to deliver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine vorherige Nachricht steht noch aus. Sende sie im Raum erneut oder warte, bis sie zugestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mensaje anterior sigue pendiente. Reinténtalo desde la sala o espera a que se entregue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre message précédent est toujours en attente. Réessayez depuis le salon ou attendez qu'il soit distribué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan Anda sebelumnya masih tertunda. Coba lagi dari ruang, atau tunggu hingga terkirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo messaggio precedente è ancora in sospeso. Riprova dalla stanza o attendi che venga consegnato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前のメッセージはまだ送信待ちです。グループから再送信するか、送信されるまでお待ちください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 메시지가 아직 대기 중이에요. 방에서 다시 시도하거나 전송될 때까지 기다리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja poprzednia wiadomość wciąż oczekuje. Ponów ją z pokoju lub poczekaj, aż zostanie dostarczona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mensagem anterior ainda está pendente. Tente enviá-la de novo pela sala ou aguarde a entrega."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше предыдущее сообщение ещё не отправлено. Повторите отправку из комнаты или дождитесь доставки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki mesajınız hâlâ bekliyor. Odadan yeniden deneyin veya teslim edilmesini bekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您上一条消息仍在等待送达。请在群聊中重试，或等待其送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的上一則訊息仍在等待送出。請在群組中重試，或等待它送達。"
          }
        }
      }
    },
