          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на хосте Hermes с локальной установкой Whisper, а не на этом iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
