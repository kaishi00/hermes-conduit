          }
        }
      }
    },
    "Each run lands in Chats as its own conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Lauf erscheint in Chats als eigene Unterhaltung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ejecución aparece en Chats como su propia conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque exécution arrive dans Chats comme sa propre conversation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap jalannya muncul di Obrolan sebagai percakapan tersendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esecuzione arriva in Chat come conversazione a sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各実行はチャットに独立した会話として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 실행은 채팅에 별도의 대화로 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde uruchomienie trafia do Czatów jako osobna rozmowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada execução aparece em Chats como uma conversa própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый запуск появляется в Чатах отдельным разговором."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her çalıştırma Sohbetler'de ayrı bir konuşma olarak yer alır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行都会作为单独的对话出现在聊天中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
