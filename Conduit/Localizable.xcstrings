    "A picture can take a minute or more. Each tap of Generate adds one; pick one, then tap Use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bild kann eine Minute oder länger dauern. Jedes Tippen auf „Erzeugen“ fügt eines hinzu; wähle eines und tippe dann auf „Verwenden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una imagen puede tardar un minuto o más. Cada toque en Generar añade una; elige una y toca Usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une image peut prendre une minute ou plus. Chaque appui sur Générer en ajoute une ; choisissez-en une, puis touchez Utiliser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu gambar bisa butuh satu menit atau lebih. Setiap ketukan Buat menambah satu; pilih satu, lalu ketuk Gunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’immagine può richiedere un minuto o più. Ogni tocco su Genera ne aggiunge una; scegline una, poi tocca Usa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 枚の生成に 1 分以上かかることがあります。「生成」をタップするたびに 1 枚追加されます。1 枚選んで「使用」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림 하나에 1분 이상 걸릴 수 있습니다. 생성을 누를 때마다 하나씩 추가됩니다. 하나를 고른 다음 사용을 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygenerowanie obrazu może zająć minutę lub dłużej. Każde stuknięcie Generuj dodaje jeden; wybierz jeden i stuknij Użyj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma imagem pode levar um minuto ou mais. Cada toque em Gerar adiciona uma; escolha uma e toque em Usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создание изображения может занять минуту и больше. Каждое нажатие «Создать» добавляет одно; выберите одно и нажмите «Использовать»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir resim bir dakika veya daha uzun sürebilir. Oluştur'a her dokunuş bir tane ekler; birini seç, sonra Kullan'a dokun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成一张图片可能需要一分钟或更久。每点一次“生成”会添加一张；选好一张后点“使用”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "產生一張圖片可能需要一分鐘或更久。每點一次「產生」會加入一張；選好一張後點「使用」。"
          }
        }
      }
    },
