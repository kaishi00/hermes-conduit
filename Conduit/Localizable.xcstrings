            "value" : "次の場所にいるときは電話しない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 장소에 있을 때는 전화하지 않기"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie dzwoń do mnie, gdy jestem w"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não me ligue enquanto eu estiver em"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не звонить мне, когда я в"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şuradayken beni arama"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在以下地点时不要给我打电话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在以下地點時不要打給我"
          }
        }
      }
    },
