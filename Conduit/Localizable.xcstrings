          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダを非表示にしても、個々のモデルの選択は保持されます。これらのフィルタはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자를 가려도 개별 모델 선택은 유지돼요. 이 필터는 이 기기에 남아 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrycie dostawcy zachowuje wybór jego poszczególnych modeli. Te filtry pozostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar um provedor preserva as escolhas de modelo dele. Estes filtros ficam neste aparelho."
          }
        },
