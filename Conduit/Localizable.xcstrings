    "another Hermes window" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 Hermes 窗口"
          }
        }
      }
    },
    "Stop waiting" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止等待"
          }
        }
      }
    },
    "This chat is yours now. Send your message again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话已由你接管。请重新发送你的消息。"
          }
        }
      }
    },
    "Waiting to take this chat over" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待接管此对话"
          }
        }
      }
    },
    "The Conduit notifier plugin gave an unexpected answer. Update it on your Hermes host and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 通知插件返回了意外的响应。请在 Hermes 主机上更新它后重试。"
          }
