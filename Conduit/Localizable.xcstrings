    "Speech Recognition isn't allowed. Allow it for Conduit in iPhone Settings, or choose a Hermes provider under Speech to text below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracherkennung ist nicht erlaubt. Erlaube sie für Conduit in den iPhone-Einstellungen oder wähle unten unter „Sprache zu Text“ einen Hermes-Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz no está permitido. Permítelo para Conduit en los Ajustes del iPhone o elige un proveedor de Hermes en Voz a texto, más abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale n'est pas autorisée. Autorisez-la pour Conduit dans les Réglages de l'iPhone, ou choisissez un fournisseur Hermes sous Transcription vocale ci-dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan Ucapan tidak diizinkan. Izinkan untuk Conduit di Pengaturan iPhone, atau pilih penyedia Hermes di Ucapan ke teks di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale non è consentito. Consentilo per Conduit nelle Impostazioni di iPhone o scegli un provider Hermes in Trascrizione vocale qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識が許可されていません。iPhoneの「設定」でConduitに許可するか、下の「音声認識」でHermesのプロバイダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 인식이 허용되지 않았어요. iPhone ‘설정’에서 Conduit에 허용하거나, 아래 ‘음성 텍스트 변환’에서 Hermes 제공자를 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy nie jest dozwolone. Zezwól na nie aplikacji Conduit w Ustawieniach iPhone’a lub wybierz poniżej dostawcę Hermes w sekcji „Mowa na tekst”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Reconhecimento de Fala não está permitido. Permita-o para o Conduit nos Ajustes do iPhone ou escolha um provedor do Hermes em Fala para texto abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи не разрешено. Разрешите его для Conduit в Настройках iPhone или выберите провайдера Hermes в разделе «Речь в текст» ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma Tanıma'ya izin verilmedi. iPhone Ayarları'nda Conduit için izin verin veya aşağıdaki Konuşmadan metne bölümünden bir Hermes sağlayıcısı seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允许语音识别。请在 iPhone 设置中为 Conduit 允许语音识别，或在下方“语音转文字”中选择 Hermes 提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允許語音辨識。請在 iPhone「設定」中允許 Conduit 使用，或在下方的「語音轉文字」中選擇 Hermes 供應商。"
          }
        }
      }
    },
