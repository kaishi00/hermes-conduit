    "Apple speech recognition stopped. Try again, or choose another speech-to-text option in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apple-Spracherkennung wurde beendet. Versuche es erneut oder wähle unter „Einstellungen“ > „Sprachmodus“ eine andere Option für Sprache zu Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz de Apple se detuvo. Vuelve a intentarlo o elige otra opción de voz a texto en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale d'Apple s'est arrêtée. Réessayez, ou choisissez une autre option de transcription vocale dans Réglages > Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
