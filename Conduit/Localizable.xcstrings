    "Your Hermes host doesn't offer GPT-Live for the Watch. Update the Conduit notifier plugin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hermes-Host bietet GPT-Live für die Watch nicht an. Aktualisiere das Conduit-Notifier-Plug-in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
