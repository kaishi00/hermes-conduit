    "That message was summarized when the chat was compressed, so it can't be taken back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachricht wurde beim Komprimieren des Chats zusammengefasst und kann nicht zurückgenommen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese mensaje se resumió al comprimir el chat, así que no se puede deshacer."
