    "I don't know a profile or bot called %@, so I didn't start the job." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kenne kein Profil und keinen Bot namens %@, deshalb habe ich den Job nicht gestartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conozco ningún perfil ni bot llamado %@, así que no inicié el trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne connais aucun profil ni bot nommé %@, je n'ai donc pas lancé le job."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya tidak mengenal profil atau bot bernama %@, jadi saya tidak memulai pekerjaan itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non conosco nessun profilo o bot chiamato %@, quindi non ho avviato il job."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」というプロファイルやボットが見つからないため、ジョブを開始しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름이 %@인 프로필이나 봇을 찾을 수 없어서 작업을 시작하지 않았어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znam profilu ani bota o nazwie %@, więc zlecenie nie zostało uruchomione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conheço um perfil ou bot chamado %@, então não iniciei o trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знаю профиля или бота с именем %@, поэтому задание не запущено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı bir profil veya bot bilmiyorum; bu yüzden işi başlatmadım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
