        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre Conduit con questa istantanea allegata a una chat, pronta per la tua domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスクリーンショットをチャットに添付した状態でConduitを開き、すぐに質問できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스크린샷을 채팅에 첨부한 상태로 Conduit을 열어 바로 질문할 수 있게 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Conduit z tym zrzutem ekranu załączonym do czatu, gotowym na Twoje pytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Conduit com esta captura de tela anexada a um chat, pronta para sua pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть Conduit с этим снимком экрана, прикреплённым к чату и готовым к вашему вопросу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'i, bu ekran görüntüsü bir sohbete eklenmiş ve sorunuza hazır olarak açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Conduit，并把这张截图附加到对话中，等你提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 Conduit 並將這張截圖附加到聊天中，等你提問。"
          }
        }
      }
    },
