      }
    },
    "Leave blank to use the default relay. A relay you run yourself only works with a Conduit build signed with your own Apple developer account, because Apple only delivers this app's notifications through its developer's key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um das Standard-Relay zu verwenden. Ein selbst betriebenes Relay funktioniert nur mit einem Conduit-Build, der mit deinem eigenen Apple-Entwicklerkonto signiert ist, weil Apple die Mitteilungen dieser App nur über den Schlüssel ihres Entwicklers zustellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para usar el relay predeterminado. Un relay que gestiones tú solo funciona con una compilación de Conduit firmada con tu propia cuenta de desarrollador de Apple, porque Apple solo entrega las notificaciones de esta app a través de la clave de su desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser le relais par défaut. Un relais que vous exécutez vous-même ne fonctionne qu'avec une version de Conduit signée avec votre propre compte développeur Apple, car Apple ne distribue les notifications de cette app que via la clé de son développeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan untuk menggunakan relai default. Relai yang Anda jalankan sendiri hanya berfungsi dengan build Conduit yang ditandatangani dengan akun pengembang Apple Anda sendiri, karena Apple hanya mengirimkan pemberitahuan app ini melalui kunci pengembangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per usare il relay predefinito. Un relay gestito da te funziona solo con una build di Conduit firmata con il tuo account sviluppatore Apple, perché Apple recapita le notifiche di questa app solo tramite la chiave del suo sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄にするとデフォルトのリレーを使用します。Apple はこのアプリの通知を開発者のキー経由でしか配信しないため、自分で運用するリレーは、自分の Apple デベロッパアカウントで署名した Conduit ビルドでのみ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 릴레이를 사용하려면 비워 두세요. 직접 운영하는 릴레이는 본인의 Apple 개발자 계정으로 서명한 Conduit 빌드에서만 작동해요. Apple은 이 앱의 알림을 개발자 키를 통해서만 전달하기 때문이에요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw puste, aby używać domyślnego przekaźnika. Własny przekaźnik działa tylko z kompilacją Conduit podpisaną Twoim kontem dewelopera Apple, ponieważ Apple dostarcza powiadomienia tej aplikacji wyłącznie przy użyciu klucza jej dewelopera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para usar a retransmissão padrão. Uma retransmissão que você mesmo executa só funciona com uma versão do Conduit assinada com sua própria conta de desenvolvedor da Apple, porque a Apple só entrega as notificações deste app pela chave do desenvolvedor dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать ретранслятор по умолчанию. Собственный ретранслятор работает только со сборкой Conduit, подписанной вашей учётной записью разработчика Apple, поскольку Apple доставляет уведомления этого приложения только через ключ его разработчика."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan aktarıcıyı kullanmak için boş bırakın. Kendi çalıştırdığınız bir aktarıcı yalnızca kendi Apple geliştirici hesabınızla imzalanmış bir Conduit derlemesiyle çalışır; çünkü Apple bu uygulamanın bildirimlerini yalnızca geliştiricisinin anahtarıyla iletir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用默认中继。Apple 只会通过本应用开发者的密钥投递其通知，因此自建中继仅适用于用你自己的 Apple 开发者账号签名的 Conduit 版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空即可使用預設中繼。你自行架設的中繼只適用於以你自己的 Apple 開發者帳號簽署的 Conduit 版本，因為 Apple 只會透過此 App 開發者的密鑰遞送其通知。"
          }
        }
      }
    },
    "End-to-end encrypted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-zu-Ende-verschlüsselt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado de extremo a extremo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrement de bout en bout"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terenkripsi end-to-end"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crittografia end-to-end"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドツーエンド暗号化済み"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종단 간 암호화됨"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szyfrowane end-to-end"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografia de ponta a ponta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сквозное шифрование"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçtan uca şifreli"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已端到端加密"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已端對端加密"
          }
        }
      }
    },
    "Not end-to-end encrypted yet, so the relay can read these notifications. Conduit turns encryption on by itself once notifications are on and this host's notifier supports it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht Ende-zu-Ende-verschlüsselt, daher kann das Relay diese Mitteilungen lesen. Conduit aktiviert die Verschlüsselung automatisch, sobald Mitteilungen aktiviert sind und der Notifier dieses Hosts sie unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún sin cifrado de extremo a extremo, así que el relay puede leer estas notificaciones. Conduit activa el cifrado por sí solo cuando las notificaciones están activadas y el notificador de este host lo admite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore chiffré de bout en bout : le relais peut donc lire ces notifications. Conduit active le chiffrement de lui-même dès que les notifications sont activées et que le plugin de notification de cet hôte le prend en charge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum terenkripsi end-to-end, jadi relai dapat membaca pemberitahuan ini. Conduit menyalakan enkripsi dengan sendirinya setelah pemberitahuan aktif dan notifier host ini mendukungnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ancora crittografate end-to-end, quindi il relay può leggere queste notifiche. Conduit attiva la crittografia da solo quando le notifiche sono attive e il plugin di notifica di questo host la supporta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだエンドツーエンド暗号化されていないため、リレーがこれらの通知を読み取れます。通知がオンで、このホストの通知プラグインが対応していれば、Conduit が自動で暗号化をオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 종단 간 암호화되지 않아 릴레이가 이 알림을 읽을 수 있어요. 알림이 켜져 있고 이 호스트의 알림 플러그인이 지원하면 Conduit이 자동으로 암호화를 켜요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze bez szyfrowania end-to-end, więc przekaźnik może odczytać te powiadomienia. Conduit sam włączy szyfrowanie, gdy powiadomienia będą włączone, a wtyczka powiadomień tego hosta będzie je obsługiwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem criptografia de ponta a ponta, então a retransmissão pode ler estas notificações. O Conduit ativa a criptografia sozinho quando as notificações estão ativadas e o notificador deste host oferece suporte a ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сквозное шифрование пока не включено, поэтому ретранслятор может читать эти уведомления. Conduit сам включит шифрование, как только уведомления будут включены и плагин уведомлений этого хоста его поддержит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz uçtan uca şifreli değil; bu nedenle aktarıcı bu bildirimleri okuyabilir. Bildirimler açıldığında ve bu ana makinenin bildirim eklentisi desteklediğinde Conduit şifrelemeyi kendiliğinden açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未端到端加密，因此中继可以读取这些通知。只要通知已开启且此主机的通知插件支持，Conduit 会自动开启加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未端對端加密，因此中繼可以讀取這些通知。開啟通知且此主機的通知外掛程式支援時，Conduit 會自動開啟加密。"
          }
        }
      }
    },
    "Not end-to-end encrypted, so notifications from this host show only generic text and don't open the chat. Update this host's notifier to turn encryption on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht Ende-zu-Ende-verschlüsselt, daher zeigen Mitteilungen von diesem Host nur allgemeinen Text und öffnen den Chat nicht. Aktualisiere den Notifier dieses Hosts, um die Verschlüsselung zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrado de extremo a extremo, así que las notificaciones de este host solo muestran texto genérico y no abren el chat. Actualiza el notificador de este host para activar el cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiffré de bout en bout : les notifications de cet hôte n'affichent donc qu'un texte générique et n'ouvrent pas la discussion. Mettez à jour le plugin de notification de cet hôte pour activer le chiffrement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak terenkripsi end-to-end, jadi pemberitahuan dari host ini hanya menampilkan teks umum dan tidak membuka obrolan. Perbarui notifier host ini untuk menyalakan enkripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non crittografate end-to-end, quindi le notifiche di questo host mostrano solo un testo generico e non aprono la chat. Aggiorna il plugin di notifica di questo host per attivare la crittografia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドツーエンド暗号化されていないため、このホストからの通知は一般的な文面だけが表示され、チャットは開きません。暗号化をオンにするには、このホストの通知プラグインを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종단 간 암호화되지 않아 이 호스트의 알림에는 일반적인 텍스트만 표시되고 채팅이 열리지 않아요. 암호화를 켜려면 이 호스트의 알림 플러그인을 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez szyfrowania end-to-end, więc powiadomienia z tego hosta pokazują tylko ogólny tekst i nie otwierają czatu. Zaktualizuj wtyczkę powiadomień tego hosta, aby włączyć szyfrowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem criptografia de ponta a ponta, então as notificações deste host mostram apenas um texto genérico e não abrem o chat. Atualize o notificador deste host para ativar a criptografia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без сквозного шифрования, поэтому уведомления от этого хоста показывают только общий текст и не открывают чат. Обновите плагин уведомлений этого хоста, чтобы включить шифрование."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçtan uca şifreli değil; bu nedenle bu ana makineden gelen bildirimler yalnızca genel metin gösterir ve sohbeti açmaz. Şifrelemeyi açmak için bu ana makinenin bildirim eklentisini güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未端到端加密，因此此主机的通知只显示通用文字，且不会打开对话。请更新此主机的通知插件以开启加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未端對端加密，因此來自此主機的通知只會顯示一般文字，且不會打開聊天。請更新此主機的通知外掛程式以開啟加密。"
          }
        }
      }
    },
