    "Pause only affects the microphone. Close ends the voice session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pausieren“ betrifft nur das Mikrofon. „Schließen“ beendet die Sprachsitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar solo afecta al micrófono. Cerrar finaliza la sesión de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause n'agit que sur le micro. Fermer met fin à la session vocale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda hanya memengaruhi mikrofon. Tutup mengakhiri sesi suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa agisce solo sul microfono. Chiudi termina la sessione vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止はマイクにのみ適用されます。閉じると音声セッションが終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지는 마이크에만 적용돼요. 닫으면 음성 세션이 종료돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wstrzymaj” dotyczy tylko mikrofonu. „Zamknij” kończy sesję głosową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar afeta apenas o microfone. Fechar encerra a sessão de voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза влияет только на микрофон. «Закрыть» завершает голосовой сеанс."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklat yalnızca mikrofonu etkiler. Kapat, sesli oturumu sonlandırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停仅作用于麦克风。关闭会结束语音会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「暫停」只會影響麥克風。「關閉」會結束語音工作階段。"
          }
        }
      }
    },
