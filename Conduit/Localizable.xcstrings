    "This chat is open in Conduit on another device or in the Hermes web chat. Send from there, or close it there and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat ist in Conduit auf einem anderen Gerät oder im Hermes-Webchat geöffnet. Sende von dort, oder schließe ihn dort und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat está abierto en Conduit en otro dispositivo o en el chat web de Hermes. Envía desde allí, o ciérralo allí y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette discussion est ouverte dans Conduit sur un autre appareil ou dans la discussion web d'Hermes. Envoyez depuis là-bas, ou fermez-la là-bas et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan ini terbuka di Conduit di perangkat lain atau di obrolan web Hermes. Kirim dari sana, atau tutup di sana dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat è aperta in Conduit su un altro dispositivo o nella chat web di Hermes. Invia da lì, oppure chiudila lì e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは別のデバイスのConduitまたはHermesのWebチャットで開かれています。そちらから送信するか、そちらで閉じてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅은 다른 기기의 Conduit이나 Hermes 웹 채팅에서 열려 있어요. 그곳에서 보내거나, 그곳에서 닫은 후 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten czat jest otwarty w Conduit na innym urządzeniu lub w czacie internetowym Hermes. Wyślij wiadomość stamtąd albo zamknij go tam i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat está aberto no Conduit em outro aparelho ou no chat web do Hermes. Envie de lá ou feche-o lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат открыт в Conduit на другом устройстве или в веб-чате Hermes. Отправьте сообщение оттуда или закройте чат там и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet başka bir cihazdaki Conduit'te veya Hermes web sohbetinde açık. Oradan gönderin ya da orada kapatıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话已在另一台设备上的 Conduit 或 Hermes 网页聊天中打开。请在那里发送，或在那里关闭后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個聊天已在另一部裝置上的 Conduit 或 Hermes 網頁聊天中打開。請在該處傳送，或在該處關閉後再試一次。"
          }
        }
      }
    },
