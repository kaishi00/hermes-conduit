    "Optional. Leave empty to start from a short identity built from the name and description." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Lass das Feld leer, um mit einer kurzen Identität aus Name und Beschreibung zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Déjalo vacío para empezar con una identidad breve creada a partir del nombre y la descripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Laissez vide pour partir d'une courte identité créée à partir du nom et de la description."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsional. Biarkan kosong untuk memulai dari identitas singkat yang dibuat dari nama dan deskripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Lascia vuoto per partire da una breve identità creata dal nome e dalla descrizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省略可。空欄の場合は、名前と説明から作成した短いアイデンティティで始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항이에요. 비워 두면 이름과 설명으로 만든 짧은 정체성 설명으로 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Pozostaw puste, aby zacząć od krótkiego opisu tożsamości utworzonego na podstawie nazwy i opisu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Deixe vazio para começar com uma identidade curta criada a partir do nome e da descrição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Оставьте пустым, чтобы начать с краткого описания личности, составленного из имени и описания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı. Ad ve açıklamadan oluşturulan kısa bir kimlikle başlamak için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。留空则根据名称和描述生成一段简短的身份设定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。留空即可從依名稱和描述產生的簡短身分設定開始。"
          }
        }
      }
    },
