    "Auto Decompose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch zerlegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descomposición automática"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décomposition auto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動分解"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decomposição Automática"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторазбиение"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动分解"
          }
        }
      }
    },
    "Auto Decompose lets the dispatcher decompose eligible triage tasks. Auto Promote Children moves parent-free children to Ready instead of leaving them in To Do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch zerlegen“ lässt den Dispatcher geeignete Triage-Aufgaben zerlegen. „Unteraufgaben automatisch hochstufen“ verschiebt Unteraufgaben ohne Elternaufgabe nach „Bereit“, statt sie in „Zu erledigen“ zu lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descomposición automática permite que el despachador descomponga las tareas aptas de Clasificación. Promoción automática de subtareas mueve las subtareas sin tarea principal a Listo en lugar de dejarlas en Por hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décomposition auto permet au répartiteur de décomposer les tâches de triage éligibles. Promotion auto des enfants déplace les enfants sans parent vers Prêt au lieu de les laisser dans À faire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動分解」を有効にすると、ディスパッチャが対象のトリアージタスクを分解します。「子タスクを自動昇格」を有効にすると、親のない子タスクを「To Do」に残さず「Ready」に移動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decomposição Automática permite que o despachante decomponha tarefas de triagem elegíveis. Promover Filhas Automaticamente move tarefas filhas sem pais pendentes para Pronto em vez de deixá-las em A fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Авторазбиение» позволяет диспетчеру разбивать подходящие задачи из колонки «Разбор» на подзадачи. «Автопродвижение подзадач» переносит подзадачи, не ожидающие родительской задачи, в «Готово к работе», а не оставляет их в «К выполнению»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自动分解」允许派发器分解符合条件的分类任务；「自动晋升子任务」会把无父级的子任务移到 Ready 列，而不是留在 To Do 列。"
          }
        }
      }
    },
    "Auto Promote Children" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unteraufgaben automatisch hochstufen"
