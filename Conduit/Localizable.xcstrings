    "The new version adds what the installed one doesn't have. Apply it only if you trust it:\n\n%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Version bringt Dinge mit, die die installierte nicht hat. Wende sie nur an, wenn du ihr vertraust:\n\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva versión añade lo que la instalada no tiene. Aplícala solo si confías en ella:\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle version ajoute ce que la version installée n'a pas. Ne l'appliquez que si vous lui faites confiance :\n\n%@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi baru menambahkan hal yang tidak ada di versi terpasang. Terapkan hanya jika Anda memercayainya:\n\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova versione aggiunge ciò che quella installata non ha. Applicala solo se ti fidi:\n\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンには、インストール済みのものにはない内容が追加されています。信頼できる場合のみ適用してください:\n\n%@"
          }
        },
        "ko" : {
