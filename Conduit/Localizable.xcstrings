    "Conduit can only add events, so it can't find existing ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann nur Ereignisse hinzufügen und daher keine vorhandenen finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit solo puede añadir eventos, así que no puede encontrar los existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit peut seulement ajouter des événements ; il ne peut donc pas trouver ceux qui existent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hanya dapat menambahkan acara, jadi tidak dapat menemukan acara yang sudah ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit può solo aggiungere eventi, quindi non può trovare quelli esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはイベントの追加しかできないため、既存のイベントを見つけられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 이벤트를 추가만 할 수 있어 기존 이벤트를 찾을 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit może tylko dodawać wydarzenia, więc nie może znaleźć istniejących."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit só pode adicionar eventos, então não consegue encontrar os existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit может только добавлять события, поэтому не может найти существующие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit yalnızca etkinlik ekleyebildiği için mevcut etkinlikleri bulamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 只能添加日程，因此无法找到已有的日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 只能加入行程，因此無法找到現有的行程。"
          }
        }
      }
    },
    "Conduit doesn't have access to your calendar or reminders. Allow it in the Settings app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hat keinen Zugriff auf deinen Kalender oder deine Erinnerungen. Erlaube ihn in der App „Einstellungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no tiene acceso a tu calendario ni a tus recordatorios. Permítelo en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas accès à votre calendrier ni à vos rappels. Autorisez-le dans l'app Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak memiliki akses ke kalender atau pengingat Anda. Izinkan di app Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non ha accesso al tuo calendario o ai tuoi promemoria. Consentilo nell'app Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitにはカレンダーやリマインダーへのアクセス権がありません。「設定」Appで許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit에 캘린더나 미리 알림 접근 권한이 없어요. 설정 앱에서 허용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie ma dostępu do Twojego kalendarza ani przypomnień. Zezwól na to w aplikacji Ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não tem acesso ao seu calendário nem aos seus lembretes. Permita o acesso no app Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Conduit нет доступа к вашему календарю или напоминаниям. Разрешите его в приложении «Настройки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'in takviminize veya anımsatıcılarınıza erişimi yok. Ayarlar uygulamasından izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无权访问你的日历或提醒事项。请在“设置” App 中允许访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無權取用你的行事曆或提醒事項。請在「設定」App 中允許取用。"
          }
        }
      }
    },
    "Conduit sends what you chose to the %@ profile on %@, sealed end to end. It never goes through Conduit's notification relay, and Conduit's developer can't see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sendet deine Auswahl Ende-zu-Ende-verschlüsselt an das Profil %1$@ auf %2$@. Sie läuft nie über das Mitteilungs-Relay von Conduit, und der Entwickler von Conduit kann sie nicht sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit envía lo que elegiste al perfil %1$@ en %2$@, con cifrado de extremo a extremo. Nunca pasa por el relay de notificaciones de Conduit y el desarrollador de Conduit no puede verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit envoie ce que vous avez choisi au profil %1$@ sur %2$@, chiffré de bout en bout. Rien ne passe par le relais de notifications de Conduit, et le développeur de Conduit ne peut pas le voir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit mengirim apa yang Anda pilih ke profil %1$@ di %2$@, terenkripsi end-to-end. Data tidak pernah melewati relai pemberitahuan Conduit, dan developer Conduit tidak dapat melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit invia ciò che hai scelto al profilo %1$@ su %2$@, con crittografia end-to-end. Non passa mai dal relay delle notifiche di Conduit e lo sviluppatore di Conduit non può vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは、選択した内容を%2$@上の「%1$@」プロファイルにエンドツーエンドで暗号化して送信します。Conduitの通知リレーを経由することはなく、Conduitの開発者が見ることもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 선택한 항목을 종단 간 암호화하여 %2$@의 %1$@ 프로필로 보내요. Conduit의 알림 릴레이를 거치지 않으며, Conduit 개발자는 이 데이터를 볼 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit wysyła to, co wybrałeś(-aś), do profilu %1$@ na %2$@, z szyfrowaniem end-to-end. Dane nigdy nie przechodzą przez przekaźnik powiadomień Conduit, a deweloper Conduit nie ma do nich wglądu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit envia o que você escolheu para o perfil %1$@ em %2$@, com criptografia de ponta a ponta. Nada passa pela retransmissão de notificações do Conduit, e o desenvolvedor do Conduit não pode ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit отправляет выбранное вами в профиль %1$@ на %2$@ со сквозным шифрованием. Данные никогда не проходят через ретранслятор уведомлений Conduit, и разработчик Conduit не может их увидеть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, seçtiklerinizi uçtan uca şifreli olarak %2$@ üzerindeki %1$@ profiline gönderir. Veriler hiçbir zaman Conduit'in bildirim aktarıcısından geçmez ve Conduit'in geliştiricisi bunları göremez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 会将你选择的内容以端到端加密方式发送到 %2$@ 上的“%1$@”档案。数据绝不会经过 Conduit 的通知中继，Conduit 的开发者也无法查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 會將你選擇的內容以端對端加密方式傳送到 %2$@ 上的「%1$@」設定檔。資料絕不會經過 Conduit 的通知中繼，Conduit 的開發者也無法查看。"
          }
        }
      }
    },
    "Conduit stops sending your calendar, reminders, Focus and phone status, and Hermes can't ask for calendar changes. Deleting removes what this iPhone sent from the host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sendet deinen Kalender, deine Erinnerungen, deinen Fokus und den iPhone-Status nicht mehr, und Hermes kann keine Kalenderänderungen mehr anfragen. Beim Löschen wird entfernt, was dieses iPhone an den Host gesendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit deja de enviar tu calendario, recordatorios, modo de concentración y estado del iPhone, y Hermes no puede pedir cambios en el calendario. Al eliminar, se borra del host lo que envió este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit cesse d'envoyer votre calendrier, vos rappels, votre mode Concentration et l'état de votre iPhone, et Hermes ne peut plus demander de modifications du calendrier. La suppression efface de l'hôte ce que cet iPhone a envoyé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit berhenti mengirim kalender, pengingat, Fokus, dan status iPhone Anda, dan Hermes tidak dapat meminta perubahan kalender. Menghapus akan membuang data yang dikirim iPhone ini dari host."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit smette di inviare calendario, promemoria, Full immersion e stato dell'iPhone, e Hermes non può più chiedere modifiche al calendario. L'eliminazione rimuove dall'host ciò che questo iPhone ha inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはカレンダー、リマインダー、集中モード、iPhoneの状態の送信を停止し、Hermesはカレンダーの変更を依頼できなくなります。削除すると、このiPhoneが送信したデータがホストから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 캘린더, 미리 알림, 집중 모드, iPhone 상태 전송을 중단하고 Hermes는 캘린더 변경을 요청할 수 없게 돼요. 삭제하면 이 iPhone이 보낸 데이터가 호스트에서 제거돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit przestanie wysyłać Twój kalendarz, przypomnienia, tryb skupienia i stan iPhone’a, a Hermes nie będzie mógł prosić o zmiany w kalendarzu. Usunięcie wymaże z hosta to, co wysłał ten iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit para de enviar seu calendário, lembretes, Foco e estado do iPhone, e o Hermes não pode pedir alterações no calendário. Apagar remove do host o que este iPhone enviou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit перестанет отправлять ваш календарь, напоминания, режим фокусирования и состояние iPhone, а Hermes не сможет запрашивать изменения в календаре. При удалении с хоста будет стёрто то, что отправил этот iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit takviminizi, anımsatıcılarınızı, Odak'ınızı ve iPhone durumunuzu göndermeyi durdurur; Hermes de takvim değişikliği isteyemez. Silme işlemi, bu iPhone'un gönderdiklerini ana makineden kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 将停止发送你的日历、提醒事项、专注模式和 iPhone 状态，Hermes 也无法再请求更改日历。删除会从主机上移除这台 iPhone 发送的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 將停止傳送你的行事曆、提醒事項、專注模式和 iPhone 狀態，Hermes 也無法再要求變更行事曆。刪除會從主機移除這部 iPhone 傳送的資料。"
          }
        }
      }
    },
    "Events can include other people's names. Notes, attendees and email addresses stay on this iPhone unless you turn them on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse können Namen anderer Personen enthalten. Notizen, Teilnehmer und E-Mail-Adressen bleiben auf diesem iPhone, außer du schaltest sie ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos pueden incluir nombres de otras personas. Las notas, los asistentes y las direcciones de correo se quedan en este iPhone a menos que los actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements peuvent contenir le nom d'autres personnes. Les notes, les participants et les adresses e-mail restent sur cet iPhone, sauf si vous les activez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acara dapat menyertakan nama orang lain. Catatan, peserta, dan alamat email tetap di iPhone ini kecuali Anda menyalakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi possono includere i nomi di altre persone. Note, partecipanti e indirizzi email restano su questo iPhone, a meno che non li attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントにはほかの人の名前が含まれることがあります。メモ、参加者、メールアドレスは、オンにしない限りこのiPhoneから出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트에는 다른 사람의 이름이 포함될 수 있어요. 메모, 참석자, 이메일 주소는 켜지 않는 한 이 iPhone에만 남아 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydarzenia mogą zawierać imiona i nazwiska innych osób. Notatki, uczestnicy i adresy e-mail pozostają na tym iPhonie, chyba że je włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos podem incluir nomes de outras pessoas. Notas, participantes e endereços de e-mail ficam neste iPhone, a menos que você os ative."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События могут содержать имена других людей. Заметки, участники и адреса электронной почты остаются на этом iPhone, если вы их не включите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinlikler başka kişilerin adlarını içerebilir. Notlar, katılımcılar ve e-posta adresleri siz açmadıkça bu iPhone'da kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日程中可能包含其他人的姓名。除非你开启，否则备注、参与者和电子邮件地址都只保留在这台 iPhone 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行程中可能包含其他人的姓名。除非你開啟，否則備註、參與者和電子郵件地址都只會留在這部 iPhone 上。"
          }
        }
      }
    },
