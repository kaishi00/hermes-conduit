    },
    "Paired before Conduit supported several dashboards, so its notifications can't be opened. Pair it again from the dashboard it belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde gekoppelt, bevor Conduit mehrere Dashboards unterstützte, daher lassen sich seine Mitteilungen nicht öffnen. Kopple es erneut über das Dashboard, zu dem es gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vinculó antes de que Conduit admitiera varios paneles, así que sus notificaciones no se pueden abrir. Vuelve a vincularlo desde el panel al que pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumelé avant que Conduit ne prenne en charge plusieurs tableaux de bord : ses notifications ne peuvent donc pas être ouvertes. Jumelez-le à nouveau depuis le tableau de bord auquel il appartient."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitが複数のダッシュボードに対応する前にペアリングされたため、その通知を開けません。所属するダッシュボードからもう一度ペアリングしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emparelhado antes de o Conduit aceitar vários painéis, então as notificações dele não podem ser abertas. Emparelhe de novo a partir do painel ao qual ele pertence."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопряжение создано до того, как Conduit стал поддерживать несколько дашбордов, поэтому его уведомления нельзя открыть. Выполните сопряжение заново с того дашборда, к которому оно относится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配对早于 Conduit 支持多个仪表板，因此无法打开它的通知。请从它所属的仪表板重新配对。"
          }
        }
      }
    },
    "Showing %@. Switch dashboards to check another one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird angezeigt. Wechsle das Dashboard, um ein anderes zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
