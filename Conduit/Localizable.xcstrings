          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale solo per le tastiere fisiche. Il tasto Invio della tastiera su schermo non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
