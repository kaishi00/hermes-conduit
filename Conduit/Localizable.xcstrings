    "GPT-Live talks with the personality in this profile's SOUL.md. SOUL.md is sent to OpenAI with the conversation. Applies to the next conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPT-Live spricht mit der Persönlichkeit aus der SOUL.md dieses Profils. SOUL.md wird mit der Unterhaltung an OpenAI gesendet. Gilt ab der nächsten Unterhaltung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
