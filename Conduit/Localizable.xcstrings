    "Files Hermes sends or writes, pages it draws, files you attach and links show up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien, die Hermes sendet oder schreibt, Seiten, die es zeichnet, Dateien, die du anhängst, und Links erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los archivos que Hermes envía o escribe, las páginas que dibuja, los archivos que adjuntas y los enlaces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers qu’Hermes envoie ou écrit, les pages qu’il dessine, les fichiers que vous joignez et les liens apparaissent ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang dikirim atau ditulis Hermes, halaman yang digambarnya, file yang Anda lampirkan, dan tautan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono i file che Hermes invia o scrive, le pagine che disegna, i file che alleghi e i link."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes が送信または作成したファイル、描いたページ、添付したファイル、リンクがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 보내거나 작성한 파일, 그린 페이지, 첨부한 파일과 링크가 여기에 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawiają się pliki, które Hermes wysyła lub zapisuje, strony, które rysuje, załączone przez ciebie pliki i linki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos que o Hermes envia ou grava, páginas que ele desenha, arquivos que você anexa e links aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются файлы, которые Hermes отправляет или записывает, страницы, которые он рисует, файлы, которые вы прикрепляете, и ссылки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'in gönderdiği veya yazdığı dosyalar, çizdiği sayfalar, eklediğiniz dosyalar ve bağlantılar burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
