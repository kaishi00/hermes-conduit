    "This removes %@ from Hermes, so it won't run again. Chats from its past runs are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird %@ aus Hermes entfernt und nicht mehr ausgeführt. Chats aus früheren Ausführungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina %@ de Hermes, así que no volverá a ejecutarse. Los chats de sus ejecuciones anteriores se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime %@ de Hermes : il ne s’exécutera plus. Les conversations de ses exécutions passées sont conservées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus %@ dari Hermes sehingga tidak akan berjalan lagi. Obrolan dari jalannya sebelumnya tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove %@ da Hermes, quindi non verrà più eseguito. Le chat delle esecuzioni passate vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を Hermes から削除し、今後は実行されなくなります。過去の実行のチャットは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes에서 %@을(를) 삭제하므로 다시 실행되지 않습니다. 이전 실행의 채팅은 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To usuwa %@ z Hermes, więc nie uruchomi się ponownie. Czaty z poprzednich uruchomień zostają zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove %@ do Hermes, então ele não será executado novamente. Os chats das execuções anteriores são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ будет удалено из Hermes и больше не запустится. Чаты прошлых запусков сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, %@ işini Hermes'ten kaldırır; bir daha çalışmaz. Geçmiş çalıştırmaların sohbetleri korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从 Hermes 中移除 %@，它将不再运行。以往运行的聊天会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 Hermes 移除 %@，它將不再執行。以往執行的聊天會保留。"
          }
        }
      }
    },
