    },
    "I don't know a profile or bot called %@, so I didn't start the job." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」というプロファイルやボットが見つからないため、ジョブを開始しませんでした。"
