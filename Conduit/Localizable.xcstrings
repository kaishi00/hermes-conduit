    },
    "Listen for a wake phrase" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクフレーズを待ち受ける"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监听唤醒词"
          }
        }
      }
    },
    "Phrases with a single word are ignored." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1語だけのフレーズは無視されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一个词的唤醒词会被忽略。"
          }
        }
      }
    },
    "Say the phrase while Conduit is open to start voice on this profile, in whichever voice mode it uses. Listening runs on this iPhone, stops during calls and in the background, and the microphone indicator stays on while it listens." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitを開いている間にフレーズを話すと、このプロファイルの音声モードで音声が開始されます。聞き取りはこのiPhone上で行われ、通話中やバックグラウンドでは停止します。聞き取り中はマイクのインジケータが点灯したままになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Conduit 打开时说出唤醒词，即可按此配置文件当前使用的语音模式开始语音对话。监听在此 iPhone 上进行，通话期间和后台时会停止，监听时麦克风指示灯会保持亮起。"
          }
        }
      }
    },
    "The microphone is not available right now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在マイクを使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风当前不可用。"
          }
        }
      }
    },
    "Use at least two words, such as \"%@\". Add a second spelling if Conduit mishears a name." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のように、2語以上にしてください。Conduitが名前を聞き間違える場合は、別の表記を追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少使用两个词，例如“%@”。如果 Conduit 听错了名字，可以再添加一种拼写。"
          }
        }
      }
    },
    "Wake phrases" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクフレーズ"
