    },
    "Hermes Conduit connects to a Hermes dashboard you (or your assistant) run yourself. The dashboard has to be up before Conduit can reach it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduitは、ご自身（またはアシスタント）が運用するHermesダッシュボードに接続します。Conduitから接続するには、ダッシュボードが起動している必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Conduit 连接的是你自己（或你的智能体）运行的 Hermes 仪表盘。仪表盘必须先启动，Conduit 才能访问它。"
          }
        }
      }
    },
    "Hermes Conduit is an independent client and is not affiliated with or endorsed by Nous Research. © 2026 Milim." : {
      "localizations" : {
        "ja" : {
