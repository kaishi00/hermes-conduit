        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito ad aprire il profilo richiesto dal comando rapido, quindi l'istantanea è in questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはショートカットで指定されたプロファイルを開けなかったため、スクリーンショットはこのプロファイルに追加されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 단축어에서 요청한 프로필을 열 수 없어서 스크린샷이 이 프로필에 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł otworzyć profilu wskazanego w skrócie, więc zrzut ekranu jest w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu abrir o perfil pedido pelo atalho, então a captura de tela está neste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось открыть профиль, указанный в быстрой команде, поэтому снимок экрана добавлен в текущий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, kestirmenin istediği profili açamadı; bu nedenle ekran görüntüsü bu profilde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法打开快捷指令指定的档案，截图已放在当前档案中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法打開捷徑指定的設定檔，因此截圖在目前這個設定檔中。"
          }
        }
      }
    },
    "Hermes could not start a chat for the screenshot. It's kept and will be attached once Hermes is ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte keinen Chat für das Bildschirmfoto starten. Es bleibt erhalten und wird angehängt, sobald Hermes bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo iniciar un chat para la captura de pantalla. Se conserva y se adjuntará cuando Hermes esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n'a pas pu démarrer de discussion pour la capture d'écran. Elle est conservée et sera jointe dès qu'Hermes sera prêt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak dapat memulai obrolan untuk jepretan layar. Jepretan layar disimpan dan akan dilampirkan setelah Hermes siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è riuscito ad avviare una chat per l'istantanea. È conservata e verrà allegata quando Hermes sarà pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがスクリーンショット用のチャットを開始できませんでした。スクリーンショットは保持され、Hermesの準備ができたら添付されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 스크린샷용 채팅을 시작할 수 없어요. 스크린샷은 그대로 유지되며 Hermes가 준비되면 첨부돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie mógł rozpocząć czatu dla zrzutu ekranu. Zrzut został zachowany i zostanie załączony, gdy Hermes będzie gotowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu iniciar um chat para a captura de tela. Ela foi guardada e será anexada quando o Hermes estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не удалось начать чат для снимка экрана. Снимок сохранён и будет прикреплён, когда Hermes будет готов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, ekran görüntüsü için bir sohbet başlatamadı. Görüntü saklanıyor ve Hermes hazır olduğunda eklenecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法为这张截图新建对话。截图已保留，Hermes 就绪后会自动附上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 無法為截圖開始聊天。截圖已保留，Hermes 就緒後會附加上去。"
          }
        }
      }
