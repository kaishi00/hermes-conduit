    "This dashboard's saved sign-in and cookies will be deleted from this device. Other dashboards are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Anmeldung und die Cookies dieses Dashboards werden von diesem Gerät gelöscht. Andere Dashboards sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión y las cookies guardados de este panel se eliminarán de este dispositivo. Los demás paneles no se verán afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion enregistrée et les cookies de ce tableau de bord seront supprimés de cet appareil. Les autres tableaux de bord ne sont pas concernés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login dan cookie yang disimpan untuk dasbor ini akan dihapus dari perangkat ini. Dasbor lain tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso e i cookie salvati di questa dashboard verranno eliminati da questo dispositivo. Le altre dashboard non sono interessate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダッシュボードの保存済みのサインイン情報とCookieがこのデバイスから削除されます。ほかのダッシュボードには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대시보드에 저장된 로그인 정보와 쿠키가 이 기기에서 삭제돼요. 다른 대시보드에는 영향이 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane logowanie i pliki cookie tego panelu zostaną usunięte z tego urządzenia. Nie wpłynie to na inne panele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login salvo e os cookies deste painel serão apagados deste aparelho. Os outros painéis não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые данные входа и cookie этого дашборда будут удалены с этого устройства. Другие дашборды это не затронет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panelin kayıtlı girişi ve çerezleri bu cihazdan silinecek. Diğer paneller etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仪表板已保存的登录信息和 Cookie 将从此设备删除。其他仪表板不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此儀表板已儲存的登入資訊和 Cookie 將從此裝置刪除。其他儀表板不受影響。"
          }
        }
      }
    },
    "This notification belongs to a dashboard this device doesn't recognize. Add that dashboard again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mitteilung gehört zu einem Dashboard, das dieses Gerät nicht kennt. Füge das Dashboard erneut hinzu, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificación pertenece a un panel que este dispositivo no reconoce. Vuelve a añadir ese panel para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette notification provient d'un tableau de bord que cet appareil ne reconnaît pas. Ajoutez à nouveau ce tableau de bord pour continuer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan ini milik dasbor yang tidak dikenali perangkat ini. Tambahkan dasbor tersebut lagi untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa notifica appartiene a una dashboard che questo dispositivo non riconosce. Aggiungi di nuovo quella dashboard per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通知は、このデバイスが認識していないダッシュボードからのものです。続けるには、そのダッシュボードをもう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 알림은 이 기기가 인식하지 못하는 대시보드에서 온 거예요. 계속하려면 해당 대시보드를 다시 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To powiadomienie należy do panelu, którego to urządzenie nie rozpoznaje. Dodaj ten panel ponownie, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificação pertence a um painel que este aparelho não reconhece. Adicione esse painel de novo para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это уведомление относится к дашборду, который это устройство не знает. Добавьте этот дашборд снова, чтобы продолжить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bildirim, bu cihazın tanımadığı bir panele ait. Devam etmek için o paneli yeniden ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知属于此设备无法识别的仪表板。请重新添加该仪表板后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知屬於此裝置無法辨識的儀表板。請重新加入該儀表板以繼續。"
          }
        }
      }
    },
    "This notification predates multi-dashboard pairing. Update the notifier on the sending gateway and pair it again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mitteilung stammt aus der Zeit vor der Kopplung mehrerer Dashboards. Aktualisiere den Notifier auf dem sendenden Gateway und kopple ihn erneut, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificación es anterior a la vinculación con varios paneles. Actualiza el notificador en la pasarela que la envió y vuelve a vincularla para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette notification est antérieure au jumelage multi-tableaux de bord. Mettez à jour le plugin de notification sur la passerelle émettrice et jumelez-la à nouveau pour continuer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan ini berasal dari sebelum pemasangan multi-dasbor. Perbarui notifier di gateway pengirim dan pasangkan lagi untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa notifica è precedente all'abbinamento con più dashboard. Aggiorna il plugin di notifica sul gateway che l'ha inviata e abbinalo di nuovo per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通知は複数ダッシュボードのペアリングに対応する前のものです。続けるには、送信元ゲートウェイの通知プラグインをアップデートして、もう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 알림은 여러 대시보드 페어링이 지원되기 전의 것이에요. 계속하려면 보낸 게이트웨이의 알림 플러그인을 업데이트하고 다시 페어링하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To powiadomienie pochodzi sprzed parowania z wieloma panelami. Zaktualizuj wtyczkę powiadomień w bramie, która je wysłała, i sparuj ją ponownie, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificação é anterior ao emparelhamento com vários painéis. Atualize o notificador no gateway que a enviou e emparelhe-o de novo para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это уведомление было отправлено до появления сопряжения с несколькими дашбордами. Обновите плагин уведомлений на шлюзе-отправителе и выполните сопряжение заново, чтобы продолжить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bildirim, çoklu panel eşlemesinden önceye ait. Devam etmek için gönderen ağ geçidindeki bildirim eklentisini güncelleyip yeniden eşleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知早于多仪表板配对。请在发送通知的网关上更新 notifier 并重新配对后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知早於多儀表板配對功能。請更新傳送端閘道上的通知外掛程式並重新配對以繼續。"
          }
        }
      }
    },
