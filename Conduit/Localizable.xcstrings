    "Google Search" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google検索"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 搜索"
          }
        }
      }
    },
    "How Gemini answers quick questions like weather or news. Hermes web search uses the search your Hermes server is set up with (SearXNG, Firecrawl…). Google Search has its own quota on your Gemini key. Automatic uses Hermes when it has a search set up, otherwise Google. Applies to the next conversation." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geminiが天気やニュースなどの簡単な質問に答える方法です。「HermesのWeb検索」は、Hermesサーバに設定されている検索（SearXNG、Firecrawl…）を使用します。「Google検索」には、Geminiキーで個別の利用枠があります。「自動」は、Hermesに検索が設定されていればHermesを、そうでなければGoogleを使用します。次回の会話から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini 如何回答天气、新闻等快速问题。Hermes 网页搜索使用你的 Hermes 服务器配置的搜索（SearXNG、Firecrawl…）。Google 搜索在你的 Gemini 密钥上有单独的配额。“自动”会在 Hermes 配置了搜索时使用 Hermes，否则使用 Google。从下一次对话开始生效。"
          }
        }
      }
    },
