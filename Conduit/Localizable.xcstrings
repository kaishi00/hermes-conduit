    "Promotes parent-free decomposed children to Ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuft zerlegte Unteraufgaben ohne Elternaufgabe nach „Bereit“ hoch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promociona a Listo las subtareas descompuestas sin tarea principal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promeut vers Prêt les enfants décomposés sans parent"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaikkan subtugas hasil penguraian yang tidak lagi menunggu induknya ke Siap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promuove a Pronto le sottoattività scomposte senza genitore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親タスクのない分解済みの子タスクを「準備完了」に昇格します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상위 태스크가 없는 분해된 하위 태스크를 ‘준비됨’으로 승격해요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awansuje podzadania z podziału, które nie mają zadań nadrzędnych, do kolumny „W gotowości”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promove para Pronto as tarefas filhas decompostas sem pais pendentes"
