    "Send text to your Hermes agent as a chat message. With Wait for Answer on, Hermes's reply comes back to the shortcut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Text als Chatnachricht an deinen Hermes-Agenten. Mit „Auf Antwort warten“ kommt die Antwort von Hermes an den Kurzbefehl zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía texto a tu agente Hermes como mensaje de chat. Con Esperar respuesta activado, la respuesta de Hermes vuelve al atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie du texte à votre agent Hermes comme message de discussion. Avec Attendre la réponse activé, la réponse de Hermes revient au raccourci."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim teks ke agen Hermes Anda sebagai pesan obrolan. Dengan Tunggu Jawaban aktif, balasan Hermes kembali ke pintasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia testo al tuo agente Hermes come messaggio di chat. Con Attendi risposta attivo, la risposta di Hermes torna al comando rapido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストをチャットメッセージとしてHermesエージェントに送信します。「回答を待つ」をオンにすると、Hermesの返答がショートカットに返されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 채팅 메시지로 Hermes 에이전트에 보냅니다. 답변 기다리기를 켜면 Hermes의 답장이 단축어로 돌아옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła tekst do agenta Hermes jako wiadomość czatu. Gdy opcja Czekaj na odpowiedź jest włączona, odpowiedź Hermesa wraca do skrótu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia texto ao seu agente Hermes como mensagem de chat. Com Aguardar resposta ativado, a resposta do Hermes volta para o atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет текст агенту Hermes как сообщение в чат. Если включено «Ждать ответа», ответ Hermes вернётся в быструю команду."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni Hermes ajanınıza sohbet mesajı olarak gönderir. Yanıtı Bekle açıkken Hermes'in yanıtı kestirmeye geri döner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文本作为聊天消息发送给你的 Hermes 智能体。打开“等待回答”后，Hermes 的回复会返回给快捷指令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將文字作為聊天訊息傳送給你的 Hermes 代理。開啟「等待回答」後，Hermes 的回覆會傳回給捷徑。"
          }
        }
      }
    },
    "Message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
