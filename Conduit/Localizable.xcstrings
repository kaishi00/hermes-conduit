          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal n'a pas demandé de réponse à Hermes. Vérifiez qu'il fonctionne et que son adresse de modèle et sa clé correspondent à Réglages > Voix > Local Live."
          }
        },
        "id" : {
          "stringUnit" : {
