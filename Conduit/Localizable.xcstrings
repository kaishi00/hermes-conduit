            "state" : "translated",
            "value" : "Yanıtla ve engeli kaldır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复并解除阻塞"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆並解除受阻"
          }
        }
      }
    },
    "Reply & unblock posts your answer and moves the task back to Ready, so the next run sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Antworten & freigeben“ postet deine Antwort und verschiebt die Aufgabe zurück nach „Bereit“, damit der nächste Lauf sie sieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Responder y desbloquear» publica tu respuesta y devuelve la tarea a Listo para que la próxima ejecución la vea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Répondre et débloquer » publie votre réponse et remet la tâche dans Prêt, pour que la prochaine exécution la voie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balas & buka blokir memposting jawaban Anda dan mengembalikan tugas ke Siap, sehingga proses berikutnya melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Rispondi e sblocca» pubblica la tua risposta e riporta l’attività in Pronto, così la prossima esecuzione la vede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「返信してブロック解除」は回答を投稿し、タスクを「準備完了」に戻します。次の実行で回答が参照されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'답장하고 차단 해제'는 답변을 게시하고 작업을 '준비됨'으로 되돌려 다음 실행에서 답변을 볼 수 있게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odpowiedz i odblokuj” publikuje Twoją odpowiedź i przenosi zadanie z powrotem do „W gotowości”, aby następne uruchomienie ją zobaczyło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Responder e desbloquear” publica sua resposta e devolve a tarefa para Pronto, para que a próxima execução a veja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ответить и разблокировать» публикует ваш ответ и возвращает задачу в «Готово к работе», чтобы следующий запуск его увидел."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Yanıtla ve engeli kaldır\" yanıtınızı gönderir ve görevi Hazır'a geri taşır; böylece sonraki çalıştırma yanıtı görür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“回复并解除阻塞”会发布你的回答并将任务移回“就绪”，下一次运行即可看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「回覆並解除受阻」會發布你的回答並將任務移回「就緒」，下一次執行即可看到。"
          }
        }
      }
    },
