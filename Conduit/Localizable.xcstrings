    "This task changed on the server. Your unsaved edits are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufgabe wurde auf dem Server geändert. Deine nicht gespeicherten Änderungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tarea cambió en el servidor. Tus cambios sin guardar se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette tâche a été modifiée sur le serveur. Vos modifications non enregistrées sont conservées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugas ini berubah di server. Editan Anda yang belum disimpan tetap dipertahankan."
