    "Read aloud needs a connection to Hermes. Wait for Conduit to reconnect, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlesen erfordert eine Verbindung zu Hermes. Warte, bis Conduit wieder verbunden ist, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
