    "Promotes parent-free decomposed children to Ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuft zerlegte Unteraufgaben ohne Elternaufgabe nach „Bereit“ hoch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promociona a Listo las subtareas descompuestas sin tarea principal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promeut vers Prêt les enfants décomposés sans parent"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaikkan subtugas hasil penguraian yang tidak lagi menunggu induknya ke Siap"
