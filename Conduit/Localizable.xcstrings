    },
    "Hermes sent a reply Conduit didn't understand. Updating Hermes and Conduit usually fixes this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat eine Antwort gesendet, die Conduit nicht verstanden hat. Meist hilft es, Hermes und Conduit zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes envió una respuesta que Conduit no entendió. Normalmente se soluciona actualizando Hermes y Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a envoyé une réponse que Conduit n'a pas comprise. Mettre à jour Hermes et Conduit règle généralement le problème."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes mengirim balasan yang tidak dipahami Conduit. Memperbarui Hermes dan Conduit biasanya dapat mengatasinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ha inviato una risposta che Conduit non ha capito. Di solito si risolve aggiornando Hermes e Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesからConduitが解釈できない応答が返されました。通常はHermesとConduitをアップデートすると解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Conduit이 이해할 수 없는 응답을 보냈어요. 보통 Hermes와 Conduit을 업데이트하면 해결돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes wysłał odpowiedź, której Conduit nie rozumie. Zwykle pomaga aktualizacja Hermesa i Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes enviou uma resposta que o Conduit não entendeu. Atualizar o Hermes e o Conduit geralmente resolve isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes прислал ответ, который Conduit не понял. Обычно помогает обновление Hermes и Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, Conduit'in anlamadığı bir yanıt gönderdi. Hermes'i ve Conduit'i güncellemek genellikle sorunu çözer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 返回了 Conduit 无法识别的回复。更新 Hermes 和 Conduit 通常可以解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 傳送了 Conduit 無法理解的回覆。更新 Hermes 和 Conduit 通常可以解決此問題。"
          }
        }
      }
    },
    "Hermes turned this down because the dashboard sign-in expired or doesn't allow it. Sign in again, then try once more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat dies abgelehnt, weil die Dashboard-Anmeldung abgelaufen ist oder es nicht erlaubt. Melde dich erneut an und versuche es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lo rechazó porque el inicio de sesión del panel caducó o no lo permite. Vuelve a iniciar sesión e inténtalo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a refusé, car la connexion au tableau de bord a expiré ou ne le permet pas. Reconnectez-vous, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes menolak ini karena login dasbor sudah kedaluwarsa atau tidak mengizinkannya. Masuk lagi, lalu coba sekali lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ha rifiutato perché l'accesso alla dashboard è scaduto o non lo consente. Accedi di nuovo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダッシュボードのサインインの有効期限が切れているか許可されていないため、Hermesに拒否されました。もう一度サインインしてから、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대시보드 로그인이 만료되었거나 허용되지 않아 Hermes가 거부했어요. 다시 로그인한 다음 한 번 더 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes odrzucił to żądanie, ponieważ logowanie do panelu wygasło lub na to nie pozwala. Zaloguj się ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes recusou isso porque o login do painel expirou ou não permite essa ação. Faça login de novo e tente mais uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes отклонил запрос: срок входа в дашборд истёк или у вас нет нужных прав. Войдите снова и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel girişinin süresi dolduğu veya buna izin vermediği için Hermes bunu reddetti. Yeniden giriş yapın, ardından bir kez daha deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 拒绝了此操作，因为控制台登录已过期或无此权限。请重新登录后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儀表板登入已過期或不允許此操作，因此 Hermes 拒絕了此要求。請重新登入，然後再試一次。"
          }
        }
      }
    },
    "The dashboard address isn't valid. Check it in Settings > Connection." : {
      "localizations" : {
        "de" : {
