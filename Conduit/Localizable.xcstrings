    "This dashboard's saved sign-in and cookies will be deleted from this device. Other dashboards are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Anmeldung und die Cookies dieses Dashboards werden von diesem Gerät gelöscht. Andere Dashboards sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión y las cookies guardados de este panel se eliminarán de este dispositivo. Los demás paneles no se verán afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion enregistrée et les cookies de ce tableau de bord seront supprimés de cet appareil. Les autres tableaux de bord ne sont pas concernés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダッシュボードの保存済みのサインイン情報とCookieがこのデバイスから削除されます。ほかのダッシュボードには影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login salvo e os cookies deste painel serão apagados deste aparelho. Os outros painéis não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые данные входа и cookie этого дашборда будут удалены с этого устройства. Другие дашборды это не затронет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仪表板已保存的登录信息和 Cookie 将从此设备删除。其他仪表板不受影响。"
          }
        }
      }
    },
    "This notification belongs to a dashboard this device doesn't recognize. Add that dashboard again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mitteilung gehört zu einem Dashboard, das dieses Gerät nicht kennt. Füge das Dashboard erneut hinzu, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificación pertenece a un panel que este dispositivo no reconoce. Vuelve a añadir ese panel para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette notification provient d'un tableau de bord que cet appareil ne reconnaît pas. Ajoutez à nouveau ce tableau de bord pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通知は、このデバイスが認識していないダッシュボードからのものです。続けるには、そのダッシュボードをもう一度追加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificação pertence a um painel que este aparelho não reconhece. Adicione esse painel de novo para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это уведомление относится к дашборду, который это устройство не знает. Добавьте этот дашборд снова, чтобы продолжить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知属于此设备无法识别的仪表板。请重新添加该仪表板后继续。"
          }
        }
      }
    },
    "This notification predates multi-dashboard pairing. Update the notifier on the sending gateway and pair it again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mitteilung stammt aus der Zeit vor der Kopplung mehrerer Dashboards. Aktualisiere den Notifier auf dem sendenden Gateway und kopple ihn erneut, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificación es anterior a la vinculación con varios paneles. Actualiza el notificador en la pasarela que la envió y vuelve a vincularla para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette notification est antérieure au jumelage multi-tableaux de bord. Mettez à jour le plugin de notification sur la passerelle émettrice et jumelez-la à nouveau pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通知は複数ダッシュボードのペアリングに対応する前のものです。続けるには、送信元ゲートウェイの通知プラグインをアップデートして、もう一度ペアリングしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta notificação é anterior ao emparelhamento com vários painéis. Atualize o notificador no gateway que a enviou e emparelhe-o de novo para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это уведомление было отправлено до появления сопряжения с несколькими дашбордами. Обновите плагин уведомлений на шлюзе-отправителе и выполните сопряжение заново, чтобы продолжить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通知早于多仪表板配对。请在发送通知的网关上更新 notifier 并重新配对后继续。"
          }
        }
      }
    },
