        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit może prosić o uprawnienia głosowe tylko wtedy, gdy działa na pierwszym planie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de voz só podem ser solicitadas com o Conduit em primeiro plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения для голоса можно запросить, только когда Conduit на переднем плане."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
