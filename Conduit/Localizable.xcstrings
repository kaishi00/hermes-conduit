      }
    },
    "Couldn't reach the push relay to check compatibility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay war nicht erreichbar, um die Kompatibilität zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el relay push para comprobar la compatibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le relais push pour vérifier la compatibilité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghubungi relai push untuk memeriksa kompatibilitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il relay push per verificare la compatibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性を確認するためにプッシュリレーに接続できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환성을 확인하기 위해 푸시 릴레이에 연결하지 못했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z przekaźnikiem push, aby sprawdzić zgodność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar a retransmissão de push para verificar a compatibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с push-ретранслятором, чтобы проверить совместимость."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumluluğu denetlemek için bildirim aktarıcısına ulaşılamadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接推送中继以检查兼容性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線推播中繼以檢查相容性。"
          }
        }
      }
    },
    "The push relay no longer knows this iPhone. Turn notifications off and on again in Settings > Notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay kennt dieses iPhone nicht mehr. Schalte Mitteilungen unter Einstellungen > Mitteilungen aus und wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay push ya no reconoce este iPhone. Desactiva y vuelve a activar las notificaciones en Ajustes > Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais push ne reconnaît plus cet iPhone. Désactivez puis réactivez les notifications dans Réglages > Notifications."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relai push tidak lagi mengenali iPhone ini. Matikan lalu nyalakan lagi notifikasi di Pengaturan > Notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relay push non riconosce più questo iPhone. Disattiva e riattiva le notifiche in Impostazioni > Notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュリレーがこのiPhoneを認識できなくなりました。設定 > 通知 で通知をオフにしてから、もう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 이 iPhone을 더 이상 알지 못해요. 설정 > 알림에서 알림을 껐다가 다시 켜세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekaźnik push nie rozpoznaje już tego iPhone'a. Wyłącz i ponownie włącz powiadomienia w Ustawieniach > Powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retransmissão de push não reconhece mais este iPhone. Desative e ative novamente as notificações em Ajustes > Notificações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-ретранслятор больше не узнаёт этот iPhone. Выключите и снова включите уведомления в разделе «Настройки» > «Уведомления»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim aktarıcısı bu iPhone'u artık tanımıyor. Ayarlar > Bildirimler'de bildirimleri kapatıp yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推送中继已不再识别这台 iPhone。请在“设置”>“通知”中关闭通知后再重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推播中繼已不再識別這支 iPhone。請在「設定」>「通知」中關閉通知後再重新開啟。"
          }
        }
      }
    },
    "The push relay can't send to this build of Conduit. Check the relay's APNs settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay kann nicht an diesen Build von Conduit senden. Prüfe die APNs-Einstellungen des Relays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay push no puede enviar a esta compilación de Conduit. Revisa los ajustes de APNs del relay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais push ne peut pas envoyer à cette version de Conduit. Vérifiez les réglages APNs du relais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relai push tidak dapat mengirim ke build Conduit ini. Periksa pengaturan APNs relai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il relay push non può inviare a questa build di Conduit. Controlla le impostazioni APNs del relay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュリレーはこのビルドのConduitに送信できません。リレーのAPNs設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 이 Conduit 빌드로 보낼 수 없어요. 릴레이의 APNs 설정을 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekaźnik push nie może wysyłać do tej kompilacji Conduit. Sprawdź ustawienia APNs przekaźnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retransmissão de push não pode enviar para esta versão do Conduit. Verifique as configurações de APNs da retransmissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-ретранслятор не может отправлять в эту сборку Conduit. Проверьте настройки APNs ретранслятора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim aktarıcısı Conduit'in bu sürümüne gönderemiyor. Aktarıcının APNs ayarlarını kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推送中继无法发送到此版本的 Conduit。请检查中继的 APNs 设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推播中繼無法傳送到此版本的 Conduit。請檢查中繼的 APNs 設定。"
          }
        }
      }
    },
    "The push relay couldn't confirm this iPhone's push token. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Push-Relay konnte das Push-Token dieses iPhones nicht bestätigen. Versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay push no pudo confirmar el token push de este iPhone. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais push n'a pas pu confirmer le jeton push de cet iPhone. Réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relai push tidak dapat mengonfirmasi token push iPhone ini. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
