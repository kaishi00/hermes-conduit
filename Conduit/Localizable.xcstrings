    },
    "Your speech server answered without asking Hermes. Check that its model address and key match Settings > Voice > Local Live, then restart it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sprachserver hat geantwortet, ohne Hermes zu fragen. Prüfe, ob Modelladresse und Schlüssel mit „Einstellungen“ > „Sprachmodus“ > „Local Live“ übereinstimmen, und starte ihn dann neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de voz respondió sin preguntar a Hermes. Comprueba que su dirección de modelo y su clave coincidan con Ajustes > Voz > Local Live y luego reinícialo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal a répondu sans demander à Hermes. Vérifiez que son adresse de modèle et sa clé correspondent à Réglages > Voix > Local Live, puis redémarrez-le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server suara Anda menjawab tanpa bertanya ke Hermes. Pastikan alamat model dan kuncinya sama dengan Pengaturan > Suara > Local Live, lalu mulai ulang server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server vocale ha risposto senza chiedere a Hermes. Verifica che indirizzo del modello e chiave corrispondano a Impostazioni > Voce > Local Live, poi riavvialo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバーが Hermes に問い合わせずに応答しました。モデルアドレスとキーが「設定」>「音声」>「Local Live」と一致しているか確認してから、サーバーを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버가 Hermes에 묻지 않고 답했어요. 모델 주소와 키가 ‘설정’ > ‘음성’ > ‘Local Live’와 같은지 확인한 뒤 서버를 다시 시작하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój serwer mowy odpowiedział bez pytania Hermesa. Sprawdź, czy adres modelu i klucz zgadzają się z sekcją Ustawienia > Głos > Local Live, a potem uruchom go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor de voz respondeu sem perguntar ao Hermes. Confira se o endereço do modelo e a chave correspondem a Ajustes > Voz > Local Live e reinicie-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш речевой сервер ответил, не спросив Hermes. Проверьте, что адрес модели и ключ совпадают с «Настройки › Голос › Local Live», затем перезапустите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma sunucunuz Hermes'e sormadan yanıt verdi. Model adresi ile anahtarın Ayarlar > Ses > Local Live ile eşleştiğini denetleyin, sonra sunucuyu yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的语音服务器没有询问 Hermes 就作答了。请确认它的模型地址和密钥与「设置」>「语音」>「Local Live」一致，然后重启它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的語音伺服器沒有詢問 Hermes 就作答了。請確認它的模型位址和密鑰與「設定」>「語音」>「Local Live」一致，然後重新啟動它。"
          }
        }
      }
    },
    "Your speech server didn't ask Hermes for a reply. Check that it's running and that its model address and key match Settings > Voice > Local Live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sprachserver hat Hermes nicht nach einer Antwort gefragt. Prüfe, ob er läuft und ob Modelladresse und Schlüssel mit „Einstellungen“ > „Sprachmodus“ > „Local Live“ übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de voz no pidió una respuesta a Hermes. Comprueba que esté en marcha y que su dirección de modelo y su clave coincidan con Ajustes > Voz > Local Live."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal n'a pas demandé de réponse à Hermes. Vérifiez qu'il fonctionne et que son adresse de modèle et sa clé correspondent à Réglages > Voix > Local Live."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server suara Anda tidak meminta jawaban dari Hermes. Pastikan server berjalan dan alamat model serta kuncinya sama dengan Pengaturan > Suara > Local Live."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server vocale non ha chiesto una risposta a Hermes. Verifica che sia in esecuzione e che indirizzo del modello e chiave corrispondano a Impostazioni > Voce > Local Live."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバーが Hermes に返答を求めませんでした。サーバーが動作していること、モデルアドレスとキーが「設定」>「音声」>「Local Live」と一致していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버가 Hermes에 답변을 요청하지 않았어요. 서버가 실행 중인지, 모델 주소와 키가 ‘설정’ > ‘음성’ > ‘Local Live’와 같은지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój serwer mowy nie poprosił Hermesa o odpowiedź. Sprawdź, czy działa oraz czy adres modelu i klucz zgadzają się z sekcją Ustawienia > Głos > Local Live."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor de voz não pediu uma resposta ao Hermes. Confira se ele está em execução e se o endereço do modelo e a chave correspondem a Ajustes > Voz > Local Live."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш речевой сервер не запросил ответ у Hermes. Проверьте, что он запущен, а адрес модели и ключ совпадают с «Настройки › Голос › Local Live»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma sunucunuz Hermes'ten yanıt istemedi. Çalıştığını ve model adresi ile anahtarın Ayarlar > Ses > Local Live ile eşleştiğini denetleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的语音服务器没有向 Hermes 请求回复。请确认它正在运行，且模型地址和密钥与「设置」>「语音」>「Local Live」一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的語音伺服器沒有向 Hermes 請求回覆。請確認它正在執行，且模型位址和密鑰與「設定」>「語音」>「Local Live」一致。"
          }
        }
      }
    },
    "Your speech server refused the call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sprachserver hat den Anruf abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de voz rechazó la llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal a refusé l’appel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server suara Anda menolak panggilan."
          }
        },
        "it" : {
