    "Readable conversation content only — messages, lists, tables, and code. Buttons, timestamps, and the rest of the interface keep their size, and iOS Dynamic Type still applies on top." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットの本文（メッセージ、リスト、表、コード）のみが対象です。ボタンやタイムスタンプなど、その他のインターフェイスのサイズは変わりません。iOSのDynamic Typeも引き続き適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅调整对话内容——消息、列表、表格与代码。按钮、时间戳等其余界面保持大小不变，iOS 动态字体仍在此基础上生效。"
          }
        }
