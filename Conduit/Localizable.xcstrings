          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada verificação que encontra algo envia uma notificação. O que você pediu para ouvir com menos frequência espera pelo resumo da manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый просмотр, который что-то находит, отправляет одно уведомление. То, о чём вы просили напоминать реже, будет ждать утренней сводки."
          }
        },
        "tr" : {
          "stringUnit" : {
