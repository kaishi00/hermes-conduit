    "%@ on Hermes isn't ready (%@). This iPhone can do it instead, with nothing to install." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf Hermes ist nicht bereit (%@). Dieses iPhone kann das stattdessen übernehmen, ganz ohne Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en Hermes no está listo (%@). Este iPhone puede hacerlo en su lugar, sin instalar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sur Hermes n'est pas prêt (%@). Cet iPhone peut s'en charger à la place, sans rien installer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di Hermes belum siap (%@). iPhone ini dapat melakukannya sebagai gantinya, tanpa perlu memasang apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ su Hermes non è pronto (%@). Questo iPhone può farlo al suo posto, senza installare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesの%@は準備ができていません（%@）。代わりにこのiPhoneで処理でき、インストールは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes의 %@ 사용 준비가 되지 않았어요(%@). 대신 이 iPhone에서 처리할 수 있으며 따로 설치할 것은 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca %@ w Hermesie nie jest gotowy (%@). Zamiast niego może to robić ten iPhone, bez instalowania czegokolwiek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no Hermes não está pronto (%@). Este iPhone pode fazer isso no lugar dele, sem instalar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в Hermes не готов (%@). Вместо него можно использовать этот iPhone — ничего устанавливать не нужно."
