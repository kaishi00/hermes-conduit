    "The Siri voice request expired before Hermes was ready. Ask Siri again now that Conduit is open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachanfrage über Siri ist abgelaufen, bevor Hermes bereit war. Frag Siri jetzt erneut, da Conduit geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de voz de Siri caducó antes de que Hermes estuviera listo. Vuelve a pedírselo a Siri ahora que Conduit está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande vocale Siri a expiré avant qu'Hermes soit prêt. Redemandez à Siri maintenant que Conduit est ouvert."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan suara Siri kedaluwarsa sebelum Hermes siap. Minta Siri lagi sekarang karena Conduit sudah terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta vocale a Siri è scaduta prima che Hermes fosse pronto. Chiedi di nuovo a Siri ora che Conduit è aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesの準備が整う前にSiriの音声リクエストの有効期限が切れました。Conduitが開いている今、もう一度Siriに頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 준비되기 전에 Siri 음성 요청이 만료됐어요. Conduit이 열려 있으니 이제 Siri에게 다시 요청하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie głosowe Siri wygasło, zanim Hermes był gotowy. Conduit jest już otwarty, więc poproś Siri ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pedido de voz da Siri expirou antes de o Hermes ficar pronto. Peça à Siri novamente agora que o Conduit está aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовой запрос Siri истёк до того, как Hermes был готов. Conduit уже открыт — снова обратитесь к Siri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri sesli isteğinin süresi Hermes hazır olmadan doldu. Conduit artık açık olduğuna göre Siri'ye tekrar sorun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 语音请求在 Hermes 准备就绪前已过期。Conduit 现已打开，请再次询问 Siri。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 語音要求在 Hermes 準備就緒前已逾時。Conduit 現已開啟，請再問一次 Siri。"
          }
        }
      }
    },
