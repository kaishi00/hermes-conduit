          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retransmissão de push não conseguiu confirmar o token de push deste iPhone. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-ретранслятор не смог подтвердить push-токен этого iPhone. Попробуйте ещё раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim aktarıcısı bu iPhone'un bildirim belirtecini doğrulayamadı. Yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
