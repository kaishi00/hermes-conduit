    "This mode is saved, so Hermes refuses every subagent instead of quietly using Default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Modus ist gespeichert, daher lehnt Hermes jeden Subagenten ab, statt still den Standard zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modo está guardado, así que Hermes rechaza todos los subagentes en lugar de usar Predeterminado sin avisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mode est enregistré : Hermes refuse donc tous les sous-agents au lieu d’utiliser Par défaut sans le dire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode ini tersimpan, jadi Hermes menolak setiap subagen alih-alih diam-diam memakai Default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modalità è salvata, quindi Hermes rifiuta ogni sottoagente invece di usare Predefinito senza dirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードが保存されているため、Hermes は黙ってデフォルトを使わず、すべてのサブエージェントを拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모드가 저장되어 있어 Hermes는 조용히 기본값을 쓰는 대신 모든 하위 에이전트를 거부합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tryb jest zapisany, więc Hermes odmawia każdemu subagentowi, zamiast po cichu użyć trybu domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modo está salvo, então o Hermes recusa todo subagente em vez de usar o Padrão sem avisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот режим сохранён, поэтому Hermes отклоняет всех субагентов, а не тихо использует режим по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mod kayıtlı, bu yüzden Hermes sessizce Varsayılan'ı kullanmak yerine her alt ajanı reddeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
