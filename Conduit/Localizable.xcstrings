          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke in einer beliebigen App die Aktionstaste, und Conduit öffnet sich mit einem Bildschirmfoto davon – bereit für deine Frage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el botón de acción en cualquier app y Conduit se abre con una captura de pantalla de ella, listo para tu pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le bouton Action dans n'importe quelle app : Conduit s'ouvre avec une capture d'écran de celle-ci, prête pour votre question."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan Tombol Tindakan di app apa pun dan Conduit terbuka dengan jepretan layar app tersebut, siap untuk pertanyaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi il tasto Azione in qualsiasi app e Conduit si apre con un'istantanea dello schermo, pronto per la tua domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのAppでもアクションボタンを押すと、その画面のスクリーンショット付きでConduitが開き、すぐに質問できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱에서든 동작 버튼을 누르면 해당 화면의 스크린샷과 함께 Conduit이 열려서 바로 질문할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij przycisk czynności w dowolnej aplikacji, a Conduit otworzy się ze zrzutem jej ekranu, gotowy na Twoje pytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione o Botão de Ação em qualquer app e o Conduit abre com uma captura de tela dele, pronta para sua pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку «Действие» в любом приложении — Conduit откроется со снимком его экрана, готовый к вашему вопросу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir uygulamada Eylem düğmesine basın; Conduit o uygulamanın ekran görüntüsüyle, sorunuza hazır şekilde açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意 App 中按下操作按钮，Conduit 就会带着该屏幕的截图打开，等你提问。"
          }
        },
        "zh-Hant" : {
