    "This Hermes profile has no ready speech-to-text provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes-Profil hat keinen bereiten Anbieter für Sprache zu Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil de Hermes no tiene ningún proveedor de voz a texto listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil Hermes n'a aucun fournisseur de transcription vocale prêt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil Hermes ini tidak memiliki penyedia ucapan ke teks yang siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo Hermes non ha un provider di trascrizione vocale pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesプロファイルには、使用可能な音声認識プロバイダがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes 프로필에 준비된 음성 텍스트 변환 제공자가 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil Hermes nie ma gotowego dostawcy zamiany mowy na tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil do Hermes não tem um provedor de fala para texto pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом профиле Hermes нет готового провайдера распознавания речи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes profilinde hazır bir konuşmadan metne sağlayıcısı yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 档案没有可用的语音转文字提供方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 設定檔沒有就緒的語音轉文字供應商。"
          }
        }
      }
    },
    "This approval is no longer active — Hermes timed it out and continued." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freigabe ist nicht mehr aktiv – Hermes hat das Zeitlimit erreicht und weitergemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aprobación ya no está activa: Hermes agotó su tiempo de espera y continuó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette approbation n'est plus active : Hermes a cessé d'attendre et a continué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persetujuan ini sudah tidak aktif — waktu tunggu Hermes habis dan Hermes melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa approvazione non è più attiva: il tempo è scaduto e Hermes ha continuato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この承認は無効になりました。Hermesがタイムアウトにして処理を続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 승인 요청은 더 이상 활성 상태가 아니에요 — Hermes가 시간 초과 처리하고 계속 진행했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zatwierdzenie nie jest już aktywne — czas na odpowiedź minął i Hermes kontynuował."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aprovação não está mais ativa — o tempo dela esgotou e o Hermes continuou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот запрос разрешения больше не активен — время ожидания истекло, и Hermes продолжил работу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu onay artık etkin değil — Hermes süreyi doldurdu ve devam etti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该审批已失效——Hermes 已超时并继续执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此核准請求已失效：Hermes 已逾時並繼續進行。"
          }
        }
      }
    },
    "This branch is only for HTTPS infrastructure you already operate — Conduit does not guide you through creating one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Weg ist nur für HTTPS-Infrastruktur, die du bereits betreibst – Conduit führt dich nicht durch deren Einrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opción es solo para la infraestructura HTTPS que ya gestionas: Conduit no te guía para crear una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette option est réservée à une infrastructure HTTPS que vous exploitez déjà : Conduit ne vous guide pas pour en créer une."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsi ini hanya untuk infrastruktur HTTPS yang sudah Anda kelola — Conduit tidak memandu Anda membuatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa opzione è solo per un'infrastruttura HTTPS che gestisci già: Conduit non ti guida nella sua creazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この方法は、すでに運用しているHTTPSインフラ向けです。Conduitでは構築手順は案内しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방법은 이미 운영 중인 HTTPS 인프라 전용이에요 — Conduit은 인프라를 만드는 과정을 안내하지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta opcja jest przeznaczona tylko dla infrastruktury HTTPS, którą już utrzymujesz — Conduit nie prowadzi przez jej tworzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opção é apenas para uma infraestrutura HTTPS que você já opera — o Conduit não orienta a criação de uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот вариант только для уже имеющейся у вас HTTPS-инфраструктуры — Conduit не помогает её создать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek yalnızca zaten işlettiğiniz HTTPS altyapısı içindir — Conduit, bunu oluşturmanız konusunda size rehberlik etmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
