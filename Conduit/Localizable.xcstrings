    "Took back your last message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzte Nachricht wurde zurückgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deshizo tu último mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernier message a été annulé."
          }
        },
        "id" : {
          "stringUnit" : {
