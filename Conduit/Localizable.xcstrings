            "value" : "Metti in pausa il microfono quando ti serve una pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休憩したいときは、いつでもマイクを一時停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
