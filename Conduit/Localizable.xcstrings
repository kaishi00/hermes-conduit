    "Precise Location is off for Conduit, so saved places and Precise aren't available. Area still works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauer Standort ist für Conduit aus, daher sind gespeicherte Orte und „Genau“ nicht verfügbar. „Gegend“ funktioniert weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación exacta está desactivada para Conduit, así que los lugares guardados y «Precisa» no están disponibles. «Zona» sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position exacte est désactivée pour Conduit : les lieux enregistrés et « Précise » ne sont pas disponibles. « Zone » fonctionne toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi Akurat mati untuk Conduit, jadi tempat tersimpan dan Akurat tidak tersedia. Area tetap berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione esatta è disattivata per Conduit, quindi luoghi salvati e «Precisa» non sono disponibili. «Zona» funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitの「正確な位置情報」がオフのため、保存した場所と「正確」は使えません。「エリア」は使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit의 정확한 위치가 꺼져 있어 저장된 장소와 ‘정확한 위치’를 사용할 수 없습니다. ‘지역’은 계속 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna lokalizacja jest wyłączona dla Conduit, więc zapisane miejsca i Dokładna nie są dostępne. Okolica nadal działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Localização Precisa está desativada para o Conduit, então lugares salvos e “Precisa” não estão disponíveis. “Região” continua funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная геопозиция для Conduit выключена, поэтому сохранённые места и «Точная» недоступны. «Район» по-прежнему работает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit için Kesin Konum kapalı, bu yüzden kayıtlı yerler ve Kesin kullanılamıyor. Bölge yine çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 的“精确位置”已关闭，因此无法使用已保存的地点和“精确”。“区域”仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 的「精確位置」已關閉，因此無法使用已儲存的地點和「精確」。「區域」仍可使用。"
          }
        }
      }
    },
