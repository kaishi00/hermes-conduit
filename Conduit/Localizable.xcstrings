    "This device doesn’t appear to have a network connection. Reconnect to Wi-Fi or cellular and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät scheint keine Netzwerkverbindung zu haben. Verbinde dich wieder mit WLAN oder Mobilfunk und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no parece tener conexión de red. Vuelve a conectarte a la red Wi-Fi o a los datos móviles e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne semble pas avoir de connexion réseau. Reconnectez-vous au Wi-Fi ou au réseau cellulaire et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini tampaknya tidak memiliki koneksi jaringan. Hubungkan kembali ke Wi-Fi atau seluler, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non sembra avere una connessione di rete. Riconnettiti al Wi-Fi o alla rete cellulare e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはネットワークに接続されていないようです。Wi-Fiまたはモバイルデータ通信に再接続して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 네트워크에 연결되어 있지 않은 것 같아요. Wi-Fi 또는 셀룰러에 다시 연결하고 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że to urządzenie nie ma połączenia z siecią. Połącz się ponownie z Wi-Fi lub siecią komórkową i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este aparelho parece estar sem conexão de rede. Reconecte-se ao Wi-Fi ou à rede celular e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, у этого устройства нет подключения к сети. Подключитесь к Wi-Fi или сотовой сети и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazın ağ bağlantısı yok gibi görünüyor. Wi-Fi'ye veya hücresel ağa yeniden bağlanıp tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本设备似乎没有网络连接。请重新连接 Wi-Fi 或蜂窝网络后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置似乎沒有網路連線。請重新連接 Wi-Fi 或行動網路，然後再試一次。"
          }
        }
      }
    },
    "This file is empty." : {
      "localizations" : {
        "de" : {
