          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <mensagem>. Envia a mensagem como o próximo turno quando a resposta em andamento terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использование: /queue <сообщение>. Отправляет сообщение следующим ходом, когда текущий ответ завершится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım: /queue <mesaj>. Süren yanıt bitince mesajı sonraki tur olarak gönderir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/queue <消息>。在当前回复结束后，将消息作为下一轮发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/queue <訊息>。在目前回覆結束後，將訊息作為下一輪傳送。"
          }
        }
      }
    },
    "Conduit can only add to the queue. Use /queue <message> to queue one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann nur zur Warteschlange hinzufügen. Mit /queue <Nachricht> reihst du eine ein."
          }
        },
        "es" : {
          "stringUnit" : {
