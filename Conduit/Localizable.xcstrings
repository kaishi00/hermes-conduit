        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat è aperta in Hermes Desktop. Riprendila per inviare da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットはHermes Desktopで開かれています。ここから送信するには引き継いでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
