    "Past a limit, a finished job sends its usual notification instead of calling. These settings are this profile's, kept on your Hermes host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über einem Limit schickt ein fertiger Job seine übliche Mitteilung, statt anzurufen. Diese Einstellungen gehören zu diesem Profil und liegen auf deinem Hermes-Host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al superar un límite, un trabajo terminado envía su notificación habitual en lugar de llamar. Estos ajustes son de este perfil y se guardan en tu host de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà d'une limite, un job terminé envoie sa notification habituelle au lieu d'appeler. Ces réglages sont propres à ce profil et conservés sur votre hôte Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika melewati batas, pekerjaan yang selesai mengirim pemberitahuan biasa alih-alih menelepon. Pengaturan ini milik profil ini dan disimpan di host Hermes Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre un limite, un job terminato invia la solita notifica invece di chiamare. Queste impostazioni sono di questo profilo e restano sul tuo host Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限を超えると、完了したジョブは電話の代わりに通常の通知を送ります。これらはこのプロファイルの設定で、Hermesホストに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도를 넘으면 끝난 작업은 전화 대신 평소 알림을 보내요. 이 설정은 이 프로필의 설정이며 Hermes 호스트에 저장돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po przekroczeniu limitu zakończone zlecenie wysyła zwykłe powiadomienie zamiast dzwonić. Te ustawienia dotyczą tego profilu i są przechowywane na Twoim hoście Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima de um limite, um trabalho concluído envia a notificação de sempre em vez de ligar. Estes ajustes são deste perfil e ficam guardados no seu host Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сверх лимита завершённое задание присылает обычное уведомление вместо звонка. Эти настройки относятся к этому профилю и хранятся на вашем хосте Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sınır aşılınca, biten iş arama yerine her zamanki bildirimini gönderir. Bu ayarlar bu profile aittir ve Hermes ana makinenizde saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过限制后，完成的任务会发送平常的通知，而不是打电话。这些设置属于此档案，保存在你的 Hermes 主机上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過限制後，完成的工作會傳送平常的通知，而不是打電話。這些設定屬於此設定檔，儲存在你的 Hermes 主機上。"
          }
        }
      }
    },
    "Couldn't read Hermes' call settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anrufeinstellungen von Hermes konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la configuración de llamadas de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les réglages d'appel d'Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membaca pengaturan panggilan Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere le impostazioni delle chiamate di Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesの通話設定を読み込めませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
