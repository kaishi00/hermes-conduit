          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de fala da Apple parou. Tente novamente ou escolha outra opção de fala para texto em Ajustes > Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи Apple остановилось. Повторите попытку или выберите другой вариант распознавания речи в разделе «Настройки › Голос»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konuşma tanıma durdu. Yeniden deneyin veya Ayarlar > Ses bölümünden başka bir konuşmadan metne seçeneği seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 语音识别已停止。请重试，或在“设置 > 语音”中选择其他语音转文字选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
