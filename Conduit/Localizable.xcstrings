    "Runs on the Hermes host using its local Whisper installation—not on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft auf dem Hermes-Host mit dessen lokaler Whisper-Installation – nicht auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta en el host de Hermes con su instalación local de Whisper, no en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'exécute sur l'hôte Hermes avec son installation locale de Whisper, et non sur cet iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjalan di host Hermes menggunakan instalasi Whisper lokalnya—bukan di iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguito sull'host Hermes con la sua installazione locale di Whisper, non su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneではなく、HermesホストにインストールされたローカルのWhisperを使って実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone이 아닌 Hermes 호스트에서 로컬 Whisper 설치를 사용해 실행돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa na hoście Hermes przy użyciu jego lokalnej instalacji Whisper — nie na tym iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda no host do Hermes usando a instalação local do Whisper — não neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает на хосте Hermes с локальной установкой Whisper, а не на этом iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da değil, Hermes ana makinesinde yerel Whisper kurulumuyla çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Hermes 主机上以其本地 Whisper 安装运行，而非这台 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Hermes 主機本機安裝的 Whisper 在主機上執行，而不是在這部 iPhone 上。"
          }
        }
      }
