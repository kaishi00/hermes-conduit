    "Voice is on for %@ on this iPhone. Each step below turns green when it's ready; an orange step has a fix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sprachmodus ist für %@ auf diesem iPhone aktiv. Jeder Schritt unten wird grün, sobald er bereit ist; für einen orangen Schritt gibt es eine Lösung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz está activada para %@ en este iPhone. Cada paso de abajo se vuelve verde cuando está listo; un paso naranja tiene una solución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix est activée pour %@ sur cet iPhone. Chaque étape ci-dessous passe au vert quand elle est prête ; une étape orange propose une correction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara aktif untuk %@ di iPhone ini. Setiap langkah di bawah berubah hijau saat siap; langkah berwarna oranye memiliki perbaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce è attiva per %@ su questo iPhone. Ogni passaggio qui sotto diventa verde quando è pronto; un passaggio arancione ha una soluzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneで%@の音声がオンになっています。下の各手順は準備ができると緑色になります。オレンジ色の手順には解決方法があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 %@의 음성이 켜져 있어요. 아래 각 단계는 준비되면 초록색으로 바뀌며, 주황색 단계에는 해결 방법이 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głos jest włączony dla profilu %@ na tym iPhonie. Każdy krok poniżej zmieni kolor na zielony, gdy będzie gotowy; przy pomarańczowym kroku znajdziesz sposób naprawy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz está ativada para %@ neste iPhone. Cada etapa abaixo fica verde quando está pronta; uma etapa laranja tem uma correção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос включён для профиля %@ на этом iPhone. Каждый шаг ниже становится зелёным, когда готов; для оранжевого шага есть исправление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da %@ için ses açık. Aşağıdaki her adım hazır olduğunda yeşile döner; turuncu bir adımın bir çözümü vardır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的语音已在这台 iPhone 上开启。下方每一步就绪后会变为绿色；橙色步骤附有修复方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在這部 iPhone 上為 %@ 開啟語音。下方每個步驟就緒後會變成綠色；橘色步驟附有修正方法。"
          }
        }
      }
    },
