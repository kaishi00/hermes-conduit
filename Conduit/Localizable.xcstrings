    "Your reports, your morning brief and the news on what Hermes promised to check land here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Berichte, dein Morgenbriefing und Neues zu dem, was Hermes prüfen wollte, landen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí llegan tus informes, tu resumen matutino y las novedades sobre lo que Hermes prometió revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos rapports, votre point du matin et les nouvelles sur ce que Hermes a promis de vérifier arrivent ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan, ringkasan pagi, dan kabar tentang hal yang dijanjikan Hermes untuk dicek muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui arrivano i tuoi resoconti, il riepilogo del mattino e le novità su ciò che Hermes ha promesso di controllare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポート、朝のブリーフ、Hermesが確認すると約束したことの続報がここに届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서, 아침 브리핑, Hermes가 확인하겠다고 한 일의 소식이 여기에 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj trafiają Twoje raporty, poranny przegląd i wieści o tym, co Hermes obiecał sprawdzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus relatórios, seu resumo da manhã e as novidades sobre o que o Hermes prometeu verificar chegam aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюда приходят ваши отчёты, утренняя сводка и новости о том, что Hermes обещал проверить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporların, sabah özetin ve Hermes'in kontrol etmeye söz verdiği şeylerle ilgili haberler burada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的报告、晨间简报，以及 Hermes 答应查看之事的进展都会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的報告、晨間簡報，以及 Hermes 答應查看之事的進展都會出現在這裡。"
          }
        }
      }
    },
    "Your sign-in stays on this device." : {
      "localizations" : {
