    "Voice messages need microphone access. You can allow it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachnachrichten brauchen Zugriff auf das Mikrofon. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes de voz necesitan acceso al micrófono. Puedes permitirlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages vocaux ont besoin d’accéder au micro. Vous pouvez l’autoriser dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan suara memerlukan akses mikrofon. Anda dapat mengizinkannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi vocali richiedono l’accesso al microfono. Puoi consentirlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボイスメッセージにはマイクへのアクセスが必要です。設定で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메시지를 쓰려면 마이크 접근 권한이 필요해요. 설정에서 허용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości głosowe wymagają dostępu do mikrofonu. Możesz zezwolić na dostęp w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagens de voz precisam de acesso ao microfone. Você pode permitir em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для голосовых сообщений нужен доступ к микрофону. Его можно разрешить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
