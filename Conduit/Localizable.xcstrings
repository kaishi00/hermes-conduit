    "All providers are hidden. Tap Edit to restore one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Anbieter sind ausgeblendet. Tippe auf „Bearbeiten“, um einen wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los proveedores están ocultos. Toca Editar para restaurar uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les fournisseurs sont masqués. Touchez Modifier pour en rétablir un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua penyedia disembunyikan. Ketuk Edit untuk memulihkan salah satunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i provider sono nascosti. Tocca Modifica per ripristinarne uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプロバイダが非表示になっています。「編集」をタップすると復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 제공자가 가려져 있어요. 다시 표시하려면 ‘편집’을 탭하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszyscy dostawcy są ukryci. Stuknij „Edycja”, aby przywrócić któregoś z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os provedores estão ocultos. Toque em Editar para restaurar um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все провайдеры скрыты. Нажмите «Изменить», чтобы вернуть какой-либо из них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm sağlayıcılar gizli. Birini geri getirmek için Düzenle'ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有提供方均已隐藏。轻点“编辑”可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有供應商皆已隱藏。點一下「編輯」即可回復。"
          }
        }
      }
    },
    "Allow Hermes to maintain user preferences." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt Hermes, Nutzervorlieben zu pflegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que Hermes mantenga las preferencias del usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Hermes de conserver les préférences de l'utilisateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Hermes mengelola preferensi pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Hermes di mantenere le preferenze dell'utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがユーザの好みを管理できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 사용자 선호 사항을 관리할 수 있게 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Hermesowi na zachowywanie preferencji użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o Hermes mantenha as preferências do usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить Hermes сохранять предпочтения пользователя."
