        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только для доступа к этому дашборду под защитой Cloudflare; секрет хранится в Связке ключей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Cloudflare korumalı bu panele ulaşmak için kullanılır; gizli anahtar Anahtar Zinciri'nde kalır."
