        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Écouter quand vous êtes prêt à reprendre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Dengarkan saat Anda siap melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Ascolta quando vuoi riprendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再開する準備ができたら「聞き取る」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시작할 준비가 되면 ‘듣기’를 탭하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij „Słuchaj”, gdy zechcesz wznowić."
          }
