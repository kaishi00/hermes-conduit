    "The new plugin is already on the host. Hermes restarts its gateway and dashboard to run it, once running chats finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Plugin ist bereits auf dem Host. Hermes startet Gateway und Dashboard neu, um es zu verwenden, sobald laufende Chats fertig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo plugin ya está en el host. Hermes reinicia su pasarela y su panel para usarlo cuando terminan los chats en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau plugin est déjà sur l'hôte. Hermes redémarre sa passerelle et son tableau de bord pour l'utiliser, une fois les discussions en cours terminées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin baru sudah ada di host. Hermes memulai ulang gateway dan dasbornya untuk menjalankannya setelah chat yang berjalan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo plugin è già sull'host. Hermes riavvia il gateway e la dashboard per usarlo, al termine delle chat in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプラグインはすでにホストにあります。実行中のチャットが終わってから、Hermesがゲートウェイとダッシュボードを再起動して読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 플러그인이 이미 호스트에 있습니다. 실행 중인 채팅이 끝나면 Hermes가 게이트웨이와 대시보드를 다시 시작해 적용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowa wtyczka jest już na hoście. Hermes po zakończeniu trwających czatów uruchomi ponownie bramę i panel, aby jej użyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo plugin já está no host. O Hermes reinicia o gateway e o painel para usá-lo quando os chats em andamento terminarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый плагин уже на хосте. Hermes перезапустит шлюз и дашборд, чтобы его загрузить, когда завершатся текущие чаты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni eklenti zaten sunucuda. Hermes, çalışan sohbetler bitince onu kullanmak için ağ geçidini ve paneli yeniden başlatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新插件已在主机上。进行中的聊天结束后，Hermes 会重启网关和仪表板来加载它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新外掛程式已在主機上。進行中的聊天結束後，Hermes 會重新啟動閘道和儀表板來載入它。"
          }
        }
      }
    },
