        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대시보드에서 Pulse가 실행되고 있지 않습니다. 플러그인을 업데이트한 후 다시 시작하세요."
          }
        },
        "pl" : {
