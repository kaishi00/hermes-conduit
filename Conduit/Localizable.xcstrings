        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche una chat con una risposta non letta si apre all'inizio di quella risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未読の返信があるチャットも、その返信の先頭から開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽지 않은 답장이 있는 채팅도 그 답장의 처음부터 열려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czat z nieprzeczytaną odpowiedzią także otwiera się na początku tej odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
