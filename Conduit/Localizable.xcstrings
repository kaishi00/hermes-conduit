    "Couldn't take this chat over. Check the connection to your Hermes host and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat konnte nicht übernommen werden. Prüfe die Verbindung zu deinem Hermes-Host und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo retomar este chat. Comprueba la conexión con tu host de Hermes y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de reprendre cette discussion. Vérifiez la connexion à votre hôte Hermes et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットを引き継げませんでした。Hermesホストへの接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
