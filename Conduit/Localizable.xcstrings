    "Speech Recognition isn't allowed. Allow it for Conduit in iPhone Settings, or choose a Hermes provider under Speech to text below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracherkennung ist nicht erlaubt. Erlaube sie für Conduit in den iPhone-Einstellungen oder wähle unten unter „Sprache zu Text“ einen Hermes-Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz no está permitido. Permítelo para Conduit en los Ajustes del iPhone o elige un proveedor de Hermes en Voz a texto, más abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale n'est pas autorisée. Autorisez-la pour Conduit dans les Réglages de l'iPhone, ou choisissez un fournisseur Hermes sous Transcription vocale ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識が許可されていません。iPhoneの「設定」でConduitに許可するか、下の「音声認識」でHermesのプロバイダを選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Reconhecimento de Fala não está permitido. Permita-o para o Conduit nos Ajustes do iPhone ou escolha um provedor do Hermes em Fala para texto abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи не разрешено. Разрешите его для Conduit в Настройках iPhone или выберите провайдера Hermes в разделе «Речь в текст» ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允许语音识别。请在 iPhone 设置中为 Conduit 允许语音识别，或在下方“语音转文字”中选择 Hermes 提供商。"
          }
        }
      }
    },
