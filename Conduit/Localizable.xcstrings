      }
    },
    "Couldn't read where the terminal runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht gelesen werden, wo das Terminal läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer dónde se ejecuta la terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire où s'exécute le terminal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membaca tempat terminal berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere dove viene eseguito il terminale."
          }
