    "This Hermes profile has no ready speech-to-text provider. Set one up in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes-Profil hat keinen bereiten Anbieter für Sprache zu Text. Richte unter „Einstellungen“ > „Sprachmodus“ einen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil de Hermes no tiene ningún proveedor de voz a texto listo. Configura uno en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil Hermes n'a aucun fournisseur de transcription vocale prêt. Configurez-en un dans Réglages > Voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesプロファイルには、使用可能な音声入力（文字起こし）プロバイダがありません。「設定」>「音声」で設定してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil do Hermes não tem um provedor de fala para texto pronto. Configure um em Ajustes > Voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом профиле Hermes нет готового провайдера распознавания речи. Настройте его в разделе «Настройки › Голос»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 配置没有可用的语音转文字服务。请在「设置」>「语音」中设置。"
          }
        }
      }
    },
