          }
        }
      }
    },
    "Each summary is one more short request to your model. It reuses the chat's prompt cache and never changes the chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zusammenfassung ist eine weitere kurze Anfrage an dein Modell. Sie nutzt den Prompt-Cache des Chats und ändert den Chat nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada resumen es una solicitud breve más a tu modelo. Reutiliza la caché de prompts del chat y nunca cambia el chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque résumé est une courte requête de plus à votre modèle. Il réutilise le cache de prompt de la conversation et ne la modifie jamais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap ringkasan adalah satu permintaan singkat tambahan ke model Anda. Permintaan ini memakai ulang cache prompt obrolan dan tidak pernah mengubah obrolan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riepilogo è una breve richiesta in più al tuo modello. Riutilizza la cache dei prompt della chat e non modifica mai la chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約ごとにモデルへの短いリクエストが 1 回増えます。チャットのプロンプトキャッシュを再利用し、チャットは変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약마다 모델에 짧은 요청이 하나 더 갑니다. 채팅의 프롬프트 캐시를 재사용하며 채팅은 바꾸지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde podsumowanie to jedno dodatkowe krótkie zapytanie do modelu. Korzysta z pamięci podręcznej promptu czatu i nigdy nie zmienia czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada resumo é mais uma solicitação curta ao seu modelo. Ele reutiliza o cache de prompt do chat e nunca altera o chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая сводка — ещё один короткий запрос к модели. Он использует кеш промпта чата и никогда не меняет чат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her özet modelinize bir kısa istek daha demektir. Sohbetin istem önbelleğini yeniden kullanır ve sohbeti asla değiştirmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条摘要都会向你的模型多发一次简短请求。它复用聊天的提示缓存，绝不会更改聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每則摘要都會向你的模型多送一次簡短請求。它會重用聊天的提示快取，絕不會更改聊天。"
          }
        }
      }
    },
