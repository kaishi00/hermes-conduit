        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено для следующего переподключения. Текущий сеанс остаётся подключённым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
