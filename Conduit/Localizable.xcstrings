    },
    "This Hermes can't take a message back. Update Hermes to edit and resend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes kann keine Nachricht zurücknehmen. Aktualisiere Hermes, um zu bearbeiten und neu zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes no puede deshacer un mensaje. Actualiza Hermes para editar y reenviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Hermes ne peut pas annuler un message. Mettez Hermes à jour pour modifier et renvoyer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ini tidak bisa menarik kembali pesan. Perbarui Hermes untuk mengedit dan mengirim ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Hermes non può ritirare un messaggio. Aggiorna Hermes per modificare e reinviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Hermes ではメッセージを取り消せません。編集して再送信するには Hermes をアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes는 메시지를 되돌릴 수 없습니다. 편집 후 다시 보내려면 Hermes를 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Hermes nie może cofnąć wiadomości. Zaktualizuj Hermesa, aby edytować i wysłać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes não consegue desfazer uma mensagem. Atualize o Hermes para editar e reenviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Hermes не может отозвать сообщение. Обновите Hermes, чтобы изменять и отправлять заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes bir mesajı geri alamaz. Düzenleyip yeniden göndermek için Hermes'i güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 无法撤回消息。请更新 Hermes 以编辑并重新发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 無法收回訊息。請更新 Hermes 以編輯並重新傳送。"
          }
        }
      }
    },
    "This Hermes runs on Hermes Cloud, so Nous Research hosts what Conduit sends." : {
      "localizations" : {
        "de" : {
