    "The call's briefing (memory and persona) is too large to send to the Watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Briefing des Anrufs (Gedächtnis und Persona) ist zu groß, um es an die Watch zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contexto inicial de la llamada (memoria y persona) es demasiado grande para enviarlo al Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le briefing de l'appel (mémoire et persona) est trop volumineux pour être envoyé à l'Apple Watch."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengarahan panggilan (memori dan persona) terlalu besar untuk dikirim ke Watch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il briefing della chiamata (memoria e personalità) è troppo grande per essere inviato ad Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話のブリーフィング（メモリとペルソナ）が大きすぎて Watch に送信できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화 브리핑(메모리와 페르소나)이 너무 커서 Watch로 보낼 수 없어요."
