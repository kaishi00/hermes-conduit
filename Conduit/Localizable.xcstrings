    "Sent with every request to this server, for reverse proxies such as Pangolin, Traefik, or nginx that check a header. Values stay in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird mit jeder Anfrage an diesen Server gesendet, für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Die Werte bleiben im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envían con cada solicitud a este servidor, para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Los valores se guardan en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyés avec chaque requête à ce serveur, pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Les valeurs restent dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けに、このサーバへのすべてのリクエストとともに送信されます。値はキーチェーンに保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviados em todas as solicitações a este servidor, para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Os valores ficam nas Chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются с каждым запросом к этому серверу — для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Значения хранятся в Связке ключей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随发往此服务器的每个请求一起发送，用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。值保存在钥匙串中。"
          }
        }
      }
    },
