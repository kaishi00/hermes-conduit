    "One block with the address, key and flags, written for whoever sets up the server, such as your Hermes agent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Block mit Adresse, Schlüssel und Flags, geschrieben für den, der den Server einrichtet, etwa deinen Hermes-Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo bloque con la dirección, la clave y las opciones, escrito para quien configure el servidor, como tu agente de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul bloc avec l'adresse, la clé et les options, rédigé pour la personne qui configure le serveur, comme votre agent Hermes."
