    "A soft tone when your turn is sent and a low one if Voice fails, in the classic voice mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter Ton, wenn deine Eingabe gesendet wurde, und ein tiefer, wenn der Sprachmodus fehlschlägt – im klassischen Sprachmodus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tono suave cuando se envía tu turno y uno grave si la voz falla, en el modo de voz clásica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son doux quand votre tour est envoyé et un son grave si la voix échoue, en mode vocal classique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada lembut saat giliran Anda terkirim dan nada rendah jika Suara gagal, dalam mode suara klasik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tono leggero quando il tuo turno viene inviato e uno grave se la voce non funziona, nella modalità vocale classica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラシック音声モードで、発言が送信されると柔らかい音が、音声でエラーが起きると低い音が鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래식 음성 모드에서 사용자의 턴이 전송되면 부드러운 소리가, 음성 기능에 실패하면 낮은 소리가 나요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatny dźwięk po wysłaniu Twojej wypowiedzi i niski ton, gdy tryb głosowy zawiedzie — w klasycznym trybie głosowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um tom suave quando seu turno é enviado e um grave se a voz falhar, no modo de voz clássico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихий сигнал, когда ваша реплика отправлена, и низкий — если голосовой режим дал сбой (в классическом голосовом режиме)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasik ses modunda, isteğiniz gönderildiğinde yumuşak bir ton, Ses başarısız olursa pes bir ton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在经典语音模式下，发送你的话时播放轻柔提示音，语音失败时播放低沉提示音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在經典語音模式中，你的回合送出時會播放輕柔的提示音，語音失敗時則播放低沉的提示音。"
          }
        }
      }
    },
    "Add them on your iPhone in Settings, Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge sie auf deinem iPhone in den Einstellungen unter „Sprachmodus“ hinzu."
          }
        },
        "es" : {
