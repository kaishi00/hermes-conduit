        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è riuscito ad avviare una chat per l'istantanea. È conservata e verrà allegata quando Hermes sarà pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがスクリーンショット用のチャットを開始できませんでした。スクリーンショットは保持され、Hermesの準備ができたら添付されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
