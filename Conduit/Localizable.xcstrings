    "Remote dashboards must use HTTPS; HTTP is allowed only for local networks (localhost, private LAN, and Tailscale)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernte Dashboards müssen HTTPS verwenden; HTTP ist nur in lokalen Netzwerken erlaubt (localhost, privates LAN und Tailscale)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paneles remotos deben usar HTTPS; HTTP solo se permite en redes locales (localhost, LAN privada y Tailscale)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tableaux de bord distants doivent utiliser HTTPS ; HTTP n'est autorisé que sur les réseaux locaux (localhost, réseau local privé et Tailscale)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dasbor jarak jauh harus menggunakan HTTPS; HTTP hanya diizinkan untuk jaringan lokal (localhost, LAN pribadi, dan Tailscale)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dashboard remote devono usare HTTPS; HTTP è consentito solo sulle reti locali (localhost, LAN privata e Tailscale)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートのダッシュボードではHTTPSを使用する必要があります。HTTPはローカルネットワーク（localhost、プライベートLAN、Tailscale）でのみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 대시보드는 HTTPS를 사용해야 해요. HTTP는 로컬 네트워크(localhost, 사설 LAN, Tailscale)에서만 허용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdalne panele muszą używać HTTPS; HTTP jest dozwolony tylko w sieciach lokalnych (localhost, prywatna sieć LAN i Tailscale)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painéis remotos precisam usar HTTPS; HTTP só é permitido em redes locais (localhost, rede local privada e Tailscale)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые дашборды должны использовать HTTPS; HTTP допускается только в локальных сетях (localhost, частная локальная сеть и Tailscale)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzak paneller HTTPS kullanmalıdır; HTTP yalnızca yerel ağlarda (localhost, özel LAN ve Tailscale) kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程仪表盘必须使用 HTTPS；HTTP 仅允许用于本地网络（localhost、私有局域网和 Tailscale）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
