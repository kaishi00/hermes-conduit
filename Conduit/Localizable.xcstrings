    "Extra headers are only sent over HTTPS. Enter an https:// server address first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliche Header werden nur über HTTPS gesendet. Gib zuerst eine https://-Serveradresse ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los encabezados adicionales solo se envían por HTTPS. Escribe primero una dirección de servidor https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en-têtes supplémentaires ne sont envoyés qu'en HTTPS. Saisissez d'abord une adresse de serveur en https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加ヘッダはHTTPS経由でのみ送信されます。先にhttps://で始まるサーバアドレスを入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeçalhos extras só são enviados por HTTPS. Digite primeiro um endereço de servidor https://."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дополнительные заголовки отправляются только по HTTPS. Сначала введите адрес сервера https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外请求头仅通过 HTTPS 发送。请先输入 https:// 服务器地址。"
          }
        }
      }
    },
    "For reverse proxies such as Pangolin, Traefik, or nginx that check a header. Sent only to this server, over HTTPS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Wird nur an diesen Server gesendet, über HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Solo se envían a este servidor, por HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Envoyés uniquement à ce serveur, en HTTPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けです。HTTPS経由でこのサーバにのみ送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Enviados só para este servidor, por HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Отправляются только на этот сервер по HTTPS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。仅通过 HTTPS 发送到此服务器。"
          }
        }
      }
    },
