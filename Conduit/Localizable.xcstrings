    "One per line. Keys, env and the rest stay as they are. Change them in JSON." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eins pro Zeile. Schlüssel, env und alles andere bleiben, wie sie sind. Ändere sie im JSON."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno por línea. Las claves, env y lo demás se quedan como están. Cámbialos en el JSON."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un par ligne. Les clés, env et le reste ne changent pas. Modifiez-les dans le JSON."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu per baris. Kunci, env, dan lainnya tetap seperti semula. Ubah di JSON."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno per riga. Chiavi, env e il resto restano come sono. Modificali nel JSON."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1行に1つ。キー、envなどはそのまま残ります。変更はJSONで行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 줄에 하나씩. 키, env 등은 그대로 유지됩니다. JSON에서 변경하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden w wierszu. Klucze, env i reszta zostają bez zmian. Zmień je w JSON."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um por linha. Chaves, env e o resto ficam como estão. Altere-os no JSON."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному в строке. Ключи, env и остальное не меняются. Меняйте их в JSON."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satıra bir tane. Anahtarlar, env ve gerisi olduğu gibi kalır. Onları JSON'da değiştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
