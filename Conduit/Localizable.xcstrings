          }
        }
      }
    },
    "Hermes didn't answer in time. Check that your Hermes server is running, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesから時間内に応答がありませんでした。Hermesサーバが実行中であることを確認して、もう一度お試しください。"
          }
