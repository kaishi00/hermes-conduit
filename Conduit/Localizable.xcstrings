    "Hermes listens and replies with the speech to text and assistant voice set up above. Works with any Hermes server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hört zu und antwortet mit der oben eingerichteten Spracherkennung und Assistentenstimme. Funktioniert mit jedem Hermes-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes escucha y responde con la voz a texto y la voz del asistente configuradas arriba. Funciona con cualquier servidor Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes écoute et répond avec la transcription vocale et la voix de l'assistant configurées ci-dessus. Fonctionne avec n'importe quel serveur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes mendengarkan dan membalas dengan ucapan ke teks dan suara asisten yang disiapkan di atas. Berfungsi dengan server Hermes apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ascolta e risponde con la trascrizione vocale e la voce dell'assistente configurate sopra. Funziona con qualsiasi server Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上で設定した音声認識とアシスタントの音声を使って、Hermesが聞き取りと返答を行います。どのHermesサーバでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에서 설정한 음성 텍스트 변환과 어시스턴트 목소리로 Hermes가 듣고 답해요. 모든 Hermes 서버에서 작동해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes słucha i odpowiada, korzystając ze skonfigurowanej powyżej zamiany mowy na tekst i głosu asystenta. Działa z każdym serwerem Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes ouve e responde com a fala para texto e a voz do assistente configuradas acima. Funciona com qualquer servidor Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes слушает и отвечает с помощью распознавания речи и голоса ассистента, настроенных выше. Работает с любым сервером Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, yukarıda ayarlanan konuşmadan metne ve asistan sesiyle dinler ve yanıt verir. Her Hermes sunucusuyla çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 使用上方设置的语音转文字和助手语音来收听和回复。适用于任何 Hermes 服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 會使用上方設定的語音轉文字和助理聲音來聆聽與回覆。適用於任何 Hermes 伺服器。"
          }
        }
      }
    },
