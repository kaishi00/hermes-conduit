    "This request is no longer active — Hermes stopped waiting and continued." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage ist nicht mehr aktiv – Hermes hat aufgehört zu warten und weitergemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud ya no está activa: Hermes dejó de esperar y continuó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande n'est plus active : Hermes a cessé d'attendre et a continué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ini sudah tidak aktif — Hermes berhenti menunggu dan melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta non è più attiva: Hermes ha smesso di aspettare ed è andato avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリクエストは無効になりました。Hermesは待機をやめて続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 요청은 더 이상 활성 상태가 아니에요. Hermes가 기다리지 않고 계속 진행했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prośba nie jest już aktywna — Hermes przestał czekać i kontynuował."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido não está mais ativo — o Hermes parou de esperar e continuou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот запрос больше не активен — Hermes перестал ждать и продолжил работу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu istek artık etkin değil; Hermes beklemeyi bıraktı ve devam etti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求已失效 — Hermes 已停止等待并继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此請求已失效：Hermes 已停止等待並繼續進行。"
          }
        }
      }
    },
