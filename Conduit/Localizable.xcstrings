    "Opens a new chat with “%@” ready to send. Send it, and your iPhone rings when Hermes replies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet einen neuen Chat mit „%@“, bereit zum Senden. Sende es, und dein iPhone klingelt, wenn Hermes antwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un chat nuevo con «%@» listo para enviar. Envíalo y tu iPhone sonará cuando Hermes responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre une nouvelle discussion avec « %@ » prêt à envoyer. Envoyez-le, et votre iPhone sonne quand Hermes répond."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka obrolan baru dengan “%@” siap dikirim. Kirim, dan iPhone Anda berdering saat Hermes membalas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre una nuova chat con «%@» pronto da inviare. Invialo e l'iPhone squillerà quando Hermes risponde."
          }
        },
        "ja" : {
          "stringUnit" : {
