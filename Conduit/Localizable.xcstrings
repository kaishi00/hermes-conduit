        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 키보드에만 적용돼요. 화면 키보드의 Return 키는 바뀌지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
