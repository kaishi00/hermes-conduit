    "Qwen Live request failed. Check the model, workspace and quota." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live request failed. Check the model, workspace and quota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live 请求失败。请检查模型、业务空间和配额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live 請求失敗。請檢查模型、業務空間和配額。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live-Anfrage fehlgeschlagen. Modell, Arbeitsbereich und Kontingent prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de Qwen Live falló. Comprueba el modelo, el espacio de trabajo y la cuota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la requête Qwen Live. Vérifiez le modèle, l’espace de travail et le quota."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan Qwen Live gagal. Periksa model, ruang kerja, dan kuota."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta Qwen Live non riuscita. Controlla modello, spazio di lavoro e quota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live のリクエストに失敗しました。モデル、ワークスペース、クォータを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live 요청이 실패했습니다. 모델, 작업 공간 및 할당량을 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie Qwen Live nie powiodło się. Sprawdź model, obszar roboczy i limit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação ao Qwen Live falhou. Verifique o modelo, o espaço de trabalho e a cota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос Qwen Live не выполнен. Проверьте модель, рабочее пространство и квоту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen Live isteği başarısız oldu. Modeli, çalışma alanını ve kotayı kontrol edin."
          }
        }
      }
    },
    "Qwen didn't come back after the connection broke." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen ist nach dem Verbindungsabbruch nicht zurückgekommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen no volvió después de que se cortara la conexión."
          }
        },
        "fr" : {
