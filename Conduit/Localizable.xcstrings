    "This Hermes is too old to run Pulse. Update Hermes, then restart the dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes ist zu alt für Pulse. Aktualisiere Hermes und starte dann das Dashboard neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hermes es demasiado antiguo para ejecutar Pulse. Actualiza Hermes y luego reinicia el panel."
          }
        },
        "fr" : {
          "stringUnit" : {
