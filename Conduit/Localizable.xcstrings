        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir en segundo plano requiere el acceso a la ubicación «Siempre». Cámbialo en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
