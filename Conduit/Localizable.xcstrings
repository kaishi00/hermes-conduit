    "Archived conversations stay here until you restore or permanently delete them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivierte Unterhaltungen bleiben hier, bis du sie wiederherstellst oder endgültig löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversaciones archivadas permanecen aquí hasta que las restaures o las elimines permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations archivées restent ici jusqu'à ce que vous les restauriez ou les supprimiez définitivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan yang diarsipkan tetap di sini hingga Anda memulihkan atau menghapusnya secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversazioni archiviate restano qui finché non le ripristini o le elimini definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブしたチャットは、復元するか完全に削除するまでここに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관된 대화는 복원하거나 영구적으로 삭제할 때까지 여기에 남아 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarchiwizowane rozmowy pozostają tutaj, dopóki ich nie przywrócisz lub trwale nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas arquivadas ficam aqui até você restaurá-las ou apagá-las permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивные чаты хранятся здесь, пока вы не восстановите их или не удалите навсегда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivlenmiş konuşmalar, siz geri yükleyene veya kalıcı olarak silene kadar burada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已归档的对话会保留在这里，直到你还原或永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已封存的對話會保留在這裡，直到你回復或永久刪除它們。"
          }
        }
      }
    },
