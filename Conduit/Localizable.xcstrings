    "Share Apple Health data with Hermes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health-Daten mit Hermes teilen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir datos de Salud con Hermes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager les données Santé avec Hermes"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan data Kesehatan dengan Hermes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi i dati di Salute con Hermes"
          }
        },
        "ja" : {
