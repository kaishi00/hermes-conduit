    "This Hermes server doesn't offer voice settings. Update Hermes to use Voice. Text chat still works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Hermes-Server bietet keine Spracheinstellungen an. Aktualisiere Hermes, um den Sprachmodus zu nutzen. Der Textchat funktioniert weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
