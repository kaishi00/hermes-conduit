        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czasy i zdarzenia łączności z połączeń z zegarka, bez treści rozmów. Udostępnij dziennik przy zgłaszaniu problemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempos e eventos de conexão das chamadas do Watch, sem o que foi dito. Compartilhe-o ao relatar um problema."
