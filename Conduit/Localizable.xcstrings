    "Costs are Hermes' estimates from each model's prices, unless the provider reports what it billed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kosten schätzt Hermes anhand der Preise jedes Modells, sofern der Anbieter nicht meldet, was er berechnet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los costes son estimaciones de Hermes según los precios de cada modelo, salvo que el proveedor informe de lo que cobró."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coûts sont des estimations d’Hermes d’après les prix de chaque modèle, sauf si le fournisseur indique ce qu’il a facturé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya adalah perkiraan Hermes dari harga tiap model, kecuali penyedia melaporkan jumlah yang ditagihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I costi sono stime di Hermes basate sui prezzi di ogni modello, a meno che il fornitore non indichi quanto ha addebitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "費用は、プロバイダが請求額を報告しない限り、各モデルの価格から Hermes が見積もった値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비용은 제공업체가 청구 금액을 알려주지 않는 한 각 모델의 가격으로 Hermes가 추정한 값입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koszty to szacunki Hermes na podstawie cen każdego modelu, chyba że dostawca podaje, ile naliczył."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os custos são estimativas do Hermes com base nos preços de cada modelo, a menos que o provedor informe o que cobrou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоимость — оценка Hermes по ценам каждой модели, если поставщик не сообщает, сколько списал."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maliyetler, sağlayıcı faturaladığı tutarı bildirmediği sürece Hermes'in her modelin fiyatlarına göre yaptığı tahminlerdir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "费用是 Hermes 根据各模型价格估算的，除非提供方报告了实际收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "費用是 Hermes 依各模型價格估算的，除非供應商回報了實際收費。"
          }
        }
      }
    },
