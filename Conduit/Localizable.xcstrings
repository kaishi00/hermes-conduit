    "Missing or out of date on this dashboard's host, so features like taking chats over from Hermes Desktop won't work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt auf dem Host dieses Dashboards oder ist veraltet, daher funktionieren Funktionen wie das Übernehmen von Chats aus Hermes Desktop nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta o está desactualizado en el host de este panel, así que funciones como retomar chats de Hermes Desktop no funcionarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manquant ou obsolète sur l'hôte de ce tableau de bord : des fonctions comme la reprise des discussions d'Hermes Desktop ne fonctionneront pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada atau versinya usang di host dasbor ini, sehingga fitur seperti mengambil alih obrolan dari Hermes Desktop tidak akan berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancante o non aggiornato sull'host di questa dashboard, quindi funzioni come la ripresa delle chat da Hermes Desktop non saranno disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダッシュボードのホストにないか古いため、Hermes Desktopからのチャットの引き継ぎなどの機能が使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대시보드의 호스트에 없거나 오래된 버전이라 Hermes Desktop에서 채팅을 넘겨받는 기능 등이 작동하지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezainstalowana lub nieaktualna na hoście tego panelu, więc funkcje takie jak przejmowanie czatów z Hermes Desktop nie będą działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausente ou desatualizado no host deste painel, então recursos como assumir chats do Hermes Desktop não vão funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствует или устарел на хосте этого дашборда, поэтому такие функции, как перенос чатов из Hermes Desktop, не будут работать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panelin ana makinesinde eksik veya güncel değil; bu nedenle sohbetleri Hermes Desktop'tan devralma gibi özellikler çalışmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仪表板的主机上缺少通知插件或版本过旧，因此从 Hermes Desktop 接管对话等功能将无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此儀表板的主機上未安裝或版本過舊，因此無法使用從 Hermes Desktop 接管聊天等功能。"
          }
        }
      }
    },
