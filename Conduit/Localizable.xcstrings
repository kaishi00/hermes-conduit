    "Conduit couldn't read that image. Ask Hermes About Screen needs a screenshot or another image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte dieses Bild nicht lesen. „Hermes zum Bildschirm fragen“ benötigt ein Bildschirmfoto oder ein anderes Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo leer esa imagen. Preguntar a Hermes sobre la pantalla necesita una captura de pantalla u otra imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu lire cette image. Interroger Hermes sur l'écran nécessite une capture d'écran ou une autre image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはその画像を読み込めませんでした。「画面についてHermesに質問」にはスクリーンショットまたはほかの画像が必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu ler essa imagem. Perguntar ao Hermes Sobre a Tela precisa de uma captura de tela ou de outra imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось прочитать это изображение. Для действия «Спросить Hermes об экране» нужен снимок экрана или другое изображение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法读取该图片。「向 Hermes 询问屏幕内容」需要截图或其他图片。"
          }
        }
      }
    },
    "Conduit could not open the profile the shortcut asked for, so the screenshot is in this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte das vom Kurzbefehl angeforderte Profil nicht öffnen, daher ist das Bildschirmfoto in diesem."
          }
        },
        "es" : {
          "stringUnit" : {
