    "This iPhone can't transcribe your language on the device. Choose a Hermes provider under Speech to text below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann deine Sprache nicht auf dem Gerät transkribieren. Wähle unten unter „Sprache zu Text“ einen Hermes-Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede transcribir tu idioma en el dispositivo. Elige un proveedor de Hermes en Voz a texto, más abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas transcrire votre langue sur l'appareil. Choisissez un fournisseur Hermes sous Transcription vocale ci-dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak dapat mentranskripsikan bahasa Anda di perangkat. Pilih penyedia Hermes di Ucapan ke teks di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non può trascrivere la tua lingua sul dispositivo. Scegli un provider Hermes in Trascrizione vocale qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでは、お使いの言語をデバイス上で文字起こしできません。下の「音声認識」でHermesのプロバイダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 사용 중인 언어를 기기에서 받아쓸 수 없어요. 아래 ‘음성 텍스트 변환’에서 Hermes 제공자를 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPhone nie może lokalnie transkrybować Twojego języka. Wybierz poniżej dostawcę Hermes w sekcji „Mowa na tekst”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não consegue transcrever seu idioma no próprio aparelho. Escolha um provedor do Hermes em Fala para texto abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот iPhone не может распознавать ваш язык на устройстве. Выберите провайдера Hermes в разделе «Речь в текст» ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone, dilinizi cihaz üzerinde metne dönüştüremiyor. Aşağıdaki Konuşmadan metne bölümünden bir Hermes sağlayıcısı seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 无法在设备上转写你的语言。请在下方“语音转文字”中选择 Hermes 提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 iPhone 無法在裝置上轉寫你的語言。請在下方的「語音轉文字」中選擇 Hermes 供應商。"
          }
        }
      }
    },
