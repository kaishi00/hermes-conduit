        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar um som quando um turno ou tarefa terminar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводить звук, когда ответ или задача завершены"
