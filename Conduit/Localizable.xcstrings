    "That was interrupted before it finished. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang wurde unterbrochen, bevor er abgeschlossen war. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió antes de terminar. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'opération a été interrompue avant la fin. Réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses tersebut terputus sebelum selesai. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
