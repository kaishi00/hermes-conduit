    },
    "Hermes can call me" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes darf mich anrufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes puede llamarme"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes peut m'appeler"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes boleh menelepon saya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes può chiamarmi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesからの電話を許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 나에게 전화할 수 있음"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes może do mnie dzwonić"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes pode me ligar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes может мне звонить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes beni arayabilir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Hermes 给我打电话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Hermes 打電話給我"
          }
        }
      }
    },
    "Hermes can no longer read what was deleted. Sharing stays as it is; turn the layers off first to stop sending." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kann Gelöschtes nicht mehr lesen. Die Freigabe bleibt, wie sie ist; schalte zuerst die Ebenen aus, um das Senden zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ya no puede leer lo eliminado. Compartir sigue como está; desactiva primero las capas para dejar de enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne peut plus lire ce qui a été supprimé. Le partage reste tel quel ; désactivez d'abord les niveaux pour arrêter l'envoi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak lagi dapat membaca yang sudah dihapus. Berbagi tetap seperti semula; matikan lapisannya terlebih dahulu untuk berhenti mengirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non può più leggere ciò che è stato eliminato. La condivisione resta com'è; disattiva prima i livelli per smettere di inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したデータはHermesから読み取れなくなります。共有の設定はそのままです。送信を止めるには先に各レイヤーをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 데이터는 Hermes가 더 이상 읽을 수 없습니다. 공유 설정은 그대로이므로, 전송을 멈추려면 먼저 각 레이어를 끄세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie może już odczytać tego, co usunięto. Udostępnianie pozostaje bez zmian; aby przestać wysyłać, najpierw wyłącz warstwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não pode mais ler o que foi apagado. O compartilhamento continua como está; desligue as camadas primeiro para parar de enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes больше не может прочитать удалённое. Передача остаётся как есть; чтобы прекратить отправку, сначала выключите уровни."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes silinenleri artık okuyamaz. Paylaşım olduğu gibi kalır; göndermeyi durdurmak için önce katmanları kapat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法再读取已删除的内容。共享设置保持不变；要停止发送，请先关闭各层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 無法再讀取已刪除的內容。分享設定維持不變；若要停止傳送，請先關閉各層。"
          }
        }
      }
    },
    "Hermes can only ask for calendar changes. You approve each one unless you choose to let new items in without asking, and changes or deletions always ask." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kann Kalenderänderungen nur anfragen. Du bestätigst jede einzelne, außer du lässt neue Einträge ohne Nachfrage zu; bei Änderungen und Löschungen wird immer gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes solo puede pedir cambios en el calendario. Tú apruebas cada uno, salvo que elijas dejar entrar elementos nuevos sin preguntar; los cambios y las eliminaciones siempre se preguntan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes peut seulement demander des modifications du calendrier. Vous approuvez chacune d'elles, sauf si vous choisissez d'accepter les nouveaux éléments sans confirmation ; les modifications et suppressions demandent toujours votre accord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hanya dapat meminta perubahan kalender. Anda menyetujui setiap perubahan kecuali Anda memilih untuk mengizinkan item baru masuk tanpa bertanya, dan perubahan atau penghapusan selalu ditanyakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes può solo chiedere modifiche al calendario. Le approvi una per una, a meno che tu non scelga di far entrare i nuovi elementi senza chiedere; modifiche ed eliminazioni chiedono sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesはカレンダーの変更を依頼することしかできません。新しい項目を確認なしで追加する設定にしない限り、変更は1件ずつ承認します。変更や削除は必ず確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes는 캘린더 변경을 요청만 할 수 있어요. 새 항목을 묻지 않고 추가하도록 선택하지 않는 한 하나하나 직접 승인하며, 변경이나 삭제는 항상 물어봐요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes może jedynie prosić o zmiany w kalendarzu. Zatwierdzasz każdą z nich, chyba że zezwolisz na dodawanie nowych elementów bez pytania; o zmiany i usunięcia Hermes zawsze pyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes só pode pedir alterações no calendário. Você aprova cada uma, a menos que escolha deixar novos itens entrarem sem perguntar; alterações e exclusões sempre pedem confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes может только запрашивать изменения в календаре. Вы одобряете каждое из них, если не разрешите добавлять новые элементы без запроса; об изменениях и удалениях Hermes спрашивает всегда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes yalnızca takvim değişikliği isteyebilir. Yeni öğelerin sormadan eklenmesini seçmedikçe her birini siz onaylarsınız; değişiklikler ve silmeler için her zaman sorulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 只能请求更改日历。除非你选择让新项目无需询问即可加入，否则每项更改都需要你批准；修改或删除始终会询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 只能要求變更行事曆。除非你選擇讓新項目不經詢問即可加入，否則每項變更都需要你核准；修改或刪除一律會詢問。"
          }
        }
      }
    },
    "Hermes can't ask this iPhone for a fresh position yet; it uses the last one sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kann dieses iPhone noch nicht nach einem aktuellen Standort fragen; es nutzt den zuletzt gesendeten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes aún no puede pedir a este iPhone una posición actual; usa la última enviada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne peut pas encore demander une position récente à cet iPhone ; il utilise la dernière envoyée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes belum dapat meminta posisi terbaru dari iPhone ini; ia memakai posisi terakhir yang dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non può ancora chiedere a questo iPhone una posizione aggiornata; usa l'ultima inviata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesはまだこのiPhoneに最新の位置を問い合わせられません。最後に送信された位置を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes는 아직 이 iPhone에 최신 위치를 요청할 수 없어 마지막으로 보낸 위치를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie może jeszcze poprosić tego iPhone’a o świeżą pozycję; używa ostatnio wysłanej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes ainda não pode pedir uma posição atual a este iPhone; ele usa a última enviada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes пока не может запросить у этого iPhone свежую позицию; он использует последнюю отправленную."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes henüz bu iPhone'dan yeni bir konum isteyemiyor; en son gönderileni kullanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 暂时还不能向这台 iPhone 请求最新位置；它会使用最后发送的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 目前還無法向這部 iPhone 要求最新位置；它會使用最後傳送的位置。"
          }
        }
      }
    },
    "Hermes can't ask this iPhone for a fresh position: the notification relay doesn't have its location token yet. Keep notifications on and open Conduit again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kann dieses iPhone nicht nach einem aktuellen Standort fragen: Das Mitteilungs-Relay hat sein Standort-Token noch nicht. Lass Mitteilungen eingeschaltet und öffne Conduit gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no puede pedir a este iPhone una posición actual: el relé de notificaciones aún no tiene su token de ubicación. Mantén las notificaciones activadas y vuelve a abrir Conduit en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne peut pas demander une position récente à cet iPhone : le relais de notifications n’a pas encore son jeton de localisation. Laissez les notifications activées et rouvrez Conduit dans un instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak dapat meminta posisi terbaru dari iPhone ini: relai notifikasi belum memiliki token lokasinya. Biarkan notifikasi tetap aktif dan buka Conduit lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non può chiedere a questo iPhone una posizione aggiornata: il relay delle notifiche non ha ancora il suo token di posizione. Lascia attive le notifiche e riapri Conduit tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesはこのiPhoneに最新の位置を問い合わせられません。通知リレーがまだ位置情報トークンを持っていません。通知をオンのままにして、少ししてからConduitをもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 이 iPhone에 최신 위치를 요청할 수 없습니다. 알림 릴레이에 아직 위치 토큰이 없습니다. 알림을 켜 둔 채 잠시 후 Conduit을 다시 열어 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie może poprosić tego iPhone’a o świeżą pozycję: przekaźnik powiadomień nie ma jeszcze jego tokenu lokalizacji. Zostaw powiadomienia włączone i za chwilę otwórz Conduit ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não pode pedir uma posição atual a este iPhone: o relay de notificações ainda não tem o token de localização dele. Mantenha as notificações ativadas e abra o Conduit de novo em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не может запросить у этого iPhone свежую позицию: у ретранслятора уведомлений пока нет его токена геопозиции. Оставьте уведомления включёнными и откройте Conduit снова через минуту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bu iPhone'dan yeni bir konum isteyemiyor: bildirim aktarıcısında henüz konum belirteci yok. Bildirimleri açık tut ve birazdan Conduit'i yeniden aç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法向这台 iPhone 请求最新位置：通知中继还没有它的位置令牌。请保持通知开启，稍后再次打开 Conduit。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 無法向這部 iPhone 要求最新位置：通知中繼還沒有它的位置權杖。請保持通知開啟，稍後再次開啟 Conduit。"
          }
        }
      }
    },
