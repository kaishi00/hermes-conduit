        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słucha, dopóki ponownie nie stukniesz dwukrotnie, aby wysłać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouve até você tocar duas vezes de novo para enviar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушает, пока вы снова не коснетесь дважды для отправки"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göndermek için yeniden iki kez dokunana kadar dinler"
          }
