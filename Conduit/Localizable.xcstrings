          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 이 내용을 채팅에서 이미 진행 중인 답장에 추가했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes dołączył to do odpowiedzi, która już trwa w czacie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes adicionou isto à resposta que já está em andamento no chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes добавил это к ответу, который уже формируется в чате."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bunu sohbette zaten devam eden yanıta ekledi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 已将此内容并入对话中正在进行的回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
