    "This only changes how the default profile is named in Conduit. Hermes itself still uses the default profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ändert nur, wie das Standardprofil in Conduit heißt. Hermes selbst verwendet weiterhin das Standardprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo cambia cómo se llama el perfil predeterminado en Conduit. Hermes sigue usando el perfil predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela modifie uniquement le nom du profil par défaut dans Conduit. Hermes continue d'utiliser le profil par défaut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini hanya mengubah nama profil default di Conduit. Hermes sendiri tetap menggunakan profil default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo il nome del profilo predefinito in Conduit. Hermes continua a usare il profilo predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitでのデフォルトプロファイルの表示名だけが変わります。Hermes自体は引き続きデフォルトプロファイルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit에서 기본 프로필의 이름만 바뀌어요. Hermes 자체는 계속 기본 프로필을 사용해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia to tylko nazwę profilu domyślnego w Conduit. Sam Hermes nadal używa profilu domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso só muda o nome do perfil padrão no Conduit. O próprio Hermes continua usando o perfil padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняется только название профиля по умолчанию в Conduit. Сам Hermes по-прежнему использует профиль по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yalnızca varsayılan profilin Conduit'te nasıl adlandırıldığını değiştirir. Hermes'in kendisi varsayılan profili kullanmaya devam eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只更改 Conduit 中默认配置档案的命名方式。Hermes 本身仍使用默认配置档案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這只會更改預設設定檔在 Conduit 中的名稱。Hermes 本身仍使用預設設定檔。"
          }
        }
      }
    },
    "This permanently deletes the conversation and cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Unterhaltung endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la conversación permanentemente y no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement la conversation et est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghapus percakapan secara permanen dan tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina definitivamente la conversazione e non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは完全に削除され、元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 영구적으로 삭제되며 되돌릴 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie rozmowy. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga a conversa permanentemente e não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат будет удалён навсегда. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem konuşmayı kalıcı olarak siler ve geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将永久删除该对话，且无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除對話，且無法還原。"
          }
        }
      }
    },
    "This permanently removes the task from the selected Hermes board." : {
      "localizations" : {
