    "Make sure a Service Auth policy allows that token to reach this Access application." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass eine Service-Auth-Richtlinie diesem Token den Zugriff auf diese Access-Anwendung erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que una política Service Auth permita que ese token llegue a esta aplicación de Access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez qu'une stratégie Service Auth autorise ce jeton à accéder à cette application Access."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan kebijakan Service Auth mengizinkan token tersebut menjangkau aplikasi Access ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che una policy Service Auth consenta a quel token di raggiungere questa applicazione Access."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Authポリシーで、そのトークンがこのAccessアプリケーションにアクセスできるよう許可されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Auth 정책에서 해당 토큰이 이 Access 애플리케이션에 접근하도록 허용하는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że zasada Service Auth zezwala temu tokenowi na dostęp do tej aplikacji Access."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se uma política Service Auth permite que esse token acesse este aplicativo Access."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что политика Service Auth разрешает этому токену доступ к этому приложению Access."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Service Auth politikasının bu token'ın bu Access uygulamasına ulaşmasına izin verdiğinden emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保某条 Service Auth 策略允许该令牌访问此 Access 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認有 Service Auth 政策允許該權杖存取此 Access 應用程式。"
          }
        }
      }
    },
