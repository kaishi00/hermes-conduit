    "How many times Hermes retries a failed model request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft Hermes eine fehlgeschlagene Modellanfrage wiederholt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas veces reintenta Hermes una solicitud al modelo que falló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de nouvelles tentatives de Hermes après l'échec d'une requête au modèle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa kali Hermes mengulang permintaan model yang gagal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante volte Hermes riprova una richiesta al modello non riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗したモデルへのリクエストを Hermes が再試行する回数です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 실패한 모델 요청을 다시 시도하는 횟수입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile razy Hermes ponawia nieudane zapytanie do modelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas vezes o Hermes tenta de novo uma solicitação ao modelo que falhou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько раз Hermes повторяет неудачный запрос к модели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
