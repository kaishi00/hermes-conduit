    "The Conduit notifier plugin gave an unexpected answer. Update it on your Hermes host and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Conduit-Notifier-Plug-in hat unerwartet geantwortet. Aktualisiere es auf deinem Hermes-Host und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin de notificaciones de Conduit dio una respuesta inesperada. Actualízalo en tu host de Hermes y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin de notification Conduit a donné une réponse inattendue. Mettez-le à jour sur votre hôte Hermes et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin notifier Conduit memberikan jawaban yang tidak terduga. Perbarui di host Hermes Anda dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plugin di notifica di Conduit ha dato una risposta imprevista. Aggiornalo sul tuo host Hermes e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit通知プラグインから予期しない応答がありました。Hermesホストでアップデートしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 알림 플러그인이 예상치 못한 응답을 보냈어요. Hermes 호스트에서 업데이트한 후 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczka powiadomień Conduit zwróciła nieoczekiwaną odpowiedź. Zaktualizuj ją na hoście Hermes i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin notificador do Conduit deu uma resposta inesperada. Atualize-o no seu host Hermes e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагин уведомлений Conduit дал неожиданный ответ. Обновите его на хосте Hermes и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bildirim eklentisi beklenmeyen bir yanıt verdi. Hermes ana makinenizde güncelleyip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 通知插件返回了意外的响应。请在 Hermes 主机上更新它后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 通知外掛程式傳回了非預期的回應。請在 Hermes 主機上更新它，然後再試一次。"
          }
        }
      }
    },
