    "This chat never resets — compacting instead. Bot chats are one continuous conversation; for a throwaway session with this bot, use Sessions mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat wird nie zurückgesetzt – stattdessen wird komprimiert. Bot-Chats sind eine durchgehende Unterhaltung; für eine Wegwerf-Sitzung mit diesem Bot nutze den Modus „Sitzungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat nunca se reinicia: se compacta en su lugar. Los chats de bot son una única conversación continua; para una sesión desechable con este bot, usa el modo Sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette discussion n'est jamais réinitialisée : elle est compactée à la place. Les discussions de bot forment une seule conversation continue ; pour une session jetable avec ce bot, utilisez le mode Sessions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットはリセットされないため、代わりに圧縮します。ボットとのチャットは1つの連続した会話です。このボットと使い捨てのセッションを行うには、「セッション」モードを使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat nunca é redefinido — compactando em vez disso. Chats de bot são uma conversa contínua; para uma sessão descartável com este bot, use o modo Sessões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат никогда не сбрасывается — вместо этого он сжимается. Чат с ботом — это один непрерывный разговор; для одноразового сеанса с этим ботом используйте режим «Сеансы»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话永不重置——改为压缩。Bot 对话是一条连续的对话；如需与该 Bot 的临时会话，请使用“会话”模式。"
          }
        }
      }
    },
    "This bot chat never resets. Remove the attachments to compact it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bot-Chat wird nie zurückgesetzt. Entferne die Anhänge, um ihn stattdessen zu komprimieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat de bot nunca se reinicia. Quita los archivos adjuntos para compactarlo en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette discussion de bot n'est jamais réinitialisée. Retirez les pièces jointes pour la compacter à la place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボットチャットはリセットされません。代わりに圧縮するには、添付ファイルを削除してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat de bot nunca é redefinido. Remova os anexos para compactá-lo em vez disso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат с ботом никогда не сбрасывается. Удалите вложения, чтобы вместо этого сжать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Bot 对话永不重置。请移除附件，改为压缩对话。"
          }
        }
      }
    },
