    },
    "%@ is larger than the %@ MB attachment limit. You can raise the limit in Settings › Chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ überschreitet das Anhanglimit von %@ MB. Du kannst das Limit unter „Einstellungen › Chat“ erhöhen."
          }
        },
        "es" : {
          "stringUnit" : {
