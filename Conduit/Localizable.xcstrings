    "Write to protected agent-instruction file(s): %@. These files steer future agent behavior; approval is always required (not bypassed by auto-approve)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In geschützte Agent-Anweisungsdatei(en) schreiben: %@. Diese Dateien steuern das künftige Verhalten des Agenten; eine Freigabe ist immer nötig (die automatische Freigabe gilt hier nicht)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir en archivos protegidos de instrucciones del agente: %@. Estos archivos guían el comportamiento futuro del agente; siempre requieren aprobación (la aprobación automática no se aplica)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire dans un ou plusieurs fichiers protégés d'instructions de l'agent : %@. Ces fichiers orientent le comportement futur de l'agent ; une approbation est toujours requise (l'approbation automatique ne s'applique pas)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menulis ke berkas instruksi agen yang dilindungi: %@. Berkas ini mengarahkan perilaku agen ke depannya; persetujuan selalu diperlukan (tidak dilewati oleh persetujuan otomatis)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivere in file protetti di istruzioni dell'agente: %@. Questi file guidano il comportamento futuro dell'agente; l'approvazione è sempre richiesta (l'approvazione automatica non si applica)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保護されたエージェント指示ファイルへの書き込み：%@。これらのファイルは今後のエージェントの動作を左右するため、常に承認が必要です（自動承認では省略されません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 에이전트 지침 파일에 쓰기: %@. 이 파일들은 앞으로의 에이전트 동작을 좌우하므로 항상 승인이 필요해요(자동 승인으로 건너뛸 수 없어요)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapis do chronionych plików z instrukcjami agenta: %@. Te pliki kierują przyszłym zachowaniem agenta; zatwierdzenie jest zawsze wymagane (automatyczne zatwierdzanie go nie pomija)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrever em arquivo(s) protegido(s) de instruções do agente: %@. Esses arquivos orientam o comportamento futuro do agente; a aprovação é sempre necessária (a aprovação automática não se aplica)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись в защищённые файлы инструкций агента: %@. Эти файлы управляют дальнейшим поведением агента; разрешение нужно всегда (автоодобрение его не обходит)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korumalı ajan talimat dosyalarına yazma: %@. Bu dosyalar ajanın gelecekteki davranışını yönlendirir; her zaman onay gerekir (otomatik onay bunu atlamaz)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入受保护的智能体指令文件：%@。这些文件会影响智能体今后的行为，因此始终需要批准（自动批准不会跳过）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入受保護的代理指示檔案：%@。這些檔案會影響代理日後的行為，因此一律需要核准（自動核准不會略過）。"
          }
        }
      }
    },
