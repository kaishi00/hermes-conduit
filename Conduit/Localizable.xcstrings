    "Send gives Hermes this value. Skip lets it continue without one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Senden“ gibt Hermes diesen Wert. „Überspringen“ lässt Hermes ohne Wert weitermachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar le da a Hermes este valor. Omitir le permite continuar sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer transmet cette valeur à Hermes. Ignorer le laisse continuer sans valeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信」するとこの値がHermesに渡されます。「スキップ」すると値なしで続行します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar entrega este valor ao Hermes. Pular deixa que ele continue sem um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отправить» передаст Hermes это значение. «Пропустить» позволит продолжить без него."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“发送”会把这个值交给 Hermes；“跳过”则让它在没有该值的情况下继续。"
          }
        }
      }
    },
