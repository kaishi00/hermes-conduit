    },
    "This chat is open in %@. Take it over to send from here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话已在 %@ 中打开。接管后即可在这里发送。"
          }
        }
      }
    },
    "This chat is open in Conduit on another device or in the Hermes web chat. Send from there, or close it there and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话已在另一台设备上的 Conduit 或 Hermes 网页聊天中打开。请在那里发送，或在那里关闭后重试。"
          }
        }
      }
    },
    "Update the Conduit notifier plugin on your Hermes host to take chats over." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 主机上的 Conduit 通知插件以接管对话。"
          }
        }
      }
    },
    "a Hermes terminal" : {
      "localizations" : {
        "zh-Hans" : {
