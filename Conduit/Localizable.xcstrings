          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат с непрочитанным ответом тоже открывается в начале этого ответа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okunmamış yanıtı olan bir sohbet de o yanıtın başında açılır."
