          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш хост Hermes не предоставляет GPT-Live для часов. Обновите плагин уведомлений Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ana makineniz Watch için GPT-Live sunmuyor. Conduit bildirim eklentisini güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
