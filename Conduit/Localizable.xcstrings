            "value" : "配置默认"
          }
        }
      }
    },
    "The model Hermes uses for background jobs started by voice. A fast model with low reasoning keeps spoken requests quick; your chats keep the profile's model." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 用于语音启动的后台任务的模型。选择快速模型和低推理强度可以让语音请求更快；你的聊天仍使用配置的模型。"
          }
        }
      }
