    "Saving moves this iPhone to the new relay. You'll need to pair each Hermes profile again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern wechselt dieses iPhone zum neuen Relay. Du musst jedes Hermes-Profil erneut koppeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar, este iPhone pasa al nuevo relay. Tendrás que volver a vincular cada perfil de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement fait passer cet iPhone au nouveau relais. Vous devrez jumeler à nouveau chaque profil Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan akan memindahkan iPhone ini ke relai baru. Anda perlu memasangkan setiap profil Hermes lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvando, questo iPhone passa al nuovo relay. Dovrai abbinare di nuovo ogni profilo Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存すると、このiPhoneは新しいリレーに移行します。各Hermesプロファイルをもう一度ペアリングする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 이 iPhone이 새 릴레이로 이동해요. 각 Hermes 프로필을 다시 페어링해야 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisanie przeniesie ten iPhone do nowego przekaźnika. Trzeba będzie ponownie sparować każdy profil Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar move este iPhone para a nova retransmissão. Você precisará emparelhar cada perfil do Hermes de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сохранении этот iPhone перейдёт на новый ретранслятор. Потребуется заново выполнить сопряжение для каждого профиля Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetmek, bu iPhone'u yeni aktarıcıya taşır. Her Hermes profilini yeniden eşlemeniz gerekecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
