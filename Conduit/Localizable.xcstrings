          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesからの電話を許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 나에게 전화할 수 있음"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes może do mnie dzwonić"
          }
        },
        "pt-BR" : {
