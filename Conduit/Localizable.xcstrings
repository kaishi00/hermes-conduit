          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesサーバにHermes通知プラグインをインストールまたはアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버에 Hermes 알림 플러그인을 설치하거나 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
