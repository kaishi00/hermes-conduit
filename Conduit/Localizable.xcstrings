    "Couldn't cancel %@. It may still be running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht abgebrochen werden. Möglicherweise läuft es noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cancelar %@. Puede que siga en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'annuler %@. Il est peut-être toujours en cours."
          }
        },
        "id" : {
