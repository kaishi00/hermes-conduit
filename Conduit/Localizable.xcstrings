    "Hermes couldn't open Local Live for the Watch. Update the Conduit notifier plugin and the push relay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte Local Live für die Watch nicht öffnen. Aktualisiere das Conduit-Notifier-Plug-in und das Push-Relay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo abrir Local Live para el Apple Watch. Actualiza el plugin de notificaciones de Conduit y el relay push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n'a pas pu ouvrir Local Live pour l'Apple Watch. Mettez à jour le plugin de notification Conduit et le relais push."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes tidak dapat membuka Local Live untuk Watch. Perbarui plugin notifier Conduit dan relai push."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è riuscito ad aprire Local Live per Apple Watch. Aggiorna il plugin di notifica di Conduit e il relay push."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes は Watch 用の Local Live を開けませんでした。Conduit 通知プラグインとプッシュリレーをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Watch용 Local Live를 열 수 없었어요. Conduit 알림 플러그인과 푸시 릴레이를 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
