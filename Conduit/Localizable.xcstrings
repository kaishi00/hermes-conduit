    "Attachments can only be sent in a new message, after the current response finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhänge können nur in einer neuen Nachricht gesendet werden, nachdem die aktuelle Antwort fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos adjuntos solo se pueden enviar en un mensaje nuevo, cuando termine la respuesta actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes ne peuvent être envoyées que dans un nouveau message, une fois la réponse en cours terminée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lampiran hanya dapat dikirim dalam pesan baru, setelah respons saat ini selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allegati possono essere inviati solo in un nuovo messaggio, al termine della risposta attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルは、現在の応答が完了した後に新しいメッセージでのみ送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첨부 파일은 현재 응답이 끝난 후 새 메시지로만 보낼 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załączniki można wysłać tylko w nowej wiadomości, po zakończeniu bieżącej odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os anexos só podem ser enviados em uma nova mensagem, depois que a resposta atual terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложения можно отправить только в новом сообщении, когда текущий ответ будет завершён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekler yalnızca geçerli yanıt bittikten sonra yeni bir mesajla gönderilebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件只能在当前回复结束后随新消息发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件只能在目前的回覆結束後，隨新訊息一起傳送。"
          }
        }
      }
    },
