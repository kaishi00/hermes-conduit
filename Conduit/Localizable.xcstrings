    "Default uses Hermes' resolved default assignee (%@). Parked leaves the task unassigned so no worker claims it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default uses Hermes' resolved default assignee (%@). Parked leaves the task unassigned so no worker claims it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デフォルト」では、Hermesが決定したデフォルトの担当者（%@）を使用します。「保留」では、タスクを未割り当てのままにして、どのワーカーにも引き受けられないようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 Hermes 解析出的默认负责人（%@）。「搁置」会让任务保持未分配，因此不会有工作代理认领。"
          }
        }
      }
    },
