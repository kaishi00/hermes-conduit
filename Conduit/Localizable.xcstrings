    "Wait for the current conversation change to finish, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis die aktuelle Änderung an der Unterhaltung abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine el cambio de conversación actual y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin du changement de conversation en cours, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu hingga perubahan percakapan saat ini selesai, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi che finisca il cambio di conversazione in corso, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のチャットの変更が完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 대화 변경이 끝날 때까지 기다린 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj na zakończenie bieżącej zmiany rozmowy, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a alteração atual da conversa terminar e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь завершения текущего изменения чата и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli konuşma değişikliğinin bitmesini bekleyin, ardından yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待当前对话更改完成后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等目前的對話變更完成，然後再試一次。"
          }
        }
      }
    },
    "Wait for the reply to finish, or /stop it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis die Antwort fertig ist, oder beende sie mit /stop, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine la respuesta, o detenla con /stop, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin de la réponse, ou arrêtez-la avec /stop, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunggu balasan selesai, atau hentikan dengan /stop, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi che la risposta finisca, o fermala con /stop, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信が終わるのを待つか /stop で止めてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답장이 끝날 때까지 기다리거나 /stop으로 멈춘 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj, aż odpowiedź się skończy, albo zatrzymaj ją przez /stop, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a resposta terminar, ou pare-a com /stop, e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь окончания ответа или остановите его через /stop, затем попробуйте снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtın bitmesini bekleyin ya da /stop ile durdurun, sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待回复完成，或用 /stop 停止它，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等待回覆完成，或用 /stop 停止它，然後重試。"
          }
        }
      }
    },
