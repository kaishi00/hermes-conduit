            "value" : "Du kannst das Limit in Conduit unter Einstellungen › Chat erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can raise the limit in Conduit's Settings › Chat."
          }
        },
