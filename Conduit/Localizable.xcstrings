    "Play a sound when a turn or task finishes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton abspielen, wenn ein Durchgang oder eine Aufgabe endet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducir un sonido cuando termine un turno o una tarea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émettre un son quand un tour ou une tâche se termine"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar bunyi saat giliran atau tugas selesai"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci un suono al termine di un turno o di un'attività"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンまたはタスクの完了時にサウンドを再生"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "턴이나 태스크가 끝나면 사운드 재생"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzaj dźwięk po zakończeniu odpowiedzi lub zadania"
