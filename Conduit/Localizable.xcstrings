        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aramanın brifingi (bellek ve persona), Watch'a gönderilemeyecek kadar büyük."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
