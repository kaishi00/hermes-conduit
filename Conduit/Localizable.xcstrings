        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa attività è cambiata sul server. Le modifiche non salvate vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタスクはサーバ上で変更されました。保存していない編集内容は保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 태스크가 서버에서 변경됐어요. 저장하지 않은 편집 내용은 그대로 유지돼요."
