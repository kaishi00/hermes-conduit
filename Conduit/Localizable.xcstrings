          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin、Traefik、nginxなど、ヘッダをチェックするリバースプロキシ向けです。HTTPS経由でこのサーバにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤더를 확인하는 Pangolin, Traefik, nginx 같은 리버스 프록시용이에요. HTTPS를 통해 이 서버에만 전송돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla odwrotnych serwerów proxy, takich jak Pangolin, Traefik czy nginx, które sprawdzają nagłówek. Wysyłane tylko do tego serwera, przez HTTPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies reversos como Pangolin, Traefik ou nginx que verificam um cabeçalho. Enviados só para este servidor, por HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обратных прокси (например, Pangolin, Traefik или nginx), которые проверяют заголовок. Отправляются только на этот сервер по HTTPS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pangolin, Traefik veya nginx gibi bir üstbilgiyi denetleyen ters proxy'ler için. Yalnızca bu sunucuya, HTTPS üzerinden gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
