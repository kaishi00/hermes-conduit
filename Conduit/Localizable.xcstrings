        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少使用两个词，例如“%@”。如果 Conduit 听错了名字，可以再添加一种拼写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請至少使用兩個字詞，例如「%@」。如果 Conduit 聽錯名稱，可以再加入一種拼法。"
          }
        }
      }
