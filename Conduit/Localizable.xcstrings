    "This Hermes server doesn't offer voice settings. Update Hermes to use Voice. Text chat still works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Hermes-Server bietet keine Spracheinstellungen an. Aktualisiere Hermes, um den Sprachmodus zu nutzen. Der Textchat funktioniert weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor Hermes no ofrece ajustes de voz. Actualiza Hermes para usar la voz. El chat de texto sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur Hermes ne propose pas de réglages vocaux. Mettez à jour Hermes pour utiliser la voix. La discussion textuelle fonctionne toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Hermes ini tidak menyediakan pengaturan suara. Perbarui Hermes untuk menggunakan Suara. Obrolan teks tetap berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server Hermes non offre impostazioni vocali. Aggiorna Hermes per usare la voce. La chat testuale funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesサーバは音声設定に対応していません。音声を使用するにはHermesをアップデートしてください。テキストチャットは引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes 서버는 음성 설정을 제공하지 않아요. 음성을 사용하려면 Hermes를 업데이트하세요. 텍스트 채팅은 계속 사용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer Hermes nie udostępnia ustawień głosu. Zaktualizuj Hermesa, aby korzystać z trybu głosowego. Czat tekstowy nadal działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor Hermes não oferece ajustes de voz. Atualize o Hermes para usar a voz. O chat por texto continua funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер Hermes не поддерживает настройки голоса. Обновите Hermes, чтобы пользоваться голосом. Текстовый чат по-прежнему работает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes sunucusu ses ayarları sunmuyor. Ses'i kullanmak için Hermes'i güncelleyin. Yazılı sohbet çalışmaya devam eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 服务器不提供语音设置。请更新 Hermes 以使用语音。文字聊天仍可正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 伺服器不提供語音設定。請更新 Hermes 以使用語音。文字聊天仍可正常使用。"
          }
        }
      }
    },
    "Conduit couldn't read audio from this microphone. Try again, or switch to another microphone or headset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte kein Audio von diesem Mikrofon lesen. Versuche es erneut oder wechsle zu einem anderen Mikrofon oder Headset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo leer el audio de este micrófono. Vuelve a intentarlo o cambia a otro micrófono o auricular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu lire l'audio de ce micro. Réessayez, ou passez à un autre micro ou casque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat membaca audio dari mikrofon ini. Coba lagi, atau beralih ke mikrofon atau headset lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a leggere l'audio da questo microfono. Riprova o passa a un altro microfono o auricolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはこのマイクから音声を読み取れませんでした。もう一度試すか、別のマイクまたはヘッドセットに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 이 마이크에서 오디오를 읽을 수 없었어요. 다시 시도하거나 다른 마이크나 헤드셋으로 전환하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł odczytać dźwięku z tego mikrofonu. Spróbuj ponownie lub przełącz się na inny mikrofon albo zestaw słuchawkowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu ler o áudio deste microfone. Tente novamente ou troque para outro microfone ou fone de ouvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось получить звук с этого микрофона. Повторите попытку или переключитесь на другой микрофон или гарнитуру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu mikrofondan ses okuyamadı. Yeniden deneyin veya başka bir mikrofona ya da kulaklığa geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法读取此麦克风的音频。请重试，或换用其他麦克风或耳机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法從此麥克風讀取音訊。請再試一次，或改用其他麥克風或耳機。"
          }
        }
      }
    },
    "Wake listening couldn't use the microphone. Close other apps using it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktivierung konnte das Mikrofon nicht nutzen. Schließe andere Apps, die es verwenden, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escucha de activación no pudo usar el micrófono. Cierra las demás apps que lo estén usando y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écoute d'activation n'a pas pu utiliser le micro. Fermez les autres apps qui l'utilisent, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendengaran frasa pemicu tidak dapat menggunakan mikrofon. Tutup app lain yang menggunakannya, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ascolto per l'attivazione vocale non ha potuto usare il microfono. Chiudi le altre app che lo usano, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクフレーズの待ち受けでマイクを使用できませんでした。マイクを使用しているほかのアプリを閉じてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출어 감지가 마이크를 사용할 수 없었어요. 마이크를 사용 중인 다른 앱을 닫은 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasłuchiwanie frazy aktywującej nie mogło użyć mikrofonu. Zamknij inne aplikacje, które z niego korzystają, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escuta de ativação não conseguiu usar o microfone. Feche outros apps que o estejam usando e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожиданию фразы активации не удалось использовать микрофон. Закройте другие приложения, которые его используют, и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyandırma dinlemesi mikrofonu kullanamadı. Mikrofonu kullanan diğer uygulamaları kapatıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唤醒监听无法使用麦克风。请关闭正在使用麦克风的其他应用，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聆聽喚醒詞時無法使用麥克風。請關閉其他正在使用麥克風的 App，然後再試一次。"
          }
        }
      }
    },
    "Choose at least one valid wake phrase before listening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens eine gültige Aktivierungsphrase, bevor du das Zuhören startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos una frase de activación válida antes de escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
