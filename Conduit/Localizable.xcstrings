    "Conduit could not connect to the dashboard at this address. Make sure the dashboard is running and that this device can reach it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte unter dieser Adresse keine Verbindung zum Dashboard herstellen. Stelle sicher, dass das Dashboard läuft und dieses Gerät es erreichen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo conectarse al panel en esta dirección. Asegúrate de que el panel esté en marcha y de que este dispositivo pueda acceder a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu se connecter au tableau de bord à cette adresse. Vérifiez que le tableau de bord est en cours d'exécution et que cet appareil peut l'atteindre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat terhubung ke dasbor di alamat ini. Pastikan dasbor berjalan dan perangkat ini dapat menjangkaunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a connettersi alla dashboard a questo indirizzo. Assicurati che la dashboard sia in esecuzione e che questo dispositivo possa raggiungerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはこのアドレスのダッシュボードに接続できませんでした。ダッシュボードが実行中で、このデバイスからアクセスできることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 이 주소의 대시보드에 연결할 수 없었어요. 대시보드가 실행 중이고 이 기기에서 접근할 수 있는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł połączyć się z panelem pod tym adresem. Upewnij się, że panel działa i że to urządzenie ma do niego dostęp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu se conectar ao painel neste endereço. Verifique se o painel está em execução e se este aparelho consegue acessá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось подключиться к дашборду по этому адресу. Убедитесь, что дашборд запущен и это устройство может с ним связаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu adresteki panele bağlanamadı. Panelin çalıştığından ve bu cihazın ona erişebildiğinden emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法连接到该地址上的仪表盘。请确认仪表盘正在运行，且本设备可以访问它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法連線到此位址上的儀表板。請確認儀表板正在執行，且此裝置可以連上它。"
          }
        }
      }
    },
    "Conduit could not establish a secure connection to the dashboard. The server’s TLS certificate may be misconfigured." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte keine sichere Verbindung zum Dashboard herstellen. Das TLS-Zertifikat des Servers ist möglicherweise falsch konfiguriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo establecer una conexión segura con el panel. Puede que el certificado TLS del servidor esté mal configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu établir de connexion sécurisée avec le tableau de bord. Le certificat TLS du serveur est peut-être mal configuré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat membuat koneksi aman ke dasbor. Sertifikat TLS server mungkin salah dikonfigurasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a stabilire una connessione sicura con la dashboard. Il certificato TLS del server potrebbe essere configurato male."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはダッシュボードとの安全な接続を確立できませんでした。サーバのTLS証明書の設定に誤りがある可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 대시보드와 보안 연결을 설정할 수 없었어요. 서버의 TLS 인증서가 잘못 구성되었을 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł nawiązać bezpiecznego połączenia z panelem. Certyfikat TLS serwera może być źle skonfigurowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu estabelecer uma conexão segura com o painel. O certificado TLS do servidor pode estar mal configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось установить безопасное соединение с дашбордом. Возможно, TLS-сертификат сервера настроен неправильно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit panelle güvenli bir bağlantı kuramadı. Sunucunun TLS sertifikası yanlış yapılandırılmış olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
