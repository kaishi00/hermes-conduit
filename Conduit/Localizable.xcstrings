    "Remote dashboards must use HTTPS. Plain HTTP is only accepted for local addresses like localhost, private LAN IPs, and Tailscale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernte Dashboards müssen HTTPS verwenden. Unverschlüsseltes HTTP wird nur für lokale Adressen wie localhost, private LAN-IPs und Tailscale akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paneles remotos deben usar HTTPS. HTTP sin cifrar solo se acepta para direcciones locales como localhost, IP privadas de la LAN y Tailscale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tableaux de bord distants doivent utiliser HTTPS. Le HTTP simple n'est accepté que pour les adresses locales comme localhost, les IP privées du réseau local et Tailscale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dasbor jarak jauh harus menggunakan HTTPS. HTTP biasa hanya diterima untuk alamat lokal seperti localhost, IP LAN pribadi, dan Tailscale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dashboard remote devono usare HTTPS. HTTP semplice è accettato solo per indirizzi locali come localhost, IP privati della LAN e Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートのダッシュボードではHTTPSを使用する必要があります。暗号化されていないHTTPは、localhost、プライベートLANのIP、Tailscaleなどのローカルアドレスでのみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 대시보드는 HTTPS를 사용해야 해요. 일반 HTTP는 localhost, 사설 LAN IP, Tailscale 같은 로컬 주소에서만 허용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdalne panele muszą używać HTTPS. Zwykły HTTP jest akceptowany tylko dla adresów lokalnych, takich jak localhost, prywatne adresy IP w sieci LAN i Tailscale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painéis remotos precisam usar HTTPS. HTTP simples só é aceito para endereços locais, como localhost, IPs privados da rede local e Tailscale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые дашборды должны использовать HTTPS. Обычный HTTP допускается только для локальных адресов, таких как localhost, частные IP-адреса локальной сети и Tailscale."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzak paneller HTTPS kullanmalıdır. Düz HTTP yalnızca localhost, özel LAN IP'leri ve Tailscale gibi yerel adresler için kabul edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程仪表盘必须使用 HTTPS。纯 HTTP 仅接受 localhost、私有局域网 IP 和 Tailscale 等本地地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端儀表板必須使用 HTTPS。純 HTTP 只接受本機位址，例如 localhost、私人區域網路 IP 和 Tailscale。"
          }
        }
      }
    },
