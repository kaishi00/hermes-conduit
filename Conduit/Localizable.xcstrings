        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conversación en tiempo real con Grok a través de la cuenta de SuperGrok de tu servidor Hermes, que pasa el trabajo a Hermes. Requiere el plugin de notificaciones de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une conversation en temps réel avec Grok via la connexion SuperGrok de votre serveur Hermes, qui confie le travail à Hermes. Nécessite le plugin de notification Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan real-time dengan Grok melalui login SuperGrok di server Hermes Anda yang menyerahkan pekerjaannya kepada Hermes. Memerlukan plugin notifier Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conversazione in tempo reale con Grok tramite l'accesso SuperGrok del tuo server Hermes, che passa il lavoro a Hermes. Richiede il plugin di notifica di Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesサーバのSuperGrokサインインを使ったGrokとのリアルタイムの会話で、作業はHermesに引き継がれます。Hermes通知プラグインが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버의 SuperGrok 로그인으로 Grok과 나누는 실시간 대화로, 작업은 Hermes에 넘겨요. Hermes 알림 플러그인이 필요해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmowa w czasie rzeczywistym z Grokiem przez konto SuperGrok zalogowane na Twoim serwerze Hermes, która przekazuje pracę Hermesowi. Wymaga wtyczki powiadomień Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conversa em tempo real com o Grok pelo login do SuperGrok do seu servidor Hermes, que passa o trabalho para o Hermes. Requer o plugin notificador do Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разговор с Grok в реальном времени через вход в SuperGrok на вашем сервере Hermes, который передаёт работу Hermes. Нужен плагин уведомлений Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sunucunuzdaki SuperGrok girişi üzerinden Grok ile yapılan ve işi Hermes'e devreden gerçek zamanlı bir konuşma. Hermes bildirim eklentisi gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Hermes 服务器上已登录的 SuperGrok 与 Grok 实时对话，并把任务交给 Hermes 完成。需要 Hermes 通知插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Hermes 伺服器上登入的 SuperGrok 與 Grok 進行即時對話，並把事情交給 Hermes 處理。需要 Hermes 通知外掛程式。"
          }
        }
      }
    },
