    "Bounds how long the Goal Mode worker may loop" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie lange der Worker im Zielmodus Schleifen drehen darf"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita cuánto tiempo puede iterar el ejecutor del modo Objetivo"
