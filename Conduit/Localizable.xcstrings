          }
        }
      }
    },
    "Sending in a chat open in Hermes Desktop or a terminal takes it over without asking. Needs the Conduit notifier plugin on your Hermes host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du in einem Chat sendest, der in Hermes Desktop oder einem Terminal geöffnet ist, wird er ohne Nachfrage übernommen. Erfordert das Conduit-Notifier-Plug-in auf deinem Hermes-Host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al enviar en un chat abierto en Hermes Desktop o en un terminal, se retoma sin preguntar. Requiere el plugin de notificaciones de Conduit en tu host de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer un message dans une discussion ouverte dans Hermes Desktop ou un terminal la reprend sans demander. Nécessite le plugin de notification Conduit sur votre hôte Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim di obrolan yang terbuka di Hermes Desktop atau terminal akan mengambil alihnya tanpa bertanya. Memerlukan plugin notifier Conduit di host Hermes Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se invii in una chat aperta in Hermes Desktop o in un terminale, Conduit la riprende senza chiedere. Richiede il plugin di notifica di Conduit sul tuo host Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Desktopまたはターミナルで開かれているチャットで送信すると、確認なしで引き継ぎます。HermesホストにConduit通知プラグインが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Desktop이나 터미널에서 열려 있는 채팅에 보내면 묻지 않고 넘겨받아요. Hermes 호스트에 Conduit 알림 플러그인이 필요해요."
          }
        },
        "pl" : {
          "stringUnit" : {
