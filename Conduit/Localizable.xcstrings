    "Not run yet. Once it runs, it shows here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht ausgeführt. Sobald er ausgeführt wurde, erscheint das hier."
          }
