          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プッシュリレーがこのiPhoneのプッシュトークンを確認できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 이 iPhone의 푸시 토큰을 확인하지 못했어요. 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
