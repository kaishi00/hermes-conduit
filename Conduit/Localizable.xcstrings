    "Compression continues in the background; the transcript will refresh when it finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Komprimierung läuft im Hintergrund weiter; das Transkript wird aktualisiert, sobald sie fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compresión continúa en segundo plano; la transcripción se actualizará cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compression se poursuit en arrière-plan ; la transcription sera actualisée une fois terminée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemadatan berlanjut di latar belakang; transkrip akan diperbarui setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compressione continua in background; la trascrizione si aggiornerà al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮はバックグラウンドで続行されます。完了すると会話履歴が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축은 백그라운드에서 계속돼요. 완료되면 대화 내용이 새로 고쳐져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompresja trwa w tle; zapis rozmowy odświeży się po jej zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compressão continua em segundo plano; a transcrição será atualizada quando ela terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатие продолжается в фоне; переписка обновится, когда оно завершится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıkıştırma arka planda sürüyor; bittiğinde transkript yenilenecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩正在后台继续；完成后对话记录将刷新。"
          }
        },
