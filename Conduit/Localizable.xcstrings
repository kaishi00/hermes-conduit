    "Maps lookups use Apple Maps on this iPhone, so Apple sees the start and destination." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartensuchen nutzen Apple Karten auf diesem iPhone, daher sieht Apple Start und Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las búsquedas de mapas usan Apple Maps en este iPhone, así que Apple ve el origen y el destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches de cartes utilisent Plans d’Apple sur cet iPhone : Apple voit le départ et la destination."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian peta memakai Apple Maps di iPhone ini, jadi Apple melihat titik awal dan tujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ricerche sulle mappe usano Mappe di Apple su questo iPhone, quindi Apple vede partenza e destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図の検索にはこのiPhoneのAppleマップを使うため、Appleには出発地と目的地が見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도 검색은 이 iPhone의 Apple 지도를 사용하므로 Apple이 출발지와 목적지를 볼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie na mapach korzysta z Map Apple na tym iPhonie, więc Apple widzi punkt startowy i cel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As buscas de mapas usam o Apple Mapas neste iPhone, então a Apple vê a origem e o destino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск по картам идёт через Apple Карты на этом iPhone, поэтому Apple видит начало и конец маршрута."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harita aramaları bu iPhone'daki Apple Haritalar'ı kullanır, bu yüzden Apple başlangıç ve varış noktasını görür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图查询使用此 iPhone 上的 Apple 地图，因此 Apple 会看到起点和终点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖查詢使用此 iPhone 上的 Apple 地圖，因此 Apple 會看到起點和終點。"
          }
        }
      }
    },
