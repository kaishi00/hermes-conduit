    "Comments reach the live worker between turns as an out-of-band note." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommentare erreichen den laufenden Worker zwischen Durchgängen als separate Notiz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comentarios llegan al ejecutor activo entre turnos como una nota aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commentaires parviennent au worker actif entre deux tours, sous forme de note hors bande."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentar sampai ke worker yang sedang berjalan di antara giliran sebagai catatan terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I commenti raggiungono il worker attivo tra un turno e l'altro come nota fuori banda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コメントは、ターンの合間に別枠のメモとして実行中のワーカーに届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "댓글은 턴 사이에 별도 메모로 실행 중인 워커에게 전달돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentarze docierają do działającego procesu roboczego między turami jako osobna notatka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comentários chegam ao executor ativo entre turnos como uma nota à parte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комментарии передаются работающему обработчику между ответами в виде внеочередной заметки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorumlar, canlı çalışana turlar arasında bant dışı bir not olarak ulaşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评论会在轮次之间以带外备注的形式传达给正在运行的工作代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留言會在回合之間，以額外附註的形式傳達給正在執行的執行者。"
          }
        }
      }
    },
