    "Uses Apple's system-managed speech model. Captured audio stays on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet das systemverwaltete Sprachmodell von Apple. Aufgenommenes Audio bleibt auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el modelo de voz gestionado por el sistema de Apple. El audio capturado se queda en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le modèle vocal géré par le système d'Apple. L'audio capturé reste sur cet iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan model ucapan yang dikelola sistem Apple. Audio yang direkam tetap di iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il modello vocale gestito dal sistema di Apple. L'audio acquisito resta su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleがシステムで管理する音声モデルを使用します。録音した音声はこのiPhone内に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 시스템에서 관리하는 음성 모델을 사용해요. 녹음된 오디오는 이 iPhone에만 남아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa zarządzanego przez system modelu mowy Apple. Nagrany dźwięk pozostaje na tym iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o modelo de fala gerenciado pelo sistema da Apple. O áudio captado fica neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует системную речевую модель Apple. Записанный звук остаётся на этом iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın sistem tarafından yönetilen konuşma modelini kullanır. Kaydedilen ses bu iPhone'da kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 系统管理的语音模型。录制的音频保留在这台 iPhone 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 系統管理的語音模型。擷取的音訊會保留在這部 iPhone 上。"
          }
        }
      }
    },
