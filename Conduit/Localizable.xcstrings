            "state" : "translated",
            "value" : "ゲートウェイから無効なファイルデータが返されました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gateway retornou um conteúdo de arquivo inválido."
          }
        },
