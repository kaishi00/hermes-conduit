    "Archive “%@”?\nThe board will be removed from the active board list. Its tasks are not being permanently deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ archivieren?\nDas Board wird aus der Liste der aktiven Boards entfernt. Seine Aufgaben werden nicht endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive “%@”?\nThe board will be removed from the active board list. Its tasks are not being permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Archivar «%@»?\nEl tablero se quitará de la lista de tableros activos. Sus tareas no se eliminarán permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiver « %@ » ?\nLe tableau sera retiré de la liste des tableaux actifs. Ses tâches ne sont pas supprimées définitivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arsipkan “%@”?\nPapan akan dihapus dari daftar papan aktif. Tugas-tugasnya tidak dihapus secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviare “%@”?\nLa bacheca verrà rimossa dall'elenco delle bacheche attive. Le sue attività non vengono eliminate definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をアーカイブしますか？\nこのボードはアクティブなボードの一覧から削除されます。タスクが完全に削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 보드를 보관할까요?\n보드가 활성 보드 목록에서 제거돼요. 보드의 태스크는 영구적으로 삭제되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarchiwizować „%@”?\nTablica zostanie usunięta z listy aktywnych tablic. Jej zadania nie zostaną trwale usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivar “%@”?\nO quadro será removido da lista de quadros ativos. As tarefas dele não serão apagadas permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивировать «%@»?\nДоска будет убрана из списка активных досок. Её задачи не удаляются безвозвратно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” arşivlensin mi?\nPano, etkin panolar listesinden kaldırılacak. Görevleri kalıcı olarak silinmiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档“%@”？该看板将从活跃看板列表中移除。其任务不会被永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要封存「%@」嗎？\n此看板將從使用中的看板列表移除。其任務不會被永久刪除。"
          }
        }
      }
    },
