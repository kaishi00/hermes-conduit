    "%@ is larger than the %@ a shared file can be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist größer als die %@, die eine geteilte Datei haben darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is larger than the %@ a shared file can be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera los %@ que puede tener un archivo compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépasse les %@ autorisés pour un fichier partagé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lebih besar dari %@ yang diizinkan untuk file yang dibagikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera i %@ consentiti per un file condiviso."
          }
        },
