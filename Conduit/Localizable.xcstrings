          }
        }
      }
    },
    "Hermes didn't accept this request. Updating Hermes and Conduit usually fixes this." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがこのリクエストを受け付けませんでした。通常はHermesとConduitをアップデートすると解決します。"
