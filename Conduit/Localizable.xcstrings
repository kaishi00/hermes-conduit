    "Health data is never used for advertising and is not stored in iCloud by Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsdaten werden nie für Werbung verwendet und von Conduit nicht in iCloud gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de salud nunca se usan para publicidad y Conduit no los guarda en iCloud."
          }
