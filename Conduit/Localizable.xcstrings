            "value" : "Mettez à jour Hermes pour déplacer des conversations entre projets."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui Hermes untuk memindahkan percakapan antarproyek."
          }
        },
        "it" : {
