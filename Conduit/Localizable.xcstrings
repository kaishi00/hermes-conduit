    "Conduit shows this draft in the chat for you to review. Nothing is sent until you send it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit zeigt dir diesen Entwurf im Chat zur Prüfung. Nichts wird gesendet, bis du es sendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit shows this draft in the chat for you to review. Nothing is sent until you send it."
          }
        },
        "es" : {
