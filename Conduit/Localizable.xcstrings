          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nova tarefa fica bloqueada até a tarefa pai ser concluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая задача останется заблокированной, пока не будет выполнена родительская."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni görev, üst görevi tamamlanana kadar engelli kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新任务在其父任务完成前保持阻塞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新任務會保持受阻，直到其父任務完成。"
          }
        }
      }
    },
    "The notifier receives a revocable credential for this phone. Your gateway never needs the phone’s push token, and you can turn notifications off here at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Notifier erhält widerrufbare Zugangsdaten für dieses iPhone. Dein Gateway braucht nie das Push-Token des iPhone, und du kannst Mitteilungen hier jederzeit deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El notificador recibe una credencial revocable para este teléfono. Tu pasarela nunca necesita el token push del teléfono, y puedes desactivar las notificaciones aquí en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin de notification reçoit un identifiant révocable pour ce téléphone. Votre passerelle n'a jamais besoin du jeton push du téléphone, et vous pouvez désactiver les notifications ici à tout moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier menerima kredensial yang dapat dicabut untuk ponsel ini. Gateway Anda tidak pernah memerlukan token push ponsel, dan Anda dapat mematikan pemberitahuan di sini kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plugin di notifica riceve una credenziale revocabile per questo telefono. Il tuo gateway non ha mai bisogno del token push del telefono e puoi disattivare le notifiche qui in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知プラグインは、このiPhone用の取り消し可能な認証情報を受け取ります。ゲートウェイがiPhoneのプッシュトークンを必要とすることはなく、通知はここでいつでもオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림 플러그인은 이 iPhone에 대한 취소 가능한 자격 증명을 받아요. 게이트웨이에는 iPhone의 푸시 토큰이 전혀 필요하지 않으며, 언제든지 여기서 알림을 끌 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczka powiadomień otrzymuje dla tego telefonu dane uwierzytelniające, które można odwołać. Twoja brama nigdy nie potrzebuje tokenu push telefonu, a powiadomienia możesz tu wyłączyć w dowolnym momencie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O notificador recebe uma credencial revogável para este telefone. Seu gateway nunca precisa do token de push do telefone, e você pode desativar as notificações aqui a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагин уведомлений получает отзываемые учётные данные для этого телефона. Вашему шлюзу никогда не нужен push-токен телефона, а уведомления можно выключить здесь в любой момент."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim eklentisi bu telefon için iptal edilebilir bir kimlik bilgisi alır. Ağ geçidinizin telefonun anlık bildirim token'ına hiç ihtiyacı olmaz ve bildirimleri istediğiniz zaman buradan kapatabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知器会收到一个仅限这台手机使用的可撤销凭据。你的网关从不需要手机的推送令牌，你也可以随时在此关闭通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知外掛程式會收到這部手機專用、可撤銷的認證資訊。你的閘道永遠不需要手機的推播權杖，你也可以隨時在這裡關閉通知。"
          }
        }
      }
    },
