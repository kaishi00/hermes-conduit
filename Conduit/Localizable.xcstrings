    "Any integer is valid; Hermes stores it verbatim (no bounds upstream)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Ganzzahl ist gültig; Hermes speichert sie unverändert (keine Grenzen auf Serverseite)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier entero es válido; Hermes lo guarda tal cual (sin límites en el servidor)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout entier est valide ; Hermes l'enregistre tel quel (aucune limite côté serveur)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilangan bulat apa pun valid; Hermes menyimpannya apa adanya (tanpa batas di upstream)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi intero è valido; Hermes lo salva così com'è (nessun limite lato server)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意の整数を指定できます。Hermesはそのまま保存します（上流での範囲制限はありません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 정수가 유효해요. Hermes는 입력값을 그대로 저장해요(상위에서 범위 제한 없음)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolna liczba całkowita jest prawidłowa; Hermes zapisuje ją dosłownie (bez ograniczeń po stronie serwera)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer número inteiro é válido; o Hermes o armazena exatamente como está (sem limites no servidor)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допустимо любое целое число; Hermes сохраняет его как есть (на сервере нет ограничений)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir tam sayı geçerlidir; Hermes bunu olduğu gibi saklar (sunucu tarafında sınır yok)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意整数均有效；Hermes 会原样存储（上游不限制范围）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何整數皆有效；Hermes 會原樣儲存（上游沒有範圍限制）。"
          }
        }
      }
    },
