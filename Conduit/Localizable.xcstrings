    "Voice is on for %@ on this iPhone. Each step below turns green when it's ready; an orange step has a fix." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneで%@の音声がオンになっています。下の各手順は準備ができると緑色になります。オレンジ色の手順には解決方法があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
