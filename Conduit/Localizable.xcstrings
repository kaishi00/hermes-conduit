    "No connection has been timed since Conduit opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Öffnen von Conduit wurde keine Verbindung gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha cronometrado ninguna conexión desde que se abrió Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion n'a été chronométrée depuis l'ouverture de Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada koneksi yang diukur waktunya sejak Conduit dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione misurata dall'apertura di Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitを開いてから、接続時間はまだ計測されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit을 연 뒤로 측정된 연결이 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od otwarcia Conduit nie zmierzono czasu żadnego połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma conexão foi cronometrada desde que o Conduit abriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С момента открытия Conduit время подключения ещё не измерялось."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
