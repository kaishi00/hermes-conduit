    "Return to Voice settings, enable this mode if it is off, and tap %@ to check availability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre zu den Spracheinstellungen zurück, aktiviere diesen Modus, falls er aus ist, und tippe auf „%@“, um die Verfügbarkeit zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a los ajustes de Voz, activa este modo si está desactivado y toca «%@» para comprobar la disponibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez aux réglages Voix, activez ce mode s'il est désactivé, puis touchez %@ pour vérifier la disponibilité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali ke pengaturan Suara, aktifkan mode ini jika mati, lalu ketuk %@ untuk memeriksa ketersediaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna alle impostazioni Voce, attiva questa modalità se è disattivata e tocca %@ per verificare la disponibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「音声」設定に戻り、このモードがオフの場合はオンにしてから、%@をタップして利用可能か確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘음성’ 설정으로 돌아가 이 모드가 꺼져 있으면 켠 다음, ‘%@’ 버튼을 탭해 사용 가능한지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć do ustawień głosu, włącz ten tryb, jeśli jest wyłączony, i stuknij „%@”, aby sprawdzić dostępność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte aos ajustes de Voz, ative este modo se estiver desativado e toque em %@ para verificar a disponibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь в настройки голоса, включите этот режим, если он выключен, и нажмите «%@», чтобы проверить доступность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses ayarlarına dönün, kapalıysa bu modu açın ve kullanılabilirliği denetlemek için “%@” düğmesine dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回“语音”设置；如果此模式尚未启用，请先启用，然后轻点 %@ 检查是否可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回「語音」設定，如果此模式已關閉請將其開啟，然後點一下「%@」檢查是否可用。"
          }
        }
      }
    },
