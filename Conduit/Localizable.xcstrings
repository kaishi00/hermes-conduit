    },
    "Update Hermes to send, stop, and steer messages from Conduit. This version can't report whether a reply is still running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Hermes, um aus Conduit Nachrichten zu senden, zu stoppen und nachzusteuern. Diese Version kann nicht melden, ob noch eine Antwort läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Hermes para enviar, detener y guiar mensajes desde Conduit. Esta versión no puede indicar si una respuesta sigue en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Hermes pour envoyer, arrêter et réorienter des messages depuis Conduit. Cette version ne peut pas indiquer si une réponse est encore en cours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui Hermes untuk mengirim, menghentikan, dan mengarahkan pesan dari Conduit. Versi ini tidak dapat melaporkan apakah balasan masih berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Hermes per inviare, interrompere e reindirizzare messaggi da Conduit. Questa versione non può indicare se una risposta è ancora in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitからメッセージの送信、停止、軌道修正を行うには、Hermesをアップデートしてください。このバージョンでは返信がまだ実行中かどうかを報告できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit에서 메시지를 보내고, 중지하고, 방향을 조정하려면 Hermes를 업데이트하세요. 이 버전은 응답이 아직 진행 중인지 알려 줄 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj Hermesa, aby wysyłać, zatrzymywać i kierować wiadomościami z Conduit. Ta wersja nie potrafi zgłosić, czy odpowiedź nadal trwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Hermes para enviar, parar e orientar mensagens pelo Conduit. Esta versão não consegue informar se uma resposta ainda está em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите Hermes, чтобы отправлять, останавливать и корректировать сообщения из Conduit. Эта версия не сообщает, выполняется ли ещё ответ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'ten mesaj göndermek, durdurmak ve yönlendirmek için Hermes'i güncelleyin. Bu sürüm bir yanıtın hâlâ devam edip etmediğini bildiremiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 才能在 Conduit 中发送、停止和引导消息。此版本无法报告回复是否仍在进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 Hermes，才能從 Conduit 傳送、停止及引導訊息。此版本無法回報回覆是否仍在進行中。"
          }
        }
      }
    },
    "Update Hermes to use Voice. This version can't tell Conduit whether voice is ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Hermes, um den Sprachmodus zu nutzen. Diese Version kann Conduit nicht mitteilen, ob der Sprachmodus bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Hermes para usar la voz. Esta versión no puede indicar a Conduit si la voz está lista."
