{
  "sourceLanguage" : "en",
  "strings" : {
    "New voice chat" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新建语音聊天"
          }
        }
      }
    },
    "Choose a chat first" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先选择聊天"
          }
        }
      }
    },
    "CarPlay opens on your pinned and recent chats, with New voice chat at the top. Off: Voice starts as soon as CarPlay opens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay 打开时显示置顶和最近的聊天，顶部是“新建语音聊天”。关闭后，CarPlay 一打开就开始语音。"
          }
        }
      }
    },
    "Applying configuration" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在应用配置"
          }
        }
      }
    },
    "Hermes asks you to confirm switching to %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 需要你确认切换到 %@。"
          }
        }
      }
    },
    "Hermes did not accept the model switch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 未接受模型切换。"
          }
        }
      }
    },
    "Not connected to a conversation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接到对话。"
          }
        }
      }
    },
    "Switch model?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换模型？"
          }
        }
      }
    },
    "Talk over it on the speaker" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在扬声器上也可打断"
          }
        }
      }
    },
    "Experimental. Keeps the microphone open while Gemini talks on the phone's speaker or in the car, with iOS echo cancellation, so you can cut in by speaking. Headphones and AirPods always allow this. Turn it off if Gemini keeps cutting itself off. Shared by Gemini Live and Grok Live. Applies to the next conversation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验功能。Gemini 通过手机扬声器或在车内说话时保持麦克风开启，并使用 iOS 回声消除，让你可以直接开口打断。耳机和 AirPods 始终支持此功能。如果 Gemini 不断打断自己，请关闭此选项。Gemini Live 与 Grok Live 共用此设置。从下一次对话开始生效。"
          }
        }
      }
    },
    "Experimental. Keeps the microphone open while Grok talks on the phone's speaker or in the car, with iOS echo cancellation, so you can cut in by speaking. Headphones and AirPods always allow this. Turn it off if Grok keeps cutting itself off. Shared by Gemini Live and Grok Live. Applies to the next conversation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实验功能。Grok 通过手机扬声器或在车内说话时保持麦克风开启，并使用 iOS 回声消除，让你可以直接开口打断。耳机和 AirPods 始终支持此功能。如果 Grok 不断打断自己，请关闭此选项。Gemini Live 与 Grok Live 共用此设置。从下一次对话开始生效。"
          }
        }
      }
    },
    "Could not open the file: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开文件：%@"
          }
        }
      }
    },
    "%@ is larger than the %@ MB attachment limit. You can raise the limit in Settings › Chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 超过了 %2$@ MB 的附件大小上限。你可以在“设置 › 聊天”中提高上限。"
          }
        }
      }
    },
    "These files are larger than the %@ MB attachment limit: %@. You can raise the limit in Settings › Chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下文件超过了 %1$@ MB 的附件大小上限：%2$@。你可以在“设置 › 聊天”中提高上限。"
          }
        }
      }
    },
    "Attachments" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件"
          }
        }
      }
    },
    "Large files are held in memory while they upload. A high limit may make Conduit freeze or crash." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大文件在上传时会保存在内存中。上限设得过高可能导致 Conduit 卡住或崩溃。"
          }
        }
      }
    },
    "Maximum file size" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大文件大小"
          }
        }
      }
    },
    "Photos, videos and files larger than this are not attached." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过此大小的照片、视频和文件将不会被附加。"
          }
        }
      }
    },
    "Remove %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 %@"
          }
        }
      }
    },
    "Starts a voice call; in a chat with messages, the call works in that chat" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始语音通话；在有消息的聊天中，通话会在该聊天里进行"
          }
        }
      }
    },
    "Steered: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已引导：%@"
          }
        }
      }
    },
    "New voice call" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新语音通话"
          }
        }
      }
    },
    "Starts a voice call that isn't tied to a chat" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始一个不关联任何聊天的语音通话"
          }
        }
      }
    },
    "Unable to change YOLO mode." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法更改 YOLO 模式。"
          }
        }
      }
    },
    "Working in %@. Say “quick…” for a fast side job." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在“%@”中通话。说“快，……”可另开快速任务。"
          }
        }
      }
    },
    "The notifier plugin on your Hermes host (version %@) is missing features Conduit uses, such as taking chats over from Hermes Desktop. Run these on the host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 主机上的通知插件（版本 %@）缺少 Conduit 使用的功能，例如从 Hermes Desktop 接管对话。请在主机上运行以下命令。"
          }
        }
      }
    },
    "The notifier plugin on your Hermes host is missing or out of date, so features like taking chats over from Hermes Desktop won't work. Run these on the host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 主机上的通知插件缺失或已过期，因此从 Hermes Desktop 接管对话等功能将无法使用。请在主机上运行以下命令。"
          }
        }
      }
    },
    "Update the Conduit notifier" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新 Conduit 通知插件"
          }
        }
      }
    },
    "Wake listening on CarPlay needs the iPhone's microphone, which is not available right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 CarPlay 上监听唤醒词需要使用 iPhone 麦克风，但它目前不可用。"
          }
        }
      }
    },
    "Listen on CarPlay" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 CarPlay 上监听"
          }
        }
      }
    },
    "On CarPlay, wake listens through the iPhone's microphone so music keeps playing normally in the car. Turn this off if the phrase is missed or music sounds wrong." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 CarPlay 时，唤醒词通过 iPhone 麦克风监听，车内音乐可照常播放。如果唤醒词未被识别或音乐听起来不正常，请关闭此项。"
          }
        }
      }
    },
    "Stops dictating; the words stay in the message" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止听写；文字会保留在消息中"
          }
        }
      }
    },
    "Cancel dictation" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消听写"
          }
        }
      }
    },
    "Dictation is unavailable while a voice conversation has the microphone" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音对话占用麦克风时无法听写"
          }
        }
      }
    },
    "Collapse editor" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收起编辑器"
          }
        }
      }
    },
    "Expand editor" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展开编辑器"
          }
        }
      }
    },
    "Types what you say into the message" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你说的话输入到消息中"
          }
        }
      }
    },
    "Stop dictation" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止听写"
          }
        }
      }
    },
    "Dictate" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写"
          }
        }
      }
    },
    "Dictation needs microphone and speech recognition access. You can allow them in Settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写需要麦克风和语音识别权限。你可以在“设置”中允许。"
          }
        }
      }
    },
    "Dictation isn't available right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写目前不可用。"
          }
        }
      }
    },
    "Hermes added this to the reply already running in the chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 已将此内容并入对话中正在进行的回复。"
          }
        }
      }
    },
    "Hermes queued this in the chat. Its reply will appear there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 已将此内容排入对话队列，回复将显示在对话中。"
          }
        }
      }
    },
    "Shows why the call stopped" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示通话停止的原因"
          }
        }
      }
    },
    "Hermes could not send this to the chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法将此内容发送到对话。"
          }
        }
      }
    },
    "This call isn't attached to a chat." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通话未关联任何对话。"
          }
        }
      }
    },
    "Hermes didn't get a request to send." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 没有收到要发送的请求。"
          }
        }
      }
    },
    "Hermes is still working on your earlier requests in this chat. Ask again once they finish." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 仍在处理你在此对话中的先前请求。请在完成后再问。"
          }
        }
      }
    },
    "Header %@ name" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头 %@ 名称"
          }
        }
      }
    },
    "Header %@ value" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头 %@ 的值"
          }
        }
      }
    },
    "Remove header %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除请求头 %@"
          }
        }
      }
    },
    "Add header" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加请求头"
          }
        }
      }
    },
    "Add headers" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加请求头"
          }
        }
      }
    },
    "Conduit manages this header itself, so it can't be set here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求头由 Conduit 自行管理，无法在此设置。"
          }
        }
      }
    },
    "Edit headers" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑请求头"
          }
        }
      }
    },
    "Enter a header name." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入请求头名称。"
          }
        }
      }
    },
    "Extra headers" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外请求头"
          }
        }
      }
    },
    "Extra headers are only sent over HTTPS. Enter an https:// server address first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外请求头仅通过 HTTPS 发送。请先输入 https:// 服务器地址。"
          }
        }
      }
    },
    "For reverse proxies such as Pangolin, Traefik, or nginx that check a header. Sent only to this server, over HTTPS." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。仅通过 HTTPS 发送到此服务器。"
          }
        }
      }
    },
    "Header name" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头名称"
          }
        }
      }
    },
    "Header values can't contain line breaks." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头的值不能包含换行。"
          }
        }
      }
    },
    "Hide value" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏值"
          }
        }
      }
    },
    "Reconnect after changing them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改后请重新连接。"
          }
        }
      }
    },
    "Remove header" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除请求头"
          }
        }
      }
    },
    "Sent with every request to this server, for reverse proxies such as Pangolin, Traefik, or nginx that check a header. Values stay in Keychain." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随发往此服务器的每个请求一起发送，用于会检查请求头的反向代理，例如 Pangolin、Traefik 或 nginx。值保存在钥匙串中。"
          }
        }
      }
    },
    "Show value" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示值"
          }
        }
      }
    },
    "This header is already in the list." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此请求头已在列表中。"
          }
        }
      }
    },
    "This isn’t a valid header name. Use letters, digits, and dashes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是有效的请求头名称。请使用字母、数字和连字符。"
          }
        }
      }
    },
    "Value" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值"
          }
        }
      }
    },
    "Minimise call" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小化通话"
          }
        }
      }
    },
    "Transcript" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字记录"
          }
        }
      }
    },
    "What you and the assistant say will appear here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和助手说的话会显示在这里。"
          }
        }
      }
    },
    "Hangs up the call" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂断通话"
          }
        }
      }
    },
    "Stops the assistant so you can speak" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让助手停下，你可以开口说话"
          }
        }
      }
    },
    "Available while the assistant is speaking" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "助手说话时可用"
          }
        }
      }
    },
    "Microphone unmuted" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已取消静音"
          }
        }
      }
    },
    "End call" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束通话"
          }
        }
      }
    },
    "Opens the call" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开通话"
          }
        }
      }
    },
    "Call stopped. Tap to see why." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话已停止。点按查看原因。"
          }
