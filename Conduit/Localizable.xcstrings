    "Check the address before you sign in. Conduit connects only when you tap Sign in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Adresse, bevor du dich anmeldest. Conduit verbindet sich erst, wenn du auf „Anmelden“ tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la dirección antes de iniciar sesión. Conduit solo se conecta cuando tocas Iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l'adresse avant de vous connecter. Conduit ne se connecte que lorsque vous touchez Se connecter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa alamatnya sebelum masuk. Conduit baru terhubung saat Anda mengetuk Masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l'indirizzo prima di accedere. Conduit si connette solo quando tocchi Accedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインする前にアドレスを確認してください。Conduitは「サインイン」をタップしたときにだけ接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하기 전에 주소를 확인하세요. Conduit은 로그인을 탭할 때만 연결해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź adres przed zalogowaniem. Conduit połączy się dopiero, gdy stukniesz Zaloguj się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira o endereço antes de entrar. O Conduit só se conecta quando você toca em Entrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте адрес, прежде чем войти. Conduit подключится, только когда вы нажмёте «Войти»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapmadan önce adresi kontrol edin. Conduit yalnızca Giriş yap'a dokunduğunuzda bağlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录前请核对地址。只有在你轻点“登录”后，Conduit 才会连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入前請核對位址。只有在你點一下「登入」後，Conduit 才會連線。"
          }
        }
      }
    },
