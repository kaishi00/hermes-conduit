    "Choose a different profile from the session drawer. Chat, model, workspace, and memory preferences on the other settings pages follow that profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in der Sitzungsleiste ein anderes Profil. Chat-, Modell-, Arbeitsbereichs- und Gedächtniseinstellungen auf den anderen Einstellungsseiten folgen diesem Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otro perfil en la barra lateral de sesiones. Las preferencias de chat, modelo, espacio de trabajo y memoria de las otras páginas de ajustes siguen a ese perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un autre profil dans le panneau des sessions. Les préférences de discussion, de modèle, d'espace de travail et de mémoire des autres pages de réglages suivent ce profil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih profil lain dari laci sesi. Preferensi obrolan, model, ruang kerja, dan memori di halaman pengaturan lainnya mengikuti profil tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un altro profilo dal pannello delle sessioni. Le preferenze di chat, modello, spazio di lavoro e memoria nelle altre pagine delle impostazioni seguono quel profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションドロワーから別のプロファイルを選択してください。ほかの設定ページのチャット、モデル、ワークスペース、メモリの設定は、そのプロファイルに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 패널에서 다른 프로필을 선택하세요. 다른 설정 페이지의 채팅, 모델, 작업 공간, 메모리 설정은 해당 프로필을 따라요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz inny profil na liście sesji. Preferencje czatu, modelu, obszaru roboczego i pamięci na pozostałych stronach ustawień dotyczą tego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha outro perfil na gaveta de sessões. As preferências de chat, modelo, espaço de trabalho e memória nas outras páginas de ajustes seguem esse perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите другой профиль на панели сеансов. Настройки чата, модели, рабочего пространства и памяти на других страницах настроек относятся к этому профилю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum çekmecesinden farklı bir profil seçin. Diğer ayar sayfalarındaki sohbet, model, çalışma alanı ve bellek tercihleri o profili izler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从会话抽屉中选择其他档案。其他设置页中的对话、模型、工作区与记忆偏好将跟随该档案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請從工作階段側邊欄選擇其他設定檔。其他設定頁面上的聊天、模型、工作區和記憶偏好設定都會跟隨該設定檔。"
          }
        }
      }
    },
