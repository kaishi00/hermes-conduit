            "value" : "Non c'è testo da inviare. Dai un messaggio a Invia a Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信するテキストがありません。「Hermesに送信」にメッセージを渡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낼 텍스트가 없습니다. Hermes에 보내기에 메시지를 넣으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak tekstu do wysłania. Podaj wiadomość akcji Wyślij do Hermesa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há texto para enviar. Dê uma mensagem para Enviar ao Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет текста для отправки. Передайте сообщение действию «Отправить Hermes»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderilecek metin yok. Hermes'e gönder eylemine bir mesaj verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可发送的文本。请给“发送给 Hermes”一条消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可傳送的文字。請給「傳送給 Hermes」一則訊息。"
          }
        }
      }
    },
    "Conduit couldn't reach Hermes. Open Conduit and check the connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte Hermes nicht erreichen. Öffne Conduit und prüfe die Verbindung."
