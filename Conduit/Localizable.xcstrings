          }
        }
      }
    },
    "These settings can’t be used yet. Go Back to edit them, then return here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定はまだ使用できません。「戻る」で編集してから、ここに戻ってください。"
