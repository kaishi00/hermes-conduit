    "Pulse (beta)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (Beta)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (beta)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (bêta)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (beta)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (beta)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse（ベータ）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse(베타)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse (beta)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
