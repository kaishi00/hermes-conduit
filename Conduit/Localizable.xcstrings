    "Ask Hermes to add an MCP server, or install one from the catalog when it lists some." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Hermes, einen MCP-Server hinzuzufügen, oder installiere einen aus dem Katalog, sobald er welche anbietet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele a Hermes que añada un servidor MCP o instala uno del catálogo cuando ofrezca alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Hermes d'ajouter un serveur MCP, ou installez-en un depuis le catalogue lorsqu'il en propose."
          }
        },
        "id" : {
          "stringUnit" : {
