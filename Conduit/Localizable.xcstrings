    "Hermes controls Running; use the dispatcher/claim path instead of setting it manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes steuert „Läuft“; nutze den Dispatcher-/Claim-Weg, statt den Status manuell zu setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes controla En ejecución; usa la ruta del despachador o de toma en lugar de establecerlo manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes contrôle En cours ; passez par le répartiteur ou la prise en charge au lieu de le définir manuellement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes mengontrol Berjalan; gunakan jalur dispatcher/klaim, bukan mengaturnya secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes controlla In esecuzione; usa il percorso dispatcher/presa in carico invece di impostarlo manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「実行中」はHermesが管理します。手動で設定せず、ディスパッチャ／引き受けの経路を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘실행 중’은 Hermes가 관리해요. 직접 설정하지 말고 디스패처/가져가기 경로를 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolumną „W toku” steruje Hermes; zamiast ustawiać ją ręcznie, użyj ścieżki dyspozytora/przejęcia."
