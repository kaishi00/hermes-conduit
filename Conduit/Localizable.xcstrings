    "Ends a running call on this iPhone. The next call asks again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet einen laufenden Anruf auf diesem iPhone. Der nächste Anruf fragt erneut."
