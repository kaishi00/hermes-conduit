        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 아직 사용할 수 없어요. ‘뒤로’를 눌러 편집한 다음 여기로 돌아오세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
