    "Allow Microphone and Speech Recognition for Conduit in Settings to use a wake phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mikrofon und Spracherkennung für Conduit in den Einstellungen, um eine Aktivierungsphrase zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al micrófono y al reconocimiento de voz para Conduit en Ajustes para usar una frase de activación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le micro et la reconnaissance vocale pour Conduit dans Réglages pour utiliser une phrase d'activation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェイクフレーズを使用するには、「設定」でConduitにマイクと音声認識へのアクセスを許可してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita Microfone e Reconhecimento de Fala para o Conduit em Ajustes para usar uma frase de ativação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать фразу активации, разрешите Conduit доступ к микрофону и распознаванию речи в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Conduit 使用麦克风和语音识别，以便使用唤醒词。"
          }
        }
      }
    },
