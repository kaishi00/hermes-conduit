          "stringUnit" : {
            "state" : "translated",
            "value" : "回合或任務結束時播放提示音"
          }
        }
      }
    },
    "Play a sound when Hermes is waiting on you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton abspielen, wenn Hermes auf dich wartet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducir un sonido cuando Hermes te esté esperando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émettre un son quand Hermes attend votre réponse"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar bunyi saat Hermes menunggu Anda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
