    "Select a provider first, then one of its available models. These defaults apply to new sessions in this profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zuerst einen Anbieter und dann eines seiner verfügbaren Modelle. Diese Standards gelten für neue Sitzungen in diesem Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona primero un proveedor y luego uno de sus modelos disponibles. Estos valores predeterminados se aplican a las sesiones nuevas de este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez d'abord un fournisseur, puis l'un de ses modèles disponibles. Ces valeurs par défaut s'appliquent aux nouvelles sessions de ce profil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih penyedia terlebih dahulu, lalu salah satu model yang tersedia. Default ini berlaku untuk sesi baru di profil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona prima un provider, poi uno dei suoi modelli disponibili. Queste impostazioni predefinite valgono per le nuove sessioni di questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずプロバイダを選択し、次にそのプロバイダで利用可能なモデルを選択してください。これらのデフォルトは、このプロファイルの新しいセッションに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 제공자를 선택한 다음, 해당 제공자에서 사용 가능한 모델을 선택하세요. 이 기본값은 이 프로필의 새 세션에 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw wybierz dostawcę, a potem jeden z jego dostępnych modeli. Te ustawienia domyślne dotyczą nowych sesji w tym profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione primeiro um provedor e depois um dos modelos disponíveis dele. Estes padrões valem para novas sessões neste perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала выберите провайдера, затем одну из его доступных моделей. Эти значения по умолчанию применяются к новым сеансам этого профиля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce bir sağlayıcı, ardından onun kullanılabilir modellerinden birini seçin. Bu varsayılanlar bu profildeki yeni oturumlara uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先选择提供方，再从其可用模型中选择。这些默认值适用于该档案中的新会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
