    "Include approval details so cards work from notifications. Disable for maximum privacy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigabedetails einschließen, damit die Karten aus Mitteilungen heraus funktionieren. Für maximale Privatsphäre deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye los detalles de la aprobación para que las tarjetas funcionen desde las notificaciones. Desactívalo para máxima privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclure les détails d'approbation pour que les cartes fonctionnent depuis les notifications. Désactivez pour une confidentialité maximale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertakan detail persetujuan agar kartu berfungsi dari pemberitahuan. Nonaktifkan untuk privasi maksimum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi i dettagli dell'approvazione in modo che le schede funzionino dalle notifiche. Disattiva per la massima privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知からカードを操作できるように、承認の詳細を含めます。プライバシーを最大限に保護するにはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림에서 카드를 사용할 수 있도록 승인 세부 정보를 포함해요. 개인정보를 최대한 보호하려면 끄세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączaj szczegóły zatwierdzeń, aby karty działały z poziomu powiadomień. Wyłącz, aby zapewnić maksymalną prywatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui detalhes da aprovação para que os cartões funcionem nas notificações. Desative para privacidade máxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять сведения о запросе разрешения, чтобы карточки работали из уведомлений. Выключите для максимальной конфиденциальности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartların bildirimlerden çalışması için onay ayrıntılarını ekle. En yüksek gizlilik için kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在通知中包含审批详情，以便直接从通知使用审批卡片。若要最大限度保护隐私，请关闭此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含核准的詳細資訊，讓卡片可以直接在通知中使用。若要最大程度保護隱私，請停用此選項。"
          }
        }
      }
    },
