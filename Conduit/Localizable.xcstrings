    "Reconnect only reconnects Conduit. Restart Gateway restarts Hermes' gateway on your host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neu verbinden“ verbindet nur Conduit neu. „Gateway neu starten“ startet das Gateway von Hermes auf deinem Host neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Reconectar» solo vuelve a conectar Conduit. «Reiniciar pasarela» reinicia la pasarela de Hermes en tu host."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Se reconnecter » reconnecte uniquement Conduit. « Redémarrer la passerelle » redémarre la passerelle d'Hermes sur votre hôte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hubungkan Ulang” hanya menghubungkan ulang Conduit. “Mulai Ulang Gateway” memulai ulang gateway Hermes di host Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Riconnetti” riconnette solo Conduit. “Riavvia gateway” riavvia il gateway di Hermes sul tuo host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再接続」はConduitの接続だけをやり直します。「ゲートウェイを再起動」はホスト上のHermesのゲートウェイを再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘다시 연결’은 Conduit만 다시 연결해요. ‘게이트웨이 재시작’은 호스트에서 Hermes의 게이트웨이를 재시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Połącz ponownie” łączy ponownie tylko Conduit. „Uruchom bramę ponownie” uruchamia ponownie bramę Hermes na Twoim hoście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reconectar” só reconecta o Conduit. “Reiniciar gateway” reinicia o gateway do Hermes no seu host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Переподключиться» переподключает только Conduit. «Перезапустить шлюз» перезапускает шлюз Hermes на вашем хосте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Yeniden Bağlan” yalnızca Conduit'i yeniden bağlar. “Ağ Geçidini Yeniden Başlat” ise ana makinenizdeki Hermes ağ geçidini yeniden başlatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“重新连接”只会重新连接 Conduit。“重启网关”会重启你主机上的 Hermes 网关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「重新連線」只會重新連接 Conduit。「重新啟動閘道」會重新啟動你主機上的 Hermes 閘道。"
          }
        }
      }
    },
    "Reconnect to Hermes to change this conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
