        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눌러서 말하기가 켜져 있으면 사용되지 않습니다: 버튼을 누르고 있을 때 각 차례가 시작됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieużywane przy włączonym Naciśnij i mów: każda tura zaczyna się, gdy przytrzymasz przycisk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é usado com Apertar para falar ativado: cada vez começa quando você segura o botão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не используется, когда включена «Нажми и говори»: каждая реплика начинается, когда вы удерживаете кнопку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas konuş açıkken kullanılmaz: her sıra düğmeyi basılı tuttuğunuzda başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
