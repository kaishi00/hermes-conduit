    "Each job is its own chat in your session list. Say “job status” or “cancel background jobs” at any time." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ジョブは、セッションリストでそれぞれ独立したチャットになります。「job status」または「cancel background jobs」といつでも話しかけられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个任务都是会话列表中的一个独立对话。随时说“后台任务状态”或“取消后台任务”。"
          }
        }
