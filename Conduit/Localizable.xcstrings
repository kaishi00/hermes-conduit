    "There is no assistant response to branch from yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch keine Assistentenantwort, von der abgezweigt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay ninguna respuesta del asistente desde la que ramificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore de réponse de l'assistant à partir de laquelle créer une branche."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
