    "Keep Sessions, Cron, and Kanban visible beside the current conversation when the window is wide enough." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen, Cron und Kanban neben der aktuellen Unterhaltung anzeigen, wenn das Fenster breit genug ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener visibles Sesiones, Cron y Kanban junto a la conversación actual cuando la ventana sea lo bastante ancha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder Sessions, Cron et Kanban visibles à côté de la conversation actuelle quand la fenêtre est assez large."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap tampilkan Sesi, Cron, dan Kanban di samping percakapan saat ini jika jendela cukup lebar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni Sessioni, Cron e Kanban visibili accanto alla conversazione attuale quando la finestra è abbastanza larga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの幅が十分にあるときは、現在のチャットの横にセッション、cron、カンバンを表示したままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창이 충분히 넓으면 현재 대화 옆에 세션, 크론, Kanban을 계속 표시해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj Sesje, Cron i Kanban obok bieżącej rozmowy, gdy okno jest wystarczająco szerokie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter Sessões, Cron e Kanban visíveis ao lado da conversa atual quando a janela for larga o bastante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать «Сеансы», Cron и Kanban рядом с текущим разговором, если окно достаточно широкое."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere yeterince genişken Oturumlar, Cron ve Kanban'ı geçerli konuşmanın yanında görünür tut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口足够宽时，在当前对话旁保持显示会话、排程与看板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗夠寬時，在目前的對話旁持續顯示工作階段、排程和 Kanban。"
          }
        }
      }
    },
