        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane wstępne połączenia (pamięć i persona) są zbyt duże, aby wysłać je do zegarka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O briefing da chamada (memória e persona) é grande demais para enviar ao Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводные данные звонка (память и персона) слишком велики для отправки на часы."
