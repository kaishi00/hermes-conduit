    "The server leaves this profile's config on your host. Its keys stay in .env." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wird aus der Konfiguration dieses Profils auf deinem Host entfernt. Seine Schlüssel bleiben in .env."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor se quita de la configuración de este perfil en tu host. Sus claves se quedan en .env."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur est retiré de la configuration de ce profil sur votre hôte. Ses clés restent dans .env."
          }
        },
        "id" : {
          "stringUnit" : {
