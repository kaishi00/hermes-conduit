        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan akan memindahkan iPhone ini ke relai baru. Anda perlu memasangkan setiap profil Hermes lagi."
          }
        },
        "it" : {
          "stringUnit" : {
