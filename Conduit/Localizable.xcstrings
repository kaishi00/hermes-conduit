    "Listens until you double-tap again to send" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört zu, bis du zum Senden erneut doppelt tippst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha hasta que vuelvas a tocar dos veces para enviar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute jusqu’à ce que vous touchiez à nouveau deux fois pour envoyer"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendengarkan sampai Anda mengetuk dua kali lagi untuk mengirim"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta finché non tocchi di nuovo due volte per inviare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度ダブルタップして送信するまで聞き取ります"
