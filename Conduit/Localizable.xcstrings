        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł połączyć się z panelem pod tym adresem. Upewnij się, że panel działa i że to urządzenie ma do niego dostęp."
          }
        },
        "pt-BR" : {
