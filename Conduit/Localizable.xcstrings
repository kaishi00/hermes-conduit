    "Install or update the Hermes notifier plugin on your Hermes server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere oder aktualisiere das Hermes-Notifier-Plug-in auf deinem Hermes-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala o actualiza el plugin de notificaciones de Hermes en tu servidor Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez ou mettez à jour le plugin de notification Hermes sur votre serveur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instal atau perbarui plugin notifier Hermes di server Hermes Anda."
          }
        },
        "it" : {
          "stringUnit" : {
