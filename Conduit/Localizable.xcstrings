        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus ancien est dans le champ de saisie pour être modifié. Messages annulés : %lld"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
