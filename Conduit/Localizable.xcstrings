    "Voice permissions can only be requested while Conduit is in the foreground." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachberechtigungen können nur angefragt werden, während Conduit im Vordergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos de voz solo se pueden solicitar mientras Conduit está en primer plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations vocales ne peuvent être demandées que lorsque Conduit est au premier plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin suara hanya dapat diminta saat Conduit berada di latar depan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le autorizzazioni vocali possono essere richieste solo quando Conduit è in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声へのアクセス許可は、Conduitがフォアグラウンドにあるときにのみリクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 권한은 Conduit이 포그라운드에 있을 때만 요청할 수 있어요."
