          "stringUnit" : {
            "state" : "translated",
            "value" : "予算、メモリ、次回の確認、タイムゾーン、今すぐチャットを確認、最近の確認。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산, 메모리, 다음 확인, 시간대, 지금 채팅 살펴보기, 최근 확인."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budżety, pamięć, następne przejrzenie, strefa czasowa, przejrzenie czatów teraz i ostatnie przejrzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orçamentos, memória, próxima verificação, fuso horário, verificar suas conversas agora e verificações recentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бюджеты, память, следующий просмотр, часовой пояс, просмотр чатов сейчас и последние просмотры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
