            "value" : "机器人将拥有自己的 Hermes 配置、聊天、记忆和技能。"
          }
        }
      }
    },
    "The bot was created, but its picture or look was not saved. Edit the bot to try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机器人已创建，但其头像或外观未保存。请编辑机器人后重试。"
          }
        }
      }
    },
    "The description or personality was not saved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述或个性设定未保存。"
          }
        }
      }
    },
    "The name or color was not saved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称或颜色未保存。"
          }
