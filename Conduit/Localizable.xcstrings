          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки будут подставлены в форму входа. Когда будете готовы, нажмите там «Продолжить»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlar giriş formunu dolduracak. Hazır olduğunuzda orada Devam'a dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
