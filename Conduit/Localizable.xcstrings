    "Update Hermes to move conversations between projects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Hermes, um Unterhaltungen zwischen Projekten zu verschieben."
          }
        },
