    },
    "Saved for your next reconnect. Your current session stays connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deine nächste Neuverbindung gespeichert. Deine aktuelle Sitzung bleibt verbunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
