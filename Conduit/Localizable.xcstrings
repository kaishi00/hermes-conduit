    },
    "Conduit couldn't read audio from this microphone. Try again, or switch to another microphone or headset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte kein Audio von diesem Mikrofon lesen. Versuche es erneut oder wechsle zu einem anderen Mikrofon oder Headset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo leer el audio de este micrófono. Vuelve a intentarlo o cambia a otro micrófono o auricular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu lire l'audio de ce micro. Réessayez, ou passez à un autre micro ou casque."
