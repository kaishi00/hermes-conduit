    "Cancel the current response and keep Voice open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bricht die aktuelle Antwort ab und lässt den Sprachmodus geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela la respuesta actual y mantiene la voz abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler la réponse en cours et garder la conversation vocale ouverte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan respons saat ini dan biarkan Suara tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla la risposta attuale e lascia aperta la voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の応答をキャンセルし、音声モードは開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 응답을 취소하고 음성은 열어 둬요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulują bieżącą odpowiedź i zostawiają tryb głosowy otwarty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela a resposta atual e mantém a voz aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить текущий ответ, не закрывая голосовой режим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli yanıtı iptal eder ve Ses'i açık tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消当前回复，并保持语音开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消目前的回覆，並讓語音保持開啟。"
          }
        }
      }
    },
