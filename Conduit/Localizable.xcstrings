          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçtan uca şifreli"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已端到端加密"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
