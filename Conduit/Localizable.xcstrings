    "Usage: /steer <message>. Sends the message into the running reply without stopping it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendung: /steer <Nachricht>. Sendet die Nachricht in die laufende Antwort, ohne sie zu stoppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /steer <mensaje>. Envía el mensaje a la respuesta en curso sin detenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation : /steer <message>. Envoie le message dans la réponse en cours sans l’arrêter."
