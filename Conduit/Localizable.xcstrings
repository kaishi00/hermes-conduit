    },
    "%@ brings its own listening and speaking, so the speech-to-text and assistant voice steps don't apply. Pick Classic under Voice mode to use them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bringt eigenes Zuhören und Sprechen mit, daher gelten die Schritte für Spracherkennung und Assistentenstimme nicht. Wähle unter „Sprachmodus“ die Option „Klassisch“, um sie zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene su propia escucha y habla, así que los pasos de voz a texto y voz del asistente no se aplican. Elige Clásico en Modo de voz para usarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gère lui-même l'écoute et la parole : les étapes de transcription vocale et de voix de l'assistant ne s'appliquent pas. Choisissez Classique sous Mode vocal pour les utiliser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ memiliki fitur mendengar dan berbicara sendiri, sehingga langkah ucapan ke teks dan suara asisten tidak berlaku. Pilih Klasik di Mode suara untuk menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ascolta e parla da sé, quindi i passaggi di trascrizione vocale e voce dell'assistente non si applicano. Scegli Classica in Modalità vocale per usarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は独自の聞き取りと発話の機能を備えているため、音声認識とアシスタントの音声の手順は適用されません。これらを使うには、「音声モード」で「クラシック」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 자체 듣기와 말하기 기능이 있어서 음성 텍스트 변환과 어시스턴트 목소리 단계는 적용되지 않아요. 이 단계를 사용하려면 ‘음성 모드’에서 ‘클래식’을 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ma własne rozpoznawanie i syntezę mowy, więc kroki „Mowa na tekst” i „Głos asystenta” nie mają zastosowania. Aby z nich korzystać, wybierz „Klasyczny” w sekcji „Tryb głosowy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem a própria escuta e fala, então as etapas de fala para texto e voz do assistente não se aplicam. Escolha Clássico em Modo de voz para usá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим %@ сам слушает и говорит, поэтому шаги распознавания речи и голоса ассистента к нему не относятся. Чтобы использовать их, выберите «Классический» в разделе «Голосовой режим»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kendi dinleme ve konuşma özelliğiyle gelir; bu nedenle konuşmadan metne ve asistan sesi adımları geçerli değildir. Bunları kullanmak için Ses modu altında Klasik'i seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 自带收听和说话功能，因此语音转文字和助手语音这两步不适用。要使用它们，请在“语音模式”中选择“经典”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 自帶聆聽與說話功能，因此語音轉文字和助理聲音這兩個步驟不適用。若要使用這些步驟，請在「語音模式」中選擇「經典」。"
          }
        }
      }
    },
