        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja poprzednia wiadomość wciąż oczekuje. Ponów ją z pokoju lub poczekaj, aż zostanie dostarczona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mensagem anterior ainda está pendente. Tente enviá-la de novo pela sala ou aguarde a entrega."
