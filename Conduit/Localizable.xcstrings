        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête la parole d'Hermes et commence à écouter immédiatement"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan ucapan Hermes dan langsung mulai mendengarkan"
