    "Hermes routes triage decomposition across these profiles by their routing description. A clear description helps the decomposer pick the right specialist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes verteilt die Triage-Zerlegung anhand ihrer Routing-Beschreibung auf diese Profile. Eine klare Beschreibung hilft dem Zerleger, den richtigen Spezialisten zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes reparte la descomposición de Clasificación entre estos perfiles según su descripción de enrutamiento. Una descripción clara ayuda al descomponedor a elegir el especialista adecuado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes répartit la décomposition du triage entre ces profils selon leur description de routage. Une description claire aide le décomposeur à choisir le bon spécialiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesは、ルーティングの説明に基づいて、トリアージの分解をこれらのプロファイルに振り分けます。説明が明確だと、分解担当が適切なスペシャリストを選びやすくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes distribui a decomposição da triagem entre estes perfis de acordo com a descrição de roteamento de cada um. Uma descrição clara ajuda o decompositor a escolher o especialista certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes распределяет разбиение задач между этими профилями по их описанию маршрутизации. Понятное описание помогает выбрать подходящего специалиста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 依据路由描述，将分类任务的分解路由到这些档案。清晰的描述有助于分解器选出合适的专长档案。"
          }
        }
      }
    },
