        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit si sta ancora connettendo alla tua dashboard. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
