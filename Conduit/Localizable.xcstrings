    "Drag categories into the order you prefer. All remains first in the session drawer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Kategorien in die gewünschte Reihenfolge. „Alle“ bleibt in der Sitzungsleiste immer zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las categorías en el orden que prefieras. «Todos» sigue apareciendo primero en la barra lateral de sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les catégories dans l'ordre de votre choix. Tous reste en premier dans le panneau des sessions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret kategori ke urutan yang Anda inginkan. “Semua” tetap di urutan pertama di laci sesi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le categorie nell'ordine che preferisci. Tutti resta sempre per primo nel pannello delle sessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリをドラッグして好きな順番に並べ替えます。「すべて」はセッション一覧の先頭に常に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카테고리를 원하는 순서로 드래그하세요. ‘전체’는 세션 패널에서 항상 맨 처음에 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij kategorie, aby ustawić preferowaną kolejność. „Wszystkie” zawsze są pierwsze na liście sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste as categorias para a ordem que preferir. Todos continua em primeiro lugar na gaveta de sessões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите категории в нужном порядке. «Все» всегда остаётся первой на панели сеансов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorileri tercih ettiğiniz sıraya sürükleyin. Oturum çekmecesinde Tümü her zaman ilk sırada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动分类可按你喜欢的顺序排列。「全部」始终位于会话抽屉首位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移類別以排列成你喜歡的順序。「全部」在工作階段側邊欄中一律排在第一個。"
          }
        }
      }
    },
    "Drag the line beside the list to make it wider or narrower." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Linie neben der Liste, um sie breiter oder schmaler zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la línea junto a la lista para hacerla más ancha o más estrecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la ligne à côté de la liste pour l’élargir ou la rétrécir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret garis di samping daftar untuk melebarkan atau menyempitkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la linea accanto all’elenco per allargarlo o restringerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧の横の線をドラッグすると、幅を広げたり狭めたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록 옆의 선을 드래그하여 너비를 넓히거나 좁히세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij linię obok listy, aby ją poszerzyć lub zwęzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a linha ao lado da lista para deixá-la mais larga ou mais estreita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите линию рядом со списком, чтобы сделать его шире или уже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeyi genişletmek veya daraltmak için yanındaki çizgiyi sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动列表旁的线条，可将列表调宽或调窄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移列表旁的線條，可將列表調寬或調窄。"
          }
        }
      }
    },
