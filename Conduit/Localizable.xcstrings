            "value" : "待ち受けを開始する前に、有効なウェイクフレーズを1つ以上選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣기 전에 유효한 호출어를 하나 이상 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed rozpoczęciem nasłuchiwania wybierz co najmniej jedną prawidłową frazę aktywującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pelo menos uma frase de ativação válida antes de ouvir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед прослушиванием выберите хотя бы одну допустимую фразу активации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlemeden önce en az bir geçerli uyandırma ifadesi seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始监听前，请至少选择一个有效的唤醒短语。"
          }
