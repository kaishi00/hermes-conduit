    "The board selection is local to this device; creating this task will not switch Hermes' global board." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Board-Auswahl gilt nur auf diesem Gerät; beim Erstellen dieser Aufgabe wird das globale Board von Hermes nicht gewechselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección de tablero es local de este dispositivo; crear esta tarea no cambiará el tablero global de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection du tableau est propre à cet appareil ; créer cette tâche ne changera pas le tableau global d'Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードの選択はこのデバイス内でのみ有効です。このタスクを作成しても、Hermes全体のボードは切り替わりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção de quadro vale apenas para este aparelho; criar esta tarefa não troca o quadro global do Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор доски хранится только на этом устройстве; при создании этой задачи глобальная доска Hermes не переключится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看板选择仅对本设备生效；创建此任务不会切换 Hermes 的全局看板。"
          }
        }
      }
    },
    "The board's project directory (%@) applies to this task." : {
