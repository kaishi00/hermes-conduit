        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser Touch ID"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan Touch ID"
          }
        },
