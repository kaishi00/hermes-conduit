    "Pause only affects the microphone. Close ends the voice session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pausieren“ betrifft nur das Mikrofon. „Schließen“ beendet die Sprachsitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar solo afecta al micrófono. Cerrar finaliza la sesión de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause n'agit que sur le micro. Fermer met fin à la session vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止はマイクにのみ適用されます。閉じると音声セッションが終了します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar afeta apenas o microfone. Fechar encerra a sessão de voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза влияет только на микрофон. «Закрыть» завершает голосовой сеанс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停仅作用于麦克风。关闭会结束语音会话。"
          }
        }
      }
    },
