            "value" : "Hermes nie mógł otworzyć Local Live dla zegarka. Zaktualizuj wtyczkę powiadomień Conduit i przekaźnik push."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu abrir o Local Live para o Watch. Atualize o plugin notificador do Conduit e a retransmissão de push."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не удалось открыть Local Live для часов. Обновите плагин уведомлений Conduit и push-ретранслятор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, Watch için Local Live'ı açamadı. Conduit bildirim eklentisini ve bildirim aktarıcısını güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
