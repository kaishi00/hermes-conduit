          "stringUnit" : {
            "state" : "translated",
            "value" : "Использование: /steer <сообщение>. Отправляет сообщение в текущий ответ, не останавливая его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım: /steer <mesaj>. Mesajı süren yanıtı durdurmadan ona gönderir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/steer <消息>。将消息发送到正在进行的回复中，不会停止它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/steer <訊息>。將訊息傳送到進行中的回覆，不會停止它。"
          }
        }
      }
    },
    "Usage: /queue <message>. Sends the message as the next turn once the running reply finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendung: /queue <Nachricht>. Sendet die Nachricht als nächsten Zug, sobald die laufende Antwort fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <mensaje>. Envía el mensaje como el siguiente turno cuando termine la respuesta en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation : /queue <message>. Envoie le message comme tour suivant une fois la réponse en cours terminée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penggunaan: /queue <pesan>. Mengirim pesan sebagai giliran berikutnya setelah balasan yang berjalan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <messaggio>. Invia il messaggio come turno successivo al termine della risposta in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使い方：/queue <メッセージ>。実行中の返信が終わったら、次のターンとしてメッセージを送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용법: /queue <메시지>. 진행 중인 응답이 끝나면 다음 차례로 메시지를 보냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
