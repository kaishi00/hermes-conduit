    "Default uses Hermes' resolved default assignee (%@). Parked leaves the task unassigned so no worker claims it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Standard“ nutzt die von Hermes ermittelte Standardzuständigkeit (%@). „Geparkt“ lässt die Aufgabe ohne Zuweisung, sodass kein Worker sie übernimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default uses Hermes' resolved default assignee (%@). Parked leaves the task unassigned so no worker claims it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado usa el responsable predeterminado que resuelve Hermes (%@). En espera deja la tarea sin asignar para que ningún ejecutor la tome."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut utilise le responsable par défaut résolu par Hermes (%@). En suspens laisse la tâche non assignée pour qu'aucun worker ne la prenne en charge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default menggunakan penanggung jawab default Hermes yang berlaku (%@). Diparkir membiarkan tugas tanpa penanggung jawab sehingga tidak ada worker yang mengambilnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predefinito usa l'assegnatario predefinito risolto da Hermes (%@). In sospeso lascia l'attività non assegnata, così nessun worker la prende in carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デフォルト」では、Hermesが決定したデフォルトの担当者（%@）を使用します。「保留」では、タスクを未割り当てのままにして、どのワーカーにも引き受けられないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘기본’은 Hermes가 정한 기본 담당자(%@)를 사용해요. ‘보류’는 태스크를 미할당 상태로 두어 어떤 워커도 가져가지 않게 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Domyślny” używa domyślnego wykonawcy ustalonego przez Hermesa (%@). „Odłożone” pozostawia zadanie nieprzypisane, aby żaden proces roboczy go nie przejął."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padrão usa o responsável padrão definido pelo Hermes (%@). Em espera deixa a tarefa sem responsável para que nenhum executor a assuma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«По умолчанию» использует исполнителя по умолчанию, определённого Hermes (%@). «Отложено» оставляет задачу без исполнителя, чтобы её не взял ни один обработчик."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan, Hermes'in çözümlediği varsayılan atananı (%@) kullanır. Beklemede, görevi atanmamış bırakır; böylece hiçbir çalışan onu üstlenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 Hermes 解析出的默认负责人（%@）。「搁置」会让任务保持未分配，因此不会有工作代理认领。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「預設」會使用 Hermes 解析出的預設負責人（%@）。「擱置」會讓任務保持未指派，因此不會有執行者認領。"
          }
        }
      }
    },
