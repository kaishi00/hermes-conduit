    "Hiding a provider preserves its individual model choices. These filters stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ausblenden eines Anbieters bleiben seine einzelnen Modellauswahlen erhalten. Diese Filter bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar un proveedor conserva sus elecciones de modelo individuales. Estos filtros se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer un fournisseur conserve ses choix de modèles individuels. Ces filtres restent sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan penyedia akan mempertahankan pilihan modelnya masing-masing. Filter ini tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondere un provider ne conserva le singole scelte di modello. Questi filtri restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダを非表示にしても、個々のモデルの選択は保持されます。これらのフィルタはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자를 가려도 개별 모델 선택은 유지돼요. 이 필터는 이 기기에 남아 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrycie dostawcy zachowuje wybór jego poszczególnych modeli. Te filtry pozostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar um provedor preserva as escolhas de modelo dele. Estes filtros ficam neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При скрытии провайдера выбор его отдельных моделей сохраняется. Эти фильтры остаются на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sağlayıcıyı gizlemek, model seçimlerini korur. Bu filtreler bu cihazda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏提供方会保留其各自的模型选择。这些筛选条件仅保存在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏供應商會保留其個別的模型選擇。這些篩選條件只會保留在此裝置上。"
          }
        }
      }
    },
