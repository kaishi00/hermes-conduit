    "Return to Voice settings, enable this mode if it is off, and tap %@ to check availability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre zu den Spracheinstellungen zurück, aktiviere diesen Modus, falls er aus ist, und tippe auf „%@“, um die Verfügbarkeit zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a los ajustes de Voz, activa este modo si está desactivado y toca «%@» para comprobar la disponibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez aux réglages Voix, activez ce mode s'il est désactivé, puis touchez %@ pour vérifier la disponibilité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「音声」設定に戻り、このモードがオフの場合はオンにしてから、%@をタップして利用可能か確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte aos ajustes de Voz, ative este modo se estiver desativado e toque em %@ para verificar a disponibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь в настройки голоса, включите этот режим, если он выключен, и нажмите «%@», чтобы проверить доступность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回“语音”设置；如果此模式尚未启用，请先启用，然后轻点 %@ 检查是否可用。"
          }
        }
      }
    },
