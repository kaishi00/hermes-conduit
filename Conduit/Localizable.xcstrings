          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlayでウェイクフレーズを聞き取るにはiPhoneのマイクが必要ですが、現在使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay에서 호출어를 들으려면 iPhone 마이크가 필요하지만 지금은 사용할 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasłuchiwanie frazy aktywującej w CarPlay wymaga mikrofonu iPhone’a, który jest teraz niedostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escuta de ativação no CarPlay precisa do microfone do iPhone, que não está disponível agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для ожидания фразы активации в CarPlay нужен микрофон iPhone, но сейчас он недоступен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay'de uyandırma dinlemesi iPhone'un mikrofonunu gerektirir; mikrofon şu anda kullanılamıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 CarPlay 上监听唤醒词需要使用 iPhone 麦克风，但它目前不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 CarPlay 上聆聽喚醒詞需要使用 iPhone 的麥克風，但麥克風目前無法使用。"
          }
        }
      }
    },
    "Listen on CarPlay" : {
