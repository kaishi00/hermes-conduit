          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backend SSH : conserver les variables exportées entre les commandes. Le dossier de travail est toujours conservé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backend SSH: pertahankan variabel yang diekspor antarperintah. Direktori kerja selalu ikut terbawa."
