    "This means the Hermes dashboard username and password you sign in with — not Tailscale, Cloudflare, or Apple credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeint sind der Benutzername und das Passwort deines Hermes-Dashboards, mit denen du dich anmeldest – nicht deine Zugangsdaten für Tailscale, Cloudflare oder Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se refiere al usuario y la contraseña del panel de Hermes con los que inicias sesión, no a los de Tailscale, Cloudflare ni Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit du nom d'utilisateur et du mot de passe du tableau de bord Hermes avec lesquels vous vous connectez, et non d'identifiants Tailscale, Cloudflare ou Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksudnya nama pengguna dan kata sandi dasbor Hermes yang Anda gunakan untuk masuk — bukan kredensial Tailscale, Cloudflare, atau Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si intendono il nome utente e la password della dashboard Hermes con cui accedi, non le credenziali di Tailscale, Cloudflare o Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは、サインインに使うHermesダッシュボードのユーザ名とパスワードのことです。Tailscale、Cloudflare、Appleの認証情報ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale, Cloudflare, Apple 자격 증명이 아니라 로그인할 때 사용하는 Hermes 대시보드 사용자 이름과 암호를 말해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chodzi o nazwę użytkownika i hasło do panelu Hermes, którymi się logujesz — nie o dane logowania Tailscale, Cloudflare ani Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou seja, o nome de usuário e a senha do painel do Hermes com que você faz login — não credenciais do Tailscale, da Cloudflare ou da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имеются в виду имя пользователя и пароль дашборда Hermes, с которыми вы входите, — не учётные данные Tailscale, Cloudflare или Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, giriş yaptığınız Hermes paneli kullanıcı adı ve parolası anlamına gelir — Tailscale, Cloudflare veya Apple kimlik bilgileri değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是指你登录 Hermes 仪表盘所用的用户名和密码——而非 Tailscale、Cloudflare 或 Apple 凭据。"
          }
