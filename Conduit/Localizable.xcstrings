    "Taking this chat over from Hermes Desktop. If it's replying, Conduit waits for the reply to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat wird aus Hermes Desktop übernommen. Falls dort gerade eine Antwort läuft, wartet Conduit, bis sie fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retomando este chat desde Hermes Desktop. Si está respondiendo, Conduit espera a que termine la respuesta."
