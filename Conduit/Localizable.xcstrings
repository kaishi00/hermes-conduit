    "Keep listening when locked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Sperre weiter zuhören"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir escuchando al bloquear"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écouter même verrouillé"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap mendengarkan saat terkunci"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
