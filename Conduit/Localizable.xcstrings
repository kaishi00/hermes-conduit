        }
      }
    },
    "Used only to reach this Cloudflare-protected dashboard; the secret stays in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur verwendet, um dieses durch Cloudflare geschützte Dashboard zu erreichen; das Secret bleibt im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usa para acceder a este panel protegido por Cloudflare; el secreto se queda en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement pour joindre ce tableau de bord protégé par Cloudflare ; le secret reste dans le trousseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
