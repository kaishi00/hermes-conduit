        }
      }
    },
    "Install the notifier if it is missing, or update your existing installation. Both commands target the Hermes gateway used by this profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere den Notifier, falls er fehlt, oder aktualisiere deine bestehende Installation. Beide Befehle richten sich an das Hermes-Gateway dieses Profils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala el notificador si falta o actualiza tu instalación actual. Ambos comandos se aplican a la pasarela de Hermes que usa este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez le plugin de notification s'il est absent, ou mettez à jour votre installation existante. Les deux commandes ciblent la passerelle Hermes utilisée par ce profil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instal notifier jika belum ada, atau perbarui instalasi yang sudah ada. Kedua perintah ditujukan ke gateway Hermes yang digunakan profil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa il plugin di notifica se manca o aggiorna l'installazione esistente. Entrambi i comandi agiscono sul gateway Hermes usato da questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知プラグインが未インストールの場合はインストールし、インストール済みの場合はアップデートしてください。どちらのコマンドも、このプロファイルが使用するHermesゲートウェイが対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림 플러그인이 없으면 설치하고, 이미 설치되어 있으면 업데이트하세요. 두 명령 모두 이 프로필이 사용하는 Hermes 게이트웨이를 대상으로 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj wtyczkę powiadomień, jeśli jej brakuje, lub zaktualizuj istniejącą instalację. Oba polecenia dotyczą bramy Hermes używanej przez ten profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o notificador se ele estiver ausente ou atualize a instalação existente. Os dois comandos se aplicam ao gateway do Hermes usado por este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите плагин уведомлений, если его нет, или обновите существующую установку. Обе команды выполняются для шлюза Hermes, который использует этот профиль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim eklentisi eksikse yükleyin veya mevcut kurulumunuzu güncelleyin. Her iki komut da bu profilin kullandığı Hermes ağ geçidini hedefler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果尚未安装，请安装通知插件；如果已安装，请更新现有版本。两个命令都针对此配置使用的 Hermes 网关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果尚未安裝通知外掛程式，請安裝；或更新你現有的安裝。兩個指令都針對此設定檔使用的 Hermes 閘道。"
          }
        }
      }
    },
