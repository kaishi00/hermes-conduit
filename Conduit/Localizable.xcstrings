    "Listening stopped while your phone was locked. Tap Listen to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zuhören wurde beendet, während dein iPhone gesperrt war. Tippe auf „Zuhören“, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escucha se detuvo mientras el teléfono estaba bloqueado. Toca Escuchar para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écoute s'est arrêtée pendant que votre téléphone était verrouillé. Touchez Écouter pour continuer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendengaran berhenti saat ponsel Anda terkunci. Ketuk Dengarkan untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ascolto si è interrotto mentre il telefono era bloccato. Tocca Ascolta per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面のロック中に聞き取りが停止しました。続けるには「聞き取り」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 잠겨 있는 동안 듣기가 중지됐어요. 계속하려면 ‘듣기’를 탭하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słuchanie zostało zatrzymane, gdy telefon był zablokowany. Stuknij „Słuchaj”, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escuta parou enquanto o telefone estava bloqueado. Toque em Ouvir para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослушивание остановилось, пока телефон был заблокирован. Нажмите «Слушать», чтобы продолжить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuz kilitliyken dinleme durdu. Devam etmek için Dinle'ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机锁定时聆听已停止。点按“聆听”继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機鎖定時已停止聆聽。點一下「聆聽」以繼續。"
          }
        }
      }
    },
