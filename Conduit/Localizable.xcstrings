    "Steer adds guidance to the active turn. Interrupt stops it before handling the new message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nachsteuern“ ergänzt den aktiven Durchgang um Hinweise. „Unterbrechen“ stoppt ihn, bevor die neue Nachricht verarbeitet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiar añade indicaciones al turno activo. Interrumpir lo detiene antes de procesar el nuevo mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réorienter ajoute des indications au tour en cours. Interrompre l'arrête avant de traiter le nouveau message."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan menambahkan panduan ke giliran aktif. Interupsi menghentikannya sebelum menangani pesan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reindirizza aggiunge indicazioni al turno attivo. Interrompi lo ferma prima di gestire il nuovo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「軌道修正」は実行中のターンに指示を追加します。「中断」は新しいメッセージを処理する前にそのターンを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘방향 조정’은 진행 중인 턴에 지침을 추가해요. ‘중단’은 새 메시지를 처리하기 전에 턴을 멈춰요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pokieruj” dodaje wskazówki do bieżącej odpowiedzi. „Przerwij” zatrzymuje ją przed obsłużeniem nowej wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientar acrescenta instruções ao turno ativo. Interromper o encerra antes de tratar a nova mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скорректировать» добавляет указания к текущему ответу. «Прервать» останавливает его, прежде чем обработать новое сообщение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönlendir, etkin tura yönlendirme ekler. Yarıda Kes, yeni mesajı işlemeden önce turu durdurur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引导会为当前回合追加指引。中断则会在处理新消息前停止当前回合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「引導」會為進行中的回合加入指引。「中斷」會先停止該回合，再處理新訊息。"
          }
        }
      }
    },
