        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse молчит"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse sessizde"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 正在保持安静"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 正在保持安靜"
          }
        }
      }
    },
    "Pulse keeps short notes on commitments, plans and interests from your chats, so its reports can bring them up later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse hält kurze Notizen zu Zusagen, Plänen und Interessen aus deinen Chats fest, damit seine Berichte sie später aufgreifen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse guarda notas breves sobre compromisos, planes e intereses de tus chats para que sus informes puedan mencionarlos más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse garde de courtes notes sur les engagements, projets et centres d’intérêt de vos discussions, pour que ses rapports puissent les évoquer plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse menyimpan catatan singkat tentang komitmen, rencana, dan minat dari chat Anda, agar laporannya bisa mengungkitnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse tiene brevi note su impegni, piani e interessi dai tuoi chat, così i suoi resoconti possono riproporli più avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulseはチャットに出てきた約束事、予定、興味について短いメモを残し、後でレポートで取り上げられるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse는 채팅에서 나온 약속, 계획, 관심사를 짧게 메모해 두었다가 나중에 리포트에서 다시 꺼낼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse zapisuje krótkie notatki o zobowiązaniach, planach i zainteresowaniach z Twoich czatów, aby jego raporty mogły do nich później wrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse guarda notas curtas sobre compromissos, planos e interesses das suas conversas, para que os relatórios possam retomá-los depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse ведёт краткие заметки об обязательствах, планах и интересах из ваших чатов, чтобы потом напомнить о них в отчётах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse, sohbetlerinizdeki taahhütler, planlar ve ilgi alanları hakkında kısa notlar tutar; böylece raporları bunları daha sonra gündeme getirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 会从你的聊天中简短记录承诺、计划和兴趣，以便之后在报告中提起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 會從你的聊天中簡短記錄承諾、計畫和興趣，以便之後在報告中提起。"
          }
        }
      }
    },
    "Pulse keeps short notes on promises, plans and dates, so it can bring them up later. You can remove any of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse macht sich kurze Notizen zu Versprechen, Plänen und Terminen, um später darauf zurückzukommen. Du kannst jede davon entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse guarda notas breves sobre promesas, planes y fechas para poder recordártelas más tarde. Puedes eliminar cualquiera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse prend de courtes notes sur les promesses, projets et dates pour pouvoir vous les rappeler plus tard. Vous pouvez supprimer chacune d'elles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse menyimpan catatan singkat tentang janji, rencana, dan tanggal agar bisa mengingatkannya nanti. Kamu bisa menghapus yang mana saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse prende brevi note su promesse, piani e date per potertele ricordare più tardi. Puoi eliminarne qualsiasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulseは約束、予定、日付について短いメモを残し、あとで取り上げられるようにします。メモはいつでも削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse는 약속, 계획, 날짜에 대한 짧은 메모를 남겨 나중에 다시 꺼낼 수 있게 합니다. 어떤 메모든 삭제할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse zapisuje krótkie notatki o obietnicach, planach i datach, aby móc do nich później wrócić. Możesz usunąć każdą z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse guarda notas curtas sobre promessas, planos e datas para poder lembrá-las depois. Você pode remover qualquer uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse делает короткие заметки об обещаниях, планах и датах, чтобы напомнить о них позже. Любую из них можно удалить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse sözler, planlar ve tarihler hakkında kısa notlar tutar, böylece onları daha sonra hatırlatabilir. Bunlardan istediğini silebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 会简短记录承诺、计划和日期，以便日后提起。你可以删除其中任何一条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 會簡短記錄承諾、計畫和日期，以便日後提起。你可以刪除其中任何一則。"
          }
        }
      }
    },
