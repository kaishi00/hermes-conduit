          }
        }
      }
    },
    "Update Conduit on your iPhone and Watch to the same version." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone と Watch の Conduit を同じバージョンにアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将 iPhone 和 Watch 上的 Conduit 更新到相同版本。"
          }
        }
      }
    },
    "Your Hermes host doesn't offer GPT-Live for the Watch. Update the Conduit notifier plugin." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ホストは Watch 用の GPT-Live に対応していません。Conduit 通知プラグインをアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Hermes 主机不提供 Watch 版 GPT-Live。请更新 Conduit 通知插件。"
          }
        }
      }
    },
    "Your Hermes host holds GPT-Live's call for the Watch, with a small runtime it sets up once. The first call sets it up too, but that can take a few minutes." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 用の GPT-Live 通話は Hermes ホストが保持し、そのための小さなランタイムを一度だけ設定します。最初の通話でも設定されますが、数分かかることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 的 GPT-Live 通话由你的 Hermes 主机承载，主机会一次性设置一个小型运行环境。首次通话也会进行设置，但可能需要几分钟。"
          }
        }
      }
    },
    "Hermes couldn't open GPT-Live for the Watch: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes は Watch 用の GPT-Live を開けませんでした：%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 无法为 Watch 打开 GPT-Live：%@"
          }
        }
      }
    },
    "Jobs per Watch call: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 通話ごとのジョブ数：%@"
          }
        },
