    "On the host, `hermes conduit-push prefs export` and `prefs import` move the same set between hosts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Host übertragen `hermes conduit-push prefs export` und `prefs import` dieselben Einstellungen zwischen Hosts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el host, `hermes conduit-push prefs export` y `prefs import` mueven el mismo conjunto entre hosts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’hôte, `hermes conduit-push prefs export` et `prefs import` transfèrent le même ensemble d’un hôte à l’autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di host, `hermes conduit-push prefs export` dan `prefs import` memindahkan set yang sama antar host."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull’host, `hermes conduit-push prefs export` e `prefs import` spostano lo stesso insieme tra host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト上では `hermes conduit-push prefs export` と `prefs import` で同じ設定をホスト間で移せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에서 `hermes conduit-push prefs export`와 `prefs import`로 같은 설정을 호스트 간에 옮길 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
