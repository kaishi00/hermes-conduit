    "The slug must be 1-64 lowercase letters or numbers, with hyphens or underscores after the first character." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Slug muss aus 1–64 Kleinbuchstaben oder Ziffern bestehen, mit Binde- oder Unterstrichen nach dem ersten Zeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El identificador debe tener de 1 a 64 letras minúsculas o números, con guiones o guiones bajos a partir del segundo carácter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le slug doit comporter de 1 à 64 lettres minuscules ou chiffres, avec des tirets ou des tirets bas après le premier caractère."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slug harus berupa 1-64 huruf kecil atau angka, dengan tanda hubung atau garis bawah setelah karakter pertama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo slug deve contenere da 1 a 64 lettere minuscole o numeri, con trattini o trattini bassi dopo il primo carattere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スラッグは1〜64文字の英小文字または数字で指定してください。2文字目以降にはハイフンとアンダースコアも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬러그는 소문자나 숫자 1~64자여야 하며, 첫 글자 다음부터 하이픈이나 밑줄을 사용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identyfikator musi mieć od 1 do 64 znaków: małe litery lub cyfry, a po pierwszym znaku także łączniki lub podkreślenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O slug precisa ter de 1 a 64 letras minúsculas ou números, com hifens ou sublinhados depois do primeiro caractere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слаг должен содержать от 1 до 64 строчных букв или цифр; после первого символа допускаются дефисы и подчёркивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa ad 1-64 küçük harf veya rakamdan oluşmalıdır; ilk karakterden sonra kısa çizgi veya alt çizgi kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标识必须为 1-64 个小写字母或数字，首字符之后可使用连字符或下划线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代稱必須是 1 到 64 個小寫字母或數字，第一個字元之後可使用連字號或底線。"
          }
        }
      }
    },
