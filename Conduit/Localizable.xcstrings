    "That answer is too long to send from a notification card. Open the chat in Conduit and answer there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Antwort ist zu lang, um sie aus einer Mitteilungskarte zu senden. Öffne den Chat in Conduit und antworte dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa respuesta es demasiado larga para enviarla desde una tarjeta de notificación. Abre el chat en Conduit y responde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette réponse est trop longue pour être envoyée depuis une carte de notification. Ouvrez la discussion dans Conduit et répondez-y."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban itu terlalu panjang untuk dikirim dari kartu notifikasi. Buka obrolan di Conduit dan jawab di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa risposta è troppo lunga per essere inviata da una scheda di notifica. Apri la chat in Conduit e rispondi da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この回答は長すぎて通知カードから送信できません。Conduitでチャットを開いて、そこで回答してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 답변은 알림 카드에서 보내기에는 너무 길어요. Conduit에서 채팅을 열고 그곳에서 답하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta odpowiedź jest za długa, by wysłać ją z karty powiadomienia. Otwórz czat w Conduit i odpowiedz tam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa resposta é longa demais para enviar de um cartão de notificação. Abra o chat no Conduit e responda lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот ответ слишком длинный для отправки из карточки уведомления. Откройте чат в Conduit и ответьте там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yanıt bir bildirim kartından gönderilemeyecek kadar uzun. Sohbeti Conduit'te açıp orada yanıtlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个回答太长，无法从通知卡片发送。请在 Conduit 中打开该对话并在那里回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個回答太長，無法從通知卡片傳送。請在 Conduit 中打開該聊天，並在那裡回答。"
          }
        }
      }
    },
