    "Keys Hermes saved for this server stay in .env on your host. The JSON shows only their names." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel, die Hermes für diesen Server gesichert hat, bleiben in .env auf deinem Host. Das JSON zeigt nur ihre Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves que Hermes guardó para este servidor siguen en .env en tu host. El JSON solo muestra sus nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés que Hermes a enregistrées pour ce serveur restent dans .env sur votre hôte. Le JSON n’affiche que leurs noms."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci yang disimpan Hermes untuk server ini tetap di .env di host Anda. JSON hanya menampilkan namanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi che Hermes ha salvato per questo server restano in .env sul tuo host. Il JSON mostra solo i loro nomi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesがこのサーバー用に保存したキーはホストの.envに残ります。JSONには名前だけが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 이 서버용으로 저장한 키는 호스트의 .env에 남아 있습니다. JSON에는 이름만 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze zapisane przez Hermes dla tego serwera zostają w .env na twoim hoście. JSON pokazuje tylko ich nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves que o Hermes salvou para este servidor ficam no .env do seu host. O JSON mostra só os nomes delas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи, которые Hermes сохранил для этого сервера, остаются в .env на вашем хосте. В JSON видны только их имена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'in bu sunucu için kaydettiği anahtarlar ana makinenizdeki .env dosyasında kalır. JSON yalnızca adlarını gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 为此服务器保存的密钥仍在你主机上的 .env 中。JSON 只显示它们的名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 為此伺服器儲存的金鑰仍在你主機上的 .env 中。JSON 只顯示它們的名稱。"
