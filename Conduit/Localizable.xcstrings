        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan real-time dengan Gemini yang menyerahkan pekerjaannya kepada Hermes. Memerlukan plugin notifier Hermes dan kunci Gemini di server Hermes Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conversazione in tempo reale con Gemini che passa il lavoro a Hermes. Richiede il plugin di notifica di Hermes e una chiave Gemini sul tuo server Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geminiとのリアルタイムの会話で、作業はHermesに引き継がれます。Hermes通知プラグインと、HermesサーバのGeminiキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini와 나누는 실시간 대화로, 작업은 Hermes에 넘겨요. Hermes 알림 플러그인과 Hermes 서버의 Gemini 키가 필요해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmowa w czasie rzeczywistym z Gemini, która przekazuje pracę Hermesowi. Wymaga wtyczki powiadomień Hermes i klucza Gemini na Twoim serwerze Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conversa em tempo real com o Gemini, que passa o trabalho para o Hermes. Requer o plugin notificador do Hermes e uma chave do Gemini no seu servidor Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разговор с Gemini в реальном времени, который передаёт работу Hermes. Нужны плагин уведомлений Hermes и ключ Gemini на вашем сервере Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini ile yapılan ve işi Hermes'e devreden gerçek zamanlı bir konuşma. Hermes bildirim eklentisi ve Hermes sunucunuzda bir Gemini anahtarı gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Gemini 实时对话，并把任务交给 Hermes 完成。需要 Hermes 通知插件，以及 Hermes 服务器上的 Gemini 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 Gemini 進行即時對話，並把事情交給 Hermes 處理。需要 Hermes 通知外掛程式，以及 Hermes 伺服器上的 Gemini 金鑰。"
          }
        }
      }
