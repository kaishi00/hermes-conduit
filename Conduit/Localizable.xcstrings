    "Hermes added this to the reply already running in the chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat dies der bereits laufenden Antwort im Chat hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes añadió esto a la respuesta que ya se estaba generando en el chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a ajouté ceci à la réponse déjà en cours dans la discussion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes menambahkan ini ke balasan yang sedang berjalan di obrolan."
          }
        },
        "it" : {
