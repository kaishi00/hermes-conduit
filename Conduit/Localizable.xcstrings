          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(То, что ваш агент Hermes помнит о вас; считывается в начале звонка.)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
