    "Setup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置"
          }
        }
      }
    },
    "Each call's transcript is saved to your Hermes server's history and shows under Voice in Sessions, where you can read it or resume the call. Needs an up-to-date Hermes notifier plugin. Shared with Gemini Live and GPT-Live. Applies to the next conversation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次通话的文字记录都会保存到 Hermes 服务器的历史记录中，并显示在“会话”的“语音”下，你可以在那里查看或继续通话。需要最新版本的 Hermes notifier 插件。Gemini Live 和 GPT-Live 共用此设置。从下一次对话开始生效。"
          }
        }
      }
    },
    "From %@" : {
