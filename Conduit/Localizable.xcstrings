    "Pulse sends its reports to a pinned chat titled “%@” in the dashboard's default profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse sendet seine Berichte an einen angehefteten Chat namens „%@“ im Standardprofil des Dashboards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse envía sus informes a un chat fijado llamado «%@» en el perfil predeterminado del panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse envoie ses rapports dans une discussion épinglée intitulée « %@ » du profil par défaut du tableau de bord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse mengirim laporannya ke chat tersemat berjudul “%@” di profil default dasbor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse invia i suoi resoconti a un chat fissato intitolato «%@» nel profilo predefinito della dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulseは、ダッシュボードのデフォルトプロフィールにある「%@」という名前のピン留めされたチャットにレポートを送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse는 대시보드 기본 프로필에 있는 ‘%@’(이)라는 고정된 채팅으로 리포트를 보냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse wysyła raporty do przypiętego czatu o nazwie „%@” w domyślnym profilu panelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse envia os relatórios para uma conversa fixada chamada “%@” no perfil padrão do painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
