    "Hardware keyboards only. The on-screen keyboard's Return key keeps inserting a new line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Hardwaretastaturen. Die Eingabetaste der Bildschirmtastatur fügt weiterhin eine neue Zeile ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo teclados físicos. La tecla Intro del teclado en pantalla sigue insertando una nueva línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claviers physiques uniquement. La touche Retour du clavier à l'écran continue d'insérer une nouvelle ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya keyboard fisik. Tombol Return di keyboard layar tetap menyisipkan baris baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tastiere fisiche. Il tasto Invio della tastiera su schermo continua a inserire una nuova riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアキーボードのみが対象です。画面上のキーボードの改行キーでは、引き続き改行が入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 키보드에만 해당돼요. 화면 키보드의 Return 키는 계속 줄 바꿈을 입력해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko klawiatury sprzętowe. Klawisz Return na klawiaturze ekranowej nadal wstawia nowy wiersz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas teclados físicos. A tecla Retorno do teclado na tela continua inserindo uma nova linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для аппаратных клавиатур. Клавиша «Ввод» экранной клавиатуры по-прежнему вставляет новую строку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca donanım klavyeleri. Ekran klavyesinin Return tuşu yeni satır eklemeye devam eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅适用于硬件键盘。屏幕键盘的 Return 键仍会插入换行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限硬體鍵盤。螢幕鍵盤的 Return 鍵仍會插入新行。"
          }
        }
      }
    },
    "Headers, keys and the rest stay as they are. Change them in JSON." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Header, Schlüssel und alles andere bleiben, wie sie sind. Ändere sie im JSON."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los encabezados, las claves y lo demás se quedan como están. Cámbialos en el JSON."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en-têtes, les clés et le reste ne changent pas. Modifiez-les dans le JSON."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Header, kunci, dan lainnya tetap seperti semula. Ubah di JSON."
          }
        },
        "it" : {
          "stringUnit" : {
