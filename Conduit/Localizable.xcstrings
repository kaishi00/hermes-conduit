    "This chat has newer messages. Try Edit and resend again to see what it takes back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat hat neuere Nachrichten. Tippe erneut auf „Bearbeiten und neu senden“, um zu sehen, was zurückgenommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
