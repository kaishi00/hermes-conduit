    "Files no longer on your Hermes host are hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien, die nicht mehr auf deinem Hermes-Host sind, werden ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que ya no están en tu host de Hermes están ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers qui ne sont plus sur ton hôte Hermes sont masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang tidak lagi ada di host Hermes kamu disembunyikan."
          }
        },
        "it" : {
