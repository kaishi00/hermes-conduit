    },
    "Hermes routes triage decomposition across these profiles by their routing description. A clear description helps the decomposer pick the right specialist." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesは、ルーティングの説明に基づいて、トリアージの分解をこれらのプロファイルに振り分けます。説明が明確だと、分解担当が適切なスペシャリストを選びやすくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 依据路由描述，将分类任务的分解路由到这些档案。清晰的描述有助于分解器选出合适的专长档案。"
          }
        }
      }
    },
    "Hermes saved this selection, but the Nous subscription needs sign-in before %@ can use it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesはこの選択を保存しましたが、%@で使用するにはNousのサブスクリプションへのサインインが必要です。"
