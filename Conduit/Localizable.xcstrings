    "Conduit can only add to the queue. Use /queue <message> to queue one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann nur zur Warteschlange hinzufügen. Mit /queue <Nachricht> reihst du eine ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit solo puede añadir a la cola. Usa /queue <mensaje> para poner uno en cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit peut seulement ajouter à la file. Utilisez /queue <message> pour en ajouter un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit hanya bisa menambah ke antrean. Gunakan /queue <pesan> untuk mengantrekan pesan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit può solo aggiungere alla coda. Usa /queue <messaggio> per accodarne uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit はキューへの追加のみできます。/queue <メッセージ> で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit는 대기열에 추가만 할 수 있습니다. /queue <메시지>로 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit może tylko dodawać do kolejki. Użyj /queue <wiadomość>, aby dodać wiadomość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit só pode adicionar à fila. Use /queue <mensagem> para enfileirar uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit может только добавлять в очередь. Используйте /queue <сообщение>, чтобы добавить сообщение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit yalnızca kuyruğa ekleyebilir. Eklemek için /queue <mesaj> kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 只能向队列添加消息。使用 /queue <消息> 添加一条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 只能向佇列新增訊息。使用 /queue <訊息> 新增一則。"
          }
        }
      }
    },
    "Conduit can't keep shared drafts on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann auf diesem Gerät keine geteilten Entwürfe speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit can't keep shared drafts on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no puede guardar borradores compartidos en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ne peut pas conserver de brouillons partagés sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat menyimpan draf yang dibagikan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non può conservare bozze condivise su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは共有した下書きを保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 공유한 초안을 보관할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie może przechowywać udostępnionych wersji roboczych na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não pode guardar rascunhos compartilhados neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не может хранить черновики из других приложений на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu cihazda paylaşılan taslakları saklayamıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法在此设备上保存共享的草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法在此裝置上保存分享的草稿。"
          }
        }
      }
    },
    "Conduit can't read its location settings right now. Unlock your iPhone and open this page again. If this keeps happening, start over: your saved places and choices are reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit kann seine Standorteinstellungen gerade nicht lesen. Entsperre dein iPhone und öffne diese Seite erneut. Wenn das so bleibt, fang neu an: Deine gespeicherten Orte und Einstellungen werden zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no puede leer ahora sus ajustes de ubicación. Desbloquea el iPhone y vuelve a abrir esta página. Si sigue pasando, empieza de nuevo: se restablecerán tus lugares guardados y tus opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit ne peut pas lire ses réglages de position pour le moment. Déverrouillez votre iPhone et rouvrez cette page. Si cela persiste, recommencez à zéro : vos lieux enregistrés et vos choix seront réinitialisés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat membaca pengaturan lokasinya saat ini. Buka kunci iPhone-mu dan buka halaman ini lagi. Jika terus terjadi, mulai ulang: tempat tersimpan dan pilihanmu akan disetel ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non riesce a leggere le sue impostazioni di posizione in questo momento. Sblocca l'iPhone e riapri questa pagina. Se continua a succedere, ricomincia da capo: i luoghi salvati e le tue scelte verranno reimpostati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは現在、位置情報の設定を読み取れません。iPhoneのロックを解除して、このページをもう一度開いてください。解決しない場合は最初からやり直してください。保存した場所と設定はリセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit가 지금 위치 설정을 읽을 수 없습니다. iPhone 잠금을 해제하고 이 페이지를 다시 여세요. 계속 이러면 처음부터 다시 시작하세요. 저장된 장소와 선택이 초기화됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie może teraz odczytać swoich ustawień lokalizacji. Odblokuj iPhone’a i otwórz tę stronę ponownie. Jeśli to się powtarza, zacznij od nowa: zapisane miejsca i wybory zostaną zresetowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não consegue ler os ajustes de localização agora. Desbloqueie o iPhone e abra esta página de novo. Se continuar acontecendo, recomece: seus locais salvos e suas escolhas serão redefinidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit сейчас не может прочитать свои настройки геопозиции. Разблокируйте iPhone и откройте эту страницу снова. Если это повторяется, начните заново: сохранённые места и настройки будут сброшены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit şu anda konum ayarlarını okuyamıyor. iPhone'unun kilidini aç ve bu sayfayı yeniden aç. Bu sürerse baştan başla: kayıtlı yerlerin ve seçimlerin sıfırlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 目前无法读取其位置设置。请解锁 iPhone 后重新打开此页面。如果问题持续，请重新开始：你保存的地点和选择将被重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 目前無法讀取其位置設定。請解鎖 iPhone 後重新開啟此頁面。如果問題持續，請重新開始：你儲存的地點和選擇將被重置。"
          }
        }
      }
    },
    "Conduit connects to the dashboard and gateway you configure. Conversations and attachments are handled by that Hermes installation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verbindet sich mit dem Dashboard und Gateway, die du konfigurierst. Unterhaltungen und Anhänge werden von dieser Hermes-Installation verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se conecta al panel y a la pasarela que configures. Las conversaciones y los archivos adjuntos los gestiona esa instalación de Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se connecte au tableau de bord et à la passerelle que vous configurez. Les conversations et les pièces jointes sont gérées par cette installation d'Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit terhubung ke dasbor dan gateway yang Anda konfigurasikan. Percakapan dan lampiran ditangani oleh instalasi Hermes tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit si connette alla dashboard e al gateway che configuri. Conversazioni e allegati sono gestiti da quell'installazione di Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは、設定したダッシュボードとゲートウェイに接続します。チャットと添付ファイルは、そのHermes環境で処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 사용자가 구성한 대시보드와 게이트웨이에 연결해요. 대화와 첨부 파일은 해당 Hermes 설치에서 처리돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit łączy się ze skonfigurowanym przez Ciebie panelem i bramą. Rozmowy i załączniki obsługuje ta instalacja Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit se conecta ao painel e ao gateway que você configurar. Conversas e anexos são tratados por essa instalação do Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit подключается к дашборду и шлюзу, которые вы настроили. Разговоры и вложения обрабатываются этой установкой Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, yapılandırdığınız panele ve ağ geçidine bağlanır. Konuşmalar ve ekler o Hermes kurulumu tarafından işlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 连接到你配置的仪表盘和网关。对话与附件由该 Hermes 实例处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 會連線到你設定的儀表板和閘道。對話和附件由該 Hermes 安裝處理。"
          }
        }
      }
    },
    "Conduit could not connect this test to the selected profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte diesen Test nicht mit dem ausgewählten Profil verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo conectar esta prueba con el perfil seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu connecter ce test au profil sélectionné."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat menghubungkan uji ini ke profil yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a collegare questo test al profilo selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはこのテストを選択したプロファイルに接続できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 이 테스트를 선택한 프로필에 연결할 수 없었어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł połączyć tego testu z wybranym profilem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu conectar este teste ao perfil selecionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось подключить эту проверку к выбранному профилю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu testi seçilen profile bağlayamadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法将此测试连接到所选档案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法將此測試連接到所選的設定檔。"
          }
        }
      }
    },
    "Conduit could not open the requested voice profile." : {
      "localizations" : {
        "de" : {
