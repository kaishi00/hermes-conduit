    "Taking a photo needs camera access. You can allow it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Fotografieren braucht Conduit Zugriff auf die Kamera. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hacer una foto se necesita acceso a la cámara. Puedes permitirlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre une photo nécessite l’accès à l’appareil photo. Vous pouvez l’autoriser dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengambil foto memerlukan akses kamera. Anda dapat mengizinkannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scattare una foto serve l’accesso alla fotocamera. Puoi consentirlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮るにはカメラへのアクセスが必要です。設定で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍으려면 카메라 접근 권한이 필요합니다. 설정에서 허용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrobienie zdjęcia wymaga dostępu do aparatu. Możesz na niego zezwolić w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para tirar uma foto é preciso acesso à câmera. Você pode permitir nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сделать фото, нужен доступ к камере. Его можно разрешить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf çekmek için kamera erişimi gerekir. Ayarlar’dan izin verebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照需要相机访问权限。你可以在“设置”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照需要相機取用權限。你可以在「設定」中允許。"
          }
        }
      }
    },
