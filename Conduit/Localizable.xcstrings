        }
      }
    },
    "Set up Grok Live" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Liveを設定"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
