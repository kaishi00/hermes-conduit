        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버가 답장을 읽어 주려면 Hermes 호스트의 Conduit 플러그인을 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj wtyczkę Conduit na hoście Hermes, aby serwer mowy czytał odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o plugin do Conduit no seu host Hermes para que o servidor de voz leia as respostas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите плагин Conduit на хосте Hermes, чтобы голосовой сервер зачитывал ответы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sunucunuzun yanıtları okuması için Hermes ana bilgisayarınızdaki Conduit eklentisini güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新 Hermes 主机上的 Conduit 插件，让你的语音服务器朗读回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新 Hermes 主機上的 Conduit 外掛，讓你的語音伺服器朗讀回覆。"
          }
        }
      }
    },
    "Your speech server answered instead of reading the reply. Set its model address to the one in Conduit's voice settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sprachserver hat selbst geantwortet, statt die Antwort vorzulesen. Stelle seine Modelladresse auf die aus den Spracheinstellungen von Conduit ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de voz respondió en lugar de leer la respuesta. Configura su dirección de modelo con la que aparece en los ajustes de voz de Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal a répondu au lieu de lire la réponse. Réglez son adresse de modèle sur celle des réglages vocaux de Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server suaramu menjawab sendiri, bukan membacakan balasan. Atur alamat modelnya ke alamat di pengaturan suara Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server vocale ha risposto invece di leggere la risposta. Imposta il suo indirizzo del modello su quello nelle impostazioni vocali di Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サーバーが返答を読み上げずに自分で答えました。モデルのアドレスを Conduit の音声設定にあるものに設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서버가 답장을 읽지 않고 직접 답했습니다. 모델 주소를 Conduit 음성 설정에 있는 주소로 설정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer mowy odpowiedział sam zamiast przeczytać odpowiedź. Ustaw jego adres modelu na ten z ustawień głosu w Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor de voz respondeu em vez de ler a resposta. Configure o endereço do modelo dele com o que aparece nos ajustes de voz do Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовой сервер ответил сам, а не зачитал ответ. Укажите для него адрес модели из настроек голоса Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sunucunuz yanıtı okumak yerine kendisi yanıt verdi. Model adresini Conduit'in ses ayarlarındaki adres olarak ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的语音服务器自己作答，而没有朗读回复。请将其模型地址设为 Conduit 语音设置中的地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的語音伺服器自己作答，而沒有朗讀回覆。請將其模型位址設為 Conduit 語音設定中的位址。"
          }
        }
      }
    },
