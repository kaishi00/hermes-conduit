    "‘%@’ is not available in the English pronunciation lexicon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist im englischen Aussprachelexikon nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no está disponible en el léxico de pronunciación en inglés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'est pas disponible dans le lexique de prononciation anglais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tidak tersedia di leksikon pelafalan bahasa Inggris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è disponibile nel lessico di pronuncia inglese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は英語の発音辞書にありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 영어 발음 사전에 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie występuje w słowniku wymowy angielskiej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não está disponível no léxico de pronúncia em inglês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» отсутствует в английском словаре произношения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”, İngilizce telaffuz sözlüğünde yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英语发音词典中没有“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英文發音詞典中沒有「%@」。"
          }
        }
      }
    },
    "‘%@’ is not supported by the bundled wake model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird vom mitgelieferten Aktivierungsmodell nicht unterstützt."
          }
