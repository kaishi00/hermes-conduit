    "Not run yet. Once it runs, it shows here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht ausgeführt. Sobald er ausgeführt wurde, erscheint das hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha ejecutado. Cuando se ejecute, aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore exécuté. Après sa première exécution, la date s'affiche ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum pernah dijalankan. Setelah dijalankan, waktunya tampil di sini."
          }
        },
        "it" : {
          "stringUnit" : {
