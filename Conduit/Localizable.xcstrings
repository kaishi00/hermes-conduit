          }
        }
      }
    },
    "Understands what you say. For example, the speech-to-speech server Hermes Live Voice runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteht, was du sagst. Zum Beispiel der Speech-to-Speech-Server, den Hermes Live Voice betreibt."
