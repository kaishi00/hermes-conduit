    "Still switching boards. Try again once the new board finishes loading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Board wird noch gewechselt. Versuche es erneut, sobald das neue Board geladen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún se está cambiando de tablero. Vuelve a intentarlo cuando termine de cargarse el nuevo tablero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changement de tableau en cours. Réessayez une fois le nouveau tableau chargé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih beralih papan. Coba lagi setelah papan baru selesai dimuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio di bacheca ancora in corso. Riprova quando la nuova bacheca ha finito di caricarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードを切り替え中です。新しいボードの読み込みが完了してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 보드를 전환하는 중이에요. 새 보드를 다 불러온 후 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa przełączanie tablic. Spróbuj ponownie, gdy nowa tablica się wczyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda trocando de quadro. Tente novamente quando o novo quadro terminar de carregar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доска ещё переключается. Повторите попытку, когда новая доска загрузится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
