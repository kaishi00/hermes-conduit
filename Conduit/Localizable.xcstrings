    "Used if you dismiss the session list without choosing another conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, wenn du die Sitzungsliste schließt, ohne eine andere Unterhaltung zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa si cierras la lista de sesiones sin elegir otra conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
