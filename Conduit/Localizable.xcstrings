    "Still waiting for a push token from Apple. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird noch auf ein Push-Token von Apple gewartet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún se está esperando un token push de Apple. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d'un jeton push d'Apple. Réessayez dans un instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih menunggu token push dari Apple. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di un token push da Apple. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleからのプッシュトークンを待っています。しばらくしてからもう一度お試しください。"
