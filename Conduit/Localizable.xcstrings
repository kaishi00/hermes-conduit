    "Conduit couldn't save the draft. Share it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte den Entwurf nicht speichern. Teile ihn erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit couldn't save the draft. Share it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo guardar el borrador. Vuelve a compartirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n’a pas pu enregistrer le brouillon. Partagez-le à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat menyimpan draf. Bagikan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a salvare la bozza. Condividila di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
