        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось получить звук с этого микрофона. Повторите попытку или переключитесь на другой микрофон или гарнитуру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
