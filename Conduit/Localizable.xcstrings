    "This chat is open in Hermes Desktop. Take it over to send from here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat ist in Hermes Desktop geöffnet. Übernimm ihn, um von hier aus zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat está abierto en Hermes Desktop. Retómalo para enviar desde aquí."
