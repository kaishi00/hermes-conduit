    "Generating replaces the current text. Your unsaved edits will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Generieren ersetzt den aktuellen Text. Deine nicht gespeicherten Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al generar se sustituye el texto actual. Se perderán tus cambios sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération remplace le texte actuel. Vos modifications non enregistrées seront perdues."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat ulang akan mengganti teks saat ini. Editan Anda yang belum disimpan akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generazione sostituisce il testo attuale. Le modifiche non salvate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成すると現在のテキストが置き換えられます。保存されていない編集内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생성하면 현재 텍스트가 바뀌어요. 저장하지 않은 편집 내용은 사라져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generowanie zastąpi bieżący tekst. Niezapisane zmiany zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
