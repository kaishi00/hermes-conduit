    "Paste the full HTTPS dashboard address Hermes supplied, including any port or path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die vollständige HTTPS-Dashboard-Adresse ein, die Hermes angegeben hat, einschließlich Port oder Pfad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la dirección HTTPS completa del panel que te dio Hermes, incluidos el puerto o la ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez l'adresse HTTPS complète du tableau de bord fournie par Hermes, y compris le port ou le chemin éventuels."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
