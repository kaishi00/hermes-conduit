    "Applies to hardware keyboards only. The on-screen keyboard's Return key is unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für Hardwaretastaturen. Die Eingabetaste der Bildschirmtastatur bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica a teclados físicos. La tecla Intro del teclado en pantalla no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
