    },
    "Conduit doesn't have permission to use your location. Allow it in the Settings app under Privacy & Security > Location Services > Conduit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit darf deinen Standort nicht verwenden. Erlaube es in der Einstellungen-App unter Datenschutz & Sicherheit > Ortungsdienste > Conduit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no tiene permiso para usar tu ubicación. Permítelo en la app Ajustes, en Privacidad y seguridad > Localización > Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas l'autorisation d'utiliser votre position. Autorisez-la dans l'app Réglages, sous Confidentialité et sécurité > Service de localisation > Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak punya izin menggunakan lokasimu. Izinkan di app Pengaturan pada Privasi & Keamanan > Layanan Lokasi > Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non ha il permesso di usare la tua posizione. Consentilo nell'app Impostazioni in Privacy e sicurezza > Localizzazione > Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitには位置情報を使用する許可がありません。設定アプリの「プライバシーとセキュリティ」>「位置情報サービス」>「Conduit」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit에 위치 사용 권한이 없습니다. 설정 앱의 개인정보 보호 및 보안 > 위치 서비스 > Conduit에서 허용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie ma pozwolenia na używanie twojej lokalizacji. Zezwól na to w aplikacji Ustawienia w Prywatność i ochrona > Usługi lokalizacji > Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não tem permissão para usar sua localização. Permita no app Ajustes, em Privacidade e Segurança > Serviços de Localização > Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Conduit нет разрешения на использование геопозиции. Разрешите его в приложении «Настройки» в разделе «Конфиденциальность и безопасность» > «Службы геолокации» > Conduit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'in konumunu kullanma izni yok. Ayarlar uygulamasında Gizlilik ve Güvenlik > Konum Servisleri > Conduit altından izin ver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 没有使用你位置的权限。请在“设置”App 的“隐私与安全性”>“定位服务”>“Conduit”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 沒有使用你位置的權限。請在「設定」App 的「隱私權與安全性」>「定位服務」>「Conduit」中允許。"
          }
        }
      }
    },
    "Conduit sends your location, at the detail you choose, to the %@ profile on %@, sealed end to end. It never goes through Conduit's notification relay, and Conduit's developer can't see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sendet deinen Standort in der gewählten Genauigkeit an das Profil %@ auf %@, Ende-zu-Ende verschlüsselt. Er geht nie über Conduits Mitteilungs-Relay, und Conduits Entwickler kann ihn nicht sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit envía tu ubicación, con el detalle que elijas, al perfil %@ en %@, cifrada de extremo a extremo. Nunca pasa por el relé de notificaciones de Conduit, y el desarrollador de Conduit no puede verla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit envoie votre position, au niveau de détail choisi, au profil %@ sur %@, chiffrée de bout en bout. Elle ne passe jamais par le relais de notifications de Conduit, et le développeur de Conduit ne peut pas la voir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit mengirim lokasimu, dengan tingkat detail pilihanmu, ke profil %@ di %@, terenkripsi ujung ke ujung. Lokasi tidak pernah melewati relai notifikasi Conduit, dan pengembang Conduit tidak dapat melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit invia la tua posizione, con il dettaglio che scegli, al profilo %@ su %@, cifrata end-to-end. Non passa mai dal relay delle notifiche di Conduit e lo sviluppatore di Conduit non può vederla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは、選んだ詳細度で、%@ プロファイル（%@）に位置情報をエンドツーエンドで暗号化して送信します。Conduitの通知リレーを経由することはなく、Conduitの開発者が見ることもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit는 선택한 상세도로 %@ 프로필(%@)에 위치를 종단간 암호화하여 보냅니다. Conduit 알림 릴레이를 거치지 않으며, Conduit 개발자도 볼 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit wysyła twoją lokalizację, z wybraną dokładnością, do profilu %@ na %@, zaszyfrowaną end-to-end. Nigdy nie przechodzi przez przekaźnik powiadomień Conduit, a twórca Conduit nie może jej zobaczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit envia sua localização, no detalhe que você escolher, para o perfil %@ em %@, criptografada de ponta a ponta. Ela nunca passa pelo relé de notificações do Conduit, e o desenvolvedor do Conduit não pode vê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit отправляет вашу геопозицию с выбранной точностью в профиль %@ на %@ со сквозным шифрованием. Она никогда не проходит через ретранслятор уведомлений Conduit, и разработчик Conduit не может её увидеть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konumunu, seçtiğin ayrıntı düzeyinde, %@ profiline (%@) uçtan uca şifreli olarak gönderir. Konum asla Conduit'in bildirim aktarıcısından geçmez ve Conduit'in geliştiricisi onu göremez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 会按你选择的详细程度，将你的位置以端到端加密方式发送到 %@ 配置文件（%@）。它从不经过 Conduit 的通知中继，Conduit 的开发者也无法看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
