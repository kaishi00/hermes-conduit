    "Hermes installs plugins for the host's default profile. Switch to it to change them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes installiert Plugins für das Standardprofil des Hosts. Wechsle dorthin, um sie zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes instala los plugins para el perfil predeterminado del host. Cambia a él para modificarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes installe les plugins pour le profil par défaut de l'hôte. Passez-y pour les modifier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes memasang plugin untuk profil default host. Beralih ke profil itu untuk mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes installa i plugin per il profilo predefinito dell'host. Passa a quel profilo per modificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes はホストのデフォルトプロファイルにプラグインをインストールします。変更するにはそのプロファイルに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes는 호스트의 기본 프로필에 플러그인을 설치합니다. 변경하려면 기본 프로필로 전환하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes instaluje wtyczki dla domyślnego profilu hosta. Przełącz się na niego, aby je zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes instala plugins para o perfil padrão do host. Mude para ele para alterá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes устанавливает плагины для профиля хоста по умолчанию. Переключитесь на него, чтобы изменить их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes eklentileri ana makinenin varsayılan profiline yükler. Değiştirmek için o profile geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 会为主机的默认档案安装插件。切换到默认档案即可更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 會為主機的預設設定檔安裝外掛。切換到預設設定檔即可更改。"
          }
        }
      }
    },
