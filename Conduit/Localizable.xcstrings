    "Shown behind the bot's initial when it has no picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird hinter dem Anfangsbuchstaben des Bots angezeigt, wenn er kein Bild hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra detrás de la inicial del bot cuando no tiene imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichée derrière l'initiale du bot quand il n'a pas d'image."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan di belakang inisial bot jika bot tidak memiliki gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato dietro l'iniziale del bot quando non ha un'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真がない場合に、ボットのイニシャルの背景として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진이 없을 때 봇 이름의 첫 글자 뒤에 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlany za inicjałem bota, gdy nie ma on obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece atrás da inicial do bot quando ele não tem imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображается за инициалом бота, если у него нет изображения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resmi olmadığında botun baş harfinin arkasında gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机器人没有头像时，显示在其首字母背后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機器人沒有圖片時，會顯示在其名稱首字的背後。"
          }
        }
      }
    },
    "This permanently removes the bot's profile, chats, memory and skills from the gateway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Profil, Chats, Gedächtnis und Skills des Bots dauerhaft vom Gateway entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente de la pasarela el perfil, los chats, la memoria y las habilidades del bot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement de la passerelle le profil, les discussions, la mémoire et les compétences du bot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghapus profil, obrolan, memori, dan skill bot dari gateway secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione rimuove definitivamente dal gateway il profilo, le chat, la memoria e le skill del bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットのプロファイル、チャット、メモリ、スキルがゲートウェイから完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇의 프로필, 채팅, 메모리, 스킬이 게이트웨이에서 영구적으로 삭제돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie profilu, czatów, pamięci i umiejętności bota z bramy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente do gateway o perfil, os chats, a memória e as habilidades do bot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль бота, его чаты, память и навыки будут безвозвратно удалены со шлюза."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem botun profilini, sohbetlerini, belleğini ve becerilerini ağ geçidinden kalıcı olarak kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从网关永久删除该机器人的配置、聊天、记忆和技能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從閘道永久移除機器人的設定檔、聊天、記憶和技能。"
          }
        }
