    "Conduit couldn't read that image. Ask Hermes About Screen needs a screenshot or another image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte dieses Bild nicht lesen. „Hermes zum Bildschirm fragen“ benötigt ein Bildschirmfoto oder ein anderes Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo leer esa imagen. Preguntar a Hermes sobre la pantalla necesita una captura de pantalla u otra imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu lire cette image. Interroger Hermes sur l'écran nécessite une capture d'écran ou une autre image."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit tidak dapat membaca gambar itu. “Tanya Hermes tentang Layar” memerlukan jepretan layar atau gambar lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit non è riuscito a leggere l'immagine. “Chiedi a Hermes sullo schermo” richiede un'istantanea o un'altra immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitはその画像を読み込めませんでした。「画面についてHermesに質問」にはスクリーンショットまたはほかの画像が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit이 그 이미지를 읽을 수 없어요. ‘화면에 대해 Hermes에게 묻기’에는 스크린샷이나 다른 이미지가 필요해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit nie mógł odczytać tego obrazu. „Zapytaj Hermesa o ekran” wymaga zrzutu ekranu lub innego obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit não conseguiu ler essa imagem. Perguntar ao Hermes Sobre a Tela precisa de uma captura de tela ou de outra imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit не удалось прочитать это изображение. Для действия «Спросить Hermes об экране» нужен снимок экрана или другое изображение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit bu görüntüyü okuyamadı. Hermes'e Ekranı Sor için bir ekran görüntüsü veya başka bir görüntü gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 无法读取该图片。「向 Hermes 询问屏幕内容」需要截图或其他图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 無法讀取該影像。「向 Hermes 詢問畫面內容」需要截圖或其他影像。"
          }
        }
      }
    },
    "Conduit could not open the profile the shortcut asked for, so the screenshot is in this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit konnte das vom Kurzbefehl angeforderte Profil nicht öffnen, daher ist das Bildschirmfoto in diesem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit no pudo abrir el perfil que pidió el atajo, así que la captura de pantalla está en este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit n'a pas pu ouvrir le profil demandé par le raccourci ; la capture d'écran se trouve donc dans celui-ci."
          }
