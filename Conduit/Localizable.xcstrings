        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Ouvir quando estiver pronto para retomar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Слушать», когда будете готовы продолжить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam etmeye hazır olduğunuzda Dinle'ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备就绪后，轻点「聆听」即可继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備好繼續時，點一下「聆聽」。"
          }
        }
      }
    },
