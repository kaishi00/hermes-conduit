    "Your speech server. Use Test connection under Speech to text to check it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Sprachserver. Prüfe ihn mit „Verbindung testen“ unter Sprache zu Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor de voz. Usa Probar conexión en Voz a texto para comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur vocal. Utilisez Tester la connexion sous Transcription vocale pour le vérifier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server suara Anda. Gunakan Uji koneksi di Ucapan ke teks untuk memeriksanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server vocale. Usa Verifica connessione in Trascrizione vocale per controllarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の音声サーバー。「音声認識」の「接続をテスト」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 음성 서버. 음성 텍스트 변환에서 연결 테스트로 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
