    "Need access away from home without existing remote access? Choose Tailscale — the simplest secure option." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出先からアクセスする必要があり、リモートアクセスの環境がまだない場合は、Tailscaleを選んでください。最も簡単で安全な方法です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出时需要访问、又没有现成的远程访问？选择 Tailscale——最简单的安全方案。"
          }
        }
      }
    },
    "Need help connecting?" : {
