    "You can turn sharing off at any time in Settings > Calendar & phone and delete what was sent from the host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Teilen jederzeit unter „Einstellungen“ > „Kalender & iPhone“ ausschalten und das Gesendete vom Host löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejar de compartir en cualquier momento en Ajustes > Calendario e iPhone y eliminar del host lo que se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez désactiver le partage à tout moment dans Réglages > Calendrier et iPhone et supprimer de l'hôte ce qui a été envoyé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mematikan berbagi kapan saja di Pengaturan > Kalender & iPhone dan menghapus data yang telah dikirim dari host."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disattivare la condivisione in qualsiasi momento in Impostazioni > Calendario e iPhone ed eliminare dall'host ciò che è stato inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」>「カレンダーとiPhone」でいつでも共有をオフにし、送信済みのデータをホストから削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘설정’ > ‘캘린더 및 iPhone’에서 언제든지 공유를 끄고 전송된 데이터를 호스트에서 삭제할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie możesz w każdej chwili wyłączyć w Ustawieniach > Kalendarz i iPhone i usunąć z hosta to, co zostało wysłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode desativar o compartilhamento a qualquer momento em Ajustes > Calendário e iPhone e apagar do host o que foi enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете в любой момент выключить отправку в разделе «Настройки» > «Календарь и iPhone» и удалить с хоста то, что было отправлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşımı istediğiniz zaman Ayarlar > Takvim ve iPhone bölümünden kapatabilir ve gönderilenleri ana makineden silebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在「设置」>「日历与 iPhone」中关闭共享，并从主机上删除已发送的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以隨時在「設定」>「行事曆與 iPhone」中關閉分享，並從主機刪除已傳送的資料。"
          }
        }
      }
    },
    "You can turn sharing off at any time in Settings > Health and delete what was sent from the host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Teilen jederzeit unter „Einstellungen“ > „Health“ ausschalten und das Gesendete vom Host löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejar de compartir en cualquier momento en Ajustes > Salud y eliminar del host lo que se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez désactiver le partage à tout moment dans Réglages > Santé et supprimer de l'hôte ce qui a été envoyé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mematikan berbagi kapan saja di Pengaturan > Kesehatan dan menghapus data yang telah dikirim dari host."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disattivare la condivisione in qualsiasi momento in Impostazioni > Salute ed eliminare dall'host ciò che è stato inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有は「設定」>「ヘルスケア」でいつでもオフにでき、送信したデータをホストから削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘설정’ > ‘건강’에서 언제든지 공유를 끄고 전송된 데이터를 호스트에서 삭제할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie możesz wyłączyć w dowolnej chwili w Ustawieniach > Zdrowie i usunąć z hosta to, co zostało wysłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode desativar o compartilhamento a qualquer momento em Ajustes > Saúde e apagar do host o que foi enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключить отправку можно в любой момент в «Настройки» > «Здоровье», а отправленное — удалить с хоста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşımı istediğiniz zaman Ayarlar > Sağlık bölümünden kapatabilir ve gönderilenleri ana makineden silebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在「设置」>「健康」中关闭共享，并从主机上删除已发送的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以隨時在「設定」>「健康」中關閉分享，並從主機刪除已傳送的資料。"
          }
        }
      }
    },
