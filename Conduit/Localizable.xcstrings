    "Stops Hermes' speech and starts listening right away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt die Sprachausgabe von Hermes und beginnt sofort zuzuhören"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene el habla de Hermes y empieza a escuchar de inmediato"
