        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/retry 只能重新发送文本消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/retry 只能重新傳送文字訊息。"
          }
        }
      }
    },
