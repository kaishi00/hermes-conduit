        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o Hermes guarde memória de trabalho relevante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить Hermes сохранять важную рабочую память."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
