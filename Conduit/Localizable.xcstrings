    "Two of these bots would claim the same @handle. Rename one bot's title, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei dieser Bots würden dasselbe @Handle beanspruchen. Ändere den Titel eines der Bots und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos de estos bots usarían el mismo @alias. Cambia el título de uno de los bots y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux de ces bots revendiqueraient le même @identifiant. Renommez le titre de l'un des bots, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua bot ini akan menggunakan @handle yang sama. Ganti judul salah satu bot, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due di questi bot userebbero lo stesso @nome. Rinomina il titolo di uno dei bot, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのボットのうち2つが同じ@ハンドルになります。いずれかのボットのタイトルを変更してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 봇 중 두 개가 같은 @핸들을 사용하게 돼요. 봇 하나의 제목을 바꾼 다음 다시 시도하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa z tych botów miałyby ten sam @identyfikator. Zmień nazwę jednego z botów i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois destes bots usariam o mesmo @identificador. Renomeie o título de um dos bots e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У двух из этих ботов было бы одинаковое @-имя. Измените название одного из ботов и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu botlardan ikisi aynı @tanıtıcıyı kullanacak. Botlardan birinin başlığını değiştirip yeniden deneyin."
          }
