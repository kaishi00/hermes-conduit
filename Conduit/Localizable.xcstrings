    "The new plugin is on the host. Hermes needs a restart to use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Plugin ist auf dem Host. Hermes muss neu starten, um es zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo plugin está en el host. Hermes necesita reiniciarse para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau plugin est sur l’hôte. Hermes doit redémarrer pour l’utiliser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin baru sudah ada di host. Hermes perlu dimulai ulang untuk menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo plugin è sull’host. Hermes deve riavviarsi per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプラグインはホストにあります。使用するにはHermesの再起動が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 플러그인이 호스트에 있습니다. 사용하려면 Hermes를 다시 시작해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowa wtyczka jest na hoście. Hermes musi się ponownie uruchomić, aby jej używać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo plugin está no host. O Hermes precisa reiniciar para usá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый плагин уже на хосте. Hermes нужно перезапустить, чтобы его использовать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
