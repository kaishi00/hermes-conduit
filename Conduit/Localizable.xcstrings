    "Talk over it on the speaker" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Lautsprecher dazwischenreden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrumpir con el altavoz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parler par-dessus sur haut-parleur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカー使用時も割り込む"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
