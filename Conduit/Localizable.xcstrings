    "YOLO automatically approves tool actions for this conversation only. Set the profile default in Workspace & safety." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO gibt Tool-Aktionen nur für diese Unterhaltung automatisch frei. Den Standard des Profils legst du unter „Arbeitsbereich & Sicherheit“ fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO aprueba automáticamente las acciones de herramientas solo en esta conversación. Define el valor predeterminado del perfil en Espacio de trabajo y seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO approuve automatiquement les actions d'outils pour cette conversation uniquement. Définissez la valeur par défaut du profil dans Espace de travail et sécurité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO menyetujui tindakan alat secara otomatis hanya untuk percakapan ini. Atur default profil di Ruang kerja & keamanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO approva automaticamente le azioni degli strumenti solo per questa conversazione. Imposta il valore predefinito del profilo in Spazio di lavoro e sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLOは、このチャットに限りツールの操作を自動承認します。プロファイルのデフォルトは「ワークスペースと安全性」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO는 이 대화에서만 도구 작업을 자동 승인해요. 프로필 기본값은 ‘작업 공간 및 안전’에서 설정하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO automatycznie zatwierdza działania narzędzi tylko w tej rozmowie. Domyślne ustawienie profilu zmienisz w sekcji Obszar roboczy i bezpieczeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O YOLO aprova automaticamente as ações de ferramentas somente nesta conversa. Defina o padrão do perfil em Espaço de trabalho e segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO автоматически разрешает действия инструментов только в этом чате. Значение по умолчанию для профиля задаётся в разделе «Рабочее пространство и безопасность»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO, araç eylemlerini yalnızca bu konuşma için otomatik olarak onaylar. Profil varsayılanını Çalışma alanı ve güvenlik bölümünde ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO 仅为此对话自动批准工具操作。请在“工作区与安全”中设置档案默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO 只會為此對話自動核准工具動作。請在「工作區與安全性」中設定設定檔的預設值。"
          }
        }
      }
    },
