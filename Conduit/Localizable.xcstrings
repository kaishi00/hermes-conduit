    "Scroll to top of conversation. Touch and hold for conversation actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Anfang der Unterhaltung scrollen. Halte gedrückt für Aktionen zur Unterhaltung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplazarse al principio de la conversación. Mantén pulsado para ver las acciones de la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenir en haut de la conversation. Maintenez le doigt dessus pour afficher les actions de la conversation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir ke awal percakapan. Sentuh dan tahan untuk tindakan percakapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri all'inizio della conversazione. Tieni premuto per le azioni della conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話の先頭までスクロールします。長押しでチャットの操作を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 맨 위로 스크롤해요. 대화 동작을 보려면 길게 터치하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewiń na początek rozmowy. Dotknij i przytrzymaj, aby wyświetlić czynności rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolar até o início da conversa. Mantenha pressionado para ver as ações da conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутить к началу чата. Коснитесь и удерживайте, чтобы открыть действия с чатом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmanın başına kaydır. Konuşma eylemleri için basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
