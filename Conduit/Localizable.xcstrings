    "Plain ws:// works for home network and Tailscale addresses. A server on the internet needs wss://." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfaches ws:// funktioniert für Adressen im Heimnetz und in Tailscale. Ein Server im Internet braucht wss://."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ws:// sin cifrar funciona con direcciones de tu red doméstica y de Tailscale. Un servidor en internet necesita wss://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un simple ws:// fonctionne pour les adresses du réseau domestique et de Tailscale. Un serveur sur Internet nécessite wss://."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ws:// biasa berfungsi untuk alamat jaringan rumah dan Tailscale. Server di internet memerlukan wss://."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un semplice ws:// funziona per gli indirizzi della rete di casa e di Tailscale. Un server su Internet richiede wss://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化なしの ws:// はホームネットワークと Tailscale のアドレスで使えます。インターネット上のサーバーには wss:// が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 ws://는 홈 네트워크와 Tailscale 주소에서 사용할 수 있어요. 인터넷에 있는 서버는 wss://가 필요해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykłe ws:// działa dla adresów w sieci domowej i Tailscale. Serwer w internecie wymaga wss://."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ws:// simples funciona com endereços da rede de casa e do Tailscale. Um servidor na internet precisa de wss://."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный ws:// подходит для адресов домашней сети и Tailscale. Серверу в интернете нужен wss://."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz ws:// ev ağı ve Tailscale adreslerinde çalışır. İnternetteki bir sunucu wss:// gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家庭网络和 Tailscale 地址可以直接使用 ws://。互联网上的服务器需要 wss://。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家用網路和 Tailscale 位址可以直接使用 ws://。網際網路上的伺服器需要 wss://。"
          }
        }
      }
    },
