    "Saved to this profile on your host. Conduit never reads them back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden in diesem Profil auf deinem Host gespeichert. Conduit liest sie nie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
