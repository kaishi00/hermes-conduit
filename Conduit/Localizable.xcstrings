            "value" : "Nutzungs-, Netzwerk- und Hänger-Berichte, die iOS etwa einmal am Tag erstellt. Sie bleiben auf diesem Gerät, bis du sie teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de uso, red y bloqueos que iOS genera aproximadamente una vez al día. Se quedan en este dispositivo hasta que los compartas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapports d’utilisation, de réseau et de blocages qu’iOS produit environ une fois par jour. Ils restent sur cet appareil jusqu’à ce que vous les partagiez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan penggunaan, jaringan, dan macet yang dibuat iOS sekitar sekali sehari. Laporan ini tetap di perangkat ini sampai Anda membagikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report su utilizzo, rete e blocchi che iOS crea circa una volta al giorno. Restano su questo dispositivo finché non li condividi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS がおよそ1日に1回作成する、使用状況・ネットワーク・ハングのレポートです。共有するまでこのデバイスから出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 하루에 한 번 정도 만드는 사용량, 네트워크, 멈춤 보고서입니다. 공유하기 전까지는 이 기기에만 보관됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporty użycia, sieci i zawieszeń, które iOS tworzy mniej więcej raz dziennie. Pozostają na tym urządzeniu, dopóki ich nie udostępnisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatórios de uso, rede e travamentos que o iOS gera cerca de uma vez por dia. Eles ficam neste dispositivo até você compartilhá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёты об использовании, сети и зависаниях, которые iOS создаёт примерно раз в день. Они остаются на этом устройстве, пока вы ими не поделитесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS'un yaklaşık günde bir kez oluşturduğu kullanım, ağ ve donma raporları. Siz paylaşana kadar bu cihazda kalırlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 大约每天生成一次的使用、网络和卡顿报告。在你分享之前，它们只保存在这台设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 大約每天產生一次的使用、網路和卡頓報告。在你分享之前，它們只會保存在這部裝置上。"
          }
        }
      }
    },
    "Usage: /queue <message>. Sends the message as the next turn once the running reply finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendung: /queue <Nachricht>. Sendet die Nachricht als nächsten Zug, sobald die laufende Antwort fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <mensaje>. Envía el mensaje como el siguiente turno cuando termine la respuesta en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation : /queue <message>. Envoie le message comme tour suivant une fois la réponse en cours terminée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penggunaan: /queue <pesan>. Mengirim pesan sebagai giliran berikutnya setelah balasan yang berjalan selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <messaggio>. Invia il messaggio come turno successivo al termine della risposta in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使い方：/queue <メッセージ>。実行中の返信が終わったら、次のターンとしてメッセージを送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용법: /queue <메시지>. 진행 중인 응답이 끝나면 다음 차례로 메시지를 보냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użycie: /queue <wiadomość>. Wysyła wiadomość jako następną turę po zakończeniu trwającej odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso: /queue <mensagem>. Envia a mensagem como o próximo turno quando a resposta em andamento terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использование: /queue <сообщение>. Отправляет сообщение следующим ходом, когда текущий ответ завершится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım: /queue <mesaj>. Süren yanıt bitince mesajı sonraki tur olarak gönderir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/queue <消息>。在当前回复结束后，将消息作为下一轮发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用法：/queue <訊息>。在目前回覆結束後，將訊息作為下一輪傳送。"
          }
        }
      }
    },
    "Usage: /steer <message>. Sends the message into the running reply without stopping it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
