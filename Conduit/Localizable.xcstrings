    },
    "Conduit is still connecting to your dashboard. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verbindet sich noch mit deinem Dashboard. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sigue conectándose a tu panel. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se connecte encore à votre tableau de bord. Réessayez dans un instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit masih menghubungkan ke dasbor Anda. Coba lagi sebentar lagi."
