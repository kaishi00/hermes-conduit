        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes soruyor: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 请求确认：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 請求確認：%@"
          }
        }
      }
    },
    "Hermes calls when it has waited a minute for your OK or an answer, or when a request fails. In a live call you can answer out loud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ruft an, wenn er eine Minute auf dein OK oder eine Antwort gewartet hat oder wenn eine Anfrage fehlschlägt. In einem Live-Anruf kannst du laut antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes llama cuando lleva un minuto esperando tu aprobación o una respuesta, o cuando falla una solicitud. En una llamada en vivo puedes responder en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes appelle quand il attend votre accord ou une réponse depuis une minute, ou quand une demande échoue. Pendant un appel en direct, vous pouvez répondre à voix haute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes menelepon saat sudah menunggu persetujuan atau jawaban Anda selama satu menit, atau saat permintaan gagal. Dalam panggilan langsung, Anda bisa menjawab dengan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes chiama quando aspetta da un minuto il tuo OK o una risposta, o quando una richiesta non va a buon fine. In una chiamata live puoi rispondere a voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認や回答を1分待っても返事がないとき、またはリクエストが失敗したときにHermesが電話します。ライブ通話では声で答えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인이나 답변을 1분 동안 기다렸거나 요청이 실패하면 Hermes가 전화해요. 라이브 통화에서는 말로 답할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes dzwoni, gdy przez minutę czeka na Twoją zgodę lub odpowiedź albo gdy prośba się nie powiedzie. W połączeniu Live możesz odpowiedzieć na głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes liga quando já esperou um minuto pela sua aprovação ou resposta, ou quando um pedido falha. Em uma chamada ao vivo, você pode responder em voz alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes звонит, если минуту ждёт вашего одобрения или ответа, или если запрос не удался. В Live-звонке можно ответить вслух."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, onayınızı ya da yanıtınızı bir dakika beklediğinde veya bir istek başarısız olduğunda arar. Canlı aramada sesli yanıt verebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 等你批准或回答满一分钟，或请求失败时，会给你打电话。在实时通话中可以直接开口回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 等你核准或回答滿一分鐘，或請求失敗時，會打電話給你。在即時通話中可以直接開口回答。"
          }
        }
      }
    },
    "Hermes calls when it has waited for your OK or an answer, or when a request fails. In a live call you can answer out loud." : {
