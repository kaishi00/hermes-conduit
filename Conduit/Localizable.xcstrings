    "Switch between your saved Hermes dashboards. Each dashboard keeps its own sign-in and cookies on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zwischen deinen gespeicherten Hermes-Dashboards. Jedes Dashboard behält auf diesem Gerät seine eigene Anmeldung und eigene Cookies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia entre tus paneles de Hermes guardados. Cada panel conserva su propio inicio de sesión y sus cookies en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez d'un tableau de bord Hermes enregistré à l'autre. Chaque tableau de bord conserve sa propre connexion et ses propres cookies sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのHermesダッシュボードを切り替えます。各ダッシュボードのサインイン情報とCookieは、このデバイス上で個別に保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne entre seus painéis do Hermes salvos. Cada painel mantém o próprio login e os próprios cookies neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайтесь между сохранёнными дашбордами Hermes. Каждый дашборд хранит на этом устройстве собственные данные входа и cookie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已保存的 Hermes 仪表板之间切换。每个仪表板在此设备上保留各自的登录状态和 Cookie。"
          }
        }
      }
    },
