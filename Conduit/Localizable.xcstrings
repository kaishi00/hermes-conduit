          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта задача изменилась на сервере. Ваши несохранённые правки не потеряны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
