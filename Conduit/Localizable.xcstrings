    },
    "This conversation is too large to load safely with this Hermes version. Update Hermes to enable paginated conversation history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Unterhaltung ist zu groß, um sie mit dieser Hermes-Version sicher zu laden. Aktualisiere Hermes, um den seitenweisen Verlauf zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversación es demasiado grande para cargarla de forma segura con esta versión de Hermes. Actualiza Hermes para activar el historial de conversación paginado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette conversation est trop volumineuse pour être chargée en toute sécurité avec cette version d'Hermes. Mettez à jour Hermes pour activer l'historique de conversation paginé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan ini terlalu besar untuk dimuat dengan aman pada versi Hermes ini. Perbarui Hermes untuk mengaktifkan riwayat percakapan berhalaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa conversazione è troppo grande per essere caricata in sicurezza con questa versione di Hermes. Aggiorna Hermes per attivare la cronologia della conversazione paginata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは大きすぎるため、このバージョンのHermesでは安全に読み込めません。ページ分割されたチャット履歴を有効にするには、Hermesをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화는 너무 커서 이 버전의 Hermes로는 안전하게 불러올 수 없어요. 페이지 단위 대화 기록을 사용하려면 Hermes를 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta rozmowa jest zbyt duża, aby bezpiecznie wczytać ją w tej wersji Hermesa. Zaktualizuj Hermesa, aby włączyć stronicowaną historię rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversa é grande demais para carregar com segurança nesta versão do Hermes. Atualize o Hermes para ativar o histórico de conversa paginado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат слишком велик для безопасной загрузки в этой версии Hermes. Обновите Hermes, чтобы включить постраничную историю чата."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konuşma, bu Hermes sürümüyle güvenle yüklenemeyecek kadar büyük. Sayfalanmış konuşma geçmişini etkinleştirmek için Hermes'i güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话过大，无法在此版本的 Hermes 中安全加载。请更新 Hermes 以启用分页对话记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此對話太大，無法在此版本的 Hermes 中安全載入。請更新 Hermes 以啟用分頁對話記錄。"
          }
        }
      }
    },
    "This dashboard uses browser-based sign-in. Conduit will open the sign-in page after you return to the login screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Dashboard verwendet die Anmeldung im Browser. Conduit öffnet die Anmeldeseite, sobald du zum Anmeldebildschirm zurückkehrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este panel usa el inicio de sesión en el navegador. Conduit abrirá la página de inicio de sesión cuando vuelvas a la pantalla de inicio de sesión."
