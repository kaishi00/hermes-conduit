    "Allow Speech Recognition for Conduit in iPhone Settings > Conduit, or choose another speech-to-text option in Settings > Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube die Spracherkennung für Conduit unter „iPhone-Einstellungen“ > „Conduit“ oder wähle unter „Einstellungen“ > „Sprachmodus“ eine andere Option für Sprache zu Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el reconocimiento de voz para Conduit en Ajustes del iPhone > Conduit, o elige otra opción de voz a texto en Ajustes > Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez la reconnaissance vocale pour Conduit dans Réglages de l'iPhone > Conduit, ou choisissez une autre option de transcription vocale dans Réglages > Voix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Pengenalan Ucapan untuk Conduit di Pengaturan iPhone > Conduit, atau pilih opsi ucapan ke teks lain di Pengaturan > Suara."
          }
