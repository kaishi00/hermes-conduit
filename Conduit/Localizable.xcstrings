          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите или обновите плагин уведомлений Hermes на вашем сервере Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sunucunuza Hermes bildirim eklentisini yükleyin veya güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Hermes 服务器上安装或更新 Hermes 通知插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在你的 Hermes 伺服器上安裝或更新 Hermes 通知外掛程式。"
          }
        }
      }
    },
    "Install the Conduit plugin on each dashboard's host, then create a short-lived pairing code here for each Hermes dashboard you want to reach." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere das Conduit-Plugin auf dem Host jedes Dashboards und erstelle dann hier für jedes Hermes-Dashboard, das dich erreichen soll, einen kurzlebigen Kopplungscode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala el plugin de Conduit en el host de cada panel y luego crea aquí un código de vinculación de corta duración para cada panel de Hermes al que quieras llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez le plugin Conduit sur l’hôte de chaque tableau de bord, puis créez ici un code de jumelage temporaire pour chaque tableau de bord Hermes à joindre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instal plugin Conduit di host setiap dasbor, lalu buat kode pemasangan berumur pendek di sini untuk setiap dasbor Hermes yang ingin Anda jangkau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa il plugin Conduit sull’host di ogni dashboard, poi crea qui un codice di abbinamento temporaneo per ogni dashboard Hermes da raggiungere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ダッシュボードのホストにConduitプラグインをインストールし、通知を受け取りたいHermesダッシュボードごとに、ここで有効期間の短いペアリングコードを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 대시보드의 호스트에 Conduit 플러그인을 설치한 다음, 연결할 Hermes 대시보드마다 여기서 유효 시간이 짧은 페어링 코드를 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj wtyczkę Conduit na hoście każdego panelu, a potem utwórz tutaj krótkotrwały kod parowania dla każdego panelu Hermesa, z którym chcesz się połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o plugin do Conduit no host de cada painel e depois crie aqui um código de emparelhamento de curta duração para cada painel do Hermes que você quer alcançar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите плагин Conduit на хост каждого дашборда, затем создайте здесь кратковременный код сопряжения для каждого дашборда Hermes, который нужно подключить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit eklentisini her panelin ana makinesine yükleyin, ardından ulaşmak istediğiniz her Hermes paneli için burada kısa ömürlü bir eşleme kodu oluşturun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个仪表板的主机上安装 Conduit 插件，然后在这里为每个要连接的 Hermes 仪表板创建一个短时有效的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每個儀表板的主機上安裝 Conduit 外掛程式，然後在這裡為每個要連接的 Hermes 儀表板建立一個短時間有效的配對碼。"
          }
        }
      }
    },
