    "Plays a short sample in the assistant's voice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt eine kurze Probe mit der Stimme des Assistenten ab"
          }
        },
        "es" : {
