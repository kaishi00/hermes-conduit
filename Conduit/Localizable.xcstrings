    "All providers are hidden. Tap Edit to restore one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Anbieter sind ausgeblendet. Tippe auf „Bearbeiten“, um einen wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los proveedores están ocultos. Toca Editar para restaurar uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les fournisseurs sont masqués. Touchez Modifier pour en rétablir un."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプロバイダが非表示になっています。「編集」をタップすると復元できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os provedores estão ocultos. Toque em Editar para restaurar um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все провайдеры скрыты. Нажмите «Изменить», чтобы вернуть какой-либо из них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有提供方均已隐藏。轻点“编辑”可恢复。"
          }
        }
      }
    },
