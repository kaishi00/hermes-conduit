    },
    "Hermes didn't send back what you said. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat nicht zurückgesendet, was du gesagt hast. Versuche es erneut."
