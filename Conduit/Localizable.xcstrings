      }
    },
    "For reverse proxies such as Pangolin, Traefik, or nginx that check a header. Sent only to this server, over HTTPS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Reverse-Proxys wie Pangolin, Traefik oder nginx, die einen Header prüfen. Wird nur an diesen Server gesendet, über HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proxies inversos como Pangolin, Traefik o nginx que comprueban un encabezado. Solo se envían a este servidor, por HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les proxys inverses comme Pangolin, Traefik ou nginx qui vérifient un en-tête. Envoyés uniquement à ce serveur, en HTTPS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk reverse proxy seperti Pangolin, Traefik, atau nginx yang memeriksa header. Hanya dikirim ke server ini, melalui HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
