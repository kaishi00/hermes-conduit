    "Extra headers are only sent over HTTPS. Enter an https:// server address first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliche Header werden nur über HTTPS gesendet. Gib zuerst eine https://-Serveradresse ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los encabezados adicionales solo se envían por HTTPS. Escribe primero una dirección de servidor https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en-têtes supplémentaires ne sont envoyés qu'en HTTPS. Saisissez d'abord une adresse de serveur en https://."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
