          }
        }
      }
    },
    "If your dashboard uses its own certificate authority or a self-signed certificate, Conduit can save it as a profile for you to install and trust in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein Dashboard eine eigene Zertifizierungsstelle oder ein selbstsigniertes Zertifikat nutzt, kann Conduit es als Profil sichern, das du in den Einstellungen installierst und dem du dort vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu panel usa su propia autoridad de certificación o un certificado autofirmado, Conduit puede guardarlo como un perfil para que lo instales y confíes en él en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre tableau de bord utilise sa propre autorité de certification ou un certificat autosigné, Conduit peut l’enregistrer comme profil à installer et approuver dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dasbor Anda memakai otoritas sertifikat sendiri atau sertifikat yang ditandatangani sendiri, Conduit dapat menyimpannya sebagai profil untuk Anda instal dan percayai di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la tua dashboard usa una propria autorità di certificazione o un certificato autofirmato, Conduit può salvarlo come profilo da installare e rendere attendibile in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダッシュボードが独自の認証局や自己署名証明書を使っている場合、Conduitはそれをプロファイルとして保存できます。設定でインストールして信頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대시보드가 자체 인증 기관이나 자체 서명 인증서를 사용한다면 Conduit이 이를 프로파일로 저장해 드립니다. ‘설정’에서 설치하고 신뢰하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli Twój panel używa własnego urzędu certyfikacji lub certyfikatu z podpisem własnym, Conduit może zapisać go jako profil, który zainstalujesz i oznaczysz jako zaufany w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o seu painel usa uma autoridade certificadora própria ou um certificado autoassinado, o Conduit pode salvá-lo como um perfil para você instalar e confiar nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ваша панель использует собственный центр сертификации или самоподписанный сертификат, Conduit может сохранить его как профиль, который вы установите и сделаете доверенным в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panonuz kendi sertifika yetkilinizi veya kendinden imzalı bir sertifika kullanıyorsa Conduit bunu, Ayarlar’da yükleyip güveneceğiniz bir profil olarak kaydedebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的控制台使用自己的证书颁发机构或自签名证书，Conduit 可以将其保存为描述文件，供你在“设置”中安装并信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的儀表板使用自己的憑證授權單位或自簽憑證，Conduit 可以將其儲存為描述檔，讓你在「設定」中安裝並信任。"
          }
        }
      }
    },
