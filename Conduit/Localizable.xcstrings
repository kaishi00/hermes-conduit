    "Their nickname and company go too, when the contact has them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spitzname und Firma werden ebenfalls geteilt, wenn der Kontakt sie enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se comparten su apodo y su empresa, si el contacto los tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son surnom et son entreprise sont aussi partagés, si le contact les indique."
          }
        },
        "id" : {
          "stringUnit" : {
