    "Applies to hardware keyboards only. The on-screen keyboard's Return key is unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für Hardwaretastaturen. Die Eingabetaste der Bildschirmtastatur bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica a teclados físicos. La tecla Intro del teclado en pantalla no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique uniquement aux claviers physiques. La touche Retour du clavier à l'écran ne change pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya berlaku untuk keyboard fisik. Tombol Return di keyboard layar tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale solo per le tastiere fisiche. Il tasto Invio della tastiera su schermo non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアキーボードにのみ適用されます。画面上のキーボードのReturnキーは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 키보드에만 적용돼요. 화면 키보드의 Return 키는 바뀌지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy tylko klawiatur sprzętowych. Klawisz Return na klawiaturze ekranowej działa bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale apenas para teclados físicos. A tecla Retorno do teclado na tela não muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует только для аппаратных клавиатур. Клавиша «Ввод» экранной клавиатуры работает как прежде."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca donanım klavyeleri için geçerlidir. Ekran klavyesinin Return tuşu değişmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
