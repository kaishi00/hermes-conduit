{
  "version": 3,
  "about": "Shared examples for card-schema.json: normalize_cards(input) must equal output, in the plugin (tests/test_cards.py) and in Conduit (RichCardSchemaTests). Regenerate only when the schema changes, and copy both files to Conduit together.",
  "cases": [
    {
      "name": "A map with a route keeps everything valid",
      "input": [
        {
          "type": "map",
          "title": "Dinner and the show",
          "places": [
            {
              "name": "Kin Khao",
              "address": "55 Cyril Magnin St, San Francisco",
              "lat": 37.7853,
              "lon": -122.4089,
              "note": "Get the khao soi."
            },
            {
              "name": "Orpheum Theatre",
              "lat": 37.779,
              "lon": -122.4148
            }
          ],
          "route": {
            "from": 0,
            "to": 1,
            "mode": "walking"
          }
        }
      ],
      "output": [
        {
          "type": "map",
          "title": "Dinner and the show",
          "places": [
            {
              "name": "Kin Khao",
              "address": "55 Cyril Magnin St, San Francisco",
              "lat": 37.7853,
              "lon": -122.4089,
              "note": "Get the khao soi."
            },
            {
              "name": "Orpheum Theatre",
              "lat": 37.779,
              "lon": -122.4148
            }
          ],
          "route": {
            "to": 1,
            "from": 0,
            "mode": "walking"
          }
        }
      ]
    },
    {
      "name": "A place card keeps only its first place",
      "input": [
        {
          "type": "place",
          "places": [
            {
              "name": "A"
            },
            {
              "name": "B"
            }
          ]
        }
      ],
      "output": [
        {
          "type": "place",
          "places": [
            {
              "name": "A"
            }
          ]
        }
      ]
    },
    {
      "name": "A rating, hours, price or photo without a source is left out",
      "input": [
        {
          "type": "place",
          "places": [
            {
              "name": "Tartine",
              "rating": {
                "value": 4.6
              },
