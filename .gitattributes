# Keep line endings deterministic across platforms.
# Shell scripts MUST stay LF or macOS/Linux CI will break.
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.swift text

# String Catalogs are written by tools (scripts/l10n.py, Xcode): GitHub
# folds their diffs in a pull request by default (issue 823). Expand one to
# review translations.
*.xcstrings linguist-generated=true
