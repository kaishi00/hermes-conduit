{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    },
    "zai-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.3-flashx": {
          "name": "GLM-5.3-FlashX",
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
