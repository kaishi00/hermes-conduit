{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "stepfun": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "StepFun",
      "options": {
        "baseURL": "https://api.stepfun.ai/step_plan/v1",
        "apiKey": "{env:STEPFUN_API_KEY}"
      },
      "whitelist": ["step-5-preview"],
      "models": {
        "step-5-preview": {
          "name": "Step 5 Preview",
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    },
    "zai-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
