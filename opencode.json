{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "whitelist": ["claude-haiku-5-5"],
      "models": {
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "options": {
            "thinking": {
              "type": "adaptive"
            },
            "effort": "high"
          }
        }
      }
    },
    "zai-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
