    "Qwen uses Hermes web search. Native search is disabled while function tools are enabled." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen uses Hermes web search. Native search is disabled while function tools are enabled."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen nutzt die Websuche von Hermes. Bei aktivierten Funktionstools ist die native Suche deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen usa la búsqueda web de Hermes. La búsqueda nativa se desactiva al usar herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen utilise la recherche web de Hermes. La recherche native est désactivée avec les outils de fonction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen menggunakan pencarian web Hermes. Pencarian bawaan dinonaktifkan saat alat fungsi aktif."
