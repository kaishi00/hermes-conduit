    "Write to protected agent-instruction file(s): %@. These files steer future agent behavior; approval is always required (not bypassed by auto-approve)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In geschützte Agent-Anweisungsdatei(en) schreiben: %@. Diese Dateien steuern das künftige Verhalten des Agenten; eine Freigabe ist immer nötig (die automatische Freigabe gilt hier nicht)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir en archivos protegidos de instrucciones del agente: %@. Estos archivos guían el comportamiento futuro del agente; siempre requieren aprobación (la aprobación automática no se aplica)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire dans un ou plusieurs fichiers protégés d'instructions de l'agent : %@. Ces fichiers orientent le comportement futur de l'agent ; une approbation est toujours requise (l'approbation automatique ne s'applique pas)."
          }
        },
        "id" : {
          "stringUnit" : {
