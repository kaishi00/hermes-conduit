    "Every call's log also reaches your iPhone, where Voice settings > Apple Watch can share it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll jedes Anrufs gelangt auch auf dein iPhone, wo du es unter „Spracheinstellungen“ > „Apple Watch“ teilen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de cada llamada también llega a tu iPhone, donde puedes compartirlo desde Ajustes > Voz > Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal de chaque appel est aussi envoyé à votre iPhone, où Réglages Voix > Apple Watch permet de le partager."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log setiap panggilan juga dikirim ke iPhone Anda, tempat pengaturan Suara > Apple Watch dapat membagikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro di ogni chiamata arriva anche su iPhone, dove puoi condividerlo da Impostazioni Voce > Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各通話のログは iPhone にも届き、音声設定 > Apple Watch から共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 통화의 로그는 iPhone에도 전송되며, ‘음성’ 설정 > ‘Apple Watch’에서 공유할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennik każdego połączenia trafia też na Twój iPhone, gdzie można go udostępnić w sekcji Ustawienia głosu > Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro de cada chamada também chega ao iPhone, onde você pode compartilhá-lo em ajustes de Voz > Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал каждого звонка также передаётся на iPhone, где им можно поделиться в разделе «Настройки › Голос › Apple Watch»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her aramanın günlüğü iPhone'unuza da ulaşır; orada Ses ayarları > Apple Watch bölümünden paylaşılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次通话的日志也会发送到 iPhone，可在“语音设置 > Apple Watch”中共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次通話的記錄也會傳送到你的 iPhone，你可以在「語音」設定 >「Apple Watch」中分享。"
          }
        }
      }
    },
    "GPT-Live" : {
      "localizations" : {
        "de" : {
