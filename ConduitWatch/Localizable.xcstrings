{
  "sourceLanguage" : "en",
  "strings" : {
    "Add a Gemini API key on your Hermes server." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesサーバにGemini APIキーを追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Hermes 服务器上添加 Gemini API 密钥。"
          }
        }
      }
    },
    "Approve once" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回だけ承認"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准一次"
          }
        }
      }
    },
    "Approve this command?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコマンドを承認しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准此命令？"
          }
        }
      }
    },
    "Asking your iPhone to set up the call" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone に通話の準備を依頼しています"
