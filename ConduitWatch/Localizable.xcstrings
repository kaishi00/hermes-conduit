  "strings" : {
    "Add a Gemini API key on your Hermes server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge auf deinem Hermes-Server einen Gemini-API-Schlüssel hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una clave de API de Gemini en tu servidor Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une clé API Gemini sur votre serveur Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kunci API Gemini di server Hermes Anda."
          }
        },
        "it" : {
