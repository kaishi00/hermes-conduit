        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나와 Hermes가 말하는 내용이 여기에 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawi się to, co mówicie Ty i Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você e o Hermes disserem aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появится то, что говорите вы и Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
