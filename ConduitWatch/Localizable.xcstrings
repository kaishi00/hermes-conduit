    "The iPhone's GPT-Live call couldn't be read. Update Conduit on both devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der GPT-Live-Anruf des iPhone konnte nicht gelesen werden. Aktualisiere Conduit auf beiden Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
