            "value" : "iPhone의 세션 정보를 읽을 수 없었어요. 두 기기 모두에서 Conduit을 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać sesji z iPhone’a. Zaktualizuj Conduit na obu urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
