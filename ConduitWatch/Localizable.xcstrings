    "Opening Conduit starts a call right away. Turn this off to start each call with a tap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Öffnen von Conduit startet sofort ein Anruf. Schalte dies aus, um jeden Anruf per Tippen zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir Conduit se inicia una llamada al instante. Desactívalo para iniciar cada llamada con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Conduit lance immédiatement un appel. Désactivez cette option pour lancer chaque appel d'un toucher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka Conduit langsung memulai panggilan. Matikan ini untuk memulai setiap panggilan dengan ketukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendo Conduit si avvia subito una chiamata. Disattiva questa opzione per avviare ogni chiamata con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitを開くとすぐに通話が始まります。オフにすると、通話はタップで始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit을 열면 바로 통화가 시작돼요. 끄면 통화를 매번 탭해서 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwarcie Conduit od razu rozpoczyna połączenie. Wyłącz tę opcję, aby każde połączenie rozpoczynać stuknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir o Conduit inicia uma chamada na hora. Desative para iniciar cada chamada com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При открытии Conduit звонок начинается сразу. Выключите, чтобы начинать каждый звонок касанием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit'i açmak hemen bir arama başlatır. Her aramayı bir dokunuşla başlatmak için bunu kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Conduit 即立刻开始通话。关闭后，每次通话需轻点开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 Conduit 會立即開始通話。關閉此選項後，每次通話都要點一下才會開始。"
          }
        }
      }
    },
