        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在请 iPhone 设置通话"
          }
        }
      }
    },
    "Call didn't work" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话失败"
          }
        }
      }
    },
    "Call ended" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話が終了しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话已结束"
          }
        }
      }
    },
    "Call log" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話ログ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话日志"
          }
        }
      }
    },
    "Calls need Conduit on your iPhone to start. Once a call is on, it carries on with your wrist down and your iPhone locked." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話の開始には iPhone の Conduit が必要です。通話が始まれば、手首を下ろしても iPhone がロックされても続きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始通话需要 iPhone 上的 Conduit。通话开始后，即使放下手腕、iPhone 锁定，通话也会继续。"
          }
        }
      }
    },
    "Clear" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消去"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除"
          }
        }
      }
    },
    "Clear the Watch call log?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch の通話ログを消去しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Watch 通话日志？"
          }
        }
      }
    },
    "Conduit" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit"
          }
        }
      }
    },
    "Conduit needs the microphone. Allow it in Settings on your Watch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit にはマイクが必要です。Watch の設定で許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 需要使用麦克风。请在 Watch 的设置中允许。"
          }
        }
      }
    },
    "Conduit on the iPhone didn't answer in time." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の Conduit が時間内に応答しませんでした。"
