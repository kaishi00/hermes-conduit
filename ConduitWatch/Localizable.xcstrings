    "Conduit needs the microphone. Allow it in Settings on your Watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit benötigt das Mikrofon. Erlaube den Zugriff in den Einstellungen deiner Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit necesita el micrófono. Permítelo en Ajustes en tu Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit a besoin du micro. Autorisez-le dans Réglages sur votre Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit にはマイクが必要です。Watch の設定で許可してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit precisa do microfone. Permita o acesso nos Ajustes do Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit нужен доступ к микрофону. Разрешите его в приложении «Настройки» на часах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 需要使用麦克风。请在 Watch 的设置中允许。"
          }
        }
      }
    },
    "Conduit on the iPhone didn't answer in time." : {
      "localizations" : {
