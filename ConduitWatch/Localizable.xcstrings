    "Conduit on the iPhone sent something this Watch app can't read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit auf dem iPhone hat etwas gesendet, das diese Watch-App nicht lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit en el iPhone envió algo que esta app del Apple Watch no puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit sur l'iPhone a envoyé des données que cette app Apple Watch ne peut pas lire."
