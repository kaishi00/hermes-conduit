    "Hermes started %@, not Grok. Update Conduit and the conduit_push plugin together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes hat %@ statt Grok gestartet. Aktualisiere Conduit und das conduit_push-Plug-in gemeinsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes inició %@, no Grok. Actualiza Conduit y el plugin conduit_push a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes a démarré %@, et non Grok. Mettez à jour Conduit et le plugin conduit_push en même temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes memulai %@, bukan Grok. Perbarui Conduit dan plugin conduit_push bersamaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ha avviato %@, non Grok. Aggiorna insieme Conduit e il plugin conduit_push."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes が Grok ではなく %@ を開始しました。Conduit と conduit_push プラグインを一緒にアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 Grok이 아닌 다른 엔진(%@)을 시작했어요. Conduit과 conduit_push 플러그인을 함께 업데이트하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes uruchomił %@ zamiast Groka. Zaktualizuj razem Conduit i wtyczkę conduit_push."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes iniciou o %@, não o Grok. Atualize o Conduit e o plugin conduit_push juntos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes запустил %@, а не Grok. Обновите Conduit и плагин conduit_push одновременно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes, Grok yerine %@ motorunu başlattı. Conduit'i ve conduit_push eklentisini birlikte güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 启动的是 %@，而不是 Grok。请同时更新 Conduit 和 conduit_push 插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 啟動的是 %@，而不是 Grok。請同時更新 Conduit 和 conduit_push 外掛程式。"
          }
        }
      }
    },
