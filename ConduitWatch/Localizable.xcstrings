        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 통화의 Hermes 접근 권한이 만료되어 작업의 요청에 답할 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp tego połączenia do Hermesa wygasł, więc nie może ono odpowiedzieć na prośbę zlecenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso desta chamada ao Hermes expirou, então ela não pode responder ao pedido do trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ этого звонка к Hermes истёк, поэтому он не может ответить на запрос задания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aramanın Hermes erişimi sona erdi; bu nedenle işin isteğini yanıtlayamıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通话对 Hermes 的访问已过期，因此无法回复任务的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此通話對 Hermes 的存取權已到期，因此無法回答工作的要求。"
          }
        }
      }
    },
